---
import { nav, site } from '../data/site';
const current = Astro.url.pathname;
---
<header class="site-header">
  <div class="utility">
    <div class="container utility-inner">
      <span>501(c)(3) nonprofit recovery housing in Pittsburgh</span>
      <a href={site.phoneHref}>Call {site.phone}</a>
    </div>
  </div>
  <div class="nav-wrap">
    <div class="container nav-inner">
      <a class="wordmark" href="/" aria-label="New Beginnings home">
        <span>New Beginnings</span>
        <small>Transitional Living Foundation</small>
      </a>
      <button class="menu-button" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="site-nav">
        <span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
      <nav id="site-nav" aria-label="Primary navigation">
        {nav.map((item) => <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>)}
        <a class="nav-cta" href="/contact/#inquiry">Ask about housing</a>
      </nav>
    </div>
  </div>
</header>
<script>
  const button = document.querySelector('.menu-button');
  const nav = document.querySelector('#site-nav');
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    button.setAttribute('aria-label', open ? 'Open navigation menu' : 'Close navigation menu');
    nav?.classList.toggle('is-open', !open);
  });
</script>
<style>
  .site-header { position: sticky; z-index: 100; top: 0; box-shadow: 0 1px 0 rgba(23,55,70,.08); }
  .utility { color: var(--white); background: var(--navy-950); font-size: .86rem; }
  .utility-inner { display: flex; min-height: 2.25rem; align-items: center; justify-content: space-between; gap: 1rem; }
  .utility a { color: var(--white); font-weight: 700; }
  .nav-wrap { background: rgba(255,254,250,.98); }
  .nav-inner { display: flex; min-height: 5rem; align-items: center; justify-content: space-between; gap: 2rem; }
  .wordmark { display: grid; color: var(--navy-950); line-height: 1; text-decoration: none; }
  .wordmark span { font-size: 1.45rem; font-weight: 780; letter-spacing: -.025em; }
  .wordmark small { margin-top: .3rem; color: var(--slate-600); font-size: .71rem; font-weight: 650; letter-spacing: .075em; text-transform: uppercase; }
  nav { display: flex; align-items: center; gap: clamp(.75rem, 1.4vw, 1.45rem); }
  nav > a { color: var(--navy-950); font-size: .93rem; font-weight: 650; text-decoration: none; }
  nav > a[aria-current='page'] { color: var(--teal-700); }
  nav .nav-cta { padding: .75rem 1rem; border-radius: var(--radius); background: var(--teal-700); color: var(--white); }
  .menu-button { display: none; width: 3rem; height: 3rem; padding: .7rem; border: 0; background: transparent; color: var(--navy-950); }
  .menu-icon { display: grid; gap: .32rem; }
  .menu-icon i { display: block; width: 100%; height: 2px; background: currentColor; transition: transform .15s ease, opacity .15s ease; }
  .menu-button[aria-expanded='true'] .menu-icon i:first-child { transform: translateY(.44rem) rotate(45deg); }
  .menu-button[aria-expanded='true'] .menu-icon i:nth-child(2) { opacity: 0; }
  .menu-button[aria-expanded='true'] .menu-icon i:last-child { transform: translateY(-.44rem) rotate(-45deg); }
  @media (max-width: 980px) {
    .menu-button { display: block; }
    nav { position: absolute; inset: 7.25rem 0 auto; display: none; padding: 1rem; border-top: 1px solid var(--slate-200); background: var(--paper); box-shadow: var(--shadow); }
    nav.is-open { display: grid; }
    nav > a { padding: .75rem; }
  }
  @media (max-width: 520px) {
    .utility-inner span { display: none; }
    .utility-inner { justify-content: flex-end; }
    .wordmark span { font-size: 1.2rem; }
    .wordmark small { font-size: .62rem; }
  }
</style>
