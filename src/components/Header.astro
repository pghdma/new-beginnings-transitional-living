---
import { nav, site } from '../data/site';
const current = Astro.url.pathname;
const isCurrent = (href: string) => current === href || (href !== '/' && current.startsWith(href));
---
<header class="site-header">
  <div class="utility">
    <div class="container utility-inner">
      <span>501(c)(3) Pittsburgh nonprofit <i aria-hidden="true">·</i> DDAP-licensed residences <i aria-hidden="true">·</i> WestPARR inspected</span>
      <a href={site.phoneHref}>Call {site.phone}</a>
    </div>
  </div>
  <div class="nav-wrap">
    <div class="container nav-inner">
      <a class="wordmark" href="/" aria-label="New Beginnings home">
        <span>New Beginnings</span>
        <small>Transitional Living Foundation</small>
      </a>
      <button class="menu-button" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="site-nav">
        <span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
      <nav id="site-nav" aria-label="Primary navigation">
        {nav.map((item, index) => 'children' in item ? (
          <div class:list={['nav-group', { 'is-current': isCurrent(item.href) }]}>
            <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
            <button
              class="submenu-toggle"
              type="button"
              aria-label={`Open ${item.label} menu`}
              aria-expanded="false"
              aria-controls={`submenu-${index}`}
            >
              <span aria-hidden="true"></span>
            </button>
            <div class="submenu" id={`submenu-${index}`}>
              {item.children.map((child) => (
                <a
                  href={child.href}
                  aria-current={current === child.href && child.href !== item.href ? 'page' : undefined}
                >
                  {child.label}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
        <a class="nav-cta" href="/admissions/#inquiry">Ask about housing</a>
      </nav>
    </div>
  </div>
</header>
<script>
  const menuButton = document.querySelector<HTMLButtonElement>('.menu-button');
  const primaryNav = document.querySelector<HTMLElement>('#site-nav');
  const groups = Array.from(document.querySelectorAll<HTMLElement>('.nav-group'));

  const closeGroup = (group: HTMLElement) => {
    group.classList.remove('is-open');
    const toggle = group.querySelector<HTMLButtonElement>('.submenu-toggle');
    toggle?.setAttribute('aria-expanded', 'false');
    if (toggle) toggle.setAttribute('aria-label', `Open ${toggle.getAttribute('aria-label')?.replace(/^(Open|Close) | menu$/g, '')} menu`);
  };

  const closeGroups = (except?: HTMLElement) => {
    groups.forEach((group) => {
      if (group !== except) closeGroup(group);
    });
  };

  menuButton?.addEventListener('click', () => {
    const open = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', String(!open));
    menuButton.setAttribute('aria-label', open ? 'Open navigation menu' : 'Close navigation menu');
    primaryNav?.classList.toggle('is-open', !open);
    if (open) closeGroups();
  });

  groups.forEach((group) => {
    const toggle = group.querySelector<HTMLButtonElement>('.submenu-toggle');
    toggle?.addEventListener('click', () => {
      const open = group.classList.contains('is-open');
      closeGroups(group);
      group.classList.toggle('is-open', !open);
      toggle.setAttribute('aria-expanded', String(!open));
      const label = group.querySelector<HTMLAnchorElement>(':scope > a')?.textContent?.trim() ?? '';
      toggle.setAttribute('aria-label', `${open ? 'Open' : 'Close'} ${label} menu`);
    });
    group.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeGroup(group);
        toggle?.focus();
      }
    });
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (target instanceof Node && !primaryNav?.contains(target)) closeGroups();
  });
</script>
<style>
  .site-header { position: sticky; z-index: 100; top: 0; box-shadow: 0 1px 0 rgba(23,55,70,.08); }
  .utility { color: var(--white); background: var(--navy-950); font-size: .86rem; }
  .utility-inner { display: flex; min-height: 2.25rem; align-items: center; justify-content: space-between; gap: 1rem; }
  .utility-inner span { display: flex; align-items: center; gap: .55rem; }
  .utility-inner i { color: var(--slate-300); font-style: normal; }
  .utility a { color: var(--white); font-weight: 700; }
  .nav-wrap { background: rgba(255,254,250,.98); }
  .nav-inner { display: flex; min-height: 5rem; align-items: center; justify-content: space-between; gap: 2rem; }
  .wordmark { display: grid; color: var(--navy-950); line-height: 1; text-decoration: none; }
  .wordmark span { font-size: 1.45rem; font-weight: 780; letter-spacing: -.025em; }
  .wordmark small { margin-top: .3rem; color: var(--slate-600); font-size: .71rem; font-weight: 650; letter-spacing: .075em; text-transform: uppercase; }
  nav { display: flex; align-items: center; gap: clamp(.65rem, 1vw, 1.15rem); }
  nav a { color: var(--navy-950); font-size: .9rem; font-weight: 650; text-decoration: none; }
  nav > a[aria-current='page'], .nav-group.is-current > a, .nav-group > a[aria-current='page'] { color: var(--teal-700); }
  .nav-group { position: relative; display: flex; align-items: center; gap: .22rem; }
  .submenu-toggle { display: grid; width: 1.5rem; height: 1.75rem; padding: 0; place-items: center; border: 0; background: transparent; color: var(--navy-950); cursor: pointer; }
  .submenu-toggle span { width: .45rem; height: .45rem; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-.12rem) rotate(45deg); transition: transform .15s ease; }
  .nav-group.is-open .submenu-toggle span { transform: translateY(.1rem) rotate(225deg); }
  .submenu { position: absolute; z-index: 2; top: calc(100% + 1.15rem); left: -.85rem; display: grid; width: max-content; min-width: 15.5rem; padding: .65rem; border: 1px solid var(--slate-200); border-radius: var(--radius); background: var(--paper); box-shadow: var(--shadow); opacity: 0; visibility: hidden; transform: translateY(-.35rem); pointer-events: none; transition: opacity .15s ease, transform .15s ease, visibility .15s ease; }
  .submenu::before { position: absolute; right: 0; bottom: 100%; left: 0; height: 1.2rem; content: ''; }
  .submenu a { padding: .7rem .8rem; border-radius: calc(var(--radius) - 2px); }
  .submenu a:hover, .submenu a:focus-visible, .submenu a[aria-current='page'] { background: var(--slate-100); color: var(--teal-700); }
  .nav-group:hover .submenu, .nav-group.is-open .submenu { opacity: 1; visibility: visible; transform: translateY(0); pointer-events: auto; }
  nav .nav-cta { padding: .75rem 1rem; border-radius: var(--radius); background: var(--teal-700); color: var(--white); }
  .menu-button { display: none; width: 3rem; height: 3rem; padding: .7rem; border: 0; background: transparent; color: var(--navy-950); }
  .menu-icon { display: grid; gap: .32rem; }
  .menu-icon i { display: block; width: 100%; height: 2px; background: currentColor; transition: transform .15s ease, opacity .15s ease; }
  .menu-button[aria-expanded='true'] .menu-icon i:first-child { transform: translateY(.44rem) rotate(45deg); }
  .menu-button[aria-expanded='true'] .menu-icon i:nth-child(2) { opacity: 0; }
  .menu-button[aria-expanded='true'] .menu-icon i:last-child { transform: translateY(-.44rem) rotate(-45deg); }
  @media (max-width: 980px) {
    .menu-button { display: block; }
    nav { position: absolute; inset: 7.25rem 0 auto; display: none; max-height: calc(100vh - 7.25rem); padding: 1rem; overflow-y: auto; border-top: 1px solid var(--slate-200); background: var(--paper); box-shadow: var(--shadow); }
    nav.is-open { display: grid; }
    nav > a { padding: .75rem; }
    .nav-group { display: grid; grid-template-columns: 1fr auto; gap: 0; }
    .nav-group > a { padding: .75rem; }
    .submenu-toggle { width: 3rem; height: 3rem; }
    .submenu { position: static; display: none; width: auto; min-width: 0; margin: 0 .75rem .55rem; padding: .25rem 0 .25rem .85rem; grid-column: 1 / -1; border: 0; border-left: 1px solid var(--slate-200); border-radius: 0; box-shadow: none; opacity: 1; visibility: visible; transform: none; pointer-events: auto; transition: none; }
    .submenu::before { display: none; }
    .nav-group:hover .submenu, .nav-group:focus-within .submenu { display: none; }
    .nav-group.is-open .submenu { display: grid; }
    .submenu a { padding: .7rem .8rem; }
  }
  @media (max-width: 520px) {
    .utility-inner span { display: none; }
    .utility-inner { justify-content: flex-end; }
    .wordmark span { font-size: 1.2rem; }
    .wordmark small { font-size: .62rem; }
  }
</style>
