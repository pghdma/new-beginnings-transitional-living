---
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';
interface Props {
  eyebrow?: string;
  title?: string;
  text?: string;
  href?: string;
  label?: string;
  phone?: boolean;
}
const {
  eyebrow = 'Take the Next Step',
  title = 'Looking for a Sober Place to Live?',
  text = `Call ${site.phone} or send the application. We’ll tell you what’s open, what it costs, and what the house expects.`,
  href = '/admissions/',
  label = 'Apply for Housing',
  phone = true,
} = Astro.props;
---
<section class="cta-band">
  <div class="container cta-band__inner">
    <div class="cta-band__copy">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="actions">
      <a class="button button--light" href={href}>{label}<Icon name="lucide:arrow-right" aria-hidden="true" /></a>
      {phone && <a class="button button--outline-light" href={site.phoneHref}><Icon name="lucide:phone" aria-hidden="true" />Call {site.phone}</a>}
    </div>
  </div>
</section>
<style>
  .cta-band { position: relative; overflow: hidden; }
  .cta-band .eyebrow { margin-bottom: var(--space-3); color: var(--accent-on-dark); }
  .cta-band__copy, .actions { position: relative; z-index: 1; }
  @media (max-width: 760px) {
    .actions { display: grid; align-items: stretch; }
    .button { width: 100%; }
  }
</style>
