---
import { site } from '../data/site';
interface Props {
  eyebrow?: string;
  title?: string;
  text?: string;
  href?: string;
  label?: string;
  phone?: boolean;
}
const {
  eyebrow = 'Take the next step',
  title = 'Looking for recovery housing?',
  text = 'Start with a private, general conversation. We will explain the current process and what happens next.',
  href = '/admissions/',
  label = 'Admissions information',
  phone = true,
} = Astro.props;
---
<section class="cta-band">
  <div class="container cta-band__inner">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="actions">
      <a class="button button--light" href={href}>{label}</a>
      {phone && <a class="phone" href={site.phoneHref}>Call {site.phone}</a>}
    </div>
  </div>
</section>
<style>
  .cta-band .eyebrow { margin-bottom: var(--space-3); color: #9ed7d2; }
  .phone { color: var(--white); font-weight: 750; }
  @media (max-width: 520px) { .actions { align-items: flex-start; flex-direction: column; } }
</style>
