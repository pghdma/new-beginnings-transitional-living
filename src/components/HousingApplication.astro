---
import { site } from '../data/site';
---

<section class="application" id="inquiry" aria-labelledby="application-title">
  <div class="container application-shell">
    <header class="application-heading">
      <p class="eyebrow">Housing Application</p>
      <h2 id="application-title">Start With the Practical Details</h2>
      <p>
        This three step form begins the conversation about housing and current availability.
        It does not replace the private admissions process or guarantee a room.
      </p>
      <p class="call-option">Prefer to speak with someone? <a class="inline-link" href={site.phoneHref}>Call {site.phone}.</a></p>
      <p class="form-required-note">All fields are required unless marked optional.</p>
    </header>

    <form data-housing-application novalidate>
      <nav class="form-progress" aria-label="Application Progress">
        <p class="progress-summary" data-progress-summary aria-live="polite">Step 1 of 3: Primary Contact</p>
        <ol>
          <li class="is-current" data-progress-step="1" aria-current="step"><span>1</span><strong>Primary Contact</strong></li>
          <li data-progress-step="2"><span>2</span><strong>Applicant and Housing</strong></li>
          <li data-progress-step="3"><span>3</span><strong>Final Details</strong></li>
        </ol>
      </nav>

      <fieldset class="form-section" data-form-step="1">
        <legend tabindex="-1"><strong>Primary Contact</strong></legend>
        <p class="section-intro">Tell us who should receive the response to this application.</p>
        <div class="form-grid">
          <label>First Name<input required autocomplete="given-name" name="firstName" maxlength="100" /></label>
          <label>Last Name<input required autocomplete="family-name" name="lastName" maxlength="100" /></label>
          <label>Email<input required type="email" autocomplete="email" name="email" maxlength="254" /></label>
          <label>Phone<input required type="tel" autocomplete="tel" name="phone" maxlength="20" /></label>
        </div>
        <fieldset class="choice-group">
          <legend>Who Is Completing This Application?</legend>
          <div class="choice-grid choice-grid--three">
            <label class="choice"><input required type="radio" name="contactType" value="Applicant" data-contact-type /><span><strong>Applicant</strong><small>I am applying for myself.</small></span></label>
            <label class="choice"><input required type="radio" name="contactType" value="Family or support person" data-contact-type /><span><strong>Family or Support Person</strong><small>I am helping someone apply.</small></span></label>
            <label class="choice"><input required type="radio" name="contactType" value="Professional or referral partner" data-contact-type /><span><strong>Professional Assisting an Applicant</strong><small>I am helping someone begin a housing inquiry.</small></span></label>
          </div>
        </fieldset>
        <fieldset class="choice-group">
          <legend>Preferred Contact Method</legend>
          <div class="choice-grid choice-grid--two compact-choices">
            <label class="choice"><input required type="radio" name="preferredContact" value="Phone" /><span><strong>Phone</strong></span></label>
            <label class="choice"><input required type="radio" name="preferredContact" value="Email" /><span><strong>Email</strong></span></label>
          </div>
        </fieldset>
        <label class="select-field">Best Time to Reach You <small>(optional)</small><select name="bestTime"><option value="">Any time</option><option value="Morning">Morning</option><option value="Afternoon">Afternoon</option><option value="Evening">Evening</option></select></label>
        <div class="step-actions step-actions--forward">
          <button class="button" type="button" data-next-step>Continue to Applicant and Housing</button>
        </div>
      </fieldset>

      <fieldset class="form-section" data-form-step="2" hidden>
        <legend tabindex="-1"><strong>Applicant and Housing</strong></legend>
        <p class="section-intro">General answers are enough. Sensitive records are not needed on this public form.</p>
        <div class="form-grid applicant-fields" data-applicant-fields hidden>
          <label>Applicant First Name<input name="applicantFirstName" maxlength="100" data-applicant-required /></label>
          <label>Applicant Last Name<input name="applicantLastName" maxlength="100" data-applicant-required /></label>
        </div>
        <fieldset class="choice-group">
          <legend>Housing Requested</legend>
          <div class="choice-grid choice-grid--two">
            <label class="choice"><input required type="radio" name="housingType" value="Men's recovery housing" /><span><strong>Men's Recovery Housing</strong><small>Shared recovery housing for adult men.</small></span></label>
            <label class="choice"><input required type="radio" name="housingType" value="Women's recovery housing" /><span><strong>Women's Recovery Housing</strong><small>Shared recovery housing for adult women.</small></span></label>
          </div>
        </fieldset>
        <fieldset class="choice-group">
          <legend>Is the Applicant 18 or Older?</legend>
          <div class="choice-grid choice-grid--two compact-choices">
            <label class="choice"><input required type="radio" name="adultStatus" value="Yes" /><span><strong>Yes</strong></span></label>
            <label class="choice"><input required type="radio" name="adultStatus" value="No" /><span><strong>No</strong></span></label>
          </div>
        </fieldset>
        <label class="select-field">Desired Move Timing<select name="moveTiming" required><option value="">Select one</option><option value="As soon as available">As soon as available</option><option value="Within two weeks">Within two weeks</option><option value="Within 30 days">Within 30 days</option><option value="Planning ahead">Planning ahead</option></select></label>
        <fieldset class="choice-group">
          <legend>Has the Applicant Lived With New Beginnings Before?</legend>
          <div class="choice-grid choice-grid--two compact-choices">
            <label class="choice"><input required type="radio" name="previousResident" value="Yes" /><span><strong>Yes</strong></span></label>
            <label class="choice"><input required type="radio" name="previousResident" value="No" /><span><strong>No</strong></span></label>
          </div>
        </fieldset>
        <fieldset class="choice-group">
          <legend>Is the Applicant Willing to Live in a Substance Free Shared Home and Follow House Expectations?</legend>
          <div class="choice-grid choice-grid--two compact-choices">
            <label class="choice"><input required type="radio" name="sharedLivingAgreement" value="Yes" /><span><strong>Yes</strong></span></label>
            <label class="choice"><input required type="radio" name="sharedLivingAgreement" value="No" /><span><strong>No</strong></span></label>
          </div>
        </fieldset>
        <div class="step-actions">
          <button class="button button-secondary" type="button" data-previous-step>Back</button>
          <button class="button" type="button" data-next-step>Continue to Final Details</button>
        </div>
      </fieldset>

      <fieldset class="form-section" data-form-step="3" hidden>
        <legend tabindex="-1"><strong>Final Details</strong></legend>
        <p class="section-intro">Add any general information that would help staff prepare for the first conversation.</p>
        <label class="select-field">Primary Referral Source <small>(optional)</small><select name="referralSource"><option value="">Select one</option><option value="Treatment provider">Treatment provider</option><option value="Court or justice partner">Court or justice partner</option><option value="Family or friend">Family or friend</option><option value="Community organization">Community organization</option><option value="Online search">Online search</option><option value="Other">Other</option></select></label>
        <label>Questions or General Information <small>(optional)</small><textarea name="message" rows="5" maxlength="2000" aria-describedby="message-guidance"></textarea></label>
        <p class="field-guidance" id="message-guidance">Do not include diagnoses, medications, treatment records, legal records, Social Security numbers, or other sensitive information.</p>
        <label class="check-choice"><input type="checkbox" name="accommodationDiscussion" value="Yes" /><span>I would like to discuss accessibility or accommodation needs privately.</span></label>
        <label class="check-choice"><input required type="checkbox" name="applicationAcknowledgement" value="Yes" /><span>I understand that submitting this application starts a review and does not guarantee availability or admission.</span></label>
        <label class="trap" aria-hidden="true">Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label>
        <input type="hidden" name="startedAt" value="" />
        <div class="submission-area">
          <div>
            <p class="privacy-note">This public form is not a secure place for medical, treatment, financial, or legal records. <a href="/privacy/">Read the Privacy Policy.</a></p>
            <div class="verification">
              <p>Security Check</p>
              <div class="cf-turnstile" data-turnstile-widget data-sitekey="0x4AAAAAADr9GhJthRcT4-R1"></div>
            </div>
          </div>
          <div class="submit-block">
            <button class="button" type="submit" data-submit-button data-default-label="Submit Application">Submit Application</button>
            <p class="status" role="status" aria-live="polite" aria-atomic="true"></p>
          </div>
        </div>
        <div class="step-actions step-actions--back-only">
          <button class="button button-secondary" type="button" data-previous-step>Back</button>
        </div>
      </fieldset>
    </form>
  </div>
</section>

<script is:inline>
  window.onNbtsApplicationTurnstileReady = function () {
    document.querySelectorAll('[data-turnstile-widget]').forEach(function (widget) {
      if (widget.dataset.widgetId) return;
      var widgetId = window.turnstile.render(widget, {
        sitekey: widget.dataset.sitekey,
        theme: 'light',
        action: 'housing_application',
        size: window.matchMedia('(max-width: 419px)').matches ? 'compact' : 'flexible'
      });
      widget.dataset.widgetId = widgetId;
    });
  };
</script>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onNbtsApplicationTurnstileReady&render=explicit" async defer></script>
<script>
  const APPLICATION_ENDPOINT = 'https://nbts-contact.pghdma.workers.dev/api/contact';
  document.querySelectorAll<HTMLFormElement>('[data-housing-application]').forEach((form) => {
    const sections = Array.from(form.querySelectorAll<HTMLElement>('[data-form-step]'));
    const progressItems = Array.from(form.querySelectorAll<HTMLElement>('[data-progress-step]'));
    const progressSummary = form.querySelector<HTMLElement>('[data-progress-summary]');
    const started = form.querySelector<HTMLInputElement>('[name="startedAt"]');
    const status = form.querySelector<HTMLElement>('.status');
    const button = form.querySelector<HTMLButtonElement>('[data-submit-button]');
    const contactChoices = form.querySelectorAll<HTMLInputElement>('[data-contact-type]');
    const applicantFields = form.querySelector<HTMLElement>('[data-applicant-fields]');
    const applicantRequired = form.querySelectorAll<HTMLInputElement>('[data-applicant-required]');
    const stepNames = ['Primary Contact', 'Applicant and Housing', 'Final Details'];
    let currentStep = 1;
    const restartTimer = () => { if (started) started.value = String(Date.now()); };
    const updateApplicantFields = () => {
      const selected = form.querySelector<HTMLInputElement>('[data-contact-type]:checked');
      const needsApplicantName = Boolean(selected && selected.value !== 'Applicant');
      if (applicantFields) applicantFields.hidden = !needsApplicantName;
      applicantRequired.forEach((field) => {
        field.required = needsApplicantName;
        if (!needsApplicantName) field.value = '';
      });
    };
    const showStep = (step: number, moveFocus = true) => {
      currentStep = Math.min(Math.max(step, 1), sections.length);
      sections.forEach((section, index) => { section.hidden = index + 1 !== currentStep; });
      progressItems.forEach((item, index) => {
        const itemStep = index + 1;
        item.classList.toggle('is-current', itemStep === currentStep);
        item.classList.toggle('is-complete', itemStep < currentStep);
        if (itemStep === currentStep) item.setAttribute('aria-current', 'step');
        else item.removeAttribute('aria-current');
      });
      if (progressSummary) progressSummary.textContent = `Step ${currentStep} of ${sections.length}: ${stepNames[currentStep - 1]}`;
      if (moveFocus) {
        sections[currentStep - 1]?.querySelector<HTMLElement>(':scope > legend')?.focus({ preventScroll: true });
        form.scrollIntoView({ block: 'start', behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      }
    };
    const validateCurrentStep = () => {
      updateApplicantFields();
      const invalid = sections[currentStep - 1]?.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(':invalid');
      if (!invalid) return true;
      invalid.reportValidity();
      invalid.focus();
      return false;
    };
    const resetVerification = () => {
      const widget = form.querySelector<HTMLElement>('.cf-turnstile');
      const widgetId = widget?.dataset.widgetId;
      const turnstile = (window as typeof window & { turnstile?: { reset: (widgetId?: string) => void } }).turnstile;
      if (turnstile && widgetId) turnstile.reset(widgetId);
    };
    const setStatus = (message: string, type: 'success' | 'error' | 'sending' = 'sending') => {
      if (!status) return;
      status.textContent = message;
      status.dataset.state = type;
    };
    form.querySelectorAll<HTMLButtonElement>('[data-next-step]').forEach((next) => next.addEventListener('click', () => { if (validateCurrentStep()) showStep(currentStep + 1); }));
    form.querySelectorAll<HTMLButtonElement>('[data-previous-step]').forEach((previous) => previous.addEventListener('click', () => showStep(currentStep - 1)));
    contactChoices.forEach((choice) => choice.addEventListener('change', updateApplicantFields));
    updateApplicantFields();
    showStep(1, false);
    restartTimer();
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      updateApplicantFields();
      if (!form.reportValidity()) return;
      const formData = new FormData(form);
      if (!formData.get('cf-turnstile-response')) {
        setStatus('Please complete the security check before submitting the application.', 'error');
        return;
      }
      const payload = Object.fromEntries(formData.entries()) as Record<string, FormDataEntryValue>;
      payload.context = 'housing';
      payload.loadtime = payload.startedAt || '';
      delete payload.startedAt;
      if (button) {
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        button.textContent = 'Submitting';
      }
      setStatus('Submitting your application.');
      try {
        const response = await fetch(APPLICATION_ENDPOINT, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        const result = await response.json().catch(() => null) as { success?: boolean; message?: string } | null;
        if (!response.ok || !result?.success) throw new Error(result?.message || 'We could not submit the application right now. Please call 412 628 0403.');
        form.reset();
        updateApplicantFields();
        setStatus(result.message || 'Thank you. Your application has been received by the website administrator for New Beginnings.', 'success');
      } catch (error) {
        setStatus(error instanceof Error ? error.message : 'We could not submit the application right now. Please call 412 628 0403.', 'error');
      } finally {
        restartTimer();
        resetVerification();
        if (button) {
          button.disabled = false;
          button.removeAttribute('aria-busy');
          button.textContent = button.dataset.defaultLabel || 'Submit Application';
        }
      }
    });
  });
</script>

<style>
  .application { padding-block: var(--section-standard); background: var(--sky-50); }
  .application-shell { max-width: var(--max-form); }
  .application-heading { display: grid; max-width: 48rem; margin: 0 auto var(--space-7); justify-items: center; gap: var(--space-3); text-align: center; }
  .application-heading h2 { max-width: 18ch; }
  .application-heading > p:not(.eyebrow):not(.form-required-note) { max-width: 62ch; font-size: 1.08rem; }
  .application-heading .form-required-note { font-size: var(--form-help-size); }
  .application-heading .call-option { font-size: .96rem; }
  .application-heading a { font-weight: var(--weight-semibold); }
  form { overflow: hidden; border: 1px solid var(--slate-200); border-radius: var(--radius-lg); background: var(--paper); box-shadow: var(--shadow-raised); scroll-margin-top: 7rem; }
  .form-progress { padding: var(--space-6) clamp(var(--space-6), 5vw, var(--space-8)); border-bottom: 1px solid var(--slate-200); background: var(--white); }
  .form-progress ol { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; }
  .form-progress li { position: relative; display: grid; grid-template-columns: 2.25rem minmax(0, 1fr); color: var(--slate-500); align-items: center; gap: var(--space-3); }
  .form-progress li:not(:last-child)::after { position: absolute; top: 50%; right: var(--space-4); left: calc(2.25rem + var(--space-4)); height: 1px; background: var(--slate-200); content: ''; }
  .form-progress li span { display: grid; width: 2.25rem; height: 2.25rem; border: 1px solid var(--slate-300); border-radius: 50%; background: var(--white); font-weight: var(--weight-semibold); place-items: center; }
  .form-progress li strong { position: relative; z-index: 1; width: fit-content; padding-right: var(--space-3); background: var(--white); font-size: .92rem; font-weight: var(--weight-heading); }
  .form-progress li.is-current { color: var(--navy-900); }
  .form-progress li.is-current span { border-color: var(--teal-700); background: var(--teal-700); color: var(--white); }
  .form-progress li.is-complete { color: var(--teal-700); }
  .form-progress li.is-complete span { border-color: var(--teal-700); color: var(--teal-700); }
  .progress-summary { display: none; }
  .form-section { display: grid; min-width: 0; margin: 0; padding: clamp(var(--space-6), 5vw, var(--space-8)); border: 0; gap: var(--space-5); }
  .form-section[hidden] { display: none; }
  .form-section > legend { display: grid; width: 100%; padding: 0; color: var(--navy-900); }
  .form-section > legend strong { font-size: var(--type-section-compact); font-weight: var(--weight-heading); line-height: 1.15; }
  .section-intro { max-width: 58ch; margin-top: calc(var(--space-3) * -1); color: var(--slate-600); }
  .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); }
  .applicant-fields[hidden] { display: none; }
  label, .choice-group > legend { color: var(--navy-900); font-size: var(--form-label-size); font-weight: var(--weight-semibold); }
  label { display: grid; gap: var(--space-2); }
  label small { color: var(--slate-500); font-size: var(--form-help-size); font-weight: var(--weight-medium); }
  input:not([type="radio"]):not([type="checkbox"]), select, textarea { width: 100%; min-height: var(--control-min-height); padding: .78rem .9rem; border: var(--control-border); border-radius: var(--control-radius); background: var(--white); color: var(--slate-700); }
  input:not([type="radio"]):not([type="checkbox"]):focus, select:focus, textarea:focus { border-color: var(--teal-700); outline: 0; box-shadow: var(--focus-ring-soft); }
  textarea { min-height: 9rem; resize: vertical; }
  .choice-group { display: grid; min-width: 0; margin: 0; padding: 0; border: 0; gap: var(--space-3); }
  .choice-group > legend { padding: 0; }
  .choice-grid { display: grid; gap: var(--space-3); }
  .choice-grid--three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .choice-grid--two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .choice { position: relative; display: flex; min-height: 5.5rem; padding: var(--space-4); border: 1px solid var(--slate-300); border-radius: var(--radius); background: var(--white); cursor: pointer; align-items: flex-start; gap: var(--space-3); }
  .choice:hover { border-color: var(--teal-700); }
  .choice:has(input:checked) { border-color: var(--teal-700); background: var(--sky-100); box-shadow: inset 0 0 0 1px var(--teal-700); }
  .choice input { width: 1.1rem; height: 1.1rem; margin: .14rem 0 0; padding: 0; accent-color: var(--teal-700); flex: 0 0 auto; }
  .choice span { display: grid; gap: var(--space-1); }
  .choice strong { color: var(--navy-900); font-size: 1rem; font-weight: var(--weight-semibold); line-height: 1.25; }
  .choice small { color: var(--slate-600); font-size: .86rem; font-weight: var(--weight-regular); line-height: 1.4; }
  .compact-choices { max-width: 31rem; }
  .compact-choices .choice { min-height: 0; align-items: center; }
  .field-guidance { margin-top: calc(var(--space-3) * -1); color: var(--slate-600); font-size: .87rem; line-height: 1.45; }
  .check-choice { display: flex; padding: var(--space-4); border: 1px solid var(--slate-300); border-radius: var(--radius); background: var(--sky-50); align-items: flex-start; gap: var(--space-3); cursor: pointer; }
  .check-choice input { width: 1.15rem; height: 1.15rem; margin: .15rem 0 0; padding: 0; accent-color: var(--teal-700); flex: 0 0 auto; }
  .check-choice span { color: var(--slate-700); font-weight: var(--weight-medium); }
  .step-actions { display: flex; padding-top: var(--space-5); border-top: 1px solid var(--slate-200); justify-content: space-between; gap: var(--space-3); }
  .step-actions--forward { justify-content: flex-end; }
  .step-actions--back-only { padding-top: 0; border-top: 0; justify-content: flex-start; }
  .button-secondary { border: 1px solid var(--navy-900); background: transparent; color: var(--navy-900); }
  .submission-area { display: grid; grid-template-columns: minmax(0, 1fr) auto; padding-top: var(--space-5); border-top: 1px solid var(--slate-200); gap: var(--space-6); align-items: end; }
  .privacy-note { max-width: 60ch; color: var(--slate-600); font-size: var(--form-help-size); line-height: 1.5; }
  .privacy-note a { color: var(--blue-700); font-weight: var(--weight-semibold); text-decoration: underline; }
  .verification { display: grid; min-width: 0; margin-top: var(--space-4); gap: var(--space-2); }
  .verification > p { color: var(--slate-700); font-size: .9rem; font-weight: var(--weight-semibold); }
  .cf-turnstile { width: 100%; min-height: 65px; }
  .submit-block { display: grid; justify-items: stretch; gap: var(--space-3); }
  .submit-block .button { min-width: 13rem; }
  button:disabled { cursor: wait; opacity: .72; }
  .trap { position: absolute; left: -9999px; }
  .status { max-width: 24rem; min-height: 1.5em; color: var(--navy-800); font-size: var(--form-status-size); font-weight: var(--weight-heading); }
  .status[data-state="error"] { color: var(--error); }
  .status[data-state="success"] { color: var(--success); }
  @media (max-width: 760px) {
    .application-heading { margin-bottom: var(--space-6); }
    .form-progress { padding: var(--space-5) var(--space-6); }
    .form-progress ol { gap: var(--space-2); }
    .form-progress li { grid-template-columns: 2rem minmax(0, 1fr); gap: var(--space-2); }
    .form-progress li span { width: 2rem; height: 2rem; }
    .form-progress li:not(:last-child)::after { display: none; }
    .form-progress li strong { padding-right: 0; font-size: .82rem; }
    .form-section { padding: var(--space-6); }
    .choice-grid--three { grid-template-columns: 1fr; }
    .submission-area { grid-template-columns: 1fr; align-items: start; }
    .submit-block { justify-items: start; }
  }
  @media (max-width: 560px) {
    .application { padding-block: var(--space-7); }
    .form-progress ol { display: none; }
    .progress-summary { display: block; color: var(--navy-900); font-size: .92rem; font-weight: var(--weight-semibold); }
    .form-section { padding: var(--space-5); }
    .form-grid, .choice-grid--two { grid-template-columns: 1fr; }
    .choice { min-height: 0; }
    .step-actions { display: grid; grid-template-columns: 1fr; }
    .step-actions .button { width: 100%; }
    .step-actions .button-secondary { order: 2; }
    .submit-block, .submit-block .button { width: 100%; }
    .cf-turnstile { width: 150px; min-height: 140px; }
  }
</style>
