---
/**
 * StepList — numbered steps.
 *
 * variant="inline"  number beside a title and one line of copy (Home "Getting In", application rail)
 *                   numbers="text" prints 01/02/03; numbers="circle" prints a filled circle
 * variant="cards"   three cards with an icon, big ghost number, and a button (Professionals)
 * tone="light|dark" for the inline variant
 */
import { Icon } from 'astro-icon/components';

interface Step { title: string; copy: string; icon?: string; href?: string; label?: string }
interface Props {
  items: Step[];
  variant?: 'inline' | 'cards';
  numbers?: 'text' | 'circle';
  tone?: 'light' | 'dark';
  label?: string;
}
const { items, variant = 'inline', numbers = 'text', tone = 'light', label } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<ol class:list={['steps', `steps--${variant}`, `steps--${numbers}`, `steps--${tone}`]} aria-label={label}>
  {items.map((step, index) => variant === 'cards' ? (
    <li>
      <span aria-hidden="true">{pad(index + 1)}</span>
      {step.icon && <Icon name={`lucide:${step.icon}`} aria-hidden="true" />}
      <h3>{step.title}</h3>
      <p>{step.copy}</p>
      {step.href && step.label && <a class="button button--outline" href={step.href}>{step.label}</a>}
    </li>
  ) : (
    <li>
      <span aria-hidden="true">{numbers === 'text' ? pad(index + 1) : index + 1}</span>
      <div><h3>{step.title}</h3><p>{step.copy}</p></div>
    </li>
  ))}
</ol>

<style>
  .steps { display: grid; margin: 0; padding: 0; list-style: none; }

  /* inline */
  .steps--inline { gap: var(--space-5); }
  .steps--inline li { display: grid; grid-template-columns: 2.4rem minmax(0, 1fr); gap: var(--space-3); align-items: start; }
  .steps--inline h3 { color: var(--navy-900); font-size: 1.2rem; }
  .steps--inline p { max-width: 33rem; margin-top: .35rem; color: var(--slate-600); font-size: .96rem; line-height: 1.45; }
  .steps--text > li > span { padding-top: .15rem; color: var(--teal-700); font-size: .82rem; font-weight: var(--weight-bold); letter-spacing: .08em; }
  .steps--circle { gap: var(--space-4); }
  .steps--circle li { grid-template-columns: 1.85rem minmax(0, 1fr); }
  .steps--circle > li > span { display: grid; width: 1.85rem; height: 1.85rem; border-radius: 50%; color: var(--white); background: var(--teal-700); font-size: .85rem; font-weight: var(--weight-semibold); place-items: center; }
  .steps--circle h3 { font-family: var(--font-body); font-size: 1rem; font-weight: var(--weight-semibold); line-height: 1.3; }
  .steps--circle p { margin-top: .25rem; font-size: .95rem; line-height: 1.5; }
  .steps--dark h3 { color: var(--white); }
  .steps--dark p { color: var(--text-soft-on-dark); }
  .steps--dark.steps--text > li > span { color: var(--accent-on-dark-soft); }

  /* cards */
  .steps--cards { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }
  .steps--cards li { position: relative; display: flex; min-height: 25rem; padding: clamp(var(--space-6), 4vw, var(--space-7)); overflow: hidden; border-radius: var(--radius-lg); background: var(--sky-50); flex-direction: column; align-items: flex-start; }
  .steps--cards li:nth-child(2) { color: var(--white); background: var(--teal-700); }
  .steps--cards li:nth-child(3) { color: var(--white); background: var(--navy-900); }
  .steps--cards li > span { position: absolute; top: var(--space-5); right: var(--space-5); color: rgba(var(--ink-rgb), .15); font-size: 3.25rem; font-weight: var(--weight-semibold); line-height: 1; }
  .steps--cards li:nth-child(n + 2) > span { color: var(--border-on-dark); }
  .steps--cards li > :global(svg) { width: 2rem; height: 2rem; color: var(--teal-700); stroke-width: 1.55; }
  .steps--cards li:nth-child(n + 2) > :global(svg) { color: var(--accent-on-dark); }
  .steps--cards h3 { max-width: 14rem; margin-top: var(--space-6); }
  .steps--cards li:nth-child(n + 2) h3 { color: var(--white); }
  .steps--cards p { margin-top: var(--space-4); color: var(--slate-600); font-size: .95rem; line-height: 1.55; }
  .steps--cards li:nth-child(n + 2) p { color: var(--sky-100); }
  .steps--cards .button { width: 100%; margin-top: auto; padding-top: .8rem; padding-bottom: .8rem; }
  .steps--cards li:nth-child(n + 2) .button { border-color: var(--outline-on-dark); color: var(--white); }
  .steps--cards li:nth-child(n + 2) .button:hover { color: var(--navy-950); background: var(--white); }

  @media (max-width: 900px) {
    .steps--cards { grid-template-columns: 1fr; gap: var(--space-4); }
    .steps--cards li { min-height: 0; }
    .steps p { font-size: 1rem; line-height: 1.55; }
  }
</style>
