---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  compact?: boolean;
  plain?: boolean;
  actions?: boolean;
  variant?: 'image' | 'editorial' | 'compact';
  fact?: string;
}

const {
  eyebrow = 'New Beginnings',
  title,
  intro,
  image = '/images/hero-community.jpg',
  imageAlt = '',
  imageWidth = 1880,
  imageHeight = 1253,
  compact = false,
  plain = false,
  actions = false,
  variant = compact || plain ? 'compact' : 'image',
  fact,
} = Astro.props;

const showImage = !plain && variant !== 'compact';
---
<section class:list={['page-hero', `page-hero--${variant}`, { 'page-hero--plain': plain }]}>
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      {intro && <p class="lead">{intro}</p>}
      {fact && <p class="hero-fact">{fact}</p>}
      {actions && <div class="actions"><a class="button" href="/admissions/#inquiry">Ask about housing</a><a class="phone-link" href="tel:+14126280403">Call 412-628-0403</a></div>}
    </div>
    {showImage && <figure><img src={image} alt={imageAlt} width={imageWidth} height={imageHeight} loading="eager" /></figure>}
  </div>
</section>
<style>
  .page-hero { position: relative; overflow: hidden; }
  .hero-grid { display: grid; align-items: stretch; }
  .hero-copy { display: grid; align-content: center; gap: var(--space-5); }
  .hero-copy h1 { max-width: 14ch; }
  .hero-copy .lead { max-width: 39rem; }
  figure { margin: 0; overflow: hidden; }
  img { width: 100%; height: 100%; object-fit: cover; }
  .phone-link { color: var(--navy-950); font-weight: 650; }
  .hero-fact { max-width: 34rem; color: var(--slate-600); font-size: .95rem; font-weight: 600; }

  .page-hero--image { background: linear-gradient(110deg, var(--sky-50), var(--canvas)); }
  .page-hero--image .hero-grid { min-height: clamp(34rem, 52vw, 43rem); grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); }
  .page-hero--image .hero-copy { padding: var(--section-hero) clamp(var(--space-6), 5vw, var(--space-9)) var(--section-hero) 0; }
  .page-hero--image figure { margin-right: calc((100vw - min(100vw - (var(--gutter) * 2), var(--max))) / -2); }

  .page-hero--editorial { border-bottom: 1px solid var(--slate-200); background: var(--paper); }
  .page-hero--editorial .hero-grid { min-height: clamp(27rem, 42vw, 35rem); grid-template-columns: minmax(0, 1.15fr) minmax(20rem, .85fr); gap: var(--gap-columns); }
  .page-hero--editorial .hero-copy { padding-block: clamp(var(--space-8), 7vw, var(--space-9)); }
  .page-hero--editorial figure { margin-block: var(--space-6); }
  .page-hero--editorial h1 { font-size: clamp(2.8rem, 5vw, 4.9rem); }

  .page-hero--compact { padding-block: clamp(var(--space-7), 6vw, var(--space-8)); background: var(--navy-950); }
  .page-hero--compact .hero-grid { grid-template-columns: minmax(0, 52rem); }
  .page-hero--compact h1 { max-width: 18ch; color: var(--white); font-size: clamp(2.6rem, 5vw, 4.6rem); }
  .page-hero--compact .lead { color: var(--sky-100); }
  .page-hero--compact .eyebrow { color: #9ed7d2; }
  .page-hero--compact .hero-fact { color: var(--sky-200); }

  @media (max-width: 800px) {
    .page-hero--image .hero-grid, .page-hero--editorial .hero-grid { min-height: 0; grid-template-columns: 1fr; gap: 0; }
    .page-hero--image .hero-copy, .page-hero--editorial .hero-copy { padding-block: var(--space-8); padding-right: 0; }
    .page-hero--image figure, .page-hero--editorial figure { height: 20rem; margin: 0 calc(var(--gutter) * -1); border: 0; }
    .page-hero--image figure { order: -1; }
  }

  @media (max-width: 520px) {
    .page-hero--image .hero-copy, .page-hero--editorial .hero-copy { padding-block: var(--space-7); }
    .page-hero--image figure, .page-hero--editorial figure { height: 15rem; }
    .hero-copy { gap: var(--space-4); }
  }
</style>
