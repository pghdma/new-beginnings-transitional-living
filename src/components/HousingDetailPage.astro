---
import { Icon } from 'astro-icon/components';
import Hero from './Hero.astro';
import FaqAccordion from './FaqAccordion.astro';
import FeatureList from './FeatureList.astro';
import SplitPanel from './SplitPanel.astro';
import MainLayout from '../layouts/MainLayout.astro';
import CtaBand from './CtaBand.astro';
import { site } from '../data/site';

interface ImageAsset {
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface Feature {
  icon: string;
  title: string;
  copy: string;
}

interface FaqItem {
  question: string;
  answer: string;
}

interface FaqGroup {
  title: string;
  items: FaqItem[];
}

interface Props {
  audience: 'men' | 'women';
  title: string;
  description: string;
  heroTitle: string;
  heroLead: string;
  heroImage: ImageAsset;
  householdImage: ImageAsset;
  householdLead: string;
  householdFeatures: Feature[];
  supportFeatures: Feature[];
  galleryImages: [ImageAsset, ImageAsset, ImageAsset];
  faqs: FaqGroup[];
}

const {
  audience,
  title,
  description,
  heroTitle,
  heroLead,
  heroImage,
  householdImage,
  householdLead,
  householdFeatures,
  supportFeatures,
  galleryImages,
  faqs,
} = Astro.props;

const audienceLabel = audience === 'men' ? 'men' : 'women';
const audienceTitle = audience === 'men' ? 'Men’s' : 'Women’s';
const houseLabel = audience === 'men' ? 'the Men’s Houses' : 'the Women’s House';
const faqSchema = faqs.flatMap((group) => group.items);

const decisionItems: Feature[] = [
  {
    icon: 'circle-dollar-sign',
    title: 'Rent and What Is Due',
    copy: 'The current rent, what’s due before move-in, and when payments are expected. Rent is set per house, so we give you the number on the phone.',
  },
  {
    icon: 'calendar-days',
    title: 'Availability',
    copy: `Beds open week to week. Calling ${site.phone} is the fastest way to find out what’s open right now.`,
  },
  {
    icon: 'clipboard-check',
    title: 'House Rules',
    copy: 'Curfew, visitors, overnight passes, chores, drug screens, and the weekly house meeting. You get them in writing before you move in.',
  },
  {
    icon: 'users-round',
    title: 'Meetings',
    copy: 'Our houses are AA and NA based. Outside meetings, a sponsor, and working the steps are part of living here.',
  },
];

const galleryCopy = [
  {
    title: 'Rooms and Shared Space',
    copy: 'Some bedrooms are shared. The kitchen, bathrooms, and living room are common space that everyone keeps up.',
  },
  {
    title: 'What to Bring',
    copy: 'Photo ID, insurance card, up to three bags of clothes, five pairs of shoes, hygiene items, and your own food. Bedding is provided.',
  },
  {
    title: 'Work and Getting Around',
    copy: 'Residents work or go to school. The houses sit on city bus lines, and curfew is worked around your schedule ahead of time.',
  },
];
---

<MainLayout title={title} description={description} faq={faqSchema}>
  <Hero
    variant="split"
    eyebrow={`Sober Living for ${audienceTitle === 'Men’s' ? 'Men' : 'Women'} in Pittsburgh`}
    title={heroTitle}
    lead={heroLead}
    image={heroImage}
  >
    <Fragment slot="actions">
      <a class="button button--light" href="/admissions/">Ask About a Bed<Icon name="lucide:arrow-right" aria-hidden="true" /></a>
      <a class="button button--outline-light" href="#frequently-asked-questions">Read the FAQ</a>
    </Fragment>
    <div class="housing-hero__facts" aria-label="Housing overview">
      <span><Icon name="lucide:users-round" aria-hidden="true" />Adult {audienceLabel}</span>
      <span><Icon name="lucide:house-heart" aria-hidden="true" />Substance-free shared house</span>
      <span><Icon name="lucide:map-pin" aria-hidden="true" />Pittsburgh</span>
    </div>
  </Hero>

  <section class="household-section">
    <div class="container">
      <header class="household-intro split-intro">
        <div>
          <p class="eyebrow">Daily Life</p>
          <h2>What Living Here Is Like</h2>
        </div>
        <p class="lead">A recovery house should be easy to understand before you move in. Here’s how ours run.</p>
      </header>

      <div class="household-stage">
        <SplitPanel tone="navy" photo={householdImage} photoFraction={0.72} contentFraction={1.28} minHeight="39rem" hidePhotoMobile>
        <div class="household-copy">
          <p class="eyebrow">Inside the House</p>
          <h2>Structure, Privacy, and a Household You Are Part Of</h2>
          <p class="household-copy__lead">{householdLead}</p>
          <div class="household-features"><FeatureList items={householdFeatures} icon="medallion" iconSize="md" tone="dark" columns={2} /></div>
        </div>
        </SplitPanel>
      </div>
    </div>
  </section>

  <section class="decision-section">
    <div class="container decision-layout">
      <div class="decision-intro">
        <p class="eyebrow">Before You Move In</p>
        <h2>What You Will Get in Writing</h2>
        <p class="lead">Pennsylvania licensed recovery houses give every resident the rules, the fee schedule, and the medication and discharge policies in writing before move-in. Here’s what to expect.</p>
        <aside class="written-information">
          <Icon name="lucide:file-check-2" aria-hidden="true" />
          <div>
            <h3>It’s in Writing</h3>
            <p>House rules, fee schedule, medication policy, and the criteria for staying or leaving. You have them before you sign anything or pay anything.</p>
          </div>
        </aside>
      </div>
      <div class="decision-grid" role="list">
        {decisionItems.map((item) => (
          <article role="listitem">
            <span class="icon-medallion"><Icon name={`lucide:${item.icon}`} aria-hidden="true" /></span>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="supports-section">
    <div class="container">
      <header class="supports-heading">
        <p class="eyebrow">What Holds It Together</p>
        <h2>What You Bring to It</h2>
        <p class="lead">We give you a safe place to live and rules you can count on. The meetings, the sponsor, the job, and your own counselor or doctor are on you.</p>
      </header>
      <div class="supports-grid"><FeatureList items={supportFeatures} layout="columns" icon="medallion" iconSize="lg" tone="dark" columns={4} /></div>
    </div>
  </section>

  <section class="questions-section">
    <div class="container">
      <header class="questions-heading split-intro">
        <div>
          <p class="eyebrow">Practical Questions</p>
          <h2>Know Before You Move In</h2>
        </div>
        <p class="lead">The things people actually want to know: rooms, what to bring, work, and getting around.</p>
      </header>
      <div class="question-gallery">
        {galleryImages.map((image, index) => (
          <article class="question-panel">
            <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" />
            <div class="question-panel__shade"></div>
            <div class="question-panel__copy">
              <span class="question-panel__number">0{index + 1}</span>
              <h3>{galleryCopy[index].title}</h3>
              <p>{galleryCopy[index].copy}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="faq-section" id="frequently-asked-questions">
    <div class="container faq-layout">
      <div class="faq-intro">
        <p class="eyebrow">Frequently Asked Questions</p>
        <h2>Straight Answers for Residents, Families, and Referral Partners</h2>
        <p>If your question is about a specific bed or a specific person, call <a class="inline-link" href={site.phoneHref}>{site.phone}</a>. Everything else is here.</p>
      </div>
      <FaqAccordion groups={faqs} />
    </div>
  </section>


  <CtaBand
    title={`Ask About ${houseLabel}`}
    label="Apply for Housing"
    text={`Call ${site.phone} or send the application. We’ll tell you what’s open, what it costs, and what the house expects.`}
  />
</MainLayout>
<style>
  .housing-hero{ color: var(--white); background: var(--navy-950); }
  .housing-hero__facts{ display: flex; margin-top: var(--space-7); flex-wrap: wrap; gap: var(--space-3) var(--space-5); color: var(--sky-100); font-size: .92rem; font-weight: var(--weight-heading); }
  .housing-hero__facts span{ display: inline-flex; align-items: center; gap: .55rem; }
  .housing-hero__facts :global(svg){ width: 1.1rem; height: 1.1rem; color: var(--accent-on-dark); stroke-width: 1.65; }

  .household-section{ padding-block: var(--section-standard); background: var(--canvas); }
  .household-intro{ margin-bottom: var(--space-7); }
  .household-intro h2{ margin-top: var(--space-4); }
  .household-copy { color: var(--white); }
  .household-copy .eyebrow{ color: var(--accent-on-dark); }
  .household-copy h2{ max-width: 27ch; margin-top: var(--space-4); color: var(--white); font-size: var(--type-section-lg); }
  .household-copy__lead{ max-width: 43rem; margin-top: var(--space-5); color: var(--sky-100); font-size: 1.12rem; line-height: 1.55; }
  .household-features { margin-top: clamp(2.5rem, 5vw, 4rem); }

  .decision-section{ padding-block: var(--section-standard); background: var(--sky-50); }
  .decision-layout{ display: grid; grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr); gap: var(--gap-columns); align-items: start; }
  .decision-intro{ position: sticky; top: var(--sticky-offset-compact); }
  .decision-intro h2{ max-width: 24ch; margin-top: var(--space-4); }
  .decision-intro .lead{ margin-top: var(--space-5); }
  .written-information{ border-radius: var(--radius-md); display: grid; margin-top: var(--space-6); padding: var(--space-5); grid-template-columns: 2rem minmax(0, 1fr); gap: var(--space-4); color: var(--sky-100); background: var(--navy-900); box-shadow: var(--shadow); }
  .written-information > :global(svg){ width: 1.7rem; height: 1.7rem; color: var(--accent-on-dark); stroke-width: 1.55; }
  .written-information h3{ color: var(--white); font-size: 1.12rem; }
  .written-information p{ margin-top: .45rem; font-size: .92rem; line-height: 1.5; }
  .decision-grid{ border-radius: var(--radius-lg); overflow: hidden; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); background: var(--paper); box-shadow: var(--shadow-raised); }
  .decision-grid article{ min-height: 18rem; padding: clamp(1.75rem, 4vw, 2.75rem); }
  .decision-grid article:nth-child(odd){ border-right: 1px solid var(--slate-200); }
  .decision-grid article:nth-child(-n + 2){ border-bottom: 1px solid var(--slate-200); }
  .decision-grid h3{ margin-top: var(--space-5); }
  .decision-grid p{ margin-top: var(--space-3); color: var(--slate-600); font-size: .96rem; line-height: 1.55; }

  .supports-section{ padding-block: var(--section-standard); color: var(--white); background: var(--navy-950); }
  .supports-heading{ max-width: 48rem; margin-inline: auto; text-align: center; }
  .supports-heading .eyebrow{ color: var(--accent-on-dark); }
  .supports-heading h2{ margin-top: var(--space-4); color: var(--white); }
  .supports-heading .lead{ margin: var(--space-5) auto 0; color: var(--sky-100); }
  .supports-grid { margin-top: var(--space-8); }

  .questions-section{ padding-block: var(--section-standard); background: var(--paper); }
  .questions-heading{ margin-bottom: var(--space-7); }
  .questions-heading h2{ margin-top: var(--space-4); }
  .question-gallery{ display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }
  .question-panel{ border-radius: var(--radius-md); position: relative; min-height: clamp(27rem, 36vw, 34rem); overflow: hidden; background: var(--navy-900); box-shadow: var(--shadow-raised); }
  .question-panel img{ position: absolute; width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; inset: 0; filter: var(--photo-filter); }
  .question-panel__shade{ position: absolute; background: var(--card-shade); inset: 0; }
  .question-panel__copy{ position: absolute; padding: clamp(1.5rem, 3vw, 2.25rem); inset: auto 0 0; color: var(--white); }
  .question-panel__number{ color: var(--accent-on-dark); font-size: .82rem; font-weight: var(--weight-semibold); letter-spacing: .12em; }
  .question-panel h3{ margin-top: var(--space-3); color: var(--white); }
  .question-panel p{ margin-top: var(--space-3); color: var(--sky-100); font-size: .94rem; line-height: 1.5; }
  .question-panel:hover img{ transform: scale(1.035); }

  .faq-section{ padding-block: var(--section-standard); background: var(--sky-50); scroll-margin-top: 7rem; }
  .faq-layout{ display: grid; grid-template-columns: minmax(0, .68fr) minmax(0, 1.32fr); gap: var(--gap-columns); align-items: start; }
  .faq-intro{ position: sticky; top: var(--sticky-offset-compact); }
  .faq-intro h2{ max-width: 24ch; margin-top: var(--space-4); }
  .faq-intro > p:last-child{ max-width: 35rem; margin-top: var(--space-5); }
  .faq-intro a{ font-weight: var(--weight-semibold); }


  @media (max-width: 1080px) {
    .decision-intro, .faq-intro{ position: static; }
    .decision-layout, .faq-layout{ grid-template-columns: 1fr; }
    .decision-intro, .faq-intro{ max-width: 48rem; }
  }

  @media (max-width: 760px) {
    .household-section,
    .decision-section,
    .supports-section,
    .questions-section,
    .faq-section,

    .housing-hero{ position: relative; overflow: hidden; }
    .housing-hero__facts{ display: grid; margin-top: var(--space-5); grid-template-columns: 1fr; gap: var(--space-2); font-size: .9rem; }

    .household-intro{ margin-bottom: var(--space-6); }
    .household-intro h2,
    .questions-heading h2{ margin-top: var(--space-3); }
    .household-copy{ padding: 2.5rem var(--space-6); }
    .household-copy h2{ margin-top: var(--space-3); font-size: 2rem; }
    .household-copy__lead{ margin-top: var(--space-4); font-size: 1rem; }
    .household-features { margin-top: clamp(2.5rem, 5vw, 4rem); }

    .decision-intro h2{ max-width: 25ch; margin-top: var(--space-3); }
    .decision-intro .lead{ margin-top: var(--space-4); }
    .written-information{ margin-top: var(--space-5); padding: var(--space-5); }
    .decision-grid{ grid-template-columns: 1fr; }
    .decision-grid article{ display: grid; min-height: 0; padding: var(--space-5); grid-template-columns: var(--icon-medallion-size-sm) minmax(0, 1fr); gap: var(--space-2) var(--space-4); align-items: start; }
    .decision-grid .icon-medallion{ width: var(--icon-medallion-size-sm); height: var(--icon-medallion-size-sm); grid-row: 1 / 3; }
    .decision-grid h3{ margin-top: 0; font-size: 1.08rem; }
    .decision-grid p{ margin-top: 0; font-size: .9rem; }
    .decision-grid article:nth-child(odd){ border-right: 0; }
    .decision-grid article:not(:last-child){ border-bottom: 1px solid var(--slate-200); }

    .supports-heading h2{ margin-top: var(--space-3); }
    .supports-heading .lead{ margin-top: var(--space-4); }
    .supports-heading{ margin-inline: 0; text-align: left; }
    .supports-heading .lead{ margin-inline: 0; }
    .supports-grid { margin-top: var(--space-8); }

    .questions-heading{ margin-bottom: var(--space-6); }
    .question-gallery{ grid-template-columns: 1fr; gap: var(--space-4); }
    .question-panel{ min-height: 16.5rem; }
    .question-panel__copy{ padding: var(--space-5); }
    .question-panel p{ margin-top: var(--space-2); font-size: .88rem; }

    .faq-intro h2{ max-width: 25ch; margin-top: var(--space-3); }
    .faq-intro > p:last-child{ margin-top: var(--space-4); }

  }


  /* Mobile floor: 16px copy, one alignment per section, 44px tap targets. Measured by scripts/mobile-audit.mjs */
  @media (max-width: 900px) {
    .supports-heading { margin-inline: 0; text-align: left; }
    .supports-heading .lead { margin-inline: 0; }
    .decision-grid p, .question-panel p { font-size: 1rem; line-height: 1.55; }
    .written-information p{ font-size: 1rem; }
  }
</style>
