---
/**
 * TrustPoints — the 501(c)(3) / DDAP / WestPARR row, rendered from data/credentials.ts.
 *
 * variant="band"     three centered items between hairlines (Home)
 * variant="columns"  three centered columns with round icons (About records panel)
 * variant="panel"    dark rounded panel with medallions (Professionals)
 * variant="compact"  small inline rows for dark footers (Footer)
 */
import { Icon } from 'astro-icon/components';
import { credentials } from '../data/credentials';

interface Props {
  variant?: 'band' | 'columns' | 'panel' | 'compact';
  label?: string;
}
const { variant = 'band', label = 'New Beginnings credentials' } = Astro.props;
const text = (c: (typeof credentials)[number]) => (variant === 'columns' ? c.detail : c.short);
---

<ul class:list={['trust', `trust--${variant}`]} aria-label={label}>
  {credentials.map((c) => (
    <li>
      {variant === 'panel' ? (
        <span class="icon-medallion icon-medallion--dark"><Icon name={`lucide:${c.icon}`} aria-hidden="true" /></span>
      ) : (
        <Icon name={`lucide:${c.icon}`} aria-hidden="true" />
      )}
      {variant === 'compact' ? <span class="trust__text"><strong>{c.compact}</strong></span> : <span class="trust__text"><strong>{c.title}</strong><small>{text(c)}</small></span>}
    </li>
  ))}
</ul>

<style>
  .trust { display: grid; margin: 0; padding: 0; list-style: none; }
  .trust__text { display: grid; min-width: 0; }
  .trust strong { display: block; color: var(--navy-900); font-size: 1rem; font-weight: var(--weight-heading); line-height: 1.25; }
  .trust small { display: block; margin-top: .2rem; color: var(--slate-600); font-size: .84rem; line-height: 1.3; }

  /* band */
  .trust--band { padding: var(--space-6) 0; border-block: 1px solid var(--slate-300); grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.25rem, 3vw, 2.5rem); }
  .trust--band li { display: flex; justify-content: center; align-items: center; gap: .8rem; }
  .trust--band > li > :global(svg) { width: 1.75rem; height: 1.75rem; color: var(--teal-700); stroke-width: 1.6; flex: 0 0 auto; }

  /* columns */
  .trust--columns { width: 100%; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }
  .trust--columns li { display: grid; min-width: 0; justify-items: center; gap: var(--space-3); text-align: center; }
  .trust--columns > li > :global(svg) { width: 1.45rem; height: 1.45rem; padding: .7rem; box-sizing: content-box; border-radius: 50%; color: var(--teal-700); background: var(--sky-100); stroke-width: 1.65; }
  .trust--columns strong { font-size: .98rem; }
  .trust--columns small { font-size: .9rem; }

  /* panel */
  .trust--panel { padding: clamp(var(--space-6), 5vw, var(--space-8)); border-radius: var(--radius-lg); gap: var(--space-6); color: var(--white); background: var(--surface-on-dark); box-shadow: var(--shadow-photo); }
  .trust--panel li { display: grid; grid-template-columns: var(--icon-medallion-size-md) minmax(0, 1fr); gap: var(--space-4); align-items: center; }
  .trust--panel strong { color: var(--white); font-size: 1.1rem; }
  .trust--panel small { color: var(--sky-200); font-size: .9rem; }

  /* compact */
  .trust--compact { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
  .trust--compact li { display: grid; grid-template-columns: auto 1fr; gap: var(--button-gap); align-items: center; }
  .trust--compact > li > :global(svg) { width: 1.4rem; height: 1.4rem; color: var(--accent-on-dark); stroke-width: 1.7; }
  .trust--compact strong { color: var(--slate-300); font-size: .82rem; line-height: 1.3; }
  .trust--compact small { display: none; }

  @media (max-width: 900px) {
    .trust--panel { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .trust--panel li { grid-template-columns: var(--icon-medallion-size-md) minmax(0, 1fr); align-items: flex-start; text-align: left; }
  }

  @media (max-width: 760px) {
    .trust--band, .trust--columns, .trust--compact, .trust--panel { grid-template-columns: 1fr; }
    .trust--band { gap: var(--space-4); }
    .trust--band li { justify-content: flex-start; }
    .trust--columns { gap: var(--space-6); }
    .trust--columns li { grid-template-columns: auto minmax(0, 1fr); justify-items: start; text-align: left; }
    .trust small { font-size: 1rem; }
    .trust--compact small { display: none; }
  }
</style>
