---
import { Icon } from 'astro-icon/components';
import BrandLockup from './BrandLockup.astro';
import TrustPoints from './TrustPoints.astro';
import { site } from '../data/site';

const columns = [
  {
    title: 'Recovery Housing',
    links: [
      { label: 'How Our Houses Work', href: '/recovery-housing/' },
      { label: 'Men’s Recovery Housing', href: '/recovery-housing/men/' },
      { label: 'Women’s Recovery Housing', href: '/recovery-housing/women/' },
      { label: 'Apply for Housing', href: '/admissions/' },
      { label: 'For Professionals', href: '/referrals/' },
    ],
  },
  {
    title: 'About',
    links: [
      { label: 'About New Beginnings', href: '/about/' },
      { label: 'Board of Directors', href: '/about/board/' },
      { label: 'Credentials & Licensing', href: '/about/transparency/' },
      { label: 'Donate', href: '/support-us/' },
      { label: 'Contact', href: '/contact/' },
    ],
  },
];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__main">
    <div class="footer__brand">
      <a class="footer__logo" href="/" aria-label="New Beginnings Transitional Living home"><BrandLockup variant="footer" /></a>
      <p class="footer__mission">Nonprofit sober living homes for men and women in Pittsburgh. Licensed, inspected, and run by a counselor who has done this work since 1999.</p>
      <div class="footer__trust"><TrustPoints variant="compact" label="Organization credentials" /></div>
      <p class="footer__ein">New Beginnings Transitional Living Foundation · EIN {site.ein}</p>
    </div>

    {columns.map((column) => (
      <nav class="footer__column" aria-label={column.title}>
        <h2>{column.title}</h2>
        <ul>
          {column.links.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
    ))}

    <div class="footer__column footer__contact">
      <h2>Contact</h2>
      <ul class="footer__details">
        <li>
          <Icon name="lucide:phone" aria-hidden="true" />
          <span><small>Call</small><a href={site.phoneHref}>{site.phone}</a></span>
        </li>
        <li>
          <Icon name="lucide:mail" aria-hidden="true" />
          <span><small>Email</small><a href={site.emailHref}>{site.email}</a></span>
        </li>
        <li>
          <Icon name="lucide:map-pin" aria-hidden="true" />
          <span><small>Office</small><address>{site.office.street}<br />{site.office.city}, {site.office.state} {site.office.zip}</address><em>Not a residence. Please call before visiting.</em></span>
        </li>
        <li>
          <Icon name="lucide:map" aria-hidden="true" />
          <span><small>Service area</small>Pittsburgh and surrounding Allegheny County</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="footer__bar">
    <div class="container footer__bar-inner">
      <p>© {year} New Beginnings Transitional Living Foundation. All rights reserved.</p>
      <ul class="footer__legal">
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/terms/">Terms</a></li>
        <li><a href="/accessibility/">Accessibility</a></li>
        <li><a href="https://pghdma.com" rel="external">Site by PGHDMA</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer { color: var(--sky-100); background: var(--navy-950); }
  .footer__main { display: grid; padding-block: clamp(3.5rem, 6vw, 5.5rem) clamp(3rem, 5vw, 4.5rem); grid-template-columns: minmax(0, 1.5fr) repeat(2, minmax(0, .9fr)) minmax(0, 1.2fr); gap: clamp(2.5rem, 5vw, 5rem); }
  .footer__brand { display: grid; align-content: start; gap: var(--space-5); }
  .footer__logo { display: inline-flex; width: fit-content; min-height: 2.75rem; align-items: center; text-decoration: none; }
  .footer__mission { max-width: 30rem; color: var(--sky-100); font-size: 1rem; line-height: 1.6; }
  .footer__trust :global(.trust--compact) { grid-template-columns: 1fr; gap: var(--space-3); }
  .footer__ein { color: var(--slate-400); font-size: .84rem; line-height: 1.5; }

  .footer__column h2 { margin-bottom: var(--space-4); color: var(--accent-on-dark); font-family: var(--font-display); font-size: .7rem; font-weight: 650; letter-spacing: .12em; line-height: 1.2; text-transform: uppercase; }
  .footer__column ul { display: grid; margin: 0; padding: 0; gap: .35rem; list-style: none; }
  .footer__column li a { display: inline-flex; min-height: 2.2rem; align-items: center; color: var(--sky-100); font-size: .98rem; text-decoration: none; }
  .footer__column li a:hover { color: var(--white); text-decoration: underline; text-underline-offset: .2em; }

  .footer__details { gap: var(--space-4) !important; }
  .footer__details li { display: grid; grid-template-columns: 1.25rem minmax(0, 1fr); gap: .7rem; align-items: start; color: var(--sky-100); font-size: .98rem; line-height: 1.45; }
  .footer__details :global(svg) { width: 1.2rem; height: 1.2rem; margin-top: .15rem; color: var(--accent-on-dark); stroke-width: 1.8; }
  .footer__details li > span { display: grid; gap: .15rem; }
  .footer__details small { color: var(--slate-400); font-size: .74rem; font-weight: var(--weight-semibold); letter-spacing: .08em; text-transform: uppercase; }
  .footer__details a { color: var(--white); font-weight: var(--weight-semibold); text-decoration: none; }
  .footer__details a:hover { text-decoration: underline; text-underline-offset: .2em; }
  .footer__details address { font-style: normal; color: var(--white); }
  .footer__details em { color: var(--slate-400); font-size: .86rem; font-style: normal; }

  .footer__bar { border-top: 1px solid var(--border-on-dark); }
  .footer__bar-inner { display: flex; padding-block: var(--space-5); align-items: center; justify-content: space-between; gap: var(--space-4); color: var(--slate-400); font-size: .84rem; }
  .footer__legal { display: flex; margin: 0; padding: 0; flex-wrap: wrap; gap: var(--space-4) var(--space-5); list-style: none; }
  .footer__legal a { display: inline-flex; min-height: 2.2rem; align-items: center; color: var(--sky-100); text-decoration: none; }
  .footer__legal a:hover { color: var(--white); text-decoration: underline; text-underline-offset: .2em; }

  @media (max-width: 1080px) {
    .footer__main { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .footer__brand { grid-column: 1 / -1; }
  }

  @media (max-width: 760px) {
    .footer__main { grid-template-columns: 1fr; gap: var(--space-7); padding-block: var(--space-8) var(--space-7); }
    .footer__column li a, .footer__details li { min-height: 2.75rem; font-size: 1rem; }
    .footer__bar-inner { flex-direction: column; align-items: flex-start; }
    .footer__legal a { min-height: 2.75rem; }
  }
</style>
