---
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';

const trustItems = [
  { icon: 'landmark', label: '501(c)(3) public charity' },
  { icon: 'badge-check', label: 'DDAP-licensed residences' },
  { icon: 'shield-check', label: 'WestPARR inspected' },
];
---

<footer>
  <div class="container footer-service">
    <div class="footer-map">
      <iframe
        title="Map of Pittsburgh and surrounding Allegheny County communities"
        src="https://www.openstreetmap.org/export/embed.html?bbox=-80.145%2C40.385%2C-79.900%2C40.555&amp;layer=mapnik"
        loading="lazy"
        referrerpolicy="no-referrer"
      ></iframe>
      <div class="map-caption">
        <Icon name="lucide:map" aria-hidden="true" />
        <div>
          <span>Service area</span>
          <strong>Pittsburgh &amp; surrounding Allegheny County</strong>
          <p>The map shows the broader service area only. Residence locations are never marked.</p>
        </div>
      </div>
    </div>

    <div class="footer-contact">
      <div class="footer-brand">
        <strong>New Beginnings</strong>
        <span>Transitional Living Foundation</span>
      </div>
      <p class="footer-summary">Structured recovery housing for men and women, grounded in accountability, peer support, and connection to independent recovery resources.</p>

      <div class="footer-contact-list">
        <a href={site.phoneHref}>
          <span class="footer-contact-icon icon-medallion icon-medallion--sm"><Icon name="lucide:phone" aria-hidden="true" /></span>
          <span><small>Call New Beginnings</small><strong>{site.phone}</strong></span>
        </a>
        <a href="/contact/">
          <span class="footer-contact-icon icon-medallion icon-medallion--sm"><Icon name="lucide:mail" aria-hidden="true" /></span>
          <span><small>Send a general message</small><strong>Contact our team</strong></span>
        </a>
      </div>

      <div class="footer-trust" aria-label="Organization credentials">
        {trustItems.map((item) => (
          <div>
            <Icon name={`lucide:${item.icon}`} aria-hidden="true" />
            <span>{item.label}</span>
          </div>
        ))}
      </div>

      <p class="footer-nonprofit">New Beginnings Transitional Living Foundation · EIN {site.ein}</p>
    </div>
  </div>

  <div class="container footer-links">
    <div>
      <h2>About</h2>
      <ul>
        <li><a href="/about/">About New Beginnings</a></li>
        <li><a href="/about/board/">Board of Directors</a></li>
        <li><a href="/about/transparency/">Credentials &amp; Transparency</a></li>
      </ul>
    </div>
    <div>
      <h2>Recovery housing</h2>
      <ul>
        <li><a href="/recovery-housing/">Housing Overview</a></li>
        <li><a href="/recovery-housing/men/">Men’s Recovery Housing</a></li>
        <li><a href="/recovery-housing/women/">Women’s Recovery Housing</a></li>
        <li><a href="/admissions/">Admissions</a></li>
      </ul>
    </div>
    <div>
      <h2>Connect</h2>
      <ul>
        <li><a href="/referrals/">Information for Professionals</a></li>
        <li><a href="/support-us/">Support Our Work</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </div>
    <div>
      <h2>Information</h2>
      <ul>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/accessibility/">Accessibility</a></li>
        <li><a href="/terms/">Terms</a></li>
      </ul>
    </div>
  </div>

  <div class="container copyright">
    <span>© {new Date().getFullYear()} New Beginnings Transitional Living Foundation. All rights reserved.</span>
    <a href="https://pghdma.com" rel="external">Site by PGHDMA</a>
  </div>
</footer>

<style>
  footer { flex: 0 0 auto; color: var(--white); background: var(--navy-950); }
  .footer-service { display: grid; padding-block: var(--section-standard); grid-template-columns: minmax(0,1.08fr) minmax(0,.92fr); gap: clamp(3rem,7vw,7rem); align-items: stretch; }
  .footer-map { display: grid; background: var(--navy-900); grid-template-rows: minmax(20rem,1fr) auto; }
  .footer-map iframe { display: block; width: 100%; min-height: 22rem; border: 0; filter: saturate(.65) contrast(.95); }
  .map-caption { display: grid; padding: var(--space-5); grid-template-columns: auto 1fr; gap: var(--space-4); align-items: start; }
  .map-caption > :global(svg) { width: 2rem; height: 2rem; color: #9ed7d2; stroke-width: 1.55; }
  .map-caption div { display: grid; }
  .map-caption span { color: #9ed7d2; font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .map-caption strong { margin-top: .35rem; color: var(--white); font-size: 1.2rem; line-height: 1.25; }
  .map-caption p { margin-top: .4rem; color: var(--slate-300); font-size: .88rem; line-height: 1.45; }

  .footer-contact { display: flex; flex-direction: column; justify-content: center; }
  .footer-brand { display: grid; line-height: 1.05; }
  .footer-brand strong { color: var(--white); font-size: clamp(2rem,4vw,3rem); font-weight: 650; letter-spacing: -.025em; }
  .footer-brand span { margin-top: .55rem; color: #9ed7d2; font-size: .78rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .footer-summary { max-width: 34rem; margin-top: var(--space-5); color: var(--slate-300); font-size: 1.06rem; line-height: 1.55; }

  .footer-contact-list { display: grid; margin-top: var(--space-7); border-block: 1px solid rgba(255,255,255,.18); }
  .footer-contact-list > a { display: grid; padding-block: var(--space-4); grid-template-columns: auto 1fr; gap: var(--space-4); align-items: center; color: var(--white); }
  .footer-contact-list > a + a { border-top: 1px solid rgba(255,255,255,.18); }
  .footer-contact-list > a:hover { color: #b7e5e1; }
  .footer-contact-icon { width: 2.7rem; height: 2.7rem; color: var(--navy-950); background: #9ed7d2; }
  .footer-contact-icon :global(svg) { width: 1.25rem; height: 1.25rem; stroke-width: 1.9; }
  .footer-contact-list a > span:last-child { display: grid; }
  .footer-contact-list small { color: var(--slate-300); font-size: .72rem; font-weight: 650; letter-spacing: .1em; text-transform: uppercase; }
  .footer-contact-list strong { margin-top: .15rem; color: inherit; font-size: 1.2rem; font-weight: 600; }

  .footer-trust { display: grid; margin-top: var(--space-6); grid-template-columns: repeat(3,minmax(0,1fr)); gap: var(--space-4); }
  .footer-trust > div { display: grid; grid-template-columns: auto 1fr; gap: .65rem; align-items: center; color: var(--slate-300); font-size: .82rem; font-weight: 600; line-height: 1.3; }
  .footer-trust :global(svg) { width: 1.4rem; height: 1.4rem; color: #9ed7d2; stroke-width: 1.7; }
  .footer-nonprofit { margin-top: var(--space-5); color: var(--slate-400); font-size: .82rem; }

  .footer-links { display: grid; padding-block: var(--space-7); border-top: 1px solid rgba(255,255,255,.18); grid-template-columns: repeat(4,1fr); gap: var(--space-7); }
  .footer-links h2 { margin-bottom: 1rem; color: #9ed7d2; font-size: .76rem; letter-spacing: .12em; text-transform: uppercase; }
  .footer-links ul { margin: 0; padding: 0; list-style: none; }
  .footer-links li + li { margin-top: .55rem; }
  .footer-links a { color: var(--white); }
  .footer-links a:hover { color: #b7e5e1; }
  .copyright { display: flex; padding-block: var(--space-5); border-top: 1px solid rgba(255,255,255,.18); color: var(--slate-300); font-size: .84rem; justify-content: space-between; gap: var(--space-4); }
  .copyright a { color: var(--slate-300); }
  .copyright a:hover { color: var(--white); }

  @media (max-width: 900px) {
    .footer-service { grid-template-columns: 1fr; }
    .footer-map iframe { min-height: 25rem; }
    .footer-contact { max-width: 42rem; }
  }

  @media (max-width: 760px) {
    .footer-links { grid-template-columns: 1fr 1fr; }
    .footer-trust { grid-template-columns: 1fr; }
  }

  @media (max-width: 480px) {
    .footer-service { padding-block: var(--space-8); gap: var(--space-7); }
    .footer-map { grid-template-rows: 18rem auto; }
    .footer-map iframe { min-height: 18rem; }
    .map-caption { padding: var(--space-5); }
    .footer-summary { font-size: 1rem; }
    .footer-contact-list strong { font-size: 1.05rem; }
    .footer-links { padding-block: var(--space-6); gap: var(--space-6) var(--space-4); }
    .footer-links a { font-size: .92rem; }
    .copyright { display: grid; }
  }
</style>
