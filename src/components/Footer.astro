---
import { nav, site } from '../data/site';
---
<footer>
  <div class="container footer-grid">
    <div class="brand">
      <strong>New Beginnings</strong>
      <p>Structured recovery housing for men and women in Pittsburgh.</p>
      <p class="nonprofit">501(c)(3) nonprofit organization<br />EIN {site.ein}</p>
    </div>
    <div>
      <h2>Explore</h2>
      <ul>{nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
    </div>
    <div>
      <h2>Information</h2>
      <ul>
        <li><a href="/board/">Board</a></li>
        <li><a href="/transparency/">Transparency</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/accessibility/">Accessibility</a></li>
        <li><a href="/terms/">Terms</a></li>
      </ul>
    </div>
    <div>
      <h2>Get in touch</h2>
      <a class="phone" href={site.phoneHref}>{site.phone}</a>
      <p>Exact residence locations are shared privately during the intake process.</p>
    </div>
  </div>
  <div class="container copyright">
    <span>© {new Date().getFullYear()} New Beginnings Transitional Living Foundation. All rights reserved.</span>
    <a href="https://pghdma.com" rel="external">Site by PGHDMA</a>
  </div>
</footer>
<style>
  footer { flex: 0 0 auto; padding-top: var(--space-8); color: var(--white); background: var(--navy-950); }
  .footer-grid { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: var(--space-7); }
  .brand strong { font-size: 1.6rem; }
  .brand p { max-width: 24rem; margin-top: 1rem; color: var(--slate-300); }
  .brand .nonprofit { font-size: .9rem; }
  h2 { margin-bottom: 1rem; color: var(--white); font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; }
  ul { margin: 0; padding: 0; list-style: none; }
  li + li { margin-top: .55rem; }
  a { color: var(--white); }
  .phone { display: inline-block; margin-bottom: 1rem; font-size: 1.5rem; font-weight: 750; }
  .footer-grid > div:last-child p { color: var(--slate-300); font-size: .92rem; }
  .copyright { display: flex; margin-top: var(--space-7); padding-block: var(--space-5); border-top: 1px solid rgba(255,255,255,.18); color: var(--slate-300); font-size: .84rem; justify-content: space-between; gap: var(--space-4); }
  .copyright a { color: var(--slate-300); }
  @media (max-width: 760px) { .footer-grid { grid-template-columns: 1fr 1fr; } .brand { grid-column: 1 / -1; } }
  @media (max-width: 460px) { .footer-grid { grid-template-columns: 1fr; } .copyright { display: grid; } }
</style>
