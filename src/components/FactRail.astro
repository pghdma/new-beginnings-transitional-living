---
import IconBadge from './IconBadge.astro';
interface Item { icon: string; label: string; href?: string; }
interface Props { items?: Item[]; }
const { items = [
  { icon: 'heart-handshake', label: '501(c)(3) nonprofit', href: '/about/transparency/' },
  { icon: 'badge-check', label: 'DDAP-licensed residences', href: '/about/transparency/' },
  { icon: 'shield-check', label: 'WestPARR inspected', href: '/about/transparency/' },
  { icon: 'users-round', label: 'AA/NA-based recovery', href: '/recovery-housing/' },
] } = Astro.props;
---
<aside class="fact-rail" aria-label="Organization facts">
  <div class="container fact-rail__inner">
    {items.map((item) => item.href
      ? <a class="fact-rail__item" href={item.href}><IconBadge name={item.icon} small />{item.label}</a>
      : <span class="fact-rail__item"><IconBadge name={item.icon} small />{item.label}</span>)}
  </div>
</aside>
<style>
  a.fact-rail__item { color: var(--slate-800); text-decoration: none; }
  a.fact-rail__item:hover { color: var(--teal-800); background: var(--sky-50); }
</style>
