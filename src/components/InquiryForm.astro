---
import { site } from '../data/site';
interface Props { title?: string; intro?: string; }
const { title = 'Start with a conversation', intro = 'Tell us how to reach you. Please do not include medical details or other sensitive information.' } = Astro.props;
---
<section class="inquiry" id="inquiry" aria-labelledby="inquiry-title">
  <div class="container inquiry-grid">
    <div class="inquiry-copy">
      <p class="eyebrow">Take the next step</p>
      <h2 id="inquiry-title">{title}</h2>
      <p class="lead">{intro}</p>
      <p>Prefer to call? <a href={site.phoneHref}>{site.phone}</a></p>
    </div>
    <form data-contact-form>
      <div class="form-grid">
        <label>First name<input required autocomplete="given-name" name="firstName" /></label>
        <label>Last name<input required autocomplete="family-name" name="lastName" /></label>
        <label>Email<input required type="email" autocomplete="email" name="email" /></label>
        <label>Phone<input required type="tel" autocomplete="tel" name="phone" /></label>
      </div>
      <label>I am contacting you for<select name="contactType" required><option value="">Select one</option><option>Myself</option><option>A loved one</option><option>A client</option><option>Donations or partnership</option><option>Something else</option></select></label>
      <label>How can we help?<textarea name="message" rows="4" maxlength="1000"></textarea></label>
      <label class="trap" aria-hidden="true">Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label>
      <input type="hidden" name="startedAt" value="" />
      <p class="privacy-note">This form is for general inquiries only. Do not send medical records, diagnoses, medication information, Social Security numbers, or other sensitive information.</p>
      <button class="button" type="submit">Send inquiry</button>
      <p class="status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const started = form.querySelector<HTMLInputElement>('[name="startedAt"]');
    if (started) started.value = String(Date.now());
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>('.status');
      if (status) status.textContent = 'Online form delivery is being finalized. Please call 412-628-0403 for immediate assistance.';
    });
  });
</script>
<style>
  .inquiry { position: relative; padding-block: clamp(var(--space-8), 7vw, var(--space-9)); color: var(--white); background: var(--navy-900); overflow: hidden; }
  .inquiry::after { position: absolute; width: var(--decor-circle); height: var(--decor-circle); border: 1px solid rgba(255,255,255,.08); border-radius: 50%; content: ''; right: calc(var(--decor-circle) / -2); bottom: calc(var(--decor-circle) / -2); }
  .inquiry-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(2rem, 7vw, 7rem); align-items: start; }
  .inquiry-copy { display: grid; gap: var(--space-5); position: sticky; top: 9rem; }
  h2 { color: var(--white); }
  .inquiry-copy a { color: var(--white); font-weight: 750; }
  form { display: grid; gap: 1rem; padding: clamp(1.25rem, 4vw, 2.5rem); border-radius: var(--radius); background: var(--paper); color: var(--slate-700); box-shadow: var(--shadow); }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  label { display: grid; gap: .35rem; font-size: .92rem; font-weight: 700; }
  input, select, textarea { width: 100%; padding: .75rem .85rem; border: 1px solid var(--slate-300); border-radius: .25rem; background: var(--white); color: var(--slate-700); }
  textarea { resize: vertical; }
  .privacy-note { color: var(--slate-600); font-size: .85rem; line-height: 1.45; }
  .trap { position: absolute; left: -9999px; }
  .status { color: var(--navy-800); font-weight: 650; }
  @media (max-width: 760px) { .inquiry-grid { grid-template-columns: 1fr; } .inquiry-copy { position: static; } }
  @media (max-width: 500px) { .form-grid { grid-template-columns: 1fr; } }
</style>
