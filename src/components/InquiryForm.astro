---
const options = [
  'Housing availability',
  'Professional question',
  'Donation or partnership',
  'Organization or public records',
  'Something else',
];

const buttonLabel = 'Send Message';
---

<div class="inquiry-form" id="inquiry" aria-labelledby="inquiry-title">
  <header class="inquiry-form__header">
    <p class="eyebrow">Send a Message</p>
    <h2 id="inquiry-title">How Can We Help?</h2>
    <p>Use this form for a general question. Please keep medical, legal, and other sensitive information out of your message.</p>
  </header>

  <form data-contact-form data-context="contact" novalidate>
    <label>
      Full Name
      <input required autocomplete="name" name="name" maxlength="200" />
    </label>
    <label>
      Email Address
      <input required type="email" autocomplete="email" name="email" maxlength="254" />
    </label>
    <label>
      <span class="field-label">Phone Number <small>(optional)</small></span>
      <input type="tel" autocomplete="tel" name="phone" maxlength="20" />
    </label>
    <label>
      What Can We Help With?
      <select name="contactType" required>
        <option value="">Select one</option>
        {options.map((option) => <option value={option}>{option}</option>)}
      </select>
    </label>
    <label>
      Message
      <textarea required name="message" rows="5" maxlength="5000"></textarea>
    </label>

    <label class="trap" aria-hidden="true">Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label>
    <input type="hidden" name="startedAt" value="" />

    <p class="privacy-note">Do not send medical records, diagnoses, medication information, Social Security numbers, or other sensitive information. <a href="/privacy/">Read the Privacy Policy.</a></p>

    <div class="verification">
      <p>Security Check</p>
      <div class="cf-turnstile" data-turnstile-widget data-sitekey="0x4AAAAAADr9GhJthRcT4-R1"></div>
    </div>

    <button class="button" type="submit" data-submit-button data-default-label={buttonLabel}>{buttonLabel}</button>
    <p class="status" role="status" aria-live="polite" aria-atomic="true"></p>
  </form>
</div>

<script is:inline>
  window.onNbtsTurnstileReady = function () {
    document.querySelectorAll('[data-turnstile-widget]').forEach(function (widget) {
      var widgetId = window.turnstile.render(widget, {
        sitekey: widget.dataset.sitekey,
        theme: 'light',
        action: 'contact',
        size: window.matchMedia('(max-width: 419px)').matches ? 'compact' : 'flexible'
      });
      widget.dataset.widgetId = widgetId;
    });
  };
</script>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onNbtsTurnstileReady&render=explicit" async defer></script>
<script>
  const CONTACT_ENDPOINT = 'https://nbts-contact.pghdma.workers.dev/api/contact';

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const started = form.querySelector<HTMLInputElement>('[name="startedAt"]');
    const status = form.querySelector<HTMLElement>('.status');
    const button = form.querySelector<HTMLButtonElement>('[data-submit-button]');

    const restartTimer = () => {
      if (started) started.value = String(Date.now());
    };

    const resetVerification = () => {
      const widget = form.querySelector<HTMLElement>('.cf-turnstile');
      const widgetId = widget?.dataset.widgetId;
      const turnstile = (window as typeof window & { turnstile?: { reset: (widgetId?: string) => void } }).turnstile;
      if (turnstile && widgetId) turnstile.reset(widgetId);
    };

    const setStatus = (message: string, type: 'success' | 'error' | 'sending' = 'sending') => {
      if (!status) return;
      status.textContent = message;
      status.dataset.state = type;
    };

    restartTimer();

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.reportValidity()) return;

      const formData = new FormData(form);
      if (!formData.get('cf-turnstile-response')) {
        setStatus('Please complete the security check before sending your message.', 'error');
        return;
      }

      const payload = Object.fromEntries(formData.entries()) as Record<string, FormDataEntryValue>;
      payload.context = form.dataset.context || 'contact';
      payload.loadtime = payload.startedAt || '';
      delete payload.startedAt;

      if (button) {
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        button.textContent = 'Sending';
      }
      setStatus('Sending your message.');

      try {
        const response = await fetch(CONTACT_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => null) as { success?: boolean; message?: string } | null;

        if (!response.ok || !result?.success) {
          throw new Error(result?.message || 'We could not send your message. Please call 412-628-0403 or email srua65@gmail.com.');
        }

        form.reset();
        setStatus(result.message || 'Thank you. Your message has been received by the website administrator for New Beginnings.', 'success');
      } catch (error) {
        const message = error instanceof Error
          ? error.message
          : 'We could not send your message. Please call 412-628-0403 or email srua65@gmail.com.';
        setStatus(message, 'error');
      } finally {
        restartTimer();
        resetVerification();
        if (button) {
          button.disabled = false;
          button.removeAttribute('aria-busy');
          button.textContent = button.dataset.defaultLabel || 'Send Message';
        }
      }
    });
  });
</script>

<style>
  .inquiry-form {
    min-width: 0;
    padding: clamp(var(--space-6), 4vw, var(--space-8));
    background: var(--paper);
  }

  .inquiry-form__header {
    display: grid;
    max-width: 38rem;
    margin-bottom: var(--space-6);
    gap: var(--space-3);
  }

  .inquiry-form__header h2 {
    font-size: clamp(2rem, 3.2vw, 2.8rem);
  }

  .inquiry-form__header > p:last-child {
    color: var(--slate-600);
  }

  form {
    display: grid;
    min-width: 0;
    gap: var(--space-4);
  }

  label {
    display: grid;
    gap: var(--space-2);
    color: var(--navy-900);
    font-size: .95rem;
    font-weight: 650;
  }

  .field-label {
    color: inherit;
    font: inherit;
  }

  .field-label small {
    color: var(--slate-500);
    font-size: .84rem;
    font-weight: 500;
  }

  input,
  select,
  textarea {
    width: 100%;
    min-height: 3.2rem;
    padding: .78rem .9rem;
    border: 1px solid var(--slate-300);
    border-radius: var(--radius);
    background: var(--white);
    color: var(--slate-700);
  }

  textarea {
    min-height: 9rem;
    resize: vertical;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--teal-700);
    box-shadow: 0 0 0 3px rgba(20, 116, 111, .14);
    outline: 0;
  }

  .privacy-note {
    max-width: 62ch;
    color: var(--slate-600);
    font-size: .86rem;
    line-height: 1.5;
  }

  .privacy-note a {
    color: var(--blue-700);
    font-weight: 650;
    text-decoration: underline;
  }

  .verification {
    display: grid;
    min-width: 0;
    gap: var(--space-2);
  }

  .verification > p {
    color: var(--navy-900);
    font-size: .92rem;
    font-weight: 650;
  }

  .cf-turnstile {
    width: 100%;
    min-height: 65px;
  }

  button {
    width: fit-content;
    min-width: 10.5rem;
  }

  button:disabled {
    cursor: wait;
    opacity: .72;
  }

  .trap {
    position: absolute;
    left: -9999px;
  }

  .status {
    min-height: 1.5em;
    color: var(--navy-800);
    font-weight: 600;
  }

  .status[data-state="error"] {
    color: var(--error);
  }

  .status[data-state="success"] {
    color: var(--success);
  }

  @media (max-width: 560px) {
    .inquiry-form {
      padding: var(--space-6) var(--space-5);
    }

    button {
      width: 100%;
    }
  }

  @media (max-width: 420px) {
    .cf-turnstile {
      width: 150px;
      min-height: 140px;
    }
  }
</style>
