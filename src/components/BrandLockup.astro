---
import lockup from '../assets/brand/lockup.svg?raw';

interface Props {
  variant?: 'header' | 'footer';
}

const { variant = 'header' } = Astro.props;
---

<span class:list={['brand-lockup', `brand-lockup--${variant}`]} set:html={lockup} />

<style>
  /* The logo is inline SVG filled with currentColor, so `color` sets the mark. */
  .brand-lockup { display: inline-flex; min-width: 0; color: var(--brand-ink); line-height: 0; }
  .brand-lockup :global(svg) { display: block; width: auto; height: var(--brand-lockup-height); }
  .brand-lockup--footer { color: var(--white); }
  .brand-lockup--footer :global(svg) { height: var(--brand-lockup-height-footer); }
</style>
