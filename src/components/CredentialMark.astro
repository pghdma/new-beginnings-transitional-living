---
/**
 * CredentialMark — the mark for one credential row. Renders the organization's
 * real logo when we have one (DDAP keystone, WestPARR hands), otherwise the
 * Lucide icon. On dark surfaces the logo sits on a small white tile.
 */
import { Icon } from 'astro-icon/components';
import type { Credential } from '../data/credentials';

interface Props {
  credential: Credential;
  tone?: 'light' | 'dark';
  class?: string;
}
const { credential: c, tone = 'light', class: className } = Astro.props;
---
<span class:list={['cred-mark', `cred-mark--${tone}`, { 'cred-mark--icon': !c.logo }, className]} aria-hidden="true">
  {c.logo ? (
    <img src={c.logo.src} alt="" width={c.logo.width} height={c.logo.height} loading="lazy" decoding="async" />
  ) : (
    <Icon name={`lucide:${c.icon}`} />
  )}
</span>

<style>
  .cred-mark { display: inline-grid; width: var(--cred-mark-size, 1.5rem); height: var(--cred-mark-size, 1.5rem); flex: 0 0 auto; place-items: center; color: var(--teal-700); }
  .cred-mark img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .cred-mark :global(svg) { width: 100%; height: 100%; stroke-width: 1.8; }
  .cred-mark--dark { padding: .16em; border-radius: 50%; background: var(--white); }
  .cred-mark--dark img, .cred-mark--dark :global(svg) { width: 82%; height: 82%; }
  .cred-mark--dark.cred-mark--icon :global(svg) { width: 62%; height: 62%; }
</style>
