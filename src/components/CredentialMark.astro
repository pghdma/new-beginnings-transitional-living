---
/**
 * CredentialMark — the mark for one credential row. Renders the organization's
 * real logo when we have one (DDAP keystone, WestPARR hands), otherwise the
 * Lucide icon. On dark surfaces the logo sits on a small white tile.
 */
import { Icon } from 'astro-icon/components';
import type { Credential } from '../data/credentials';

interface Props {
  credential: Credential;
  tone?: 'light' | 'dark';
  class?: string;
}
const { credential: c, tone = 'light', class: className } = Astro.props;
---
{c.logo ? (
  <span class:list={['cred-mark', `cred-mark--${tone}`, className]} aria-hidden="true">
    <img src={c.logo.src} alt="" width={c.logo.width} height={c.logo.height} loading="lazy" decoding="async" />
  </span>
) : (
  <Icon class={className} name={`lucide:${c.icon}`} aria-hidden="true" />
)}

<style>
  .cred-mark { display: inline-grid; width: var(--cred-mark-size, 1.5rem); height: var(--cred-mark-size, 1.5rem); flex: 0 0 auto; place-items: center; }
  .cred-mark img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .cred-mark--dark { padding: .16em; border-radius: 50%; background: var(--white); }
  .cred-mark--dark img { width: 82%; height: 82%; }
</style>
