---
/**
 * ApplicationForm — the housing application, five short steps that each fit on a laptop
 * screen. Field names and values match the contact worker's validation. Posts to the worker.
 */
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';

const steps = ['About you', 'Housing', 'The applicant', 'Details', 'Send'];
---

<form class="form apply-form" id="inquiry" data-housing-application novalidate aria-labelledby="apply-title">
  <header class="apply-form__head">
    <h1 id="apply-title">Apply for Recovery Housing</h1>
    <p class="apply-form__call">Rather just talk? <a class="inline-link" href={site.phoneHref}>Call {site.phone}</a></p>
  </header>

  <div class="apply-form__progress" aria-hidden="true">
    {steps.map((label, index) => <span class:list={['apply-form__seg', { 'is-current': index === 0 }]} data-progress-step={index + 1} title={label}></span>)}
  </div>
  <p class="apply-form__counter" data-progress-summary aria-live="polite">Step 1 of {steps.length}: {steps[0]}</p>

  <fieldset class="form-section" data-form-step="1">
    <legend tabindex="-1">Who should we call back?</legend>
    <div class="form-grid">
      <label><span class="field-label">First name <span class="req" aria-hidden="true">*</span></span><input required autocomplete="given-name" name="firstName" maxlength="100" /></label>
      <label><span class="field-label">Last name <span class="req" aria-hidden="true">*</span></span><input required autocomplete="family-name" name="lastName" maxlength="100" /></label>
      <label><span class="field-label">Email <span class="req" aria-hidden="true">*</span></span><input required type="email" autocomplete="email" name="email" maxlength="254" /></label>
      <label><span class="field-label">Phone <span class="req" aria-hidden="true">*</span></span><input required type="tel" autocomplete="tel" name="phone" maxlength="20" /></label>
    </div>
    <fieldset class="choice-group">
      <legend>I am <span class="req" aria-hidden="true">*</span></legend>
      <div class="choice-grid choice-grid--three">
        <label class="choice"><input required type="radio" name="contactType" value="Applicant" data-contact-type /><span><strong>Applying for myself</strong></span></label>
        <label class="choice"><input required type="radio" name="contactType" value="Family or support person" data-contact-type /><span><strong>Helping a family member or friend</strong></span></label>
        <label class="choice"><input required type="radio" name="contactType" value="Professional or referral partner" data-contact-type /><span><strong>A counselor, case manager, or PO</strong></span></label>
      </div>
    </fieldset>
    <div class="step-actions">
      <button class="button" type="button" data-next-step>Continue<Icon name="lucide:arrow-right" aria-hidden="true" /></button>
      <span class="step-actions__hint">Fields marked <span class="req" aria-hidden="true">*</span> are required</span>
    </div>
  </fieldset>

  <fieldset class="form-section" data-form-step="2" hidden>
    <legend tabindex="-1">Which housing?</legend>
    <fieldset class="choice-group">
      <legend>Housing requested <span class="req" aria-hidden="true">*</span></legend>
      <div class="choice-grid choice-grid--two">
        <label class="choice"><input required type="radio" name="housingType" value="Men's recovery housing" /><span><strong>Men’s recovery housing</strong><small>Houses in four neighborhoods, including one for men on parole</small></span></label>
        <label class="choice"><input required type="radio" name="housingType" value="Women's recovery housing" /><span><strong>Women’s recovery housing</strong><small>One house in Bellevue</small></span></label>
      </div>
    </fieldset>
    <div class="form-grid applicant-fields" data-applicant-fields hidden>
      <label><span class="field-label">Applicant’s first name <span class="req" aria-hidden="true">*</span></span><input name="applicantFirstName" maxlength="100" data-applicant-required /></label>
      <label><span class="field-label">Applicant’s last name <span class="req" aria-hidden="true">*</span></span><input name="applicantLastName" maxlength="100" data-applicant-required /></label>
    </div>
    <div class="step-actions">
      <button class="button" type="button" data-next-step>Continue<Icon name="lucide:arrow-right" aria-hidden="true" /></button>
      <button class="button button-secondary" type="button" data-previous-step>Back</button>
    </div>
  </fieldset>

  <fieldset class="form-section" data-form-step="3" hidden>
    <legend tabindex="-1">About the applicant</legend>
    <div class="pill-rows">
      <fieldset class="choice-group pill-row">
        <legend>18 or older? <span class="req" aria-hidden="true">*</span></legend>
        <div class="pills"><label class="pill"><input required type="radio" name="adultStatus" value="Yes" /><span>Yes</span></label><label class="pill"><input required type="radio" name="adultStatus" value="No" /><span>No</span></label></div>
      </fieldset>
      <fieldset class="choice-group pill-row">
        <legend>Lived with New Beginnings before? <span class="req" aria-hidden="true">*</span></legend>
        <div class="pills"><label class="pill"><input required type="radio" name="previousResident" value="Yes" /><span>Yes</span></label><label class="pill"><input required type="radio" name="previousResident" value="No" /><span>No</span></label></div>
      </fieldset>
      <fieldset class="choice-group pill-row">
        <legend>Willing to live substance free and follow the house rules? <span class="req" aria-hidden="true">*</span></legend>
        <div class="pills"><label class="pill"><input required type="radio" name="sharedLivingAgreement" value="Yes" /><span>Yes</span></label><label class="pill"><input required type="radio" name="sharedLivingAgreement" value="No" /><span>No</span></label></div>
      </fieldset>
    </div>
    <label class="select-field"><span class="field-label">When would the applicant like to move? <span class="req" aria-hidden="true">*</span></span><select name="moveTiming" required><option value="">Select one</option><option value="As soon as available">As soon as available</option><option value="Within two weeks">Within two weeks</option><option value="Within 30 days">Within 30 days</option><option value="Planning ahead">Planning ahead</option></select></label>
    <div class="step-actions">
      <button class="button" type="button" data-next-step>Continue<Icon name="lucide:arrow-right" aria-hidden="true" /></button>
      <button class="button button-secondary" type="button" data-previous-step>Back</button>
    </div>
  </fieldset>

  <fieldset class="form-section" data-form-step="4" hidden>
    <legend tabindex="-1">Anything else?</legend>
    <label class="select-field"><span class="field-label">How did you hear about us? <small>(optional)</small></span><select name="referralSource"><option value="">Select one</option><option value="Treatment provider">Treatment provider</option><option value="Court or justice partner">Court or justice partner</option><option value="Family or friend">Family or friend</option><option value="Community organization">Community organization</option><option value="Online search">Online search</option><option value="Other">Other</option></select></label>
    <label><span class="field-label">Anything you want us to know <small>(optional)</small></span><textarea name="message" rows="3" maxlength="2000" aria-describedby="message-guidance"></textarea></label>
    <p class="field-guidance" id="message-guidance">Leave out diagnoses, medications, treatment, and legal records. We’ll ask for what we need by phone.</p>
    <div class="step-actions">
      <button class="button" type="button" data-next-step>Continue<Icon name="lucide:arrow-right" aria-hidden="true" /></button>
      <button class="button button-secondary" type="button" data-previous-step>Back</button>
    </div>
  </fieldset>

  <fieldset class="form-section" data-form-step="5" hidden>
    <legend tabindex="-1">How should we reach you?</legend>
    <div class="form-grid">
      <fieldset class="choice-group pill-row pill-row--stack">
        <legend>Preferred contact <span class="req" aria-hidden="true">*</span></legend>
        <div class="pills"><label class="pill"><input required type="radio" name="preferredContact" value="Phone" /><span>Phone</span></label><label class="pill"><input required type="radio" name="preferredContact" value="Email" /><span>Email</span></label></div>
      </fieldset>
      <label class="select-field"><span class="field-label">Best time <small>(optional)</small></span><select name="bestTime"><option value="">Any time</option><option value="Morning">Morning</option><option value="Afternoon">Afternoon</option><option value="Evening">Evening</option></select></label>
    </div>
    <label class="trap" aria-hidden="true">Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label>
    <input type="hidden" name="startedAt" value="" />
    <div class="check-list">
      <label class="check-choice"><input type="checkbox" name="accommodationDiscussion" value="Yes" /><span>I’d like to discuss accessibility or accommodation needs privately.</span></label>
      <label class="check-choice"><input required type="checkbox" name="applicationAcknowledgement" value="Yes" /><span>I understand this application starts a conversation and doesn’t guarantee a bed. <span class="req" aria-hidden="true">*</span></span></label>
    </div>
    <div class="step-actions step-actions--submit">
      <div class="verification"><div class="cf-turnstile" data-turnstile-widget data-sitekey="0x4AAAAAADr9GhJthRcT4-R1"></div></div>
      <button class="button" type="submit" data-submit-button data-default-label="Send Application">Send Application<Icon name="lucide:send" aria-hidden="true" /></button>
      <button class="button button-secondary" type="button" data-previous-step>Back</button>
    </div>
    <p class="status" role="status" aria-live="polite" aria-atomic="true"></p>
  </fieldset>
</form>

<script is:inline>
  window.onNbtsApplicationTurnstileReady = function () {
    document.querySelectorAll('[data-turnstile-widget]').forEach(function (widget) {
      if (widget.dataset.widgetId) return;
      var widgetId = window.turnstile.render(widget, {
        sitekey: widget.dataset.sitekey,
        theme: 'light',
        action: 'housing_application',
        size: window.matchMedia('(max-width: 419px)').matches ? 'compact' : 'flexible'
      });
      widget.dataset.widgetId = widgetId;
    });
  };
</script>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onNbtsApplicationTurnstileReady&render=explicit" async defer></script>

<script>
  const APPLICATION_ENDPOINT = 'https://nbts-contact.pghdma.workers.dev/api/contact';
  const STEP_NAMES = ['About you', 'Housing', 'The applicant', 'Details', 'Send'];
  const ERROR_TEXT: Record<string, string> = {
    firstName: 'Enter your first name.',
    lastName: 'Enter your last name.',
    email: 'Enter an email address we can reply to.',
    phone: 'Enter a phone number we can call.',
    applicantFirstName: 'Enter the applicant’s first name.',
    applicantLastName: 'Enter the applicant’s last name.',
    contactType: 'Choose who is completing this application.',
    preferredContact: 'Choose how you’d like us to reach you.',
    housingType: 'Choose men’s or women’s housing.',
    adultStatus: 'Tell us whether the applicant is 18 or older.',
    moveTiming: 'Select when the applicant would like to move.',
    previousResident: 'Tell us whether the applicant has lived here before.',
    sharedLivingAgreement: 'Answer whether the applicant is willing to follow the house rules.',
    applicationAcknowledgement: 'Check this box to continue.',
  };
  type Control = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

  document.querySelectorAll<HTMLFormElement>('[data-housing-application]').forEach((form) => {
    const sections = Array.from(form.querySelectorAll<HTMLElement>('[data-form-step]'));
    const progressItems = Array.from(form.querySelectorAll<HTMLElement>('[data-progress-step]'));
    const progressSummary = form.querySelector<HTMLElement>('[data-progress-summary]');
    const started = form.querySelector<HTMLInputElement>('[name="startedAt"]');
    const status = form.querySelector<HTMLElement>('.status');
    const button = form.querySelector<HTMLButtonElement>('[data-submit-button]');
    const contactChoices = form.querySelectorAll<HTMLInputElement>('[data-contact-type]');
    const applicantFields = form.querySelector<HTMLElement>('[data-applicant-fields]');
    const applicantRequired = form.querySelectorAll<HTMLInputElement>('[data-applicant-required]');
    let currentStep = 1;

    const restartTimer = () => { if (started) started.value = String(Date.now()); };

    const errorHost = (control: Control) => control.type === 'radio' || control.type === 'checkbox'
      ? (control.closest('.choice-group') || control.closest('.check-choice')) as HTMLElement | null
      : (control.closest('label') as HTMLElement | null);
    const clearError = (control: Control) => {
      const host = errorHost(control);
      host?.querySelector('.field-error')?.remove();
      host?.classList.remove('has-error');
      const group = control.type === 'radio' ? form.querySelectorAll<HTMLInputElement>(`[name="${control.name}"]`) : [control];
      group.forEach((c) => c.removeAttribute('aria-invalid'));
    };
    const showError = (control: Control) => {
      const host = errorHost(control);
      if (!host) return;
      clearError(control);
      const message = document.createElement('p');
      message.className = 'field-error';
      message.id = `error-${control.name}`;
      message.innerHTML = `<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg><span></span>`;
      message.querySelector('span')!.textContent = ERROR_TEXT[control.name] || control.validationMessage || 'Please complete this field.';
      host.appendChild(message);
      host.classList.add('has-error');
      const group = control.type === 'radio' ? form.querySelectorAll<HTMLInputElement>(`[name="${control.name}"]`) : [control];
      group.forEach((c) => { c.setAttribute('aria-invalid', 'true'); c.setAttribute('aria-describedby', message.id); });
    };
    form.addEventListener('input', (event) => { const t = event.target as Control; if (t?.name && t.checkValidity()) clearError(t); });
    form.addEventListener('change', (event) => { const t = event.target as Control; if (t?.name && t.checkValidity()) clearError(t); });

    const updateApplicantFields = () => {
      const selected = form.querySelector<HTMLInputElement>('[data-contact-type]:checked');
      const needsApplicantName = Boolean(selected && selected.value !== 'Applicant');
      if (applicantFields) applicantFields.hidden = !needsApplicantName;
      applicantRequired.forEach((field) => {
        field.required = needsApplicantName;
        if (!needsApplicantName) { field.value = ''; clearError(field); }
      });
    };

    const showStep = (step: number, moveFocus = true) => {
      currentStep = Math.min(Math.max(step, 1), sections.length);
      sections.forEach((section, index) => { section.hidden = index + 1 !== currentStep; });
      progressItems.forEach((item, index) => {
        item.classList.toggle('is-current', index + 1 === currentStep);
        item.classList.toggle('is-complete', index + 1 < currentStep);
      });
      if (progressSummary) progressSummary.textContent = `Step ${currentStep} of ${sections.length}: ${STEP_NAMES[currentStep - 1]}`;
      if (moveFocus) {
        sections[currentStep - 1]?.querySelector<HTMLElement>(':scope > legend')?.focus({ preventScroll: true });
        form.scrollIntoView({ block: 'start', behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      }
    };

    const validateStep = (section: HTMLElement) => {
      updateApplicantFields();
      const controls = Array.from(section.querySelectorAll<Control>('input, select, textarea')).filter((c) => !c.closest('[hidden]') || c.closest('[hidden]') === section);
      const seen = new Set<string>();
      let first: Control | null = null;
      controls.forEach((control) => {
        if (control.type === 'radio' && seen.has(control.name)) return;
        seen.add(control.name);
        if (control.checkValidity()) { clearError(control); return; }
        showError(control);
        if (!first) first = control;
      });
      if (first) {
        const target = first as Control;
        (target.type === 'radio' ? (errorHost(target) || target) : target).scrollIntoView({ block: 'center', behavior: 'smooth' });
        target.focus({ preventScroll: true });
        return false;
      }
      return true;
    };

    const resetVerification = () => {
      const widget = form.querySelector<HTMLElement>('.cf-turnstile');
      const widgetId = widget?.dataset.widgetId;
      const turnstile = (window as typeof window & { turnstile?: { reset: (widgetId?: string) => void } }).turnstile;
      if (turnstile && widgetId) turnstile.reset(widgetId);
    };
    const setStatus = (message: string, type: 'success' | 'error' | 'sending' = 'sending') => {
      if (!status) return;
      status.textContent = message;
      status.dataset.state = type;
    };

    form.querySelectorAll<HTMLButtonElement>('[data-next-step]').forEach((next) => next.addEventListener('click', () => { if (validateStep(sections[currentStep - 1])) showStep(currentStep + 1); }));
    form.querySelectorAll<HTMLButtonElement>('[data-previous-step]').forEach((previous) => previous.addEventListener('click', () => showStep(currentStep - 1)));
    contactChoices.forEach((choice) => choice.addEventListener('change', updateApplicantFields));
    updateApplicantFields();
    showStep(1, false);
    restartTimer();

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      for (let i = 0; i < sections.length; i += 1) {
        if (!validateStep(sections[i])) { if (currentStep !== i + 1) showStep(i + 1); return; }
      }
      const formData = new FormData(form);
      if (!formData.get('cf-turnstile-response')) {
        setStatus('Please complete the security check before sending.', 'error');
        return;
      }
      const payload = Object.fromEntries(formData.entries()) as Record<string, FormDataEntryValue>;
      payload.context = 'housing';
      payload.loadtime = payload.startedAt || '';
      delete payload.startedAt;
      if (button) {
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        button.textContent = 'Sending';
      }
      setStatus('Sending your application.');
      try {
        const response = await fetch(APPLICATION_ENDPOINT, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        const result = await response.json().catch(() => null) as { success?: boolean; message?: string } | null;
        if (!response.ok || !result?.success) throw new Error(result?.message || 'We could not send the application right now. Please call 412-628-0403.');
        form.reset();
        updateApplicantFields();
        setStatus(result.message || 'Thank you. Your application has been received. We’ll call you back.', 'success');
      } catch (error) {
        setStatus(error instanceof Error ? error.message : 'We could not send the application right now. Please call 412-628-0403.', 'error');
      } finally {
        restartTimer();
        resetVerification();
        if (button) {
          button.disabled = false;
          button.removeAttribute('aria-busy');
          button.textContent = button.dataset.defaultLabel || 'Send Application';
        }
      }
    });
  });
</script>

<style>
  .apply-form { display: grid; width: 100%; min-height: 100%; grid-template-rows: auto auto auto minmax(0, 1fr); padding: clamp(1.25rem, 2.5vw, 1.75rem) clamp(var(--space-5), 4vw, var(--space-8)) clamp(1.5rem, 2.5vw, 2rem); border: 1px solid var(--slate-200); border-radius: var(--radius-lg); background: var(--paper); box-shadow: var(--shadow-raised); gap: var(--space-4); scroll-margin-top: calc(var(--header-total-height) + 1rem); }
  .apply-form__head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-5); }
  .apply-form__head h1 { max-width: none; margin-top: 0; font-size: clamp(1.45rem, 2.2vw, 1.85rem); }
  .apply-form__call { color: var(--slate-600); font-size: .95rem; white-space: nowrap; }
  .apply-form__progress { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .3rem; }
  .apply-form__seg { height: .35rem; border-radius: 999px; background: var(--slate-200); transition: background .15s ease; }
  .apply-form__seg.is-current, .apply-form__seg.is-complete { background: var(--teal-700); }
  .apply-form__counter { margin-top: calc(var(--space-2) * -1); color: var(--teal-800); font-size: .74rem; font-weight: var(--weight-semibold); letter-spacing: .08em; text-transform: uppercase; }

  .form-section { display: flex; min-width: 0; margin: 0; padding: 0; border: 0; flex-direction: column; gap: var(--space-4); }
  .form-section[hidden] { display: none; }
  .form-section > legend { padding: var(--space-1) 0 var(--space-1); color: var(--navy-900); font-family: var(--font-display); font-size: clamp(1.25rem, 2vw, 1.5rem); font-weight: var(--weight-display); letter-spacing: -.015em; line-height: 1.2; }
  .form-section > legend:focus { outline: 0; }
  .section-intro { max-width: 58ch; margin-top: calc(var(--space-3) * -1); color: var(--slate-600); font-size: .95rem; }
  .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); align-items: start; }
  .form-grid > label { align-content: start; }
  .applicant-fields[hidden] { display: none; }
  .apply-form :global(input:not([type="radio"]):not([type="checkbox"])), .apply-form :global(select) { min-height: 2.9rem; padding-block: .6rem; }
  .apply-form :global(textarea) { min-height: 5.5rem; }
  .apply-form :global(.choice) { min-height: 0; padding: .7rem .85rem; align-items: center; }
  .apply-form :global(.choice small) { font-size: .86rem; }
  .apply-form :global(.check-choice) { padding: .6rem .85rem; }
  .apply-form :global(.check-list) { gap: var(--space-2); }
  .apply-form :global(.privacy-note) { font-size: .84rem; }

  /* Compact yes/no pills */
  .pill-rows { display: grid; gap: var(--space-3); }
  .pill-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-4); align-items: center; padding-bottom: var(--space-3); border-bottom: 1px solid var(--slate-200); }
  .pill-row:last-child { padding-bottom: 0; border-bottom: 0; }
  .pill-row > legend { float: left; padding: 0; font-size: 1rem; font-weight: var(--weight-medium); }
  .pill-row--stack { display: grid; grid-template-columns: 1fr; gap: var(--space-2); padding: 0; border: 0; }
  .pill-row--stack > legend { font-weight: var(--weight-semibold); }
  .pills { display: inline-flex; padding: .2rem; border: var(--control-border); border-radius: 999px; background: var(--white); gap: .2rem; }
  .pill { position: relative; cursor: pointer; }
  .pill input { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .pill span { display: inline-flex; min-width: 4.5rem; min-height: 2.35rem; padding: .35rem 1rem; border-radius: 999px; align-items: center; justify-content: center; color: var(--navy-900); font-weight: var(--weight-semibold); transition: background .12s ease, color .12s ease; }
  .pill input:checked + span { color: var(--white); background: var(--teal-700); }
  .pill input:focus-visible + span { box-shadow: var(--focus-ring); }
  .pill-row.has-error { padding-left: var(--space-4); border-left: 3px solid var(--error); }
  .pill-row :global(.field-error) { grid-column: 1 / -1; }

  .step-actions { display: flex; margin-top: auto; padding-top: var(--space-3); border-top: 1px solid var(--slate-200); align-items: center; gap: var(--space-3); }
  .step-actions .button { gap: var(--button-gap); }
  .step-actions .button :global(svg) { width: 1rem; height: 1rem; }
  .step-actions__hint { margin-left: auto; color: var(--slate-600); font-size: .88rem; }
  .button-secondary { border: 1px solid var(--navy-900); background: transparent; color: var(--navy-900); }
  .button-secondary:hover { background: var(--sky-100); color: var(--navy-900); }
  .step-actions--submit { flex-wrap: wrap; }
  .step-actions--submit .verification { margin: 0 auto 0 0; }
  .apply-form :global(.cf-turnstile) { max-width: 19rem; min-height: 65px; }

  @media (max-width: 900px) {
    .apply-form__call, .section-intro, .step-actions__hint, .apply-form :global(.choice small), .apply-form :global(.privacy-note), .field-guidance { font-size: 1rem; }
  }

  @media (max-width: 760px) {
    .apply-form { padding: var(--space-5) var(--space-4); gap: var(--space-4); }
    .apply-form__head { flex-direction: column; align-items: flex-start; gap: var(--space-2); }
    .form-grid { grid-template-columns: 1fr; }
    .pill-row { grid-template-columns: 1fr; gap: var(--space-2); }
    .step-actions { display: grid; grid-template-columns: 1fr; }
    .step-actions--submit .verification { margin: 0; }
    .step-actions .button { width: 100%; }
    .step-actions__hint { margin-left: 0; }
  }
</style>
