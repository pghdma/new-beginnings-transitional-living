---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { buildStructuredData, normalizePathname, seoRoutes } from '../data/seo';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  lastReviewed?: string;
}

const {
  title,
  description: suppliedDescription = site.description,
  noindex = false,
  lastReviewed,
} = Astro.props;

const pathname = normalizePathname(Astro.url.pathname);
const routeSeo = seoRoutes[pathname];
const documentTitle = routeSeo?.documentTitle ?? (title === site.shortName ? title : `${title} | ${site.shortName}`);
const description = routeSeo?.description ?? suppliedDescription;
const canonical = new URL(pathname, site.url);
const canonicalUrl = canonical.toString();
const socialImagePath = routeSeo?.image ?? '/images/og-default.jpg';
const socialImage = new URL(socialImagePath, site.url).toString();
const socialImageAlt = routeSeo?.imageAlt ?? 'New Beginnings recovery housing website in Pittsburgh';
const structuredData = routeSeo && !noindex
  ? buildStructuredData(routeSeo, canonicalUrl, lastReviewed)
  : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#102c3c" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.shortName} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="home" href={`${site.url}/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
