---
import MainLayout from './MainLayout.astro'; import PageHero from '../components/PageHero.astro'; interface Props { title: string; intro: string; } const { title, intro } = Astro.props;
---
<MainLayout title={title}><PageHero eyebrow="Website information" title={title} intro={intro} plain actions={false} compact /><article class="container legal"><slot /></article></MainLayout>
<style>.legal { max-width: 50rem; padding-block: var(--space-8) var(--space-9); }.legal :global(h2) { margin-top: var(--space-7); font-size: 1.8rem; }.legal :global(h3) { margin-top: var(--space-6); font-size: 1.3rem; }.legal :global(p), .legal :global(ul) { margin-top: var(--space-4); }</style>
