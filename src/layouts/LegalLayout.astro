---
import MainLayout from './MainLayout.astro';

interface Section {
  id: string;
  title: string;
}

interface Props {
  title: string;
  intro: string;
  description?: string;
  updated: string;
  sections: Section[];
}

const { title, intro, description = intro, updated, sections } = Astro.props;
const parsedReviewDate = new Date(updated);
const lastReviewed = Number.isNaN(parsedReviewDate.getTime())
  ? undefined
  : parsedReviewDate.toISOString().slice(0, 10);
---

<MainLayout title={title} description={description} lastReviewed={lastReviewed}>
  <header class="legal-masthead" aria-labelledby="legal-page-title">
    <div class="container legal-masthead__inner">
      <div class="legal-masthead__copy">
        <p class="eyebrow">Website Information</p>
        <h1 id="legal-page-title">{title}</h1>
        <p class="legal-masthead__intro">{intro}</p>
      </div>

      <dl class="legal-metadata" aria-label="Document information">
        <div>
          <dt>Published by</dt>
          <dd>New Beginnings Transitional Living Foundation</dd>
        </div>
        <div>
          <dt>Last reviewed</dt>
          <dd>{updated}</dd>
        </div>
      </dl>
    </div>
  </header>

  <section class="legal-body" aria-label={`${title} document`}>
    <div class="container legal-layout">
      <aside class="legal-toc-wrap">
        <nav class="legal-toc legal-toc--desktop" aria-label="On this page">
          <p class="legal-toc-heading">On this page</p>
          <ol class="legal-toc-list">
            {
              sections.map((section, index) => (
                <li>
                  <a
                    class="legal-toc-link"
                    href={`#${section.id}`}
                    data-section={section.id}
                  >
                    <span class="legal-toc-num" aria-hidden="true">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <span>{section.title}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>

        <details class="legal-toc-disclosure">
          <summary>
            <span>On this page</span>
            <small>{sections.length} sections</small>
          </summary>
          <nav aria-label="On this page, mobile">
            <ol class="legal-toc-list">
              {
                sections.map((section, index) => (
                  <li>
                    <a
                      class="legal-toc-link"
                      href={`#${section.id}`}
                      data-section={section.id}
                    >
                      <span class="legal-toc-num" aria-hidden="true">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <span>{section.title}</span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>
        </details>
      </aside>

      <article class="legal-content">
        <slot />
      </article>
    </div>
  </section>
</MainLayout>

<style>
  .legal-masthead {
    padding-block: clamp(3.5rem, 7vw, 6rem);
    background: var(--sky-50);
  }

  .legal-masthead__inner {
    display: grid;
    grid-template-columns: minmax(0, 46rem) minmax(14rem, 18rem);
    gap: clamp(var(--space-7), 5vw, var(--space-9));
    align-items: end;
    justify-content: start;
  }

  .legal-masthead__copy {
    max-width: 48rem;
  }

  .legal-masthead h1 {
    max-width: 22ch;
    margin-top: var(--space-4);
    font-size: var(--type-display-document);
    font-weight: var(--weight-heading);
    line-height: 1.04;
  }

  .legal-masthead__intro {
    max-width: 44rem;
    margin-top: var(--space-5);
    color: var(--slate-800);
    font-size: clamp(1.12rem, 1.6vw, 1.3rem);
    line-height: 1.55;
  }

  .legal-metadata {
    display: grid;
    gap: var(--space-5);
    margin: 0;
  }

  .legal-metadata div {
    display: grid;
    gap: var(--space-2);
  }

  .legal-metadata dt,
  .legal-toc-heading {
    margin: 0;
    color: var(--teal-700);
    font-size: .74rem;
    font-weight: var(--weight-semibold);
    letter-spacing: .13em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .legal-metadata dd {
    margin: 0;
    color: var(--navy-900);
    font-size: .94rem;
    line-height: 1.45;
  }

  .legal-body {
    padding-block: clamp(var(--space-8), 7vw, var(--space-10));
    background: var(--canvas);
  }

  .legal-layout {
    display: grid;
    grid-template-columns: minmax(13rem, 15.5rem) minmax(0, 48rem);
    gap: clamp(var(--space-6), 5vw, var(--space-9));
    align-items: start;
    justify-content: center;
  }

  .legal-toc-wrap {
    position: sticky;
    top: var(--sticky-offset);
    align-self: start;
  }

  .legal-toc {
    position: static;
  }

  .legal-toc-heading {
    margin-bottom: var(--space-4);
    padding-inline: var(--space-3);
  }

  .legal-toc-list {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .legal-toc-link {
    display: grid;
    grid-template-columns: 1.65rem minmax(0, 1fr);
    gap: var(--space-2);
    align-items: start;
    padding: .62rem var(--space-3);
    border-radius: var(--radius);
    color: var(--slate-700);
    font-size: .9rem;
    line-height: 1.35;
    text-decoration: none;
    transition: color .15s ease, background-color .15s ease;
  }

  .legal-toc-link:hover {
    color: var(--navy-900);
    background: rgba(216, 231, 230, .55);
  }

  .legal-toc-link.is-active {
    color: var(--navy-900);
    background: var(--sky-100);
    font-weight: var(--weight-heading);
  }

  .legal-toc-num {
    color: var(--slate-600);
    font-size: .7rem;
    font-variant-numeric: tabular-nums;
    font-weight: var(--weight-semibold);
    letter-spacing: .07em;
    line-height: 1.75;
  }

  .legal-toc-link.is-active .legal-toc-num {
    color: var(--teal-700);
  }

  .legal-toc-disclosure {
    display: none;
  }

  .legal-content {
    width: 100%;
    padding: clamp(var(--space-6), 4vw, var(--space-8));
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: var(--shadow-raised);
  }

  .legal-content :global(.legal-intro) {
    margin: 0 0 var(--space-4);
    color: var(--navy-900);
    font-size: clamp(1.12rem, 1.8vw, 1.28rem);
    line-height: 1.62;
  }

  .legal-content :global(.legal-entity) {
    margin: 0 0 clamp(var(--space-7), 5vw, var(--space-8));
    color: var(--slate-600);
    font-size: .9rem;
    font-style: italic;
    line-height: 1.55;
  }

  .legal-content :global(.legal-section) {
    padding: 0;
    margin-top: clamp(3.5rem, 6vw, 5rem);
    scroll-margin-top: var(--space-4);
  }

  .legal-content :global(.legal-section:first-of-type) {
    margin-top: 0;
  }

  .legal-content :global(.legal-section > h2) {
    margin: 0 0 var(--space-5);
    font-size: clamp(1.6rem, 3vw, 2rem);
    font-weight: var(--weight-heading);
    letter-spacing: -.015em;
    line-height: 1.18;
  }

  .legal-content :global(.legal-section > h2)::before {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--teal-700);
    content: attr(data-label);
    font-family: var(--font-body);
    font-size: .72rem;
    font-weight: var(--weight-semibold);
    letter-spacing: .13em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .legal-content :global(h3) {
    margin: var(--space-6) 0 var(--space-3);
    font-size: 1.2rem;
    font-weight: var(--weight-heading);
    letter-spacing: -.01em;
    line-height: 1.3;
  }

  .legal-content :global(p) {
    margin: 0 0 var(--space-4);
    line-height: 1.74;
  }

  .legal-content :global(ul) {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-4) 0 var(--space-5);
    padding-left: 1.3rem;
  }

  .legal-content :global(li) {
    padding-left: var(--space-2);
    line-height: 1.65;
  }

  .legal-content :global(li::marker) {
    color: var(--teal-700);
  }

  .legal-content :global(a) {
    font-weight: var(--weight-heading);
    text-decoration-line: underline;
    text-decoration-thickness: .07em;
    text-underline-offset: .18em;
  }

  .legal-content :global(strong) {
    color: var(--navy-900);
    font-weight: var(--weight-semibold);
  }

  .legal-content :global(.legal-callout) {
    display: grid;
    grid-template-columns: minmax(8rem, 10rem) minmax(0, 1fr);
    gap: var(--space-4) var(--space-6);
    align-items: start;
    padding: var(--space-5);
    margin: var(--space-5) 0 var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--sky-50);
  }

  .legal-content :global(.legal-callout-label) {
    margin: .2rem 0 0;
    color: var(--teal-700);
    font-size: .73rem;
    font-weight: var(--weight-semibold);
    letter-spacing: .12em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .legal-content :global(.legal-callout-body p:last-child),
  .legal-content :global(.legal-contact p:last-child) {
    margin-bottom: 0;
  }

  .legal-content :global(.legal-contact) {
    padding: var(--space-5);
    margin-top: var(--space-5);
    border-radius: var(--radius);
    background: var(--sky-50);
  }

  @media (max-width: 900px) {
    .legal-masthead__inner,
    .legal-layout {
      grid-template-columns: 1fr;
    }

    .legal-masthead__inner {
      gap: var(--space-7);
    }

    .legal-metadata {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 40rem;
      gap: var(--space-6);
    }

    .legal-layout {
      max-width: 50rem;
      gap: var(--space-5);
    }

    .legal-toc-wrap {
      position: static;
    }

    .legal-toc--desktop {
      display: none;
    }

    .legal-toc-disclosure {
      display: block;
      border-radius: var(--radius-lg);
      background: var(--paper);
      box-shadow: var(--shadow);
    }

    .legal-toc-disclosure summary {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto 1rem;
      gap: var(--space-3);
      align-items: center;
      padding: var(--space-4) var(--space-5);
      color: var(--navy-900);
      font-weight: var(--weight-heading);
      cursor: pointer;
      list-style: none;
    }

    .legal-toc-disclosure summary::-webkit-details-marker {
      display: none;
    }

    .legal-toc-disclosure summary::after {
      width: .5rem;
      height: .5rem;
      border-right: 1.5px solid currentColor;
      border-bottom: 1.5px solid currentColor;
      content: '';
      transform: translateY(-.15rem) rotate(45deg);
      transition: transform .15s ease;
    }

    .legal-toc-disclosure[open] summary::after {
      transform: translateY(.15rem) rotate(225deg);
    }

    .legal-toc-disclosure summary small {
      color: var(--slate-600);
      font-size: .82rem;
      font-weight: var(--weight-medium);
    }

    .legal-toc-disclosure nav {
      padding: 0 var(--space-3) var(--space-4);
    }

    .legal-toc-disclosure .legal-toc-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-1) var(--space-3);
    }
  }

  @media (max-width: 760px) {
    .legal-masthead {
      padding-block: var(--space-7);
    }

    .legal-masthead h1 {
      font-size: clamp(2.45rem, 12vw, 3.35rem);
    }

    .legal-masthead__intro {
      margin-top: var(--space-4);
      font-size: 1.08rem;
    }

    .legal-metadata {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .legal-body {
      padding-block: var(--space-7) var(--space-8);
    }

    .legal-toc-disclosure summary {
      padding-inline: var(--space-4);
    }

    .legal-toc-disclosure summary small {
      display: none;
    }

    .legal-toc-disclosure .legal-toc-list {
      grid-template-columns: 1fr;
    }

    .legal-content {
      padding: var(--space-5);
    }

    .legal-content :global(.legal-section) {
      margin-top: var(--space-8);
    }

    .legal-content :global(.legal-callout) {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      padding: var(--space-4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .legal-toc-disclosure summary::after {
      transition: none;
    }
  }

  /* Mobile floor: 16px copy, one alignment per section, 44px tap targets. Measured by scripts/mobile-audit.mjs */
  @media (max-width: 900px) {
    .legal-toc-link { min-height: 2.75rem; }
    .legal-metadata dd { font-size: 1rem; }
    .legal-content :global(.legal-entity) { font-size: 1rem; }
  }
</style>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.legal-toc-link'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('.legal-section'));

  if (links.length && sections.length) {
    const offset = 144;
    const setActive = () => {
      let current = sections[0]?.id ?? '';

      for (const section of sections) {
        if (section.getBoundingClientRect().top <= offset + 20) current = section.id;
      }

      for (const link of links) {
        const active = link.dataset.section === current;
        link.classList.toggle('is-active', active);
        if (active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
    };

    window.addEventListener('scroll', setActive, { passive: true });
    window.addEventListener('hashchange', setActive);
    setActive();

  }
</script>
