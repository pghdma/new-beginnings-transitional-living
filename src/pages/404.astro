---
import MainLayout from '../layouts/MainLayout.astro';

const helpfulPages = [
  {
    href: '/admissions/',
    title: 'Admissions',
    description: 'Ask about availability and the next steps for housing.',
  },
  {
    href: '/recovery-housing/',
    title: 'Recovery Housing',
    description: 'Learn how structured shared living supports recovery.',
  },
  {
    href: '/referrals/',
    title: 'Professional Referrals',
    description: 'Find referral information for providers and community partners.',
  },
  {
    href: '/contact/',
    title: 'Contact',
    description: 'Reach New Beginnings with a general question.',
  },
];
---

<MainLayout
  title="Page Not Found"
  description="The page you requested could not be found. Use these links to continue through the New Beginnings website."
  noindex
>
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="container">
      <div class="not-found__surface">
        <div class="not-found__message">
          <p class="eyebrow">404 · Page not found</p>
          <h1 id="not-found-title">We couldn’t find that page.</h1>
          <p class="lead">
            The address may have changed, or the page may no longer exist. Return to the
            homepage or choose a useful place to continue.
          </p>
          <div class="actions">
            <a class="button" href="/">Return to the homepage</a>
            <a class="text-link" href="/contact/">Contact New Beginnings</a>
          </div>
        </div>

        <nav class="not-found__directory" aria-labelledby="directory-title">
          <div class="not-found__directory-heading">
            <p class="eyebrow">Website directory</p>
            <h2 id="directory-title">Helpful places to continue</h2>
          </div>

          <ul>
            {
              helpfulPages.map((page) => (
                <li>
                  <a href={page.href}>
                    <span>
                      <strong>{page.title}</strong>
                      <small>{page.description}</small>
                    </span>
                    <span class="not-found__arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .not-found {
    padding-block: clamp(var(--space-8), 8vw, var(--space-10));
    background: var(--sky-50);
  }

  .not-found__surface {
    max-width: 65rem;
    margin-inline: auto;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: var(--shadow-raised);
  }

  .not-found__message {
    padding: clamp(var(--space-7), 6vw, var(--space-9));
  }

  .not-found__message h1 {
    max-width: 13ch;
    margin-top: var(--space-4);
    font-size: clamp(2.7rem, 5.5vw, 4.4rem);
    font-weight: 600;
  }

  .not-found__message .lead {
    max-width: 42rem;
    margin-top: var(--space-5);
  }

  .not-found__message .actions {
    margin-top: var(--space-6);
  }

  .not-found__message .text-link {
    color: var(--navy-900);
  }

  .not-found__directory {
    display: grid;
    grid-template-columns: minmax(12rem, .55fr) minmax(0, 1.45fr);
    gap: clamp(var(--space-6), 5vw, var(--space-8));
    padding: clamp(var(--space-6), 5vw, var(--space-8));
    background: var(--sky-100);
  }

  .not-found__directory-heading h2 {
    max-width: 13ch;
    margin-top: var(--space-3);
    font-size: clamp(1.65rem, 2.8vw, 2.25rem);
    font-weight: 600;
    line-height: 1.18;
  }

  .not-found__directory ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .not-found__directory a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: start;
    color: inherit;
    text-decoration: none;
  }

  .not-found__directory strong {
    display: block;
    color: var(--navy-900);
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .not-found__directory small {
    display: block;
    margin-top: var(--space-2);
    color: var(--slate-700);
    font-size: .92rem;
    line-height: 1.45;
  }

  .not-found__arrow {
    color: var(--teal-700);
    font-size: 1.2rem;
    line-height: 1.35;
    transition: transform .15s ease;
  }

  .not-found__directory a:hover strong {
    color: var(--teal-800);
  }

  .not-found__directory a:hover .not-found__arrow {
    transform: translateX(.2rem);
  }

  @media (max-width: 760px) {
    .not-found__directory {
      grid-template-columns: 1fr;
    }

    .not-found__directory-heading h2 {
      max-width: none;
    }
  }

  @media (max-width: 520px) {
    .not-found {
      padding-block: var(--space-7);
    }

    .not-found__message,
    .not-found__directory {
      padding: var(--space-5);
    }

    .not-found__message h1 {
      font-size: clamp(2.4rem, 12vw, 3.25rem);
    }

    .not-found__message .button {
      width: 100%;
    }

    .not-found__directory ul {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found__arrow {
      transition: none;
    }
  }
</style>
