---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Page Not Found"
  description="The page you requested could not be found. Use these links to continue through the New Beginnings website."
  noindex
>
  <section class="not-found-arrival" aria-labelledby="not-found-title">
    <div class="container not-found-arrival__inner">
      <div>
        <p class="eyebrow">Page not found · 404</p>
        <h1 id="not-found-title">We couldn’t find that page.</h1>
        <p class="lead">
          The address may have changed, or the page may no longer exist. You can return to the
          homepage or use the directory below to keep going.
        </p>
      </div>

      <a class="button button--light" href="/">Return to the homepage</a>
    </div>
  </section>

  <section class="not-found-directory" aria-labelledby="directory-title">
    <div class="container not-found-directory__inner">
      <header>
        <p class="eyebrow">Website directory</p>
        <h2 id="directory-title">Find what you need.</h2>
        <p>These are the most useful places to continue from here.</p>
      </header>

      <nav aria-label="Helpful pages">
        <ul class="directory-list">
          <li>
            <a href="/admissions/">
              <span>
                <strong>Admissions</strong>
                <small>Ask about availability and the next steps for housing.</small>
              </span>
              <span class="directory-list__arrow" aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a href="/recovery-housing/">
              <span>
                <strong>Recovery Housing</strong>
                <small>Learn how structured shared living supports recovery.</small>
              </span>
              <span class="directory-list__arrow" aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a href="/referrals/">
              <span>
                <strong>Professional Referrals</strong>
                <small>Find referral information for providers and community partners.</small>
              </span>
              <span class="directory-list__arrow" aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a href="/contact/">
              <span>
                <strong>Contact</strong>
                <small>Reach New Beginnings with a general question.</small>
              </span>
              <span class="directory-list__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </section>
</MainLayout>

<style>
  .not-found-arrival {
    padding-block: clamp(4rem, 8vw, 6.5rem);
    color: var(--sky-100);
    background: var(--navy-950);
  }

  .not-found-arrival__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-7);
    align-items: end;
  }

  .not-found-arrival .eyebrow {
    color: #9ed7d2;
  }

  .not-found-arrival h1 {
    max-width: 11ch;
    margin-top: var(--space-4);
    color: var(--white);
    font-size: clamp(2.75rem, 5vw, 4.75rem);
  }

  .not-found-arrival .lead {
    max-width: 47rem;
    margin-top: var(--space-5);
    color: var(--sky-100);
  }

  .not-found-arrival .button {
    white-space: nowrap;
  }

  .not-found-directory {
    padding-block: var(--section-standard);
    background: var(--canvas);
  }

  .not-found-directory__inner {
    display: grid;
    grid-template-columns: minmax(14rem, .62fr) minmax(0, 1.38fr);
    gap: var(--gap-columns);
    align-items: start;
  }

  .not-found-directory header h2 {
    max-width: 11ch;
    margin-top: var(--space-3);
  }

  .not-found-directory header > p:last-child {
    max-width: 30rem;
    margin-top: var(--space-4);
  }

  .directory-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--slate-300);
    list-style: none;
  }

  .directory-list li {
    border-bottom: 1px solid var(--slate-300);
  }

  .directory-list a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-5);
    padding-block: var(--space-5);
    color: inherit;
    align-items: center;
  }

  .directory-list a:hover {
    color: inherit;
  }

  .directory-list strong {
    display: block;
    color: var(--navy-900);
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    font-weight: 600;
    line-height: 1.25;
  }

  .directory-list small {
    display: block;
    max-width: 48rem;
    margin-top: var(--space-2);
    color: var(--slate-700);
    font-size: .98rem;
    line-height: 1.5;
  }

  .directory-list__arrow {
    color: var(--teal-700);
    font-size: 1.4rem;
    line-height: 1;
    transition: transform .15s ease;
  }

  .directory-list a:hover .directory-list__arrow {
    transform: translateX(.2rem);
  }

  @media (max-width: 760px) {
    .not-found-arrival__inner,
    .not-found-directory__inner {
      grid-template-columns: 1fr;
    }

    .not-found-arrival__inner {
      gap: var(--space-6);
      align-items: start;
    }

    .not-found-arrival .button {
      width: fit-content;
      white-space: normal;
    }

    .not-found-directory {
      padding-block: var(--section-compact);
    }

    .not-found-directory__inner {
      gap: var(--space-7);
    }
  }

  @media (max-width: 420px) {
    .not-found-arrival {
      padding-block: var(--section-compact);
    }

    .directory-list a {
      gap: var(--space-4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .directory-list__arrow {
      transition: none;
    }
  }
</style>
