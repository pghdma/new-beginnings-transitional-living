---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Page Not Found"><section class="section"><div class="container narrow"><p class="eyebrow">404</p><h1>That page was not found.</h1><p class="lead">The address may have changed, or the page may no longer exist.</p><div class="actions"><a class="button" href="/">Return home</a><a class="button button--outline" href="/contact/">Contact us</a></div></div></section></MainLayout>
<style>.narrow { display: grid; gap: 1.5rem; }</style>
