---
import { Icon } from 'astro-icon/components';
import Hero from '../components/Hero.astro';
import TrustPoints from '../components/TrustPoints.astro';
import StepList from '../components/StepList.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import FeatureList from '../components/FeatureList.astro';
import MainLayout from '../layouts/MainLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

const audiences = [
  { icon: 'lucide:hospital', title: 'Treatment and Hospital Teams', copy: 'Discharge planners, counselors, and social workers lining up a safe place for a client to go after detox, inpatient, or a hospital stay.' },
  { icon: 'lucide:scale', title: 'Courts, Probation, and Parole', copy: 'One of our men’s houses works specifically with men on parole. All of our houses are DDAP licensed, which Pennsylvania courts are required to consider first.' },
  { icon: 'lucide:briefcase-business', title: 'Case Managers and Reentry', copy: 'Housing navigators and reentry workers who need a licensed sober house that answers the phone and returns the call.' },
  { icon: 'lucide:landmark', title: 'Community Partners', copy: 'County teams, nonprofits, churches, and community programs that want to know who we are before they send someone our way.' },
];


const coordinationSteps = [
  { icon: 'phone', title: 'Call About a Bed', copy: 'Tell us men’s or women’s, roughly when, and anything we need to know up front.', href: site.phoneHref, label: `Call ${site.phone}` },
  { icon: 'clipboard-list', title: 'Send the Application', copy: 'Your client can fill it out, or you can do it with them. It takes a few minutes and we call back.', href: '/admissions/', label: 'Go to Admissions' },
  { icon: 'messages-square', title: 'Coordinate Directly', copy: 'Records, supervision requirements, and move-in details are handled by phone, not through the website.', href: '/contact/', label: 'Contact Us' },
];

const questions = [
  { question: 'Is New Beginnings a Treatment Provider?', answer: 'No. We’re licensed recovery housing. Counseling, medical care, and medication stay with the client’s own providers. Our founder, Susan Rua, is a licensed counselor who runs a separate practice, but residency doesn’t depend on it.' },
  { question: 'Do You Take Clients on Parole or Probation?', answer: 'Yes. One of our men’s houses works specifically with men on parole, and all of our houses accept court-involved residents who are ready to live sober and follow the house rules. Supervision requirements are coordinated by phone.' },
  { question: 'What About Medication?', answer: 'Prescription narcotics aren’t permitted in the house. For other prescriptions, including medication for addiction treatment, call us before placement so we can go over the written medication policy with you and your client.' },
  { question: 'How Do I Verify the License?', answer: 'Pennsylvania’s DDAP directory and the WestPARR directory both list New Beginnings. Our credentials page links to each, along with our IRS record.' },
  { question: 'Can I Send Records Through the Website?', answer: 'No. Keep diagnoses, medications, treatment records, court and supervision records, and Social Security numbers off the web form. Call and we’ll arrange the right way to share what’s needed.' },
  { question: 'Can You Do Emergency Placement?', answer: 'We aren’t a shelter or crisis service and can’t place someone the same hour. Call 911 for an emergency or 988 for crisis support. For a bed in the coming days, call us.' },
];
---

<MainLayout
  title="For Professionals"
  description="For discharge planners, counselors, case managers, and probation and parole officers: how to place a client in DDAP-licensed sober living in Pittsburgh."
  faq={questions}
>
  <Hero
    variant="split"
    titleId="professional-title"
    eyebrow="For Professionals"
    title="Recovery Housing Referrals in Pittsburgh"
    lead="Discharge planners, counselors, case managers, and probation and parole officers: here’s what you need to know about New Beginnings and how to get someone placed."
    image={{ src: '/images/shared-bedroom.webp', alt: 'A representative shared bedroom with two beds and a desk', width: 2200, height: 1466 }}
  >
    <Fragment slot="actions">
      <a class="button button--light" href={site.phoneHref}><Icon name="lucide:phone" aria-hidden="true" />Call {site.phone}</a>
      <a class="button button--outline-light" href="/recovery-housing/">See the Houses</a>
    </Fragment>
    <p><Icon name="lucide:lock-keyhole" aria-hidden="true" />Please keep medical, treatment, court, and supervision records off the web form. We’ll get what we need directly.</p>
  </Hero>

  <section class="audience-section" aria-labelledby="audience-title">
    <div class="container">
      <header class="section-head section-head--center">
        <p class="eyebrow">Who This Page Is For</p>
        <h2 id="audience-title">The People Trying to Find Someone a Safe Place to Go</h2>
      </header>
      <FeatureList items={audiences} layout="columns" icon="medallion" iconSize="lg" columns={4} />
    </div>
  </section>

  <section class="role-section" aria-labelledby="role-title">
    <div class="container role-layout">
      <div class="role-copy">
        <p class="eyebrow">Scope</p>
        <h2 id="role-title">What We Are and What We Aren’t</h2>
        <p class="lead">New Beginnings is DDAP-licensed recovery housing: substance-free, AA and NA based sober living homes with random drug screens, curfew, and a weekly house meeting.</p>
        <p>We aren’t a treatment provider, a halfway house in the licensing sense, or a shelter. Clients keep their own counselor, prescriber, and program. If a client is on medication for addiction treatment or has other medication needs, talk to us before placement.</p>
        <div class="scope-comparison">
          <article><Icon name="lucide:house" aria-hidden="true" /><h3>New Beginnings Provides</h3><p>A licensed, substance-free house, housemates in recovery, house rules, random drug screens, and a director who returns calls.</p></article>
          <article><Icon name="lucide:stethoscope" aria-hidden="true" /><h3>Your Client Keeps</h3><p>Counseling, medical care, medication, supervision, and treatment with their existing providers.</p></article>
        </div>
      </div>
      <figure class="role-photo"><img src="/images/rustic-dining-room.webp" alt="An empty dining room with a shared table and natural light" width="1600" height="2133" loading="lazy" /></figure>
    </div>
  </section>

  <section class="verification-section" aria-labelledby="verification-title">
    <div class="container verification-layout">
      <div class="verification-copy">
        <p class="eyebrow">Licensing</p>
        <h2 id="verification-title">Licensed Means You Can Refer With Confidence</h2>
        <p>Pennsylvania requires recovery houses to be DDAP licensed before they can take referrals from state agencies or state-funded facilities, and courts must give first consideration to licensed houses. New Beginnings is licensed, WestPARR certified, and a 501(c)(3). Check us at the links below.</p>
        <div class="actions">
          <a class="button button--light" href="/about/transparency/">Verify Our Standing<Icon name="lucide:arrow-right" aria-hidden="true" /></a>
          <a class="text-link verification-guidance" href="https://www.pa.gov/services/ddap/apply-to-become-a-licensed-recovery-house">Pennsylvania’s licensing rules</a>
        </div>
      </div>
      <TrustPoints variant="panel" />
    </div>
  </section>

  <section class="coordination-section" aria-labelledby="coordination-title">
    <div class="container">
      <header class="coordination-heading split-intro">
        <div><p class="eyebrow">How to Refer</p><h2 id="coordination-title">Call First. It’s Faster Than Any Form</h2></div>
        <p>There’s no separate referral form. Call {site.phone} with the basics, or have your client send the application. We’ll tell you what’s open and what we need to move forward.</p>
      </header>
      <div class="coordination-steps"><StepList variant="cards" items={coordinationSteps} /></div>
    </div>
  </section>

  <section class="professional-faq" aria-labelledby="professional-faq-title">
    <div class="container faq-layout">
      <header class="faq-heading">
        <p class="eyebrow">Professional Questions</p>
        <h2 id="professional-faq-title">What Referral Partners Usually Ask</h2>
        <p>For a question about one person or one opening, call <a class="inline-link" href={site.phoneHref}>{site.phone}</a>.</p>
      </header>
      <FaqAccordion items={questions} variant="card" single openFirst />
    </div>
  </section>

  <CtaBand eyebrow="For Professionals" title="Have a Client Who Needs a Bed?" text={`Call ${site.phone}. Susan or staff will tell you what’s open and what we need to move forward.`} href="/contact/" label="Contact Us" />
</MainLayout>
<style>

  .audience-section{ padding-block: var(--section-standard); background: var(--paper); }
  .audience-section .section-head{ max-width: 48rem; margin-bottom: clamp(3rem, 6vw, 4.5rem); }

  .role-section{ padding-block: var(--section-standard); background: var(--sky-50); }
  .role-layout{ display: grid; grid-template-areas: 'photo copy'; grid-template-columns: minmax(0, .86fr) minmax(0, 1.14fr); gap: clamp(3rem, 8vw, 7rem); align-items: center; }
  .role-photo{ border-radius: var(--radius-md); height: 39rem; margin: 0; overflow: hidden; box-shadow: var(--shadow-raised); grid-area: photo; }
  .role-photo img{ width: 100%; height: 100%; object-fit: cover; object-position: center; filter: var(--photo-filter); }
  .role-copy{ grid-area: copy; }
  .role-copy h2{ max-width: 24ch; margin-top: var(--space-4); }
  .role-copy > .lead{ margin-top: var(--space-5); }
  .role-copy > p:not(.eyebrow):not(.lead){ max-width: 38rem; margin-top: var(--space-4); }
  .scope-comparison{ display: grid; margin-top: var(--space-7); grid-template-columns: repeat(2, minmax(0, 1fr)); box-shadow: var(--shadow); }
  .scope-comparison article{ border-radius: var(--radius-md); padding: var(--space-6); background: var(--paper); }
  .scope-comparison article + article{ color: var(--white); background: var(--teal-700); }
  .scope-comparison :global(svg){ width: 1.8rem; height: 1.8rem; color: var(--teal-700); stroke-width: 1.55; }
  .scope-comparison article + article :global(svg){ color: var(--accent-on-dark); }
  .scope-comparison h3{ margin-top: var(--space-4); font-size: 1.08rem; }
  .scope-comparison article + article h3{ color: var(--white); }
  .scope-comparison p{ margin-top: var(--space-3); color: var(--slate-600); font-size: .9rem; line-height: 1.5; }
  .scope-comparison article + article p{ color: var(--sky-100); }

  .verification-section{ padding-block: var(--section-standard); color: var(--white); background: var(--navy-900); }
  .verification-layout{ display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(22rem, .92fr); gap: clamp(3rem, 8vw, 7rem); align-items: center; }
  .verification-copy .eyebrow{ color: var(--accent-on-image); }
  .verification-copy h2{ max-width: 24ch; margin-top: var(--space-4); color: var(--white); }
  .verification-copy > p:not(.eyebrow){ max-width: 42rem; margin-top: var(--space-5); color: var(--sky-100); }
  .verification-copy .actions{ margin-top: var(--space-6); }
  .verification-copy .button{ gap: var(--button-gap); }
  .verification-copy .button :global(svg){ width: 1rem; height: 1rem; }
  .verification-guidance{ color: var(--white); }
  .verification-guidance:hover{ color: var(--accent-on-dark); }

  .coordination-section{ padding-block: var(--section-standard); background: var(--paper); }
  .coordination-heading h2{ margin-top: var(--space-4); }
  .coordination-heading > p{ color: var(--slate-600); font-size: 1.05rem; }
  .coordination-steps { margin-top: clamp(3rem, 6vw, 4.5rem); }

  .professional-faq{ padding-block: var(--section-standard); background: var(--sky-50); }
  .faq-layout{ display: grid; grid-template-columns: minmax(17rem, .72fr) minmax(0, 1.28fr); gap: clamp(3rem, 8vw, 7rem); align-items: start; }
  .faq-heading{ display: grid; gap: var(--space-4); }
  .faq-heading h2{ max-width: 24ch; }
  .faq-heading > p:not(.eyebrow){ max-width: 27rem; color: var(--slate-600); }
  .faq-heading a{ font-weight: var(--weight-semibold); }

  @media (max-width: 900px) {
    .role-layout, .verification-layout, .faq-layout{ grid-template-columns: 1fr; }
    .role-layout{ grid-template-areas: 'copy' 'photo'; gap: var(--space-7); }
    .role-photo{ height: auto; aspect-ratio: 16 / 10; }
    .verification-layout{ gap: var(--space-7); }
  }

  @media (max-width: 760px) {
    .role-photo{ aspect-ratio: 4 / 3; }
    .scope-comparison article{ padding: var(--space-5); }
    .coordination-steps { margin-top: clamp(3rem, 6vw, 4.5rem); }
  }


  /* Mobile floor: 16px copy, one alignment per section, 44px tap targets. Measured by scripts/mobile-audit.mjs */
  @media (max-width: 900px) {
    .scope-comparison p { font-size: 1rem; line-height: 1.55; }
  }
</style>
