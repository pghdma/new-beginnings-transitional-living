---
import { Icon } from 'astro-icon/components';
import MainLayout from '../layouts/MainLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

const audiences = [
  { icon: 'lucide:hospital', title: 'Treatment and Hospital Teams', copy: 'Discharge planners, counselors, and social workers lining up a safe place for a client to go after detox, inpatient, or a hospital stay.' },
  { icon: 'lucide:scale', title: 'Courts, Probation, and Parole', copy: 'One of our men’s houses works specifically with men on parole. All of our houses are DDAP licensed, which Pennsylvania courts are required to consider first.' },
  { icon: 'lucide:briefcase-business', title: 'Case Managers and Reentry', copy: 'Housing navigators and reentry workers who need a licensed sober house that answers the phone and returns the call.' },
  { icon: 'lucide:landmark', title: 'Community Partners', copy: 'County teams, nonprofits, churches, and community programs that want to know who we are before they send someone our way.' },
];

const credentials = [
  { icon: 'lucide:badge-check', title: 'Pennsylvania DDAP', copy: 'Licensed recovery houses' },
  { icon: 'lucide:shield-check', title: 'WestPARR', copy: 'Certified member, inspected' },
  { icon: 'lucide:landmark', title: '501(c)(3)', copy: 'Pittsburgh public charity' },
];

const questions = [
  { question: 'Is New Beginnings a Treatment Provider?', answer: 'No. We’re licensed recovery housing. Counseling, medical care, and medication stay with the client’s own providers. Our founder, Susan Rua, is a licensed counselor who runs a separate practice, but residency doesn’t depend on it.' },
  { question: 'Do You Take Clients on Parole or Probation?', answer: 'Yes. One of our men’s houses works specifically with men on parole, and all of our houses accept court-involved residents who are ready to live sober and follow the house rules. Supervision requirements are coordinated by phone.' },
  { question: 'What About Medication?', answer: 'Prescription narcotics aren’t permitted in the house. For other prescriptions, including medication for addiction treatment, call us before placement so we can go over the written medication policy with you and your client.' },
  { question: 'How Do I Verify the License?', answer: 'Pennsylvania’s DDAP directory and the WestPARR directory both list New Beginnings. Our credentials page links to each, along with our IRS record.' },
  { question: 'Can I Send Records Through the Website?', answer: 'No. Keep diagnoses, medications, treatment records, court and supervision records, and Social Security numbers off the web form. Call and we’ll arrange the right way to share what’s needed.' },
  { question: 'Do You Publish House Addresses?', answer: 'No. Residents live there. You’ll get the address when a placement is being arranged.' },
  { question: 'Can You Do Emergency Placement?', answer: 'We aren’t a shelter or crisis service and can’t place someone the same hour. Call 911 for an emergency or 988 for crisis support. For a bed in the coming days, call us.' },
];
---

<MainLayout
  title="For Professionals"
  description="For discharge planners, counselors, case managers, and probation and parole officers: how to place a client in DDAP-licensed sober living in Pittsburgh."
  faq={questions}
>
  <section class="professional-hero" aria-labelledby="professional-title">
    <div class="container professional-hero__grid">
      <div class="professional-hero__copy">
        <p class="eyebrow">For Professionals</p>
        <h1 id="professional-title">Referring a Client to Recovery Housing in Pittsburgh</h1>
        <p class="lead">Discharge planners, counselors, case managers, and probation and parole officers: here’s what you need to know about New Beginnings and how to get someone placed.</p>
        <div class="actions">
          <a class="button button--light" href={site.phoneHref}><Icon name="lucide:phone" aria-hidden="true" />Call {site.phone}</a>
          <a class="button button--outline-light" href="/recovery-housing/">See the Houses</a>
        </div>
        <p class="professional-hero__note"><Icon name="lucide:lock-keyhole" aria-hidden="true" />Please keep medical, treatment, court, and supervision records off the web form. We’ll get what we need directly.</p>
      </div>
      <figure class="professional-hero__photo">
        <img src="/images/shared-bedroom.webp" alt="A representative shared bedroom with two beds and a desk" width="2200" height="1466" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <section class="audience-section" aria-labelledby="audience-title">
    <div class="container">
      <header class="section-head section-head--center">
        <p class="eyebrow">Who This Page Is For</p>
        <h2 id="audience-title">The People Trying to Find Someone a Safe Place to Go</h2>
      </header>
      <ul class="audience-grid">
        {audiences.map((audience) => (
          <li>
            <span class="icon-medallion icon-medallion--lg"><Icon name={audience.icon} aria-hidden="true" /></span>
            <h3>{audience.title}</h3>
            <p>{audience.copy}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="role-section" aria-labelledby="role-title">
    <div class="container role-layout">
      <div class="role-copy">
        <p class="eyebrow">Scope</p>
        <h2 id="role-title">What We Are and What We Aren’t</h2>
        <p class="lead">New Beginnings is DDAP-licensed recovery housing: substance-free, AA and NA based sober living homes with random drug screens, curfew, and a weekly house meeting.</p>
        <p>We aren’t a treatment provider, a halfway house in the licensing sense, or a shelter. Clients keep their own counselor, prescriber, and program. If a client is on medication for addiction treatment or has other medication needs, talk to us before placement.</p>
        <div class="scope-comparison">
          <article><Icon name="lucide:house" aria-hidden="true" /><h3>New Beginnings Provides</h3><p>A licensed, substance-free house, housemates in recovery, house rules, random drug screens, and a director who returns calls.</p></article>
          <article><Icon name="lucide:stethoscope" aria-hidden="true" /><h3>Your Client Keeps</h3><p>Counseling, medical care, medication, supervision, and treatment with their existing providers.</p></article>
        </div>
      </div>
      <figure class="role-photo"><img src="/images/rustic-dining-room.webp" alt="An empty dining room with a shared table and natural light" width="1600" height="2133" loading="lazy" /></figure>
    </div>
  </section>

  <section class="verification-section" aria-labelledby="verification-title">
    <div class="container verification-layout">
      <div class="verification-copy">
        <p class="eyebrow">Licensing</p>
        <h2 id="verification-title">Licensed Means You Can Refer With Confidence</h2>
        <p>Pennsylvania requires recovery houses to be DDAP licensed before they can take referrals from state agencies or state-funded facilities, and courts must give first consideration to licensed houses. New Beginnings is licensed, WestPARR certified, and a 501(c)(3). Check us at the links below.</p>
        <div class="actions">
          <a class="button button--light" href="/about/transparency/">Verify Our Standing<Icon name="lucide:arrow-right" aria-hidden="true" /></a>
          <a class="text-link verification-guidance" href="https://www.pa.gov/services/ddap/apply-to-become-a-licensed-recovery-house">Pennsylvania’s licensing rules</a>
        </div>
      </div>
      <ul class="credential-grid">
        {credentials.map((credential) => (
          <li><span class="icon-medallion icon-medallion--dark"><Icon name={credential.icon} aria-hidden="true" /></span><div><h3>{credential.title}</h3><p>{credential.copy}</p></div></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="coordination-section" aria-labelledby="coordination-title">
    <div class="container">
      <header class="coordination-heading split-intro">
        <div><p class="eyebrow">How to Refer</p><h2 id="coordination-title">Call First. It’s Faster Than Any Form</h2></div>
        <p>There’s no separate referral form. Call {site.phone} with the basics, or have your client send the application. We’ll tell you what’s open and what we need to move forward.</p>
      </header>
      <ol class="coordination-steps">
        <li><span>01</span><Icon name="lucide:phone" aria-hidden="true" /><h3>Call About a Bed</h3><p>Tell us men’s or women’s, roughly when, and anything we need to know up front.</p><a class="button button--outline" href={site.phoneHref}>Call {site.phone}</a></li>
        <li><span>02</span><Icon name="lucide:clipboard-list" aria-hidden="true" /><h3>Send the Application</h3><p>Your client can fill it out, or you can do it with them. It takes a few minutes and we call back.</p><a class="button button--outline" href="/admissions/">Go to Admissions</a></li>
        <li><span>03</span><Icon name="lucide:messages-square" aria-hidden="true" /><h3>Coordinate Directly</h3><p>Records, supervision requirements, and move-in details are handled by phone, not through the website.</p><a class="button button--outline" href="/contact/">Contact Us</a></li>
      </ol>
    </div>
  </section>

  <section class="professional-faq" aria-labelledby="professional-faq-title">
    <div class="container faq-layout">
      <header class="faq-heading">
        <p class="eyebrow">Professional Questions</p>
        <h2 id="professional-faq-title">What Referral Partners Usually Ask</h2>
        <p>For a question about one person or one opening, call <a class="inline-link" href={site.phoneHref}>{site.phone}</a>.</p>
      </header>
      <div class="faq-list" data-single-accordion>
        {questions.map((item, index) => (
          <details open={index === 0}><summary><span>{item.question}</span><Icon name="lucide:plus" aria-hidden="true" /></summary><div class="faq-answer"><p>{item.answer}</p></div></details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand eyebrow="For Professionals" title="Have a Client Who Needs a Bed?" text={`Call ${site.phone}. Susan or staff will tell you what’s open and what we need to move forward.`} href="/contact/" label="Contact Us" />
</MainLayout>
<style>
  .professional-hero { color: var(--white); background: var(--navy-950); }
  .professional-hero__grid { display: grid; min-height: clamp(35rem, 54vw, 44rem); grid-template-columns: minmax(0, .94fr) minmax(0, 1.06fr); align-items: stretch; }
  .professional-hero__copy { display: flex; padding: var(--section-hero) clamp(2.5rem, 6vw, 5rem) var(--section-hero) 0; flex-direction: column; justify-content: center; }
  .professional-hero .eyebrow { color: var(--accent-on-image); }
  .professional-hero h1 { max-width: 9ch; margin-top: var(--space-4); color: var(--white); font-size: var(--type-display-editorial); }
  .professional-hero .lead { max-width: 36rem; margin-top: var(--space-5); color: var(--sky-100); }
  .professional-hero .actions { margin-top: var(--space-6); }
  .professional-hero .button { gap: var(--button-gap); }
  .professional-hero .button :global(svg) { width: 1rem; height: 1rem; }
  .professional-hero__note { display: flex; max-width: 38rem; margin-top: var(--space-7); align-items: flex-start; gap: .7rem; color: var(--sky-200); font-size: .91rem; line-height: 1.5; }
  .professional-hero__note :global(svg) { width: 1.1rem; height: 1.1rem; margin-top: .18rem; color: var(--accent-on-image); flex: 0 0 auto; }
  .professional-hero__photo { position: relative; margin: 0 calc((100vw - min(100vw - (var(--gutter) * 2), var(--max))) / -2) 0 0; overflow: hidden; background: var(--navy-900); }
  .professional-hero__photo img { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: saturate(.72) contrast(.96); }
  .professional-hero__photo::after { position: absolute; background: linear-gradient(90deg, rgba(23,55,70,.22), transparent 35%); content: ''; inset: 0; }

  .audience-section { padding-block: var(--section-standard); background: var(--paper); }
  .audience-section .section-head { max-width: 48rem; margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  .audience-grid { display: grid; margin: 0; padding: 0; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(1.75rem, 4vw, 3rem); list-style: none; }
  .audience-grid li { display: flex; text-align: center; align-items: center; flex-direction: column; }
  .audience-grid h3 { max-width: 14rem; margin-top: var(--space-5); font-size: 1.2rem; }
  .audience-grid p { max-width: 17rem; margin-top: var(--space-3); color: var(--slate-600); font-size: .94rem; line-height: 1.55; }

  .role-section { padding-block: var(--section-standard); background: var(--sky-50); }
  .role-layout { display: grid; grid-template-areas: 'photo copy'; grid-template-columns: minmax(0, .86fr) minmax(0, 1.14fr); gap: clamp(3rem, 8vw, 7rem); align-items: center; }
  .role-photo { height: 39rem; margin: 0; overflow: hidden; box-shadow: var(--shadow-raised); grid-area: photo; }
  .role-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: saturate(.76) contrast(.97); }
  .role-copy { grid-area: copy; }
  .role-copy h2 { max-width: 12ch; margin-top: var(--space-4); }
  .role-copy > .lead { margin-top: var(--space-5); }
  .role-copy > p:not(.eyebrow):not(.lead) { max-width: 38rem; margin-top: var(--space-4); }
  .scope-comparison { display: grid; margin-top: var(--space-7); grid-template-columns: repeat(2, minmax(0, 1fr)); box-shadow: var(--shadow); }
  .scope-comparison article { padding: var(--space-6); background: var(--paper); }
  .scope-comparison article + article { color: var(--white); background: var(--teal-700); }
  .scope-comparison :global(svg) { width: 1.8rem; height: 1.8rem; color: var(--teal-700); stroke-width: 1.55; }
  .scope-comparison article + article :global(svg) { color: var(--accent-on-dark); }
  .scope-comparison h3 { margin-top: var(--space-4); font-size: 1.08rem; }
  .scope-comparison article + article h3 { color: var(--white); }
  .scope-comparison p { margin-top: var(--space-3); color: var(--slate-600); font-size: .9rem; line-height: 1.5; }
  .scope-comparison article + article p { color: var(--sky-100); }

  .verification-section { padding-block: var(--section-standard); color: var(--white); background: var(--navy-900); }
  .verification-layout { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(22rem, .92fr); gap: clamp(3rem, 8vw, 7rem); align-items: center; }
  .verification-copy .eyebrow { color: var(--accent-on-image); }
  .verification-copy h2 { max-width: 14ch; margin-top: var(--space-4); color: var(--white); }
  .verification-copy > p:not(.eyebrow) { max-width: 42rem; margin-top: var(--space-5); color: var(--sky-100); }
  .verification-copy .actions { margin-top: var(--space-6); }
  .verification-copy .button { gap: var(--button-gap); }
  .verification-copy .button :global(svg) { width: 1rem; height: 1rem; }
  .verification-guidance { color: var(--white); }
  .verification-guidance:hover { color: var(--accent-on-dark); }
  .credential-grid { display: grid; margin: 0; padding: clamp(var(--space-6), 5vw, var(--space-8)); gap: var(--space-6); color: var(--white); background: rgba(255,255,255,.055); box-shadow: 0 1.1rem 3rem rgba(5,25,35,.2); list-style: none; }
  .credential-grid li { display: grid; grid-template-columns: var(--icon-medallion-size-md) minmax(0, 1fr); gap: var(--space-4); align-items: center; }
  .credential-grid h3 { color: var(--white); font-size: 1.1rem; }
  .credential-grid p { margin-top: .2rem; color: var(--sky-200); font-size: .9rem; }

  .coordination-section { padding-block: var(--section-standard); background: var(--paper); }
  .coordination-heading h2 { margin-top: var(--space-4); }
  .coordination-heading > p { color: var(--slate-600); font-size: 1.05rem; }
  .coordination-steps { display: grid; margin: clamp(3rem, 6vw, 4.5rem) 0 0; padding: 0; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); list-style: none; }
  .coordination-steps li { position: relative; display: flex; min-height: 25rem; padding: clamp(var(--space-6), 4vw, var(--space-7)); overflow: hidden; background: var(--sky-50); flex-direction: column; align-items: flex-start; }
  .coordination-steps li:nth-child(2) { color: var(--white); background: var(--teal-700); }
  .coordination-steps li:nth-child(3) { color: var(--white); background: var(--navy-900); }
  .coordination-steps li > span { position: absolute; top: var(--space-5); right: var(--space-5); color: rgba(29,64,80,.15); font-size: 3.25rem; font-weight: var(--weight-semibold); line-height: 1; }
  .coordination-steps li:nth-child(n + 2) > span { color: rgba(255,255,255,.18); }
  .coordination-steps li > :global(svg) { width: 2rem; height: 2rem; color: var(--teal-700); stroke-width: 1.55; }
  .coordination-steps li:nth-child(n + 2) > :global(svg) { color: var(--accent-on-dark); }
  .coordination-steps h3 { max-width: 14rem; margin-top: var(--space-6); }
  .coordination-steps li:nth-child(n + 2) h3 { color: var(--white); }
  .coordination-steps p { margin-top: var(--space-4); color: var(--slate-600); font-size: .95rem; line-height: 1.55; }
  .coordination-steps li:nth-child(n + 2) p { color: var(--sky-100); }
  .coordination-steps .button { width: 100%; margin-top: auto; padding-top: .8rem; padding-bottom: .8rem; }
  .coordination-steps li:nth-child(n + 2) .button { border-color: rgba(255,255,255,.72); color: var(--white); }
  .coordination-steps li:nth-child(n + 2) .button:hover { color: var(--navy-950); background: var(--white); }

  .professional-faq { padding-block: var(--section-standard); background: var(--sky-50); }
  .faq-layout { display: grid; grid-template-columns: minmax(17rem, .72fr) minmax(0, 1.28fr); gap: clamp(3rem, 8vw, 7rem); align-items: start; }
  .faq-heading { display: grid; gap: var(--space-4); }
  .faq-heading h2 { max-width: 12ch; }
  .faq-heading > p:not(.eyebrow) { max-width: 27rem; color: var(--slate-600); }
  .faq-heading a { font-weight: var(--weight-semibold); }
  .faq-list { background: var(--paper); box-shadow: var(--shadow-raised); }
  .faq-list details + details { border-top: 1px solid var(--slate-200); }
  .faq-list summary { display: grid; padding: var(--space-5) var(--space-6); grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-5); align-items: center; color: var(--navy-900); cursor: pointer; font-size: 1.08rem; font-weight: var(--weight-semibold); list-style: none; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary :global(svg) { width: 1.25rem; height: 1.25rem; color: var(--teal-700); transition: transform .18s ease; }
  .faq-list details[open] summary :global(svg) { transform: rotate(45deg); }
  .faq-answer { padding: 0 var(--space-6) var(--space-6); }
  .faq-answer p { max-width: 60ch; color: var(--slate-600); }

  @media (max-width: 900px) {
    .role-layout, .verification-layout, .faq-layout { grid-template-columns: 1fr; }
    .professional-hero { position: relative; overflow: hidden; }
    .professional-hero__grid { display: block; min-height: 0; }
    .professional-hero__photo { position: absolute; z-index: 0; margin: 0; inset: 0; }
    .professional-hero__photo img { object-position: center 40%; }
    .professional-hero__photo::after { background: linear-gradient(0deg, rgba(9,34,45,.97) 0%, rgba(9,34,45,.84) 55%, rgba(9,34,45,.5) 100%); }
    .professional-hero__copy { position: relative; z-index: 1; min-height: clamp(30rem, 82svh, 38rem); padding: 4rem 0 2.75rem; justify-content: flex-end; }
    .audience-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-7); }
    .role-layout { grid-template-areas: 'copy' 'photo'; gap: var(--space-7); }
    .role-photo { height: auto; aspect-ratio: 16 / 10; }
    .verification-layout { gap: var(--space-7); }
    .credential-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .credential-grid li { grid-template-columns: 1fr; justify-items: center; text-align: center; }
  }

  @media (max-width: 700px) {
    .professional-hero h1 { font-size: clamp(2.75rem, 13vw, 3.65rem); }
    .professional-hero .actions { display: grid; }
    .professional-hero .button { width: 100%; }
    .audience-grid, .credential-grid, .coordination-steps, .scope-comparison { grid-template-columns: 1fr; }
    .audience-grid { gap: var(--space-7); }
    .role-photo { aspect-ratio: 4 / 3; }
    .scope-comparison article { padding: var(--space-5); }
    .credential-grid li { grid-template-columns: var(--icon-medallion-size-md) minmax(0, 1fr); justify-items: start; text-align: left; }
    .coordination-steps { gap: var(--space-4); }
    .coordination-steps li { min-height: 21rem; }
    .faq-list summary { padding: var(--space-5); }
    .faq-answer { padding: 0 var(--space-5) var(--space-5); }
  }

  @media (prefers-reduced-motion: reduce) { .faq-list summary :global(svg) { transition: none; } }
</style>
