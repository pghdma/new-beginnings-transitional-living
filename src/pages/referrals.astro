---
import MainLayout from '../layouts/MainLayout.astro'; import PageHero from '../components/PageHero.astro'; import InquiryForm from '../components/InquiryForm.astro';
---
<MainLayout title="Professional Referrals"><PageHero eyebrow="For professionals" title="A dependable recovery-housing referral partner." intro="Clear communication for treatment providers, case managers, discharge planners, courts, and community organizations." image="/images/referrals.jpg" imageAlt="Two professionals reviewing information together at a table" />
<section class="section"><div class="container grid-2"><div><p class="eyebrow">Referral partners</p><h2>Start with a general availability conversation.</h2></div><div><p class="lead">New Beginnings provides nonprofit recovery housing for adult men and women in Pittsburgh-area communities.</p><p>Our network includes Pennsylvania DDAP-licensed residences and homes inspected through WestPARR. We work alongside independent treatment and community providers rather than presenting recovery housing as clinical treatment.</p><ul class="rule-list"><li><strong>Call first</strong>Contact us at 412-628-0403 to discuss general fit and availability.</li><li><strong>Protect client information</strong>Do not send treatment records or sensitive client details through the public form.</li><li><strong>Receive current instructions</strong>Required documents and exact location information are provided privately.</li></ul></div></div></section><InquiryForm title="Start a referral conversation" intro="Tell us who you represent and how to reach you. Please do not send client records or sensitive information through this form." /></MainLayout>
