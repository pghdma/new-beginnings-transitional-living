---
import { Icon } from 'astro-icon/components';
import MainLayout from '../../../layouts/MainLayout.astro';
import { publishedBoardMembers, type LeadershipProfile } from '../../../data/leadership';

export function getStaticPaths() {
  return publishedBoardMembers.map((person) => ({
    params: { slug: person.slug },
    props: { person },
  }));
}

interface Props {
  person: LeadershipProfile;
}

const { person } = Astro.props;
const hasBackground = Boolean(
  person.biography?.length ||
  person.credentials?.length ||
  person.education?.length ||
  person.experience?.length,
);
---

<MainLayout
  title={`${person.name}, ${person.role}`}
  description={person.summary ?? `${person.name} serves on the Board of Directors of New Beginnings Transitional Living Foundation.`}
>
  <section class="profile-hero">
    <div class="container profile-hero__inner">
      <a class="back-link" href="/about/board/">
        <Icon name="lucide:arrow-left" aria-hidden="true" />
        Board of Directors
      </a>
      <p class="eyebrow">Volunteer leadership</p>
      <h1>{person.name}</h1>
      <p class="role">{person.role}</p>
      {person.summary && <p class="lead">{person.summary}</p>}
    </div>
  </section>

  <section class="section profile-body">
    <div class="container profile-grid">
      <header>
        <p class="eyebrow">Current public listing</p>
        <h2>Board service</h2>
      </header>
      <div class="profile-content">
        <p class="lead">
          {person.name} serves on the Board of Directors of New Beginnings Transitional
          Living Foundation.
        </p>
        {person.biography?.map((paragraph) => <p>{paragraph}</p>)}

        {!hasBackground && (
          <p>
            This listing is intentionally concise. New Beginnings publishes leadership
            information only after it has been confirmed for public use.
          </p>
        )}

        <dl class="profile-record">
          <div>
            <dt>Organization</dt>
            <dd>New Beginnings Transitional Living Foundation</dd>
          </div>
          <div>
            <dt>Role</dt>
            <dd>{person.role}</dd>
          </div>
        </dl>

        {person.credentials && person.credentials.length > 0 && (
          <section class="profile-detail" aria-labelledby="credentials-heading">
            <h3 id="credentials-heading">Credentials</h3>
            <ul>
              {person.credentials.map((credential) => <li>{credential}</li>)}
            </ul>
          </section>
        )}

        {person.education && person.education.length > 0 && (
          <section class="profile-detail" aria-labelledby="education-heading">
            <h3 id="education-heading">Education</h3>
            <ul>
              {person.education.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        )}

        {person.experience && person.experience.length > 0 && (
          <section class="profile-detail" aria-labelledby="experience-heading">
            <h3 id="experience-heading">Experience</h3>
            <ul>
              {person.experience.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        )}
      </div>
    </div>
  </section>

  <section class="profile-footer">
    <div class="container profile-footer__inner">
      <div>
        <p class="eyebrow">Organization information</p>
        <h2>Review New Beginnings’ public credentials.</h2>
      </div>
      <a class="button button--light" href="/about/transparency/">
        View transparency information
        <Icon name="lucide:arrow-right" aria-hidden="true" />
      </a>
    </div>
  </section>
</MainLayout>

<style>
  .profile-hero { padding-block: clamp(var(--space-8), 8vw, var(--space-9)); background: var(--sky-50); border-bottom: 1px solid var(--slate-200); }
  .profile-hero__inner { display: grid; gap: var(--space-4); }
  .profile-hero h1 { max-width: 15ch; font-size: clamp(3rem, 5.5vw, 5rem); }
  .back-link { display: inline-flex; width: fit-content; margin-bottom: var(--space-5); align-items: center; gap: var(--space-2); color: var(--navy-900); font-weight: 650; }
  .back-link :global(svg) { width: 1rem; height: 1rem; }
  .role { color: var(--teal-700); font-size: clamp(1.15rem, 2vw, 1.45rem); font-weight: 600; }
  .profile-hero .lead { margin-top: var(--space-2); }

  .profile-grid { display: grid; grid-template-columns: minmax(0, .68fr) minmax(0, 1.32fr); gap: clamp(var(--space-7), 8vw, 8rem); align-items: start; }
  .profile-grid > header { display: grid; gap: var(--space-4); }
  .profile-content { max-width: var(--measure); }
  .profile-content > p + p { margin-top: var(--space-5); }
  .profile-record { margin: var(--space-7) 0 0; border-top: 1px solid var(--slate-300); }
  .profile-record > div { display: grid; grid-template-columns: minmax(8rem, .45fr) minmax(0, 1.55fr); gap: var(--space-5); padding-block: var(--space-4); border-bottom: 1px solid var(--slate-300); }
  .profile-record dt { color: var(--slate-600); font-size: .78rem; font-weight: 650; letter-spacing: .12em; text-transform: uppercase; }
  .profile-record dd { margin: 0; color: var(--navy-900); font-weight: 600; }
  .profile-detail { margin-top: var(--space-7); }
  .profile-detail h3 { margin-bottom: var(--space-4); }
  .profile-detail ul { margin: 0; padding: 0; border-top: 1px solid var(--slate-300); list-style: none; }
  .profile-detail li { padding-block: var(--space-4); border-bottom: 1px solid var(--slate-300); }

  .profile-footer { padding-block: var(--section-compact); color: var(--white); background: var(--navy-900); }
  .profile-footer__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-7); }
  .profile-footer h2 { max-width: 18ch; margin-top: var(--space-3); color: var(--white); font-size: clamp(2rem, 3.5vw, 3rem); }
  .profile-footer .eyebrow { color: #9ed7d2; }
  .profile-footer .button { gap: var(--space-2); }
  .profile-footer .button :global(svg) { width: 1rem; height: 1rem; }

  @media (max-width: 760px) {
    .profile-grid { grid-template-columns: 1fr; }
    .profile-footer__inner { display: grid; }
    .profile-footer .button { justify-self: start; }
  }

  @media (max-width: 520px) {
    .profile-hero h1 { font-size: clamp(2.7rem, 13vw, 3.7rem); }
    .profile-record > div { grid-template-columns: 1fr; gap: var(--space-2); }
  }
</style>
