---
import { Icon } from 'astro-icon/components';
import MainLayout from '../../../layouts/MainLayout.astro';
import { publishedBoardMembers, type LeadershipProfile } from '../../../data/leadership';

export function getStaticPaths() {
  return publishedBoardMembers.map((person) => ({
    params: { slug: person.slug },
    props: { person },
  }));
}

interface Props {
  person: LeadershipProfile;
}

const { person } = Astro.props;
const hasBackground = Boolean(
  person.biography?.length ||
  person.credentials?.length ||
  person.education?.length ||
  person.experience?.length,
);
---

<MainLayout
  title={`${person.name}, ${person.role}`}
  description={person.summary ?? `${person.name} is listed as a ${person.role} on the Board of Directors of New Beginnings Transitional Living Foundation.`}
>
  <section class="profile-hero">
    <div class="container profile-hero__grid">
      <div class="profile-hero__identity">
        <a class="back-link" href="/about/board/">
          <Icon name="lucide:arrow-left" aria-hidden="true" />
          Board of Directors
        </a>
        <p class="eyebrow">Volunteer leadership</p>
        <h1>{person.name}</h1>
        <p class="role">{person.role}</p>
      </div>
      <div class="profile-hero__summary">
        <p class="lead">
          {person.summary ?? `${person.name} is listed as a ${person.role} on the Board of Directors of New Beginnings Transitional Living Foundation.`}
        </p>
      </div>
    </div>
  </section>

  <section class="section profile-story">
    <div class="container profile-story__grid">
      <header class="profile-story__intro">
        <p class="eyebrow">Published board listing</p>
        <h2>Service on a mission-led board.</h2>
        <p>
          New Beginnings publishes the leadership information selected for its public
          website.
        </p>
      </header>
      <div class="profile-story__content">
        {person.biography?.map((paragraph, index) => (
          <p class:list={{ lead: index === 0 }}>{paragraph}</p>
        ))}

        {!hasBackground && (
          <>
            <p class="lead">
              New Beginnings lists {person.name} as a {person.role} in the board roster
              published on this website.
            </p>
            <p>
              As a board member, {person.name} shares collective responsibility for mission
              stewardship, nonprofit oversight, and organizational accountability.
            </p>
          </>
        )}

        <div class="profile-story__identity" aria-label="Leadership listing details">
          <div>
            <span>Organization</span>
            <strong>New Beginnings Transitional Living Foundation</strong>
          </div>
          <div>
            <span>Published role</span>
            <strong>{person.role}</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  {hasBackground && (
    <section class="profile-background">
      <div class="container profile-background__grid">
        {person.experience && person.experience.length > 0 && (
          <section aria-labelledby="experience-heading">
            <p class="eyebrow">Experience</p>
            <h2 id="experience-heading">Professional background.</h2>
            <ul>
              {person.experience.map((item) => <li><Icon name="lucide:check" aria-hidden="true" />{item}</li>)}
            </ul>
          </section>
        )}
        {(person.education?.length || person.credentials?.length) && (
          <section aria-labelledby="education-heading">
            <p class="eyebrow">Education and credentials</p>
            <h2 id="education-heading">Professional foundation.</h2>
            <ul>
              {person.education?.map((item) => <li><Icon name="lucide:check" aria-hidden="true" />{item}</li>)}
              {person.credentials?.map((item) => <li><Icon name="lucide:check" aria-hidden="true" />{item}</li>)}
            </ul>
          </section>
        )}
      </div>
    </section>
  )}

  <section class="governance-context">
    <div class="container governance-context__grid">
      <div>
        <p class="eyebrow">Governance is shared work</p>
        <h2>The board protects the purpose of New Beginnings.</h2>
      </div>
      <div class="governance-context__copy">
        <p>
          The volunteer Board of Directors provides stewardship and oversight while
          organizational leadership manages the day-to-day work of recovery housing.
        </p>
        <div class="actions">
          <a class="button button--light" href="/about/board/">
            Meet the full board
            <Icon name="lucide:arrow-right" aria-hidden="true" />
          </a>
          <a class="governance-context__link" href="/about/transparency/">Review public credentials</a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .profile-hero { color: var(--white); background: var(--navy-950); }
  .profile-hero__grid { display: grid; min-height: clamp(31rem, 48vw, 39rem); grid-template-columns: minmax(0, 1.15fr) minmax(20rem, .85fr); gap: clamp(var(--space-8), 9vw, 9rem); align-items: center; }
  .profile-hero__identity { display: grid; padding-block: var(--section-hero); gap: var(--space-4); }
  .profile-hero .eyebrow { color: #9ed7d2; }
  .profile-hero h1 { max-width: 11ch; color: var(--white); font-size: clamp(3.2rem, 6vw, 5.6rem); }
  .role { color: #9ed7d2; font-size: clamp(1.15rem, 2vw, 1.45rem); font-weight: 600; }
  .back-link { display: inline-flex; width: fit-content; margin-bottom: var(--space-6); align-items: center; gap: var(--space-2); color: var(--sky-100); font-weight: 650; }
  .back-link:hover { color: var(--white); }
  .back-link :global(svg) { width: 1rem; height: 1rem; }
  .profile-hero__summary { max-width: 30rem; }
  .profile-hero__summary .lead { color: var(--sky-100); font-size: clamp(1.2rem, 2vw, 1.5rem); }

  .profile-story { background: var(--paper); }
  .profile-story__grid { display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); gap: clamp(var(--space-8), 8vw, 8rem); align-items: start; }
  .profile-story__intro { display: grid; max-width: 29rem; gap: var(--space-4); }
  .profile-story__intro h2 { max-width: 12ch; }
  .profile-story__content { max-width: 43rem; }
  .profile-story__content > p + p { margin-top: var(--space-5); }
  .profile-story__identity { display: grid; margin-top: var(--space-8); grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); gap: var(--space-7); }
  .profile-story__identity div { display: grid; align-content: start; gap: var(--space-2); }
  .profile-story__identity span { color: var(--teal-700); font-size: .76rem; font-weight: 650; letter-spacing: .12em; text-transform: uppercase; }
  .profile-story__identity strong { color: var(--navy-900); font-size: 1.05rem; font-weight: 600; line-height: 1.35; }

  .profile-background { padding-block: var(--section-standard); background: var(--sky-50); }
  .profile-background__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(var(--space-8), 8vw, 8rem); }
  .profile-background section { display: grid; align-content: start; gap: var(--space-4); }
  .profile-background h2 { max-width: 13ch; }
  .profile-background ul { display: grid; margin: var(--space-4) 0 0; padding: 0; gap: var(--space-4); list-style: none; }
  .profile-background li { display: grid; grid-template-columns: 1.4rem minmax(0, 1fr); gap: var(--space-3); color: var(--navy-900); font-weight: 600; }
  .profile-background li > :global(svg) { width: 1.2rem; height: 1.2rem; margin-top: .3rem; color: var(--teal-700); stroke-width: 2; }

  .governance-context { padding-block: var(--section-standard); color: var(--white); background: var(--navy-900); }
  .governance-context__grid { display: grid; grid-template-columns: minmax(0, .86fr) minmax(0, 1.14fr); gap: clamp(var(--space-8), 8vw, 8rem); align-items: start; }
  .governance-context .eyebrow { color: #9ed7d2; }
  .governance-context h2 { max-width: 15ch; margin-top: var(--space-4); color: var(--white); }
  .governance-context__copy > p { max-width: 41rem; color: var(--sky-100); font-size: 1.12rem; }
  .governance-context .actions { margin-top: var(--space-6); }
  .governance-context .button { gap: var(--space-2); }
  .governance-context .button :global(svg) { width: 1rem; height: 1rem; }
  .governance-context__link { color: var(--white); font-weight: 650; }
  .governance-context__link:hover { color: #9ed7d2; }

  @media (max-width: 800px) {
    .profile-hero__grid, .profile-story__grid, .profile-background__grid, .governance-context__grid { grid-template-columns: 1fr; }
    .profile-hero__grid { padding-block: var(--space-8); gap: var(--space-7); }
    .profile-hero__identity { padding-block: 0; }
    .profile-story__intro { max-width: 40rem; }
  }

  @media (max-width: 520px) {
    .profile-hero__grid { padding-block: var(--space-7); }
    .profile-hero h1 { font-size: clamp(2.7rem, 13vw, 3.7rem); }
    .back-link { margin-bottom: var(--space-4); }
    .profile-story__identity { margin-top: var(--space-7); grid-template-columns: 1fr; }
    .governance-context .button { width: 100%; }
  }
</style>
