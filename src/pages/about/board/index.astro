---
import { Icon } from 'astro-icon/components';
import FeatureList from '../../../components/FeatureList.astro';
import CtaBand from '../../../components/CtaBand.astro';
import Hero from '../../../components/Hero.astro';
import MainLayout from '../../../layouts/MainLayout.astro';
import { currentBoardMembers } from '../../../data/leadership';
import { site } from '../../../data/site';

const responsibilities = [
  {
    icon: 'compass',
    title: 'Mission',
    copy: 'Keep New Beginnings focused on one thing: safe, licensed recovery housing for people in Pittsburgh who are done using.',
  },
  {
    icon: 'landmark',
    title: 'Money',
    copy: 'Watch over the nonprofit’s finances so the houses stay open, the bills get paid, and the books stay clean.',
  },
  {
    icon: 'badge-check',
    title: 'Accountability',
    copy: 'Make sure the organization follows the law, keeps its license, files with the IRS, and tells the public the truth about itself.',
  },
];

type Member = (typeof currentBoardMembers)[number];

const profileSummary = (person: Member) => {
  if (person.slug === 'susan-rua') {
    return 'Susan is a licensed professional counselor who has worked in addiction treatment since 1999. She started New Beginnings because too many people finish treatment with nowhere safe to go.';
  }
  return 'Theresa serves as a volunteer board member, helping oversee the nonprofit’s governance, finances, and accountability.';
};

// Short public facts per member: tenure, day job, and affiliations. Add rows here as they are cleared for publication.
const memberFacts = (person: Member): { icon: string; text: string; href?: string; label?: string; after?: string }[] => {
  if (person.slug === 'susan-rua') {
    return [
      { icon: 'calendar-check', text: 'President since founding New Beginnings in 2016' },
      { icon: 'house-heart', text: 'Has run recovery houses in Pittsburgh for more than ten years' },
      { icon: 'briefcase', text: 'Also owns ', label: 'Step By Step Support', href: 'https://stepbystepsupport.net', after: ', a counseling practice in Mt. Washington' },
    ];
  }
  return [{ icon: 'users', text: 'Volunteer director, not on staff' }];
};

const initials = (name: string) => name.split(/[\s-]+/).map((part) => part[0]).join('');
---

<MainLayout
  title="Board of Directors"
  description="Meet the board responsible for New Beginnings Transitional Living Foundation, a Pittsburgh nonprofit that runs licensed recovery housing for men and women."
>
  <Hero
    variant="centered"
    size="lg"
    eyebrow="Board of Directors"
    title="The People Responsible for New Beginnings"
    lead="New Beginnings is a public charity, which means it answers to a board, files with the IRS, and keeps its standing public. These are the people who hold that responsibility."
  >
    <Fragment slot="actions">
      <a class="button button--light" href="#meet-the-board">Meet the Board<Icon name="lucide:arrow-down" aria-hidden="true" /></a>
    </Fragment>
    <img slot="media" src="/images/community-table.jpg" alt="An empty meeting table and chairs ready for a working conversation" width="1880" height="1253" fetchpriority="high" />
  </Hero>

  <section class="board-role" aria-labelledby="board-role-title">
    <div class="container">
      <header class="board-role__intro">
        <p class="eyebrow">What the Board Does</p>
        <h2 id="board-role-title">Keep It Honest, Solvent, and On Mission</h2>
        <p>
          Susan and staff run the houses day to day. The board makes sure the organization
          stays true to its purpose, spends money responsibly, and meets its legal obligations.
        </p>
      </header>

      <div class="board-role__features"><FeatureList items={responsibilities} layout="columns" icon="medallion" iconSize="xl" columns={3} divided /></div>
    </div>
  </section>

  {currentBoardMembers.length > 0 && (
    <section class="board-directory" id="meet-the-board" aria-labelledby="board-directory-title">
      <div class="container">
        <header class="board-directory__intro">
          <p class="eyebrow">Meet the Board</p>
          <h2 id="board-directory-title">Our Board</h2>
          <p>
            We publish our board so residents, families, referral partners, and donors
            know exactly who is accountable for this organization.
          </p>
        </header>

        <ul class:list={['board-directory__grid', { 'board-directory__grid--two': currentBoardMembers.length === 2 }]}>
          {currentBoardMembers.map((person) => (
            <li id={person.slug}>
              <article class="member" aria-labelledby={`${person.slug}-name`}>
                <div class="member__media">
                  {person.slug === 'susan-rua' ? (
                    <img src="/images/susan-rua.webp" alt="Susan Rua" width="900" height="1125" loading="lazy" />
                  ) : (
                    <div class="member__monogram" aria-hidden="true"><span>{initials(person.name)}</span></div>
                  )}
                </div>

                <div class="member__content">
                  <p class="member__role">{person.role}</p>
                  <h3 id={`${person.slug}-name`}>{person.name}</h3>
                  {person.credentials && <p class="member__credentials">{person.credentials.join(' · ')}</p>}
                  <p class="member__summary">{profileSummary(person)}</p>
                  <ul class="member__meta" aria-label={`About ${person.name}`}>
                    {memberFacts(person).map((fact) => (
                      <li>
                        <Icon name={`lucide:${fact.icon}`} aria-hidden="true" />
                        <span>{fact.text}{fact.href && <a href={fact.href} rel="external">{fact.label}</a>}{fact.after}</span>
                      </li>
                    ))}
                  </ul>
                  {person.slug === 'susan-rua' && (
                    <a class="member__link" href="/about/susan-rua/">Read Susan’s full bio<Icon name="lucide:arrow-right" aria-hidden="true" /></a>
                  )}
                </div>
              </article>
            </li>
          ))}
        </ul>

        <p class="board-directory__note">
          Have a question for the board, or interested in serving on it? Email <a href={site.emailHref}>{site.email}</a> and Susan will pass it along.
        </p>
      </div>
    </section>
  )}

  <CtaBand
    eyebrow="Accountability"
    title="Check Our Standing Yourself"
    text="Our nonprofit status, state license, and WestPARR certification are all public record. We have put the links in one place."
    href="/about/transparency/"
    label="See Credentials and Records"
    phone={false}
  />
</MainLayout>

<style>
  .board-role{
    padding-block: var(--section-standard);
    background: var(--canvas);
  }

  .board-role__intro,
  .board-directory__intro{
    display: grid;
    max-width: 46rem;
    margin-inline: auto;
    justify-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .board-role__intro h2,
  .board-directory__intro h2{
    max-width: 24ch;
  }

  .board-role__intro > p:last-child,
  .board-directory__intro > p:last-child{
    max-width: 41rem;
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .board-role__features { margin-top: clamp(3.5rem, 7vw, 5.5rem); }

  .board-directory{
    padding-block: var(--section-standard);
    background: var(--sky-100);
  }

  .board-directory__grid{
    display: grid;
    margin: clamp(3.5rem, 7vw, 5.5rem) auto 0;
    padding: 0;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(var(--space-6), 3vw, var(--space-8));
    list-style: none;
  }

  .board-directory__grid--two{
    max-width: 68rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (max-width: 900px) {
    .board-role__features { margin-top: clamp(3.5rem, 7vw, 5.5rem); }
  }

  /* Mobile floor: 16px copy, one alignment per section, 44px tap targets. Measured by scripts/mobile-audit.mjs */
  @media (max-width: 900px) {
    .board-role__intro, .board-directory__intro{ margin-inline: 0; justify-items: start; text-align: left; }
  }

  /* Board cards: one face, everything visible (image, title, a line or two, one action). Photo beside the copy. */
  .board-directory__grid, .board-directory__grid--two{ max-width: 64rem; grid-template-columns: 1fr; }
  .member{ display: grid; height: 100%; grid-template-columns: minmax(0, 19rem) minmax(0, 1fr); overflow: hidden; border-radius: var(--radius-lg); background: var(--paper); box-shadow: var(--shadow-photo); }
  .member__media{ position: relative; min-height: 18rem; background: var(--navy-900); }
  .member__media img{ position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 25%; }
  .member__monogram{ display: grid; height: 100%; color: var(--white); background: linear-gradient(135deg, rgba(25, 126, 120, .98), rgba(var(--ink-rgb), .98)); place-items: center; }
  .member__monogram span{ display: grid; width: clamp(7rem, 12vw, 9rem); aspect-ratio: 1; border: 1px solid var(--outline-on-dark); border-radius: 50%; place-items: center; font-size: clamp(2.25rem, 4vw, 3rem); font-weight: var(--weight-heading); letter-spacing: .04em; }
  .member__content{ display: flex; flex-direction: column; align-items: flex-start; justify-content: center; padding: clamp(var(--space-6), 3.5vw, var(--space-8)); }
  .member__role{ margin-bottom: var(--space-3); color: var(--teal-700); font-size: .78rem; font-weight: var(--weight-semibold); letter-spacing: .12em; text-transform: uppercase; }
  .member h3{ color: var(--navy-900); font-size: clamp(1.75rem, 2.6vw, 2.4rem); line-height: 1.08; }
  .member__credentials{ margin-top: var(--space-2); color: var(--slate-600); font-size: .82rem; font-weight: var(--weight-semibold); letter-spacing: .1em; }
  .member__summary{ max-width: 58ch; margin-top: var(--space-4); color: var(--slate-600); line-height: 1.65; }
  .member__meta{ display: grid; width: 100%; margin: var(--space-5) 0 0; padding: var(--space-5) 0 0; border-top: 1px solid var(--slate-200); gap: var(--space-3); list-style: none; }
  .member__meta li{ display: grid; grid-template-columns: 1.15rem minmax(0, 1fr); gap: var(--space-3); align-items: start; color: var(--navy-900); font-size: .95rem; line-height: 1.5; }
  .member__meta :global(svg){ width: 1.15rem; height: 1.15rem; margin-top: .15rem; color: var(--teal-700); stroke-width: 1.8; }
  .member__meta a, .board-directory__note a{ display: inline-block; padding-block: .1rem; color: var(--blue-700); font-weight: var(--weight-semibold); text-decoration: underline; text-underline-offset: .15em; }
  .member__link{ display: inline-flex; min-height: 2.75rem; margin-top: var(--space-4); align-items: center; gap: var(--button-gap); color: var(--teal-700); font-weight: var(--weight-semibold); text-decoration: none; }
  .member__link:hover{ text-decoration: underline; text-underline-offset: .2em; }
  .member__link :global(svg){ width: 1rem; height: 1rem; }
  .board-directory__note{ max-width: 64rem; margin: var(--space-6) auto 0; color: var(--slate-600); line-height: 1.6; text-align: center; }

  @media (max-width: 760px) {
    .member{ grid-template-columns: 1fr; }
    .member__media{ aspect-ratio: 4 / 3; min-height: 0; }
    .member__media img{ object-position: center 22%; }
    .member__monogram{ min-height: 14rem; }
    .member__meta li, .member__summary{ font-size: 1rem; }
  }

  @media (max-width: 900px) {
    .board-directory__note{ text-align: left; }
  }
</style>
