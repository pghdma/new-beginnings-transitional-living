---
import { Icon } from 'astro-icon/components';
import MainLayout from '../../../layouts/MainLayout.astro';
import { currentBoardMembers } from '../../../data/leadership';

const responsibilities = [
  {
    icon: 'compass',
    title: 'Mission and direction',
    copy: 'Keep the organization focused on safe, accountable recovery housing and the long-term needs of the people and communities it serves.',
  },
  {
    icon: 'scale',
    title: 'Ethical and legal oversight',
    copy: 'Provide nonprofit oversight, protect the organization’s purpose, and support compliance with applicable public responsibilities.',
  },
  {
    icon: 'hand-coins',
    title: 'Financial stewardship',
    copy: 'Exercise care over the organization’s resources so they continue to support stable homes and responsible operations.',
  },
  {
    icon: 'badge-check',
    title: 'Organizational accountability',
    copy: 'Provide perspective and oversight while organizational leadership manages the day-to-day work of New Beginnings.',
  },
];
---

<MainLayout
  title="Board of Directors"
  description="Learn how the volunteer Board of Directors provides governance and stewardship for New Beginnings Transitional Living Foundation."
>
  <section class="board-hero">
    <div class="container board-hero__grid">
      <div class="board-hero__copy">
        <p class="eyebrow">Board of Directors</p>
        <h1>Stewardship in service of the mission.</h1>
        <p class="lead">
          A volunteer Board of Directors provides governance, oversight, and long-range
          stewardship for New Beginnings Transitional Living Foundation.
        </p>
        <a class="button button--light" href="#board-roster">
          Meet the board
          <Icon name="lucide:arrow-down" aria-hidden="true" />
        </a>
      </div>
      <figure class="board-hero__figure">
        <img
          src="/images/community-table.jpg"
          alt="An empty meeting table prepared for a group conversation"
          width="1880"
          height="1253"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <section class="section governance">
    <div class="container governance__layout">
      <header class="governance__intro">
        <p class="eyebrow">The board’s role</p>
        <h2>Responsible nonprofit leadership is active work.</h2>
        <p class="lead">
          The board protects the mission and helps New Beginnings remain accountable to the
          people and Pittsburgh-area communities it serves.
        </p>
      </header>
      <ul class="responsibilities">
        {responsibilities.map((item) => (
          <li>
            <Icon name={`lucide:${item.icon}`} aria-hidden="true" />
            <div>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {currentBoardMembers.length > 0 && (
    <section class="roster" id="board-roster">
      <div class="container roster__layout">
        <header class="roster__intro">
          <p class="eyebrow">Board roster</p>
          <h2>People entrusted with the work.</h2>
          <p>
            This is the leadership roster published on the New Beginnings website.
          </p>
        </header>
        <ul class="roster__people">
          {currentBoardMembers.map((person) => (
            <li>
              <a href={person.group === 'board' ? `/about/board/${person.slug}/` : `/about/${person.slug}/`}>
                <span class="roster__role">{person.role}</span>
                <span class="roster__name">{person.name}</span>
                {person.summary && <span class="roster__summary">{person.summary}</span>}
                <span class="roster__action">
                  View profile
                  <Icon name="lucide:arrow-up-right" aria-hidden="true" />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="accountability">
    <figure class="accountability__figure">
      <img
        src="/images/pittsburgh.jpg"
        alt="Downtown Pittsburgh and its rivers"
        width="1880"
        height="1253"
        loading="lazy"
      />
    </figure>
    <div class="accountability__content">
      <div class="accountability__inner">
        <p class="eyebrow">Public accountability</p>
        <h2>Standing that can be reviewed independently.</h2>
        <p>
          New Beginnings collects its nonprofit status, state licensing information, and
          recovery-housing credentials in one place for residents, families, professionals,
          and supporters.
        </p>
        <a class="button" href="/about/transparency/">
          Review credentials and records
          <Icon name="lucide:arrow-right" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .board-hero { overflow: hidden; color: var(--white); background: var(--navy-950); }
  .board-hero__grid { display: grid; min-height: clamp(38rem, 58vw, 48rem); grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr); align-items: stretch; }
  .board-hero__copy { display: grid; padding: var(--section-hero) clamp(var(--space-6), 5vw, var(--space-9)) var(--section-hero) 0; align-content: center; gap: var(--space-5); }
  .board-hero .eyebrow { color: #9ed7d2; }
  .board-hero h1 { max-width: 10ch; color: var(--white); font-size: clamp(3.1rem, 5.7vw, 5.45rem); }
  .board-hero .lead { max-width: 35rem; color: var(--sky-100); }
  .board-hero .button { width: fit-content; margin-top: var(--space-2); gap: var(--space-2); }
  .board-hero .button :global(svg) { width: 1rem; height: 1rem; }
  .board-hero__figure { min-height: 100%; margin: 0 calc((100vw - min(100vw - (var(--gutter) * 2), var(--max))) / -2) 0 0; overflow: hidden; background: var(--slate-200); box-shadow: -1.4rem 1.6rem 3.8rem rgba(7, 28, 38, .28); }
  .board-hero__figure img { width: 100%; height: 100%; object-fit: cover; object-position: 56% center; }

  .governance { background: var(--canvas); }
  .governance__layout { display: grid; grid-template-columns: minmax(0, .74fr) minmax(0, 1.26fr); gap: clamp(var(--space-8), 8vw, 8rem); align-items: start; }
  .governance__intro { display: grid; max-width: 31rem; gap: var(--space-4); }
  .governance__intro h2 { max-width: 12ch; }
  .responsibilities { display: grid; margin: 0; padding: 0; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(var(--space-7), 6vw, var(--space-9)) clamp(var(--space-7), 5vw, var(--space-8)); list-style: none; }
  .responsibilities li { display: grid; grid-template-columns: 2.25rem minmax(0, 1fr); gap: var(--space-4); align-items: start; }
  .responsibilities li > :global(svg) { width: 1.8rem; height: 1.8rem; margin-top: .1rem; color: var(--teal-700); stroke-width: 1.6; }
  .responsibilities h3 { margin-bottom: var(--space-3); }
  .responsibilities p { color: var(--slate-600); line-height: 1.6; }

  .roster { padding-block: var(--section-standard); color: var(--white); background: var(--navy-900); }
  .roster__layout { display: grid; grid-template-columns: minmax(0, .66fr) minmax(0, 1.34fr); gap: clamp(var(--space-8), 8vw, 8rem); align-items: start; }
  .roster__intro { display: grid; max-width: 30rem; gap: var(--space-4); }
  .roster__intro .eyebrow { color: #9ed7d2; }
  .roster__intro h2 { max-width: 11ch; color: var(--white); }
  .roster__intro p:last-child { color: var(--sky-100); }
  .roster__people { display: grid; margin: 0; padding: 0; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(var(--space-7), 5vw, var(--space-8)); list-style: none; }
  .roster__people a { display: flex; min-height: 21rem; color: var(--white); flex-direction: column; }
  .roster__people a:hover { color: #b7e4df; }
  .roster__role { margin-bottom: var(--space-4); color: #9ed7d2; font-size: .78rem; font-weight: 650; letter-spacing: .13em; text-transform: uppercase; }
  .roster__name { max-width: 10ch; color: inherit; font-size: clamp(2rem, 3.5vw, 3.25rem); font-weight: 600; letter-spacing: -.02em; line-height: 1.05; }
  .roster__summary { margin-top: var(--space-5); color: var(--sky-100); font-size: .98rem; line-height: 1.55; }
  .roster__action { display: inline-flex; margin-top: auto; padding-top: var(--space-6); align-items: center; gap: var(--space-2); font-weight: 650; }
  .roster__action :global(svg) { width: 1rem; height: 1rem; }

  .accountability { display: grid; min-height: 34rem; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); background: var(--paper); }
  .accountability__figure { min-height: 34rem; margin: 0; overflow: hidden; background: var(--slate-200); }
  .accountability__figure img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .accountability__content { display: grid; padding: var(--section-standard) var(--gutter); align-items: center; }
  .accountability__inner { width: min(100%, 37rem); margin-inline: auto; }
  .accountability h2 { max-width: 14ch; margin-top: var(--space-4); }
  .accountability p:not(.eyebrow) { max-width: 36rem; margin-top: var(--space-5); }
  .accountability .button { margin-top: var(--space-6); gap: var(--space-2); }
  .accountability .button :global(svg) { width: 1rem; height: 1rem; }

  @media (max-width: 900px) {
    .board-hero__grid, .governance__layout, .roster__layout { grid-template-columns: 1fr; }
    .board-hero__figure { height: clamp(19rem, 58vw, 31rem); min-height: 0; margin: 0 calc(var(--gutter) * -1); order: -1; box-shadow: none; }
    .board-hero__copy { padding-block: var(--space-8); padding-right: 0; }
    .governance__intro, .roster__intro { max-width: 43rem; }
  }

  @media (max-width: 680px) {
    .responsibilities, .roster__people, .accountability { grid-template-columns: 1fr; }
    .roster__people { gap: var(--space-8); }
    .roster__people a { min-height: 0; }
    .roster__action { margin-top: var(--space-5); }
    .accountability__figure { min-height: 22rem; }
  }

  @media (max-width: 520px) {
    .board-hero__figure { height: 16rem; }
    .board-hero__copy { padding-block: var(--space-7); }
    .board-hero h1 { font-size: clamp(2.7rem, 13vw, 3.7rem); }
    .board-hero .button, .accountability .button { width: 100%; }
    .responsibilities { gap: var(--space-7); }
    .responsibilities li { grid-template-columns: 2rem minmax(0, 1fr); gap: var(--space-3); }
    .responsibilities li > :global(svg) { width: 1.55rem; height: 1.55rem; }
    .accountability__content { padding-block: var(--space-8); }
  }
</style>
