---
import { Icon } from 'astro-icon/components';
import MainLayout from '../../../layouts/MainLayout.astro';
import { susanRua } from '../../../data/leadership';

if (!susanRua) {
  throw new Error('Susan Rua must be published in the leadership data before this page can build.');
}
---

<MainLayout
  title="Susan Rua, President and Founder"
  description="Meet Susan Rua, President and Founder of New Beginnings Transitional Living Foundation and a Pittsburgh recovery professional specializing in substance use since 1999."
>
  <section class="founder-hero">
    <div class="container founder-hero__grid">
      <div class="founder-hero__copy">
        <a class="back-link" href="/about/">
          <Icon name="lucide:arrow-left" aria-hidden="true" />
          About New Beginnings
        </a>
        <p class="eyebrow">Organizational leadership</p>
        <h1>{susanRua.name}</h1>
        <p class="role">{susanRua.role}</p>
        {susanRua.credentials && (
          <p class="credentials" aria-label="Professional credentials">
            {susanRua.credentials.join(' · ')}
          </p>
        )}
      </div>
      <div class="founder-hero__statement">
        <p>
          Recovery housing works in the space between treatment appointments and everyday
          life: a stable home, dependable routines, peer connection, and room to move forward.
        </p>
      </div>
    </div>
  </section>

  <section class="section biography">
    <div class="container biography__grid">
      <header>
        <p class="eyebrow">Background</p>
        <h2>Clinical perspective. Lived-in understanding.</h2>
      </header>
      <div class="biography__copy">
        {susanRua.biography?.map((paragraph, index) => (
          <p class:list={{ lead: index === 0 }}>{paragraph}</p>
        ))}
      </div>
    </div>
  </section>

  {(susanRua.education || susanRua.experience) && (
    <section class="section section--tint record">
      <div class="container record__grid">
        {susanRua.experience && susanRua.experience.length > 0 && (
          <section aria-labelledby="experience-heading">
            <p class="eyebrow">Experience</p>
            <h2 id="experience-heading">A long view of recovery.</h2>
            <ul>
              {susanRua.experience.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        )}
        {susanRua.education && susanRua.education.length > 0 && (
          <section aria-labelledby="education-heading">
            <p class="eyebrow">Education and credentials</p>
            <h2 id="education-heading">Professional foundation.</h2>
            <ul>
              {susanRua.education.map((item) => <li>{item}</li>)}
              {susanRua.credentials?.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        )}
      </div>
    </section>
  )}

  <section class="mission-band">
    <div class="container mission-band__grid">
      <div>
        <p class="eyebrow">The New Beginnings mission</p>
        <h2>A dependable foundation outside the treatment room.</h2>
      </div>
      <div>
        <p class="lead">
          New Beginnings provides recovery housing, not clinical treatment. Its homes are
          designed to support the daily structure and community that help residents continue
          their individual work in recovery.
        </p>
        <div class="actions">
          <a class="button button--light" href="/recovery-housing/">How recovery housing works</a>
          <a class="mission-band__link" href="/about/board/">Board and governance</a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .founder-hero { padding-block: clamp(var(--space-8), 9vw, 8rem); background: var(--sky-50); border-bottom: 1px solid var(--slate-200); }
  .founder-hero__grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(19rem, .8fr); gap: clamp(var(--space-7), 9vw, 9rem); align-items: end; }
  .founder-hero__copy { display: grid; gap: var(--space-4); }
  .founder-hero h1 { max-width: 12ch; }
  .back-link { display: inline-flex; width: fit-content; margin-bottom: var(--space-6); align-items: center; gap: var(--space-2); font-weight: 700; text-decoration: none; }
  .back-link :global(svg) { width: 1rem; }
  .role { color: var(--teal-700); font-size: clamp(1.25rem, 2vw, 1.6rem); font-weight: 700; }
  .credentials { padding-top: var(--space-4); border-top: 1px solid var(--slate-300); color: var(--navy-900); font-size: .9rem; font-weight: 750; letter-spacing: .1em; }
  .founder-hero__statement { padding-block: var(--space-6); border-block: 1px solid var(--slate-300); }
  .founder-hero__statement p { color: var(--navy-900); font-size: clamp(1.35rem, 2.3vw, 2rem); font-weight: 600; line-height: 1.35; }

  .biography__grid { display: grid; grid-template-columns: minmax(0, .72fr) minmax(0, 1.28fr); gap: clamp(var(--space-7), 8vw, 8rem); align-items: start; }
  .biography header { display: grid; gap: var(--space-4); }
  .biography__copy { max-width: var(--measure); }
  .biography__copy p + p { margin-top: var(--space-5); }

  .record__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(var(--space-7), 9vw, 9rem); }
  .record section { display: grid; gap: var(--space-4); align-content: start; }
  .record h2 { max-width: 14ch; font-size: clamp(2rem, 3.4vw, 3rem); }
  .record ul { margin: var(--space-4) 0 0; padding: 0; border-top: 1px solid var(--slate-300); list-style: none; }
  .record li { padding-block: var(--space-4); border-bottom: 1px solid var(--slate-300); color: var(--navy-900); font-weight: 650; }

  .mission-band { padding-block: clamp(var(--space-8), 7vw, var(--space-9)); color: var(--white); background: var(--navy-950); }
  .mission-band__grid { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(var(--space-7), 8vw, 8rem); align-items: start; }
  .mission-band h2 { max-width: 16ch; margin-top: var(--space-3); color: var(--white); }
  .mission-band .eyebrow { color: #9ed7d2; }
  .mission-band .lead { color: var(--sky-100); }
  .mission-band .actions { margin-top: var(--space-6); }
  .mission-band__link { color: var(--white); font-weight: 700; }
  .mission-band__link:hover { color: #9ed7d2; }

  @media (max-width: 760px) {
    .founder-hero__grid, .biography__grid, .record__grid, .mission-band__grid { grid-template-columns: 1fr; }
    .founder-hero__statement { max-width: 35rem; }
  }
</style>
