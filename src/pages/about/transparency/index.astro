---
import { Icon } from 'astro-icon/components';
import MainLayout from '../../../layouts/MainLayout.astro';
import { site } from '../../../data/site';

const standing = [
  { icon: 'landmark', label: 'Federal status', value: '501(c)(3) public charity' },
  { icon: 'calendar-check', label: 'IRS ruling', value: 'Tax exempt since February 2019' },
  { icon: 'badge-check', label: 'Pennsylvania oversight', value: 'DDAP-licensed recovery houses' },
  { icon: 'shield-check', label: 'Independent inspection', value: 'WestPARR certified member' },
];

const publicSources = [
  {
    icon: 'landmark',
    category: 'Federal nonprofit record',
    title: 'IRS Nonprofit Filings',
    text: `Form 990 filings and tax-exempt status for EIN ${site.ein}, through ProPublica’s Nonprofit Explorer.`,
    label: 'View Public Filings',
    href: 'https://projects.propublica.org/nonprofits/organizations/812901849',
  },
  {
    icon: 'badge-check',
    category: 'Pennsylvania licensing',
    title: 'Department of Drug and Alcohol Programs',
    text: 'Pennsylvania’s directory of licensed recovery houses. Search for New Beginnings Transitional Living.',
    label: 'Search DDAP Records',
    href: 'https://www.pa.gov/services/ddap/locate-licensed-recovery-or-halfway-housing',
  },
  {
    icon: 'shield-check',
    category: 'Independent inspection',
    title: 'WestPARR Directory',
    text: 'The Western Pennsylvania Alliance of Recovery Residences lists New Beginnings as a certified, AA and NA based member with three men’s houses and one women’s house.',
    label: 'View WestPARR Listing',
    href: 'https://westparr.org/search-homes/',
  },
];
---

<MainLayout
  title="Credentials and Licensing"
  description="Check New Beginnings yourself: 501(c)(3) status, Pennsylvania DDAP recovery house license, WestPARR certification, and IRS filings, with links to each public record."
>
  <section class="transparency-hero">
    <img class="transparency-hero__image" src="/images/home-entry.webp" alt="" width="2200" height="1467" fetchpriority="high" />
    <div class="transparency-hero__shade"></div>
    <div class="container transparency-hero__inner">
      <div class="transparency-hero__copy">
        <p class="eyebrow">Credentials</p>
        <h1>Licensed, Inspected, and On the Record</h1>
        <p>Anyone can call themselves a sober house. Before you or someone you love moves in, you should be able to check who is running it. Here’s everything you need to check us.</p>
        <a class="button button--light hero-button" href="#public-records">
          See the Public Records
          <Icon name="lucide:arrow-down" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <section class="identity-section">
    <div class="container identity-layout">
      <div class="identity-content">
        <p class="eyebrow">Who We Are</p>
        <h2>A Pittsburgh Nonprofit You Can Look Up</h2>
        <p class="identity-lede">New Beginnings Transitional Living Foundation is an independent Pennsylvania public charity that runs DDAP-licensed recovery housing for men and women in Pittsburgh.</p>
        <dl class="standing-list">
          {standing.map((item) => (
            <div class="standing-item">
              <dt><Icon name={`lucide:${item.icon}`} aria-hidden="true" />{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>
        <div class="identity-meta">
          <span>Employer Identification Number</span>
          <strong>{site.ein}</strong>
        </div>
      </div>
      <figure class="identity-photo">
        <img src="/images/pittsburgh.jpg" alt="Downtown Pittsburgh and its rivers" width="1880" height="1253" loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="records-section" id="public-records">
    <div class="container records-layout">
      <div class="records-intro">
        <p class="eyebrow">Public Records</p>
        <h2>Look Us Up</h2>
        <p>These records are kept by the IRS, the Commonwealth of Pennsylvania, and WestPARR, not by us. You don’t have to take our word for any of it.</p>
        <p class="records-privacy"><Icon name="lucide:eye-off" aria-hidden="true" /> Some public directories list licensed house addresses. We don’t repeat them here, for our residents’ sake.</p>
      </div>
      <div class="record-directory" aria-label="Independent public records">
        {publicSources.map((source) => (
          <article class="record-entry">
            <span class="record-entry__icon"><Icon name={`lucide:${source.icon}`} aria-hidden="true" /></span>
            <div class="record-entry__content">
              <p class="record-entry__category">{source.category}</p>
              <h3>{source.title}</h3>
              <p>{source.text}</p>
            </div>
            <a class="button button--outline record-entry__action" href={source.href} rel="external">
              {source.label}<Icon name="lucide:external-link" aria-hidden="true" />
            </a>
          </article>
        ))}
      </div>
    </div>
    <div class="container meaning-strip">
      <div class="meaning-heading">
        <p class="eyebrow">In Plain Language</p>
        <h2>What the Credentials Mean</h2>
      </div>
      <div class="meaning-item">
        <Icon name="lucide:clipboard-check" aria-hidden="true" />
        <div><h3>DDAP License</h3><p>The Commonwealth reviewed our houses and our written policies on drug screens, medication, fees, and discharge. Licensed houses are the only ones state agencies and courts can refer to first.</p></div>
      </div>
      <div class="meaning-item">
        <Icon name="lucide:house-heart" aria-hidden="true" />
        <div><h3>WestPARR Certification</h3><p>An independent Pittsburgh alliance of recovery residences inspected our homes against recognized recovery housing standards and lists us as a certified member.</p></div>
      </div>
    </div>
  </section>

  <section class="privacy-section">
    <div class="privacy-content">
      <div class="privacy-content__inner">
        <p class="eyebrow">Residence Privacy</p>
        <h2>Why the Addresses Are Not Here</h2>
        <p class="privacy-lede">We tell you the neighborhoods so you know where you would be living. We don’t publish the street addresses because our residents live there.</p>
        <p>The same goes for photos: you won’t find a front porch on this site. If you need to verify a license, the state directory is public. If you need the address, call and we’ll talk.</p>
        <div class="neighborhoods">
          <div class="neighborhoods__label"><Icon name="lucide:map-pin" aria-hidden="true" /><span>Our neighborhoods</span></div>
          <ul>{site.neighborhoods.map((neighborhood) => <li>{neighborhood}</li>)}</ul>
          <p class="neighborhoods__note">Administrative office in Mt. Washington.</p>
        </div>
      </div>
    </div>
    <figure class="privacy-photo">
      <img src="/images/house-living-room.webp" alt="A comfortable residential living room" width="2200" height="1467" loading="lazy" />
    </figure>
  </section>

  <section class="records-cta">
    <img class="records-cta__image" src="/images/admissions.jpg" alt="" width="1880" height="1245" loading="lazy" />
    <div class="records-cta__shade"></div>
    <div class="container records-cta__inner">
      <div>
        <p class="eyebrow">Questions?</p>
        <h2>Ask Us for Any Policy or Record</h2>
        <p>Want to see the house rules, the fee schedule, or a copy of our license? Call or email and we’ll send it.</p>
      </div>
      <div class="records-cta__actions">
        <a class="button button--light" href="/contact/"><Icon name="lucide:mail" aria-hidden="true" />Contact New Beginnings</a>
        <a class="button button--cta-outline" href={site.phoneHref}><Icon name="lucide:phone" aria-hidden="true" />Call {site.phone}</a>
      </div>
    </div>
  </section>
</MainLayout>
<style>
  .transparency-hero { position: relative; display: grid; min-height: clamp(35rem, 72vh, 48rem); overflow: hidden; align-items: center; color: var(--white); background: var(--navy-950); }
  .transparency-hero__image, .transparency-hero__shade { position: absolute; width: 100%; height: 100%; inset: 0; }
  .transparency-hero__image { object-fit: cover; object-position: 60% 54%; }
  .transparency-hero__shade { background: linear-gradient(90deg, rgba(13,43,56,.96) 0%, rgba(13,43,56,.9) 38%, rgba(13,43,56,.42) 69%, rgba(13,43,56,.18) 100%), linear-gradient(0deg, rgba(9,35,46,.2), rgba(9,35,46,.2)); }
  .transparency-hero__inner { position: relative; z-index: 1; padding-block: var(--section-hero); }
  .transparency-hero__copy { max-width: 43rem; }
  .transparency-hero .eyebrow { color: var(--accent-on-image); }
  .transparency-hero h1 { max-width: 11ch; margin-top: var(--space-4); color: var(--white); }
  .transparency-hero__copy > p:last-of-type { max-width: 38rem; margin-top: var(--space-5); color: var(--text-on-dark); font-size: clamp(1.15rem, 1.8vw, 1.4rem); line-height: 1.55; }
  .hero-button { gap: .7rem; margin-top: var(--space-6); }
  .hero-button :global(svg) { width: 1.05rem; height: 1.05rem; }

  .identity-section { padding-block: var(--section-standard); background: var(--canvas); }
  .identity-layout { display: grid; grid-template-areas: 'photo content'; grid-template-columns: minmax(0,.88fr) minmax(0,1.12fr); align-items: stretch; }
  .identity-photo { min-height: 44rem; margin: 0; overflow: hidden; grid-area: photo; }
  .identity-photo img { width: 100%; height: 100%; object-fit: cover; }
  .identity-content { display: flex; padding: clamp(3rem,6vw,5.5rem); grid-area: content; background: var(--paper); flex-direction: column; justify-content: center; }
  .identity-content h2 { max-width: 13ch; margin-top: var(--space-4); }
  .identity-lede { max-width: 40rem; margin-top: var(--space-5); color: var(--slate-800); font-size: clamp(1.15rem,1.7vw,1.35rem); line-height: 1.55; }
  .standing-list { display: grid; margin: var(--space-7) 0 0; grid-template-columns: 1fr 1fr; gap: var(--space-6) var(--space-7); }
  .standing-item { margin: 0; }
  .standing-item dt { display: flex; align-items: center; gap: .7rem; color: var(--teal-700); font-size: .77rem; font-weight: var(--weight-semibold); letter-spacing: .1em; line-height: 1.25; text-transform: uppercase; }
  .standing-item dt :global(svg) { width: 1.35rem; height: 1.35rem; flex: 0 0 auto; stroke-width: 1.8; }
  .standing-item dd { margin: .55rem 0 0 2.05rem; color: var(--navy-900); font-size: 1.05rem; font-weight: var(--weight-heading); line-height: 1.35; }
  .identity-meta { display: flex; margin-top: var(--space-7); padding-top: var(--space-5); border-top: 1px solid var(--slate-200); align-items: baseline; justify-content: space-between; gap: var(--space-4); }
  .identity-meta span { color: var(--slate-600); font-size: .77rem; font-weight: var(--weight-semibold); letter-spacing: .1em; text-transform: uppercase; }
  .identity-meta strong { color: var(--navy-900); font-size: 1.08rem; letter-spacing: .03em; }

  .records-section { padding-block: var(--section-standard); color: var(--white); background: var(--navy-950); }
  .records-layout { display: grid; grid-template-columns: minmax(0,.72fr) minmax(0,1.28fr); gap: clamp(3rem,7vw,7rem); align-items: start; }
  .records-intro { position: sticky; top: var(--sticky-offset); }
  .records-intro .eyebrow { color: var(--accent-on-dark); }
  .records-intro h2 { max-width: 11ch; margin-top: var(--space-4); color: var(--white); }
  .records-intro > h2 + p { max-width: 31rem; margin-top: var(--space-5); color: var(--sky-100); }
  .records-privacy { display: flex; margin-top: var(--space-6); align-items: flex-start; gap: .8rem; font-size: .95rem; line-height: 1.5; }
  .records-privacy :global(svg) { width: 1.25rem; height: 1.25rem; margin-top: .15rem; color: var(--accent-on-dark); flex: 0 0 auto; }
  .record-directory { background: var(--paper); color: var(--slate-700); }
  .record-entry { display: grid; grid-template-columns: auto minmax(0,1fr) auto; padding: clamp(1.8rem,4vw,2.7rem); gap: var(--space-5); align-items: center; }
  .record-entry + .record-entry { border-top: 1px solid var(--slate-200); }
  .record-entry__icon { display: grid; width: 2.5rem; height: 2.5rem; color: var(--teal-700); place-items: center; }
  .record-entry__icon :global(svg) { width: 1.55rem; height: 1.55rem; stroke-width: 1.7; }
  .record-entry__category { color: var(--teal-700); font-size: .72rem; font-weight: var(--weight-semibold); letter-spacing: .11em; line-height: 1.2; text-transform: uppercase; }
  .record-entry h3 { margin-top: .45rem; font-size: clamp(1.35rem,2vw,1.75rem); }
  .record-entry__content > p:last-child { max-width: 42rem; margin-top: .55rem; font-size: .98rem; line-height: 1.5; }
  .record-entry__action { min-width: 12rem; gap: .6rem; white-space: nowrap; }
  .record-entry__action :global(svg) { width: 1rem; height: 1rem; }
  .meaning-strip { display: grid; margin-top: var(--space-8); padding-top: var(--space-7); border-top: 1px solid var(--border-on-dark); grid-template-columns: .8fr 1fr 1fr; gap: clamp(2rem,5vw,4rem); }
  .meaning-heading .eyebrow { color: var(--accent-on-dark); }
  .meaning-heading h2 { max-width: 13ch; margin-top: var(--space-3); color: var(--white); font-size: clamp(1.8rem,3vw,2.55rem); }
  .meaning-item { display: grid; grid-template-columns: auto 1fr; gap: var(--space-4); }
  .meaning-item > :global(svg) { width: 2rem; height: 2rem; color: var(--accent-on-dark); stroke-width: 1.55; }
  .meaning-item h3 { color: var(--white); font-size: 1.25rem; }
  .meaning-item p { margin-top: .55rem; color: var(--sky-100); font-size: .96rem; line-height: 1.55; }

  .privacy-section { display: grid; min-height: 43rem; grid-template-areas: 'photo content'; grid-template-columns: minmax(0,1fr) minmax(0,1fr); background: var(--paper); }
  .privacy-photo { min-height: 43rem; margin: 0; overflow: hidden; grid-area: photo; }
  .privacy-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .privacy-content { display: grid; grid-area: content; align-items: center; }
  .privacy-content__inner { width: min(100%,43rem); padding: clamp(3rem,6vw,5rem); }
  .privacy-content h2 { max-width: 13ch; margin-top: var(--space-4); }
  .privacy-lede { margin-top: var(--space-5); color: var(--slate-800); font-size: clamp(1.15rem,1.7vw,1.35rem); line-height: 1.55; }
  .privacy-content__inner > p + p { margin-top: var(--space-5); }
  .neighborhoods { margin-top: var(--space-7); padding-top: var(--space-5); border-top: 1px solid var(--slate-200); }
  .neighborhoods__label { display: flex; align-items: center; gap: var(--button-gap); color: var(--teal-700); font-size: .77rem; font-weight: var(--weight-semibold); letter-spacing: .1em; text-transform: uppercase; }
  .neighborhoods__label :global(svg) { width: 1.25rem; height: 1.25rem; stroke-width: 1.8; }
  .neighborhoods ul { display: flex; flex-wrap: wrap; margin: var(--space-4) 0 0; padding: 0; gap: .4rem 1.5rem; list-style: none; }
  .neighborhoods li { position: relative; color: var(--navy-900); font-weight: var(--weight-heading); }
  .neighborhoods li + li::before { position: absolute; left: -.9rem; color: var(--teal-700); content: '•'; }
  .neighborhoods__note { max-width: 34rem; margin-top: var(--space-3); color: var(--slate-600); font-size: .92rem; }

  .records-cta { position: relative; display: grid; min-height: 26rem; overflow: hidden; align-items: center; color: var(--white); background: var(--navy-950); }
  .records-cta__image, .records-cta__shade { position: absolute; width: 100%; height: 100%; inset: 0; }
  .records-cta__image { object-fit: cover; object-position: center 48%; }
  .records-cta__shade { background: linear-gradient(90deg, rgba(12,42,54,.95) 0%, rgba(12,42,54,.86) 52%, rgba(12,42,54,.5) 100%); }
  .records-cta__inner { position: relative; z-index: 1; display: grid; padding-block: var(--section-standard); grid-template-columns: minmax(0,1fr) auto; gap: var(--space-7); align-items: center; }
  .records-cta .eyebrow { color: var(--accent-on-image); }
  .records-cta h2 { max-width: 15ch; margin-top: var(--space-3); color: var(--white); }
  .records-cta p:not(.eyebrow) { max-width: 42rem; margin-top: var(--space-4); color: var(--text-on-dark); font-size: 1.1rem; }
  .records-cta__actions { display: grid; min-width: 15.5rem; gap: var(--space-3); }
  .records-cta__actions .button { gap: var(--button-gap); }
  .records-cta__actions :global(svg) { width: 1.05rem; height: 1.05rem; }
  .button--cta-outline { border-color: rgba(255,255,255,.78); color: var(--white); background: rgba(12,42,54,.35); }
  .button--cta-outline:hover { color: var(--navy-950); background: var(--white); }

  @media (max-width: 1050px) {
    .identity-layout { grid-template-columns: minmax(0,.82fr) minmax(0,1.18fr); }
    .identity-content { padding: 3rem; }
    .standing-list { grid-template-columns: 1fr; gap: var(--space-5); }
    .record-entry { grid-template-columns: auto minmax(0,1fr); }
    .record-entry__action { grid-column: 2; justify-self: start; }
    .meaning-strip { grid-template-columns: 1fr 1fr; }
    .meaning-heading { grid-column: 1 / -1; }
  }

  @media (max-width: 820px) {
    .transparency-hero { min-height: 37rem; }
    .transparency-hero__image { object-position: 66% center; }
    .transparency-hero__shade { background: linear-gradient(90deg, rgba(11,40,52,.96) 0%, rgba(11,40,52,.86) 62%, rgba(11,40,52,.58) 100%); }
    .identity-layout, .records-layout, .privacy-section { grid-template-columns: 1fr; }
    .identity-layout { grid-template-areas: 'content' 'photo'; }
    .privacy-section { grid-template-areas: 'content' 'photo'; }
    .identity-photo { min-height: 26rem; }
    .identity-content { padding: var(--section-standard) var(--gutter); }
    .standing-list { grid-template-columns: 1fr 1fr; }
    .records-intro { position: static; }
    .record-directory { margin-top: var(--space-2); }
    .privacy-photo { min-height: 28rem; }
    .privacy-content__inner { padding: var(--section-standard) var(--gutter); }
    .records-cta__inner { grid-template-columns: 1fr; }
    .records-cta__actions { grid-template-columns: repeat(2,minmax(0,1fr)); justify-self: start; }
  }

  @media (max-width: 760px) {
    .transparency-hero { min-height: 35rem; }
    .transparency-hero__image { object-position: 70% center; }
    .transparency-hero__shade { background: rgba(11,40,52,.82); }
    .transparency-hero__inner { display: flex; min-height: 35rem; padding-block: var(--space-8); align-items: flex-end; }
    .transparency-hero h1 { font-size: clamp(2.75rem,13vw,4rem); }
    .hero-button { width: 100%; }
    .identity-photo { min-height: 21rem; }
    .standing-list { grid-template-columns: 1fr; gap: var(--space-5); }
    .identity-meta { align-items: flex-start; flex-direction: column; gap: .35rem; }
    .record-entry { grid-template-columns: 1fr; gap: var(--space-4); }
    .record-entry__action { width: 100%; min-width: 0; grid-column: 1; }
    .meaning-strip { grid-template-columns: 1fr; }
    .meaning-heading { grid-column: auto; }
    .meaning-item { padding-top: var(--space-5); border-top: 1px solid rgba(255,255,255,.16); }
    .privacy-photo { min-height: 22rem; }
    .neighborhoods ul { display: grid; gap: .35rem; }
    .neighborhoods li + li::before { display: none; }
    .records-cta { min-height: 33rem; }
    .records-cta__shade { background: rgba(11,40,52,.84); }
    .records-cta__inner { min-height: 33rem; align-content: center; }
    .records-cta__actions { width: 100%; min-width: 0; grid-template-columns: 1fr; }
  }
</style>
