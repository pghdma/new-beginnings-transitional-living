---
import MainLayout from '../../../layouts/MainLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CtaBand from '../../../components/CtaBand.astro';
import FactRail from '../../../components/FactRail.astro';
import { site } from '../../../data/site';
---
<MainLayout title="Credentials and Transparency" description="Review New Beginnings nonprofit status, recovery-housing credentials, public records, and residence-privacy approach.">
  <PageHero variant="editorial" eyebrow="Accountability" title="Credentials and public records." intro="Residents, families, professionals, and supporters should be able to verify who operates recovery housing and understand the standards connected to it." image="/images/credentials.jpg" imageAlt="Organized documents and a pen on a professional desk" />

  <FactRail />

  <section class="section identity">
    <div class="container identity-grid">
      <div><p class="eyebrow">Organization identity</p><h2>A Pittsburgh public charity.</h2><p class="lead">New Beginnings Transitional Living Foundation operates as an independent Pennsylvania nonprofit focused on recovery housing.</p></div>
      <dl>
        <div><dt>Organization</dt><dd>New Beginnings Transitional Living Foundation</dd></div>
        <div><dt>Federal tax status</dt><dd>501(c)(3) public charity</dd></div>
        <div><dt>Employer Identification Number</dt><dd>{site.ein}</dd></div>
        <div><dt>IRS ruling</dt><dd>Tax-exempt since February 2019</dd></div>
        <div><dt>Area served</dt><dd>Pittsburgh and surrounding Allegheny County communities</dd></div>
      </dl>
    </div>
  </section>

  <section class="section section--tint records">
    <div class="container">
      <div class="records-head"><p class="eyebrow">Independent sources</p><h2>Where to verify the information.</h2><p>These external sources are maintained by government agencies or independent organizations. Their pages may include information New Beginnings intentionally does not reproduce here, including facility addresses.</p></div>
      <ul class="document-list">
        <li><div><strong>IRS nonprofit filings</strong><p>Review available Form 990 filings and tax-exempt organization information for EIN {site.ein}.</p></div><a class="text-link" href="https://projects.propublica.org/nonprofits/organizations/812901849" rel="external">View public filings</a></li>
        <li><div><strong>Pennsylvania DDAP licensing</strong><p>Search Pennsylvania’s public facility directory for recovery residences operated by New Beginnings.</p></div><a class="text-link" href="https://sais.health.pa.gov/CommonPOC/Content/PublicWeb/DAFind.aspx" rel="external">Search the state directory</a></li>
        <li><div><strong>WestPARR directory</strong><p>Review New Beginnings’ inspected AA/NA-based recovery-housing listing.</p></div><a class="text-link" href="https://westparr.org/search-homes/" rel="external">View the WestPARR directory</a></li>
      </ul>
    </div>
  </section>

  <section class="section privacy">
    <div class="container editorial-split">
      <div class="editorial-title"><p class="eyebrow">Residence privacy</p><h2>Public accountability without publishing someone’s home.</h2></div>
      <div class="editorial-copy"><p class="lead">Government records may contain licensed-facility addresses. New Beginnings does not reproduce those addresses on this website.</p><p>Neighborhood-level information gives prospective residents and referral partners useful context while helping protect the privacy of people who live in the homes. Exact location details are provided privately when appropriate.</p><p>This same approach applies to photography: the website does not identify residences through exterior photographs.</p></div>
    </div>
  </section>

  <section class="section section--navy boundaries">
    <div class="container boundaries-grid">
      <div><p class="eyebrow">Plain-language boundaries</p><h2>What our credentials mean.</h2></div>
      <div><p class="lead">Licensing and inspection provide important independent standards. They do not turn recovery housing into clinical treatment.</p><p>New Beginnings provides recovery housing. Counseling, medical services, medication management, and other treatment remain with independent licensed providers.</p><a class="button button--light" href="/recovery-housing/">Learn how recovery housing works</a></div>
    </div>
  </section>

  <CtaBand eyebrow="Questions about the organization" title="Ask for the information you need." text="For general questions about credentials, governance, or public records, contact New Beginnings directly." href="/contact/" label="Contact us" />
</MainLayout>

<style>
  .identity-grid, .boundaries-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: var(--gap-columns); }
  .identity-grid > div, .boundaries-grid > div { display: grid; align-content: start; gap: var(--space-4); }
  .identity dl { margin: 0; border-top: 1px solid var(--slate-300); }
  .identity dl div { display: grid; grid-template-columns: .85fr 1.15fr; gap: var(--space-5); padding-block: var(--space-4); border-bottom: 1px solid var(--slate-300); }
  .identity dt { color: var(--slate-600); font-size: .82rem; font-weight: 750; letter-spacing: .09em; text-transform: uppercase; }
  .identity dd { margin: 0; color: var(--navy-900); font-weight: 700; }
  .records-head { display: grid; max-width: 56rem; margin-bottom: var(--space-6); gap: var(--space-3); }
  .records-head p:last-child { max-width: var(--measure); }
  .boundaries p:not(.eyebrow) { color: var(--sky-100); }
  .boundaries .button { margin-top: var(--space-5); }
  @media (max-width: 800px) { .identity-grid, .boundaries-grid { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .identity dl div { grid-template-columns: 1fr; gap: var(--space-2); } }
</style>
