---
import { Icon } from 'astro-icon/components';
import FeatureList from '../../../components/FeatureList.astro';
import CtaBand from '../../../components/CtaBand.astro';
import Hero from '../../../components/Hero.astro';
import SplitPanel from '../../../components/SplitPanel.astro';
import MainLayout from '../../../layouts/MainLayout.astro';
import { site } from '../../../data/site';

const standing = [
  { icon: 'landmark', label: 'Federal status', value: '501(c)(3) public charity' },
  { icon: 'calendar-check', label: 'IRS ruling', value: 'Tax exempt since February 2019' },
  { icon: 'badge-check', label: 'Pennsylvania oversight', value: 'DDAP-licensed recovery houses' },
  { icon: 'shield-check', label: 'Independent inspection', value: 'WestPARR certified member' },
];

const meanings = [
  { icon: 'clipboard-check', title: 'DDAP License', copy: 'The Commonwealth reviewed our houses and our written policies on drug screens, medication, fees, and discharge. Licensed houses are the only ones state agencies and courts can refer to first.' },
  { icon: 'house-heart', title: 'WestPARR Certification', copy: 'An independent Pittsburgh alliance of recovery residences inspected our homes against recognized recovery housing standards and lists us as a certified member.' },
];

const publicSources = [
  {
    icon: 'landmark',
    category: 'Federal nonprofit record',
    title: 'IRS Nonprofit Filings',
    text: `Form 990 filings and tax-exempt status for EIN ${site.ein}, through ProPublica’s Nonprofit Explorer.`,
    label: 'View Public Filings',
    href: 'https://projects.propublica.org/nonprofits/organizations/812901849',
  },
  {
    icon: 'badge-check',
    category: 'Pennsylvania licensing',
    title: 'Department of Drug and Alcohol Programs',
    text: 'Pennsylvania’s directory of licensed recovery houses. Search for New Beginnings Transitional Living.',
    label: 'Search DDAP Records',
    href: 'https://www.pa.gov/services/ddap/locate-licensed-recovery-or-halfway-housing',
  },
  {
    icon: 'shield-check',
    category: 'Independent inspection',
    title: 'WestPARR Directory',
    text: 'The Western Pennsylvania Alliance of Recovery Residences lists New Beginnings as a certified, AA and NA based member with three men’s houses and one women’s house.',
    label: 'View WestPARR Listing',
    href: 'https://westparr.org/search-homes/',
  },
];
---

<MainLayout
  title="Credentials and Licensing"
  description="Check New Beginnings yourself: 501(c)(3) status, Pennsylvania DDAP recovery house license, WestPARR certification, and IRS filings, with links to each public record."
>
  <Hero
    variant="image"
    size="lg"
    height="tall"
    eyebrow="Credentials"
    title="Licensed, Inspected, and On the Record"
    lead="Anyone can call themselves a recovery house. Before you or someone you love moves in, you should be able to check who is running it. Here’s everything you need to check us."
    image={{ src: '/images/home-entry.webp', alt: '', width: 2200, height: 1467, position: '60% 54%', positionMobile: '70% center' }}
  >
    <Fragment slot="actions">
      <a class="button button--light" href="#public-records">See the Public Records<Icon name="lucide:arrow-down" aria-hidden="true" /></a>
    </Fragment>
  </Hero>

  <section class="identity-section">
    <div class="container">
      <SplitPanel tone="paper" padding="xl" photo={{ src: '/images/pittsburgh.jpg', alt: 'Downtown Pittsburgh and its rivers', width: 1880, height: 1253 }} photoFraction={0.88} contentFraction={1.12} minHeight="44rem">
      <div class="identity-content">
        <p class="eyebrow">Who We Are</p>
        <h2>A Pittsburgh Nonprofit You Can Look Up</h2>
        <p class="identity-lede">New Beginnings Transitional Living Foundation is an independent Pennsylvania public charity that runs DDAP-licensed recovery housing for men and women in Pittsburgh.</p>
        <dl class="standing-list">
          {standing.map((item) => (
            <div class="standing-item">
              <dt><Icon name={`lucide:${item.icon}`} aria-hidden="true" />{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>
        <div class="identity-meta">
          <span>Employer Identification Number</span>
          <strong>{site.ein}</strong>
        </div>
      </div>
      </SplitPanel>
    </div>
  </section>

  <section class="records-section" id="public-records">
    <div class="container records-layout">
      <div class="records-intro">
        <p class="eyebrow">Public Records</p>
        <h2>Look Us Up</h2>
        <p>These records are kept by the IRS, the Commonwealth of Pennsylvania, and WestPARR, not by us. You don’t have to take our word for any of it.</p>
      </div>
      <div class="record-directory" aria-label="Independent public records">
        {publicSources.map((source) => (
          <article class="record-entry">
            <span class="record-entry__icon"><Icon name={`lucide:${source.icon}`} aria-hidden="true" /></span>
            <div class="record-entry__content">
              <p class="record-entry__category">{source.category}</p>
              <h3>{source.title}</h3>
              <p>{source.text}</p>
            </div>
            <a class="button button--outline record-entry__action" href={source.href} rel="external">
              {source.label}<Icon name="lucide:external-link" aria-hidden="true" />
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="meaning-section" aria-labelledby="meaning-title">
    <div class="container meaning-strip">
      <div class="meaning-heading">
        <p class="eyebrow">In Plain Language</p>
        <h2 id="meaning-title">What the Credentials Mean</h2>
      </div>
      <FeatureList items={meanings} icon="bare" iconSize="md" columns={2} />
    </div>
  </section>


  <CtaBand
    eyebrow="Questions?"
    title="Ask Us for Any Policy or Record"
    text="Want to see the house rules, the fee schedule, or a copy of our license? Call or email and we’ll send it."
    href="/contact/"
    label="Contact New Beginnings"
  />
</MainLayout>
<style>

  .identity-section{ padding-block: var(--section-standard); background: var(--canvas); }
  .identity-content { min-width: 0; }
  .identity-content h2{ max-width: 24ch; margin-top: var(--space-4); }
  .identity-lede{ max-width: 40rem; margin-top: var(--space-5); color: var(--slate-800); font-size: clamp(1.15rem,1.7vw,1.35rem); line-height: 1.55; }
  .standing-list{ display: grid; margin: var(--space-7) 0 0; grid-template-columns: 1fr 1fr; gap: var(--space-6) var(--space-7); }
  .standing-item{ margin: 0; }
  .standing-item dt{ display: flex; align-items: center; gap: .7rem; color: var(--teal-700); font-size: .77rem; font-weight: var(--weight-semibold); letter-spacing: .1em; line-height: 1.25; text-transform: uppercase; }
  .standing-item dt :global(svg){ width: 1.35rem; height: 1.35rem; flex: 0 0 auto; stroke-width: 1.8; }
  .standing-item dd{ margin: .55rem 0 0 2.05rem; color: var(--navy-900); font-size: 1.05rem; font-weight: var(--weight-heading); line-height: 1.35; }
  .identity-meta{ display: flex; margin-top: var(--space-7); padding-top: var(--space-5); border-top: 1px solid var(--slate-200); align-items: baseline; justify-content: space-between; gap: var(--space-4); }
  .identity-meta span{ color: var(--slate-600); font-size: .77rem; font-weight: var(--weight-semibold); letter-spacing: .1em; text-transform: uppercase; }
  .identity-meta strong{ color: var(--navy-900); font-size: 1.08rem; letter-spacing: .03em; }

  .records-section{ padding-block: var(--section-standard); color: var(--white); background: var(--navy-950); }
  .records-layout{ display: grid; grid-template-columns: minmax(0,.72fr) minmax(0,1.28fr); gap: clamp(3rem,7vw,7rem); align-items: start; }
  .records-intro{ position: sticky; top: var(--sticky-offset); }
  .records-intro .eyebrow{ color: var(--accent-on-dark); }
  .records-intro h2{ max-width: 24ch; margin-top: var(--space-4); color: var(--white); }
  .records-intro > h2 + p{ max-width: 31rem; margin-top: var(--space-5); color: var(--sky-100); }
  .record-directory{ border-radius: var(--radius-lg); overflow: hidden; background: var(--paper); color: var(--slate-700); }
  .record-entry{ display: grid; grid-template-columns: auto minmax(0,1fr) auto; padding: clamp(1.8rem,4vw,2.7rem); gap: var(--space-5); align-items: center; }
  .record-entry + .record-entry{ border-top: 1px solid var(--slate-200); }
  .record-entry__icon{ display: grid; width: 2.5rem; height: 2.5rem; color: var(--teal-700); place-items: center; }
  .record-entry__icon :global(svg){ width: 1.55rem; height: 1.55rem; stroke-width: 1.7; }
  .record-entry__category{ color: var(--teal-700); font-size: .72rem; font-weight: var(--weight-semibold); letter-spacing: .11em; line-height: 1.2; text-transform: uppercase; }
  .record-entry h3{ margin-top: .45rem; font-size: clamp(1.35rem,2vw,1.75rem); }
  .record-entry__content > p:last-child{ max-width: 42rem; margin-top: .55rem; font-size: .98rem; line-height: 1.5; }
  .record-entry__action{ min-width: 12rem; gap: .6rem; white-space: nowrap; }
  .record-entry__action :global(svg){ width: 1rem; height: 1rem; }
  .meaning-section{ padding-block: var(--section-compact); background: var(--canvas); }
  .meaning-strip{ display: grid; grid-template-columns: .8fr 2fr; gap: clamp(2rem,5vw,4rem); }
  .meaning-heading h2{ max-width: 24ch; margin-top: var(--space-3); color: var(--navy-900); font-size: clamp(1.8rem,3vw,2.55rem); }

  @media (max-width: 1080px) {
    .identity-content{ padding: 3rem; }
    .standing-list{ grid-template-columns: 1fr; gap: var(--space-5); }
    .record-entry{ grid-template-columns: auto minmax(0,1fr); }
    .record-entry__action{ grid-column: 2; justify-self: start; }
    .meaning-strip{ grid-template-columns: 1fr 1fr; }
    .meaning-heading{ grid-column: 1 / -1; }
  }

  @media (max-width: 900px) {
    .identity-content{ padding: var(--section-standard) var(--gutter); }
    .standing-list{ grid-template-columns: 1fr 1fr; }
    .records-intro{ position: static; }
    .record-directory{ margin-top: var(--space-2); }
  }

  @media (max-width: 760px) {
    .standing-list{ grid-template-columns: 1fr; gap: var(--space-5); }
    .identity-meta{ align-items: flex-start; flex-direction: column; gap: .35rem; }
    .record-entry{ grid-template-columns: 1fr; gap: var(--space-4); }
    .record-entry__action{ width: 100%; min-width: 0; grid-column: 1; }
    .meaning-strip{ grid-template-columns: 1fr; }
    .meaning-heading{ grid-column: auto; }
  }

  /* Mobile floor: 16px copy, one alignment per section, 44px tap targets. Measured by scripts/mobile-audit.mjs */
  @media (max-width: 900px) {
    .record-entry__content p{ font-size: 1rem; line-height: 1.55; }
    .record-entry__content > p:not(.record-entry__category){ font-size: 1rem; line-height: 1.55; }
  }
</style>
