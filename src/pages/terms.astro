---
import LegalLayout from '../layouts/LegalLayout.astro';

const sections = [
  { id: 'acceptance', title: 'Using this website' },
  { id: 'housing', title: 'Recovery housing information' },
  { id: 'emergency', title: 'Not for emergencies' },
  { id: 'availability', title: 'Admissions and availability' },
  { id: 'forms', title: 'Using website forms' },
  { id: 'residences', title: 'Residence privacy and safety' },
  { id: 'conduct', title: 'Responsible use' },
  { id: 'third-party', title: 'External links and credentials' },
  { id: 'content', title: 'Website content' },
  { id: 'disclaimers', title: 'Availability and limitations' },
  { id: 'law', title: 'Pennsylvania law' },
  { id: 'changes', title: 'Changes to these terms' },
  { id: 'contact', title: 'Contact us' },
];
---

<LegalLayout
  title="Terms of Use"
  intro="Important information about using this website and the limits of the housing, referral, and nonprofit information it provides."
  description="Terms governing use of the New Beginnings Transitional Living Foundation website."
  updated="August 21, 2026"
  sections={sections}
>
  <p class="legal-intro">
    These terms apply to newbeginningspgh.org, the public website of New Beginnings
    Transitional Living Foundation. The site is intended to make general recovery-housing and
    nonprofit information easier to find. It does not replace a direct conversation about a
    person's circumstances or current housing availability.
  </p>
  <p class="legal-entity">
    New Beginnings Transitional Living Foundation ("New Beginnings," "we," "us," or "our")
  </p>

  <section class="legal-section" id="acceptance">
    <h2 data-label="Section 01">Using this website</h2>
    <p>
      By accessing or using this website, you agree to these Terms of Use and acknowledge the
      <a href="/privacy/">Privacy Policy</a>. If you do not agree, please discontinue use of
      the site. You may still contact New Beginnings by telephone for general information.
    </p>
    <p>
      The site is intended for lawful, personal, informational, referral, and nonprofit
      purposes. These terms concern the public website only. Separate agreements, policies,
      residence rules, and intake documents may apply to residents, applicants, employees,
      volunteers, donors, vendors, or partner organizations.
    </p>
  </section>

  <section class="legal-section" id="housing">
    <h2 data-label="Section 02">Recovery housing information</h2>
    <p>
      New Beginnings operates nonprofit recovery housing for adults. Recovery housing provides
      a substance-free living environment, peer community, structure, and accountability. New
      Beginnings is <strong>not a medical, behavioral-health, detoxification, or clinical
      treatment provider</strong> through this website or its housing program.
    </p>
    <p>
      Website content is general information, not medical advice, legal advice, a diagnosis,
      treatment, or a recommendation for any individual. Questions about treatment, medication,
      withdrawal, mental health, or another clinical concern should be directed to an
      appropriately qualified professional.
    </p>
  </section>

  <section class="legal-section" id="emergency">
    <h2 data-label="Section 03">Not for emergencies</h2>
    <aside class="legal-callout" role="note">
      <p class="legal-callout-label">Immediate help</p>
      <div class="legal-callout-body">
        <p>
          <strong>This website and its forms are not emergency or crisis services.</strong>
          Do not rely on a website message for an urgent response.
        </p>
        <p>
          For a medical or immediate safety emergency, call <a href="tel:911">911</a>. If you
          or someone else is in emotional distress or at risk of suicide, call or text
          <a href="tel:988">988</a> for the Suicide &amp; Crisis Lifeline.
        </p>
      </div>
    </aside>
  </section>

  <section class="legal-section" id="availability">
    <h2 data-label="Section 04">Admissions and availability</h2>
    <p>
      Nothing on this website guarantees admission, placement, a particular residence,
      eligibility, current bed availability, a move-in date, length of stay, or a specific
      outcome. Program details and availability can change. A website form or telephone call is
      only the beginning of a conversation.
    </p>
    <p>
      New Beginnings may need additional information and may apply current intake and residence
      requirements before determining whether a placement is available or appropriate. Contact
      us at <a href="tel:+14126280403">412-628-0403</a> for current information.
    </p>
  </section>

  <section class="legal-section" id="forms">
    <h2 data-label="Section 05">Using website forms</h2>
    <p>
      A public website form is for a general housing, referral, donation, partnership, or
      organizational inquiry. Provide accurate contact information and a brief, general message.
      Submitting a form does not guarantee delivery, a response, admission, or the creation of a
      confidential, professional, or resident relationship.
    </p>
    <p>
      Do not submit medical or treatment records, medication information, criminal-history
      details, Social Security numbers, financial-account information, passwords, or another
      person's confidential information. Review the <a href="/privacy/">Privacy Policy</a>
      for a complete explanation of what should not be submitted.
    </p>
  </section>

  <section class="legal-section" id="residences">
    <h2 data-label="Section 06">Residence privacy and safety</h2>
    <p>
      New Beginnings intentionally provides neighborhood-level information rather than
      publishing individual recovery-residence addresses or identifying exterior details. This
      practice supports resident privacy and safety.
    </p>
    <p>
      Do not use this website to locate, identify, publish, distribute, or request an
      unauthorized visit to a residence. Exact location information may be provided privately
      when appropriate in the intake, referral, or resident-support process.
    </p>
  </section>

  <section class="legal-section" id="conduct">
    <h2 data-label="Section 07">Responsible use</h2>
    <p>When using this website, you agree not to:</p>
    <ul>
      <li>Submit false, unlawful, threatening, discriminatory, harassing, or abusive material</li>
      <li>Send spam, malicious code, automated attacks, or excessive requests</li>
      <li>Attempt to bypass security, gain unauthorized access, or disrupt the site</li>
      <li>Impersonate another person or misrepresent your relationship to a prospective resident</li>
      <li>Use site content to compromise the privacy or safety of a resident or residence</li>
    </ul>
    <p>
      New Beginnings may restrict access or take other reasonable action when website use
      threatens security, privacy, safety, or lawful operation.
    </p>
  </section>

  <section class="legal-section" id="third-party">
    <h2 data-label="Section 08">External links and credentials</h2>
    <p>
      The site may link to government agencies, licensing resources, recovery organizations,
      nonprofit records, crisis services, or other third parties. A link is provided for
      convenience and context. New Beginnings does not control an external site's content,
      availability, security, or privacy practices.
    </p>
    <p>
      Names, logos, certificates, and marks belonging to licensing bodies, membership
      organizations, or other third parties remain the property of their respective owners.
      Visitors should consult the issuing organization for the current status and meaning of a
      license, membership, filing, or credential.
    </p>
  </section>

  <section class="legal-section" id="content">
    <h2 data-label="Section 09">Website content</h2>
    <p>
      Unless otherwise indicated, text, design, graphics, and original materials on this site
      are owned by or used with permission of New Beginnings. You may view, download, or print
      pages for personal, informational, or referral use. You may not reproduce substantial
      portions for commercial use, remove ownership notices, or present New Beginnings content
      as your own without permission.
    </p>
    <p>
      Factual references to government programs, licensing authorities, public records, and
      community resources remain subject to the rights and terms of their respective sources.
    </p>
  </section>

  <section class="legal-section" id="disclaimers">
    <h2 data-label="Section 10">Availability and limitations</h2>
    <p>
      New Beginnings works to keep the website useful and accurate, but information may become
      outdated and the site may occasionally be unavailable, incomplete, or contain an error.
      The website is provided on an "as available" basis. Contact New Beginnings directly
      before relying on information about availability, admissions, documents, or program
      operations.
    </p>
    <p>
      To the extent permitted by law, New Beginnings is not responsible for losses caused by
      reliance on general website content, inability to access the site, misuse of the site,
      or content and services supplied by third parties. Nothing in these terms excludes a
      responsibility that cannot legally be excluded.
    </p>
  </section>

  <section class="legal-section" id="law">
    <h2 data-label="Section 11">Pennsylvania law</h2>
    <p>
      These terms are governed by applicable federal law and the laws of the Commonwealth of
      Pennsylvania, without regard to conflict-of-law principles. Any provision found
      unenforceable should be limited to the minimum extent necessary while the remaining terms
      continue to apply.
    </p>
  </section>

  <section class="legal-section" id="changes">
    <h2 data-label="Section 12">Changes to these terms</h2>
    <p>
      New Beginnings may revise these terms as the website, organization, or applicable
      requirements change. The review date at the top identifies the current published version.
      Continued use of the website after an update is subject to the revised terms.
    </p>
  </section>

  <section class="legal-section" id="contact">
    <h2 data-label="Section 13">Contact us</h2>
    <p>For a question about these terms or current program information, contact:</p>
    <div class="legal-contact">
      <p><strong>New Beginnings Transitional Living Foundation</strong></p>
      <p>Phone: <a href="tel:+14126280403">412-628-0403</a></p>
    </div>
  </section>
</LegalLayout>
