---
import { Icon } from 'astro-icon/components';
import MainLayout from '../layouts/MainLayout.astro';
import { currentBoardMembers, susanRua } from '../data/leadership';

const purposeScenes = [
  {
    src: '/images/home-entry.webp',
    alt: 'A welcoming residential entry and staircase',
    label: 'A Real Home',
    description: 'Ordinary houses in ordinary neighborhoods. A kitchen, a living room, and a bed that is yours.',
    className: 'purpose-gallery__scene--primary',
    width: 2200,
    height: 1467,
  },
  {
    src: '/images/house-kitchen.webp',
    alt: 'A shared kitchen and dining table prepared for everyday routines',
    label: 'A Real Routine',
    description: 'Meetings, chores, work, and a weekly house meeting give the week a shape you can count on.',
    className: '',
    width: 2200,
    height: 1467,
  },
  {
    src: '/images/pittsburgh.jpg',
    alt: 'The Pittsburgh skyline and rivers',
    label: 'A Real City',
    description: 'Our houses sit in established Pittsburgh neighborhoods near bus lines, jobs, and meetings.',
    className: '',
    width: 1880,
    height: 1253,
  },
];

const commitments = [
  {
    icon: 'heart-handshake',
    title: 'Respect',
    copy: 'You are an adult and a neighbor, not a case number. We expect you to treat the house and the people in it the same way.',
  },
  {
    icon: 'scale',
    title: 'Accountability',
    copy: 'House rules, random drug screens, and a weekly house meeting are not there to catch you. They keep the house safe for the person who moved in yesterday.',
  },
  {
    icon: 'users-round',
    title: 'Community',
    copy: 'Recovery is easier next to someone who is also doing it. Housemates, sponsors, home groups, and family are all part of the plan.',
  },
];

const founderHighlights = [
  { icon: 'badge-check', label: 'CADC · MSPC · LPC' },
  { icon: 'heart-pulse', label: 'Addiction counselor since 1999' },
  { icon: 'house-heart', label: 'Ten plus years running sober homes' },
];

const accountabilityProof = [
  { icon: 'landmark', label: '501(c)(3)', detail: 'Public charity since 2019' },
  { icon: 'badge-check', label: 'Pennsylvania DDAP', detail: 'Licensed recovery houses' },
  { icon: 'shield-check', label: 'WestPARR', detail: 'Certified member' },
];
---

<MainLayout
  title="About"
  description="New Beginnings is a Pittsburgh 501(c)(3) founded in 2016 by counselor Susan Rua to run safe, licensed recovery housing for men and women."
>
  <section class="about-hero">
    <img
      class="about-hero__image"
      src="/images/pittsburgh-rowhouses.webp"
      alt=""
      width="1800"
      height="1204"
      fetchpriority="high"
    />
    <div class="about-hero__shade" aria-hidden="true"></div>
    <div class="container about-hero__inner">
      <div class="about-hero__copy">
        <p class="eyebrow">About New Beginnings</p>
        <h1>A Pittsburgh Nonprofit That Runs Sober Houses the Right Way</h1>
        <p class="lead">
          New Beginnings Transitional Living Foundation gives adults in recovery a safe,
          substance-free home and the structure to stay that way. Licensed, inspected,
          and run by people who know the work.
        </p>
        <p class="about-hero__origin">
          <Icon name="lucide:map-pin" aria-hidden="true" />
          Founded in Pittsburgh in 2016
        </p>
      </div>
    </div>
  </section>

  <section class="purpose-section">
    <div class="container purpose-section__intro">
      <header>
        <p class="eyebrow">Why We Exist</p>
        <h2>The Hardest Part Often Starts the Day Treatment Ends</h2>
      </header>
      <div class="purpose-section__copy">
        <p class="purpose-section__statement">
          Plenty of people get sober. Fewer stay sober, and the difference is usually where
          they go home to. New Beginnings exists to make sure that home is safe.
        </p>
        <div class="purpose-section__details">
          <div>
            <span>What we do</span>
            <p>
              We run sober living homes in Pittsburgh for men and women. Residents live
              substance free, go to AA or NA, keep up with work or school, and share the
              responsibilities of a household with people who understand.
            </p>
          </div>
          <div>
            <span>What we do not do</span>
            <p>
              We are not a treatment center, a detox, or a shelter. Counseling, medical care,
              and medication stay with your own providers. We give you the stable home that
              makes all of that easier to keep up with.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="container purpose-gallery" role="list" aria-label="What the houses provide">
      {purposeScenes.map((scene) => (
        <figure
          class:list={['purpose-gallery__scene', scene.className]}
          role="listitem"
          tabindex="0"
        >
          <img
            src={scene.src}
            alt={scene.alt}
            width={scene.width}
            height={scene.height}
            loading="lazy"
          />
          <figcaption>
            <h3>{scene.label}</h3>
            <p>{scene.description}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="principles-band">
    <div class="principles-band__content">
      <header>
        <p class="eyebrow">How We Run the Houses</p>
        <h2>What We Ask of Everyone, Including Ourselves</h2>
        <p>
          A good sober house comes down to how people are treated, what everyone can count
          on, and who is responsible for what.
        </p>
      </header>
      <ul>
        {commitments.map((commitment) => (
          <li>
            <span class="principles-band__icon icon-medallion icon-medallion--dark">
              <Icon name={`lucide:${commitment.icon}`} aria-hidden="true" />
            </span>
            <div>
              <h3>{commitment.title}</h3>
              <p>{commitment.copy}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
    <figure class="principles-band__visual">
      <img
        src="/images/windowed-living-room.webp"
        alt="A bright shared living and dining room set for an ordinary day at home"
        width="2200"
        height="1467"
        loading="lazy"
      />
    </figure>
  </section>

  {susanRua && (
    <section class="founder-profile">
      <div class="container founder-profile__grid">
        <div class="founder-profile__content">
          <p class="eyebrow">President and Founder</p>
          <h2>{susanRua.name}</h2>
          <p class="lead">
            I have been a counselor since 1999 and a nurse before that, and I have owned and
            run sober living homes in Pittsburgh for more than ten years.
          </p>
          <p>
            I started New Beginnings as a nonprofit because this city needed more decent,
            licensed recovery housing, and because I had watched too many people do the hard
            work of treatment and then have nowhere safe to go. The houses are built on what I
            have seen work: clear rules, a weekly house meeting, AA and NA, and housemates who
            are doing the same thing you are.
          </p>
          <p>
            I also run <a class="inline-link" href="https://stepbystepsupport.net/" rel="external">Step By Step Support</a>,
            my counseling practice in Mt. Washington. It is a separate organization, and living
            at New Beginnings does not require seeing me or anyone in particular for counseling.
          </p>
          <ul class="founder-profile__highlights" aria-label="Susan Rua’s professional background">
            {founderHighlights.map((item) => (
              <li>
                <Icon name={`lucide:${item.icon}`} aria-hidden="true" />
                <span>{item.label}</span>
              </li>
            ))}
          </ul>
          <a class="button" href="/about/board/#susan-rua">
            More About Susan
            <Icon name="lucide:arrow-right" aria-hidden="true" />
          </a>
        </div>
        <figure class="founder-profile__portrait">
          <img
            src="/images/susan-rua.webp"
            alt="Susan Rua, President and Founder of New Beginnings"
            width="900"
            height="1125"
            loading="lazy"
          />
        </figure>
      </div>
    </section>
  )}

  <section class="governance-section" id="governance">
    <div class="container governance-section__intro">
      <div>
        <p class="eyebrow">Nonprofit Governance</p>
        <h2>Accountable to a Board, Not Just an Owner</h2>
      </div>
      <p class="lead">
        New Beginnings is a public charity with a volunteer Board of Directors. That means
        the organization answers to more than one person, files with the IRS every year,
        and keeps its standing public.
      </p>
    </div>

    <div class="container governance-section__stage">
      <article class="board-preview">
        <div class="board-preview__content">
          <p class="eyebrow">Leadership</p>
          <h3>The People Responsible for the Mission</h3>
          <p>
            Susan and staff run the houses day to day. The board keeps the organization
            honest, solvent, and focused on housing.
          </p>
          <div class="board-preview__roster" aria-label="Board of Directors">
            {currentBoardMembers.map((member) => (
              <div>
                <strong>{member.name}</strong>
                <span>{member.role}</span>
              </div>
            ))}
          </div>
          <a class="button button--light" href="/about/board/">
            Meet the Board
            <Icon name="lucide:arrow-right" aria-hidden="true" />
          </a>
        </div>
        <figure class="board-preview__visual">
          <img
            src="/images/community-table.jpg"
            alt="An empty meeting room prepared for organizational work"
            width="1880"
            height="1253"
            loading="lazy"
          />
          <figcaption>Volunteer Board</figcaption>
        </figure>
      </article>

      <article class="records-preview">
        <div class="records-preview__content">
          <header>
            <p class="eyebrow">Check for Yourself</p>
            <h3>Licensed, Inspected, and On the Record</h3>
          </header>
          <div class="records-preview__proof" aria-label="Public credentials">
            {accountabilityProof.map((item) => (
              <div>
                <Icon name={`lucide:${item.icon}`} aria-hidden="true" />
                <span><strong>{item.label}</strong>{item.detail}</span>
              </div>
            ))}
          </div>
          <a class="button" href="/about/transparency/">
            See Our Credentials
            <Icon name="lucide:arrow-right" aria-hidden="true" />
          </a>
        </div>
      </article>
    </div>
  </section>
</MainLayout>
<style>
  .about-hero { position: relative; display: grid; min-height: clamp(29rem, 48vw, 34rem); overflow: hidden; align-items: center; color: var(--white); background: var(--navy-950); }
  .about-hero__image, .about-hero__shade { position: absolute; width: 100%; height: 100%; inset: 0; }
  .about-hero__image { object-fit: cover; object-position: center 54%; filter: saturate(.78) contrast(1.02); }
  .about-hero__shade { background: linear-gradient(90deg, rgba(9,34,45,.97) 0%, rgba(9,34,45,.9) 38%, rgba(9,34,45,.62) 64%, rgba(9,34,45,.2) 100%); }
  .about-hero__inner { position: relative; z-index: 1; padding-block: clamp(4.5rem, 7vw, 6.5rem); }
  .about-hero__copy { max-width: 43rem; }
  .about-hero .eyebrow { color: var(--accent-on-image); }
  .about-hero h1 { max-width: 13ch; margin-top: var(--space-4); color: var(--white); font-size: var(--type-display-narrative); font-weight: var(--weight-heading); }
  .about-hero .lead { max-width: 38rem; margin-top: var(--space-5); color: var(--text-on-dark); }
  .about-hero__origin { display: flex; margin-top: var(--space-6); align-items: center; gap: var(--button-gap); color: var(--text-muted-on-dark); font-size: .93rem; }
  .about-hero__origin :global(svg) { width: 1.1rem; height: 1.1rem; color: var(--accent-on-image); stroke-width: 1.7; }

  .purpose-section { padding-block: var(--section-standard); background: var(--canvas); }
  .purpose-section__intro { display: grid; grid-template-columns: minmax(0, .78fr) minmax(0, 1.22fr); gap: clamp(var(--space-7), 8vw, 8rem); align-items: start; }
  .purpose-section__intro header { display: grid; gap: var(--space-4); }
  .purpose-section__intro h2 { max-width: 13ch; }
  .purpose-section__copy { display: grid; max-width: 48rem; gap: var(--space-7); }
  .purpose-section__statement { max-width: 39rem; color: var(--navy-900); font-size: clamp(1.35rem, 2vw, 1.75rem); font-weight: var(--weight-medium); letter-spacing: -.01em; line-height: 1.45; }
  .purpose-section__details { display: grid; border-top: 1px solid var(--slate-300); grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(var(--space-5), 4vw, var(--space-8)); }
  .purpose-section__details > div { padding-top: var(--space-5); }
  .purpose-section__details span { display: block; margin-bottom: var(--space-3); color: var(--teal-700); font-size: .74rem; font-weight: var(--weight-semibold); letter-spacing: .11em; text-transform: uppercase; }
  .purpose-section__details p { color: var(--slate-600); line-height: 1.65; }
  .purpose-gallery { display: grid; height: clamp(23rem, 31vw, 29rem); margin-top: clamp(var(--space-8), 7vw, var(--space-10)); grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
  .purpose-gallery__scene { position: relative; min-width: 0; margin: 0; overflow: hidden; background: var(--slate-200); box-shadow: 0 .8rem 2rem rgba(23,55,70,.08); transition: box-shadow .35s ease, transform .35s ease; }
  .purpose-gallery__scene img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.77) contrast(.99); transition: filter .45s ease, transform .55s ease; }
  .purpose-gallery__scene--primary img { object-position: 54% center; }
  .purpose-gallery__scene:nth-child(2) img { object-position: 46% center; }
  .purpose-gallery__scene:nth-child(3) img { object-position: center; }
  .purpose-gallery__scene::after { position: absolute; background: linear-gradient(0deg, rgba(9,34,45,.9), rgba(9,34,45,.1) 62%); content: ''; inset: 0; transition: background .4s ease; }
  .purpose-gallery__scene figcaption { position: absolute; z-index: 1; right: var(--space-5); bottom: var(--space-5); left: var(--space-5); color: var(--white); }
  .purpose-gallery__scene h3 { color: var(--white); font-size: clamp(1.25rem, 2.2vw, 1.7rem); font-weight: var(--weight-heading); letter-spacing: -.01em; line-height: 1.1; }
  .purpose-gallery__scene figcaption p { max-width: 29rem; max-height: 0; margin-top: 0; overflow: hidden; color: var(--sky-100); font-size: clamp(.95rem, 1.3vw, 1.06rem); line-height: 1.5; opacity: 0; transform: translateY(.65rem); transition: max-height .45s ease, margin-top .35s ease, opacity .3s ease, transform .4s ease; }
  .purpose-gallery__scene:hover, .purpose-gallery__scene:focus-visible { box-shadow: 0 1.15rem 2.8rem rgba(23,55,70,.16); transform: translateY(-.25rem); }
  .purpose-gallery__scene:hover img, .purpose-gallery__scene:focus-visible img { filter: saturate(.82) contrast(1.02); transform: scale(1.035); }
  .purpose-gallery__scene:hover::after, .purpose-gallery__scene:focus-visible::after { background: linear-gradient(0deg, rgba(9,34,45,.95), rgba(9,34,45,.24) 72%); }
  .purpose-gallery__scene:hover figcaption p, .purpose-gallery__scene:focus-visible figcaption p { max-height: 8rem; margin-top: var(--space-3); opacity: 1; transform: translateY(0); }

  .principles-band { display: grid; min-height: 46rem; grid-template-areas: 'visual content'; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); color: var(--white); background: var(--navy-950); }
  .principles-band__visual { min-height: 46rem; margin: 0; overflow: hidden; grid-area: visual; background: var(--slate-200); }
  .principles-band__visual img { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: saturate(.72) contrast(.98); }
  .principles-band__content { display: grid; padding: var(--section-standard) max(var(--gutter), calc((100vw - var(--max)) / 2)) var(--section-standard) clamp(3rem, 6vw, 6.5rem); grid-area: content; align-content: center; }
  .principles-band__content header { display: grid; max-width: 38rem; gap: var(--space-4); }
  .principles-band .eyebrow { color: var(--accent-on-dark); }
  .principles-band h2 { max-width: 12ch; color: var(--white); }
  .principles-band__content header > p:last-child { color: var(--sky-100); font-size: 1.08rem; line-height: 1.6; }
  .principles-band ul { display: grid; max-width: 40rem; margin: var(--space-8) 0 0; padding: 0; gap: var(--space-6); list-style: none; }
  .principles-band li { display: grid; grid-template-columns: 3.3rem minmax(0, 1fr); gap: var(--space-4); align-items: start; }
  .principles-band__icon { width: 3.3rem; height: 3.3rem; }
  .principles-band__icon :global(svg) { width: 1.5rem; height: 1.5rem; stroke-width: 1.65; }
  .principles-band h3 { margin-bottom: var(--space-2); color: var(--white); }
  .principles-band li p { max-width: 33rem; color: var(--sky-200); line-height: 1.55; }

  .founder-profile { padding-block: var(--section-standard); overflow: hidden; background: var(--paper); }
  .founder-profile__grid { display: grid; grid-template-areas: 'portrait content'; grid-template-columns: minmax(17rem, 22rem) minmax(0, 1fr); gap: clamp(var(--space-8), 9vw, 9rem); align-items: center; }
  .founder-profile__portrait { position: relative; z-index: 0; width: 100%; max-width: 22rem; aspect-ratio: 1 / 1; margin: 0; grid-area: portrait; }
  .founder-profile__portrait::before { position: absolute; z-index: -1; background: var(--teal-700); content: ''; inset: 2.25rem -2.25rem -2.25rem 2.25rem; }
  .founder-profile__portrait img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 32%; box-shadow: 0 1.15rem 2.75rem rgba(23,55,70,.16); }
  .founder-profile__content { display: grid; max-width: 43rem; grid-area: content; gap: var(--space-5); }
  .founder-profile__content h2 { max-width: 11ch; }
  .founder-profile__content > p:not(.eyebrow, .lead) { max-width: 40rem; }
  .founder-profile__highlights { display: grid; margin: var(--space-2) 0 0; padding: var(--space-5) 0; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); list-style: none; }
  .founder-profile__highlights li { display: grid; min-width: 0; grid-template-columns: 1.6rem minmax(0, 1fr); gap: var(--space-3); align-items: start; color: var(--navy-900); font-size: .94rem; font-weight: var(--weight-heading); line-height: 1.4; }
  .founder-profile__highlights :global(svg) { width: 1.4rem; height: 1.4rem; margin-top: .05rem; color: var(--teal-700); stroke-width: 1.65; }
  .founder-profile .button { width: fit-content; margin-top: var(--space-2); gap: var(--button-gap); }
  .founder-profile .button :global(svg) { width: 1rem; height: 1rem; }

  .governance-section { padding-block: var(--section-standard); background: var(--sky-50); }
  .governance-section__intro { display: grid; grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr); gap: clamp(var(--space-7), 8vw, 8rem); align-items: center; }
  .governance-section__intro > div { display: grid; gap: var(--space-4); }
  .governance-section__intro h2 { max-width: 15ch; }
  .governance-section__intro .lead { max-width: 42rem; }
  .governance-section__stage { display: grid; margin-top: clamp(var(--space-8), 7vw, var(--space-10)); gap: clamp(var(--space-6), 4vw, var(--space-8)); }
  .board-preview { display: grid; min-height: 32rem; overflow: hidden; grid-template-areas: 'visual content'; grid-template-columns: minmax(0, 1.06fr) minmax(0, .94fr); color: var(--white); background: var(--navy-900); box-shadow: 0 1.25rem 3.25rem rgba(23,55,70,.14); }
  .board-preview__content { display: flex; min-width: 0; padding: clamp(var(--space-7), 5vw, var(--space-9)); grid-area: content; flex-direction: column; align-items: flex-start; justify-content: center; }
  .board-preview .eyebrow { color: var(--accent-on-image); }
  .board-preview h3, .records-preview h3 { max-width: 13ch; margin-top: var(--space-3); font-size: var(--type-section-medium); font-weight: var(--weight-heading); letter-spacing: -.02em; line-height: 1.08; }
  .board-preview h3 { color: var(--white); }
  .board-preview__content > p:not(.eyebrow) { max-width: 32rem; margin-top: var(--space-4); color: var(--sky-100); font-size: 1.03rem; line-height: 1.58; }
  .board-preview__roster { display: grid; width: 100%; max-width: 32rem; margin-top: var(--space-7); grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6); }
  .board-preview__roster div { display: grid; gap: .2rem; }
  .board-preview__roster strong { color: var(--white); font-size: 1.04rem; font-weight: var(--weight-heading); }
  .board-preview__roster span { color: var(--text-muted-on-dark); font-size: .9rem; line-height: 1.35; }
  .board-preview .button { margin-top: var(--space-7); gap: var(--button-gap); }
  .board-preview__visual { position: relative; min-height: 100%; margin: 0; overflow: hidden; grid-area: visual; background: var(--navy-950); }
  .board-preview__visual::after { position: absolute; background: linear-gradient(0deg, rgba(9,34,45,.82), rgba(9,34,45,.03) 58%); content: ''; inset: 0; }
  .board-preview__visual img { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: saturate(.78) contrast(.99); }
  .board-preview__visual figcaption { position: absolute; z-index: 1; right: var(--space-5); bottom: var(--space-5); left: var(--space-5); color: var(--text-muted-on-dark); font-size: .8rem; font-weight: var(--weight-heading); letter-spacing: .08em; text-transform: uppercase; }
  .records-preview { min-width: 0; background: var(--paper); box-shadow: 0 1.15rem 3rem rgba(23,55,70,.1); }
  .records-preview__content { display: grid; padding: clamp(var(--space-6), 4vw, var(--space-8)); grid-template-columns: minmax(13rem, .82fr) minmax(0, 1.55fr) auto; gap: clamp(var(--space-6), 4vw, var(--space-8)); align-items: center; }
  .records-preview__content header { display: grid; gap: var(--space-3); }
  .records-preview h3 { color: var(--navy-900); }
  .records-preview__proof { display: grid; width: 100%; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }
  .records-preview__proof > div { display: grid; min-width: 0; justify-items: center; gap: var(--space-3); text-align: center; }
  .records-preview__proof :global(svg) { width: 1.45rem; height: 1.45rem; padding: .7rem; box-sizing: content-box; border-radius: 50%; color: var(--teal-700); background: var(--sky-100); stroke-width: 1.65; }
  .records-preview__proof span { display: grid; color: var(--slate-600); font-size: .9rem; line-height: 1.3; }
  .records-preview__proof strong { color: var(--navy-900); font-size: .98rem; font-weight: var(--weight-heading); }
  .records-preview .button { white-space: nowrap; gap: var(--button-gap); }
  .board-preview .button :global(svg), .records-preview .button :global(svg) { width: 1rem; height: 1rem; }

  @media (max-width: 900px) {
    .about-hero { min-height: 31rem; }
    .about-hero__shade { background: linear-gradient(90deg, rgba(9,34,45,.96) 0%, rgba(9,34,45,.86) 56%, rgba(9,34,45,.42) 100%); }
    .purpose-section__intro, .governance-section__intro { grid-template-columns: 1fr; gap: var(--space-7); }
    .purpose-section__copy { max-width: 44rem; }
    .purpose-gallery { height: 20rem; grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .principles-band { min-height: 0; grid-template-areas: 'content' 'visual'; grid-template-columns: 1fr; }
    .principles-band__visual { min-height: 0; aspect-ratio: 16 / 9; }
    .principles-band__content { padding: var(--section-standard) var(--gutter); }
    .principles-band ul { grid-template-columns: repeat(3, minmax(0, 1fr)); max-width: none; gap: var(--space-6); }
