---
import { Icon } from 'astro-icon/components';
import MainLayout from '../layouts/MainLayout.astro';
import { susanRua } from '../data/leadership';

const commitments = [
  {
    number: '01',
    title: 'Dignity',
    copy: 'People in recovery deserve to be treated as adults, neighbors, and whole human beings.',
  },
  {
    number: '02',
    title: 'Accountability',
    copy: 'Clear expectations and shared responsibility help protect the stability of each home.',
  },
  {
    number: '03',
    title: 'Community',
    copy: 'Peer connection and outside partnerships help recovery extend beyond the walls of a residence.',
  },
];
---

<MainLayout
  title="About"
  description="Learn about the mission, leadership, nonprofit governance, and recovery-housing purpose of New Beginnings Transitional Living Foundation."
>
  <section class="about-hero">
    <div class="container about-hero__grid">
      <div class="about-hero__copy">
        <p class="eyebrow">About New Beginnings</p>
        <h1>A Pittsburgh nonprofit with a practical purpose.</h1>
        <p class="lead">
          New Beginnings gives adults in recovery a stable place to strengthen the routines,
          skills, and connections that support lasting change.
        </p>
        <div class="actions">
          <a class="button" href="/recovery-housing/">
            Explore recovery housing
            <Icon name="lucide:arrow-right" aria-hidden="true" />
          </a>
          <a class="about-hero__link" href="/about/transparency/">Review our standing</a>
        </div>
      </div>
      <figure class="about-hero__figure">
        <img
          src="/images/pittsburgh.jpg"
          alt="The Pittsburgh skyline and rivers"
          width="1880"
          height="1253"
          loading="eager"
        />
      </figure>
    </div>
  </section>

  <section class="section mission">
    <div class="container mission__grid">
      <header>
        <p class="eyebrow">Our purpose</p>
        <h2>Housing, support, and a foundation for independence.</h2>
      </header>
      <div class="mission__copy">
        <p class="lead">
          New Beginnings Transitional Living Foundation provides transitional sober housing
          in a supportive, peer-driven environment.
        </p>
        <p>
          Residents work on establishing a solid foundation of recovery, developing positive
          life skills, and staying connected to independent licensed drug, alcohol, and
          mental-health providers.
        </p>
        <p>
          Founded in Pittsburgh in 2016, the organization has grown around a practical idea:
          recovery housing is not clinical treatment, but it can be the stable daily
          environment where routines, responsibilities, relationships, and individual goals
          continue to take shape.
        </p>
      </div>
    </div>
  </section>

  <section class="commitments">
    <div class="commitments__visual">
      <img
        src="/images/home-entry.webp"
        alt="A welcoming home entry and staircase"
        width="2200"
        height="1467"
        loading="lazy"
      />
    </div>
    <div class="commitments__content">
      <div class="commitments__inner">
        <header>
          <p class="eyebrow">What guides the work</p>
          <h2>Principles carried into daily life.</h2>
          <p>
            A stable residence is shaped by how people are treated, what everyone can count
            on, and how responsibility is shared.
          </p>
        </header>
        <ol>
          {commitments.map((commitment) => (
            <li>
              <span>{commitment.number}</span>
              <div>
                <h3>{commitment.title}</h3>
                <p>{commitment.copy}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  {susanRua && (
    <section class="section founder">
      <div class="container founder__grid">
        <div class="founder__identity">
          <p class="eyebrow">President and founder</p>
          <h2>{susanRua.name}</h2>
          {susanRua.credentials && <p class="founder__credentials">{susanRua.credentials.join(' · ')}</p>}
        </div>
        <div class="founder__copy">
          {susanRua.summary && <p class="lead">{susanRua.summary}</p>}
          <p>
            Her background connects professional counseling, nursing, and the practical work
            of operating sober-living homes. That perspective informs an organization built
            around stable housing, clear expectations, and connection to recovery support.
          </p>
          <a class="text-link" href="/about/susan-rua/">Meet Susan Rua</a>
        </div>
      </div>
    </section>
  )}

  <section class="governance-band">
    <div class="container governance-band__grid">
      <div>
        <p class="eyebrow">Nonprofit governance</p>
        <h2>Accountability extends beyond the homes.</h2>
      </div>
      <div>
        <p class="lead">
          A volunteer Board of Directors provides stewardship and oversight of the New
          Beginnings mission and its nonprofit responsibilities.
        </p>
        <nav class="governance-band__links" aria-label="Governance information">
          <a href="/about/board/">
            <span>Board and governance</span>
            <Icon name="lucide:arrow-up-right" aria-hidden="true" />
          </a>
          <a href="/about/transparency/">
            <span>Credentials and public records</span>
            <Icon name="lucide:arrow-up-right" aria-hidden="true" />
          </a>
        </nav>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .about-hero { background: var(--sky-50); }
  .about-hero__grid { display: grid; min-height: clamp(35rem, 52vw, 43rem); grid-template-columns: minmax(0, .88fr) minmax(0, 1.12fr); align-items: stretch; }
  .about-hero__copy { display: grid; padding: var(--section-hero) clamp(var(--space-6), 5vw, var(--space-9)) var(--section-hero) 0; align-content: center; gap: var(--space-5); }
  .about-hero h1 { max-width: 11ch; font-size: clamp(3rem, 5.7vw, 5.35rem); }
  .about-hero .lead { max-width: 38rem; }
  .about-hero .button { gap: var(--space-2); }
  .about-hero .button :global(svg) { width: 1rem; height: 1rem; }
  .about-hero__link { color: var(--navy-900); font-weight: 650; }
  .about-hero__figure { min-height: 100%; margin: 0 calc((100vw - min(100vw - (var(--gutter) * 2), var(--max))) / -2) 0 0; overflow: hidden; background: var(--slate-200); box-shadow: -1.25rem 1.5rem 3.5rem rgba(23, 55, 70, .11); }
  .about-hero__figure img { width: 100%; height: 100%; object-fit: cover; object-position: 52% center; }

  .mission__grid, .founder__grid, .governance-band__grid { display: grid; grid-template-columns: minmax(0, .78fr) minmax(0, 1.22fr); gap: clamp(var(--space-7), 8vw, 8rem); align-items: start; }
  .mission header, .founder__identity, .governance-band__grid > div:first-child { display: grid; gap: var(--space-4); }
  .mission h2 { max-width: 13ch; }
  .mission__copy, .founder__copy { max-width: var(--measure); }
  .mission__copy p + p, .founder__copy p + p { margin-top: var(--space-5); }

  .commitments { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); background: var(--paper); }
  .commitments__visual { min-height: 43rem; overflow: hidden; background: var(--slate-200); }
  .commitments__visual img { width: 100%; height: 100%; object-fit: cover; }
  .commitments__content { display: grid; padding: var(--section-standard) var(--gutter); align-items: center; }
  .commitments__inner { width: min(100%, 38rem); margin-inline: auto; }
  .commitments header { display: grid; gap: var(--space-4); margin-bottom: var(--space-7); }
  .commitments h2 { max-width: 13ch; }
  .commitments ol { margin: 0; padding: 0; border-top: 1px solid var(--slate-300); list-style: none; }
  .commitments li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: var(--space-4); padding-block: var(--space-5); border-bottom: 1px solid var(--slate-300); }
  .commitments li > span { color: var(--teal-700); font-size: .8rem; font-weight: 650; letter-spacing: .12em; }
  .commitments h3 { margin-bottom: var(--space-2); }

  .founder { background: var(--canvas); }
  .founder__credentials { color: var(--teal-700); font-size: .9rem; font-weight: 650; letter-spacing: .1em; }
  .founder .text-link { margin-top: var(--space-6); }

  .governance-band { padding-block: clamp(var(--space-8), 7vw, var(--space-9)); color: var(--white); background: var(--navy-950); }
  .governance-band h2 { max-width: 14ch; color: var(--white); }
  .governance-band .eyebrow { color: #9ed7d2; }
  .governance-band .lead { color: var(--sky-100); }
  .governance-band__links { display: grid; margin-top: var(--space-6); border-top: 1px solid rgba(255,255,255,.24); }
  .governance-band__links a { display: flex; padding-block: var(--space-4); border-bottom: 1px solid rgba(255,255,255,.24); align-items: center; justify-content: space-between; gap: var(--space-4); color: var(--white); font-weight: 650; }
  .governance-band__links a:hover { color: #9ed7d2; }
  .governance-band__links :global(svg) { width: 1.1rem; height: 1.1rem; }

  @media (max-width: 800px) {
    .about-hero__grid { min-height: 0; grid-template-columns: 1fr; }
    .about-hero__figure { height: clamp(17rem, 58vw, 26rem); margin: 0 calc(var(--gutter) * -1); order: -1; box-shadow: none; }
    .about-hero__copy { padding-block: var(--space-8); padding-right: 0; }
    .mission__grid, .founder__grid, .governance-band__grid { grid-template-columns: 1fr; }
    .commitments { grid-template-columns: 1fr; }
    .commitments__visual { min-height: 0; aspect-ratio: 4 / 3; }
    .commitments__content { padding-block: var(--space-8); }
  }

  @media (max-width: 520px) {
    .about-hero__copy { padding-block: var(--space-7); }
    .about-hero h1 { font-size: clamp(2.75rem, 13vw, 3.65rem); }
    .about-hero__figure { height: 16rem; }
    .commitments__content { padding: var(--space-7) var(--gutter); }
  }
</style>
