---
import MainLayout from '../layouts/MainLayout.astro'; import PageHero from '../components/PageHero.astro'; import InquiryForm from '../components/InquiryForm.astro'; import IconBadge from '../components/IconBadge.astro';
---
<MainLayout title="About"><PageHero eyebrow="About us" title="Recovery housing with a practical purpose." intro="New Beginnings exists to give adults in recovery a stable place to strengthen the routines, skills, and connections that support lasting change." image="/images/pittsburgh.jpg" imageAlt="The Pittsburgh skyline and rivers" />
<section class="section"><div class="container grid-2"><div><p class="eyebrow">Our mission</p><h2>Housing, support, and a foundation for independence.</h2></div><div><p class="lead">New Beginnings Transitional Living Foundation provides transitional sober housing in a supportive, peer-driven environment.</p><p>Residents work on establishing a solid foundation of recovery, developing positive life skills, and staying connected to independent licensed drug, alcohol, and mental-health providers.</p><p>The organization was established in Pittsburgh and is led by Susan Rua, a licensed professional counselor who has specialized in substance use and recovery since 1999.</p></div></div></section>
<section class="section section--tint"><div class="container"><div class="section-head"><p class="eyebrow">Our commitments</p><h2>What guides the work</h2></div><div class="grid-3"><article class="card"><IconBadge name="heart" /><h3>Dignity</h3><p>People in recovery deserve to be treated as adults, neighbors, and whole human beings.</p></article><article class="card"><IconBadge name="scale" /><h3>Accountability</h3><p>Stable homes depend on clear expectations, shared responsibility, and consistent follow-through.</p></article><article class="card"><IconBadge name="network" /><h3>Community</h3><p>Peer connection and strong outside partnerships help recovery extend beyond the walls of a house.</p></article></div><div class="board-link"><a class="button button--outline" href="/board/">Meet the board</a></div></div></section><InquiryForm /></MainLayout>
<style>.board-link { margin-top: 2rem; }</style>
