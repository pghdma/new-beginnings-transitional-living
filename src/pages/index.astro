---
import { Icon } from 'astro-icon/components';
import MainLayout from '../layouts/MainLayout.astro';
import { site } from '../data/site';

const foundations = [
  {
    icon: 'shield-check',
    title: 'A House Where Nobody Uses',
    copy: 'Every house is substance free, with random drug screens. That’s what keeps the house safe for everyone living in it.',
  },
  {
    icon: 'users-round',
    title: 'People Who Get It',
    copy: 'Your housemates are in recovery too. The person across the kitchen table has been where you are, and that counts for a lot.',
  },
  {
    icon: 'list-checks',
    title: 'Structure You Can Lean On',
    copy: 'House rules, a weekly house meeting, chores, and a curfew give your days a shape while you rebuild the rest.',
  },
];

const dailyLife = [
  { icon: 'briefcase-business', title: 'Work and School' },
  { icon: 'users', title: 'Meetings and Sponsors' },
  { icon: 'list-checks', title: 'Chores and House Meeting' },
  { icon: 'calendar-check', title: 'Appointments and Court' },
];

const firstConversation = [
  { number: '01', title: 'Call or Apply', copy: `Call ${site.phone} or send the short application. Tell us whether you’re asking about the men’s houses or the women’s house.` },
  { number: '02', title: 'We Talk', copy: 'We call you back, ask a few questions, and tell you what’s open, what it costs, and what the house expects.' },
  { number: '03', title: 'Move In', copy: 'If it’s a fit and a bed is open, you get the address, the move-in list, and a date.' },
];

const trustPoints = [
  { icon: 'heart-handshake', title: '501(c)(3)', copy: 'Pittsburgh public charity' },
  { icon: 'badge-check', title: 'Pennsylvania DDAP', copy: 'Licensed recovery houses' },
  { icon: 'shield-check', title: 'WestPARR', copy: 'Certified member' },
];
---

<MainLayout
  title={site.shortName}
  description={site.description}
>
  <section class="home-hero">
    <img class="home-hero__image" src="/images/house-living-room.webp" alt="" width="2200" height="1467" fetchpriority="high" />
    <div class="home-hero__shade" aria-hidden="true"></div>
    <div class="container home-hero__inner">
      <div class="home-hero__copy">
        <p class="eyebrow">Nonprofit Sober Living in Pittsburgh</p>
        <h1>Recovery Housing in Pittsburgh for Men and Women</h1>
        <p class="lead">Safe, substance-free homes where staying sober is the normal thing to do. Licensed by Pennsylvania, run by a counselor who has done this since 1999. You don’t need to have it all figured out to call.</p>
        <div class="actions home-hero__actions">
          <a class="button" href="/admissions/">Ask About a Bed<Icon name="lucide:arrow-right" aria-hidden="true" /></a>
          <a class="button button--outline" href={site.phoneHref}><Icon name="lucide:phone" aria-hidden="true" />Call {site.phone}</a>
        </div>
        <p class="home-hero__location"><Icon name="lucide:map-pin" aria-hidden="true" />Houses in Sheraden, Observatory Hill, Brighton Heights, McKees Rocks, and Bellevue. Office in Mt. Washington.</p>
      </div>
    </div>
  </section>

  <section class="purpose-section" id="purpose">
    <div class="container purpose-layout">
      <header class="purpose-heading">
        <p class="eyebrow">Why Recovery Housing</p>
        <h2>Getting Sober Is One Thing. <span>Staying Sober Is Another</span></h2>
        <figure class="purpose-photo">
          <img src="/images/home-entry.webp" alt="A welcoming home entry and staircase" width="2200" height="1467" loading="lazy" />
        </figure>
      </header>
      <div class="purpose-content">
        <p class="lead">Treatment ends. Then you need somewhere to live where staying clean is the normal thing to do. That’s what a recovery house is for.</p>
        <p>New Beginnings runs sober living homes for adults in Pittsburgh who are done using and want a real shot at keeping it that way. The houses are AA and NA based. You live with other people doing the same work, you go to meetings, you keep a job or go to school, and you come home to a house where nobody is using.</p>
        <ul class="foundation-list">
          {foundations.map((item) => (
            <li>
              <Icon name={`lucide:${item.icon}`} aria-hidden="true" />
              <div><h3>{item.title}</h3><p>{item.copy}</p></div>
            </li>
          ))}
        </ul>
        <a class="button button--outline purpose-action" href="/recovery-housing/">How Our Houses Work<Icon name="lucide:arrow-right" aria-hidden="true" /></a>
      </div>
    </div>
  </section>

  <section class="housing-section" id="housing">
    <div class="container">
      <header class="housing-heading">
        <div>
          <p class="eyebrow">Our Homes</p>
          <h2>Houses for Men in Four Neighborhoods. One House for Women</h2>
        </div>
        <p>New Beginnings runs separate sober living homes for men and women in established Pittsburgh neighborhoods. Every house is licensed by the Pennsylvania Department of Drug and Alcohol Programs and certified by WestPARR.</p>
      </header>

      <div class="housing-paths">
        <a class="housing-path" href="/recovery-housing/men/">
          <img src="/images/home-entry.webp" alt="" width="2200" height="1467" loading="lazy" />
          <span class="housing-path__shade"></span>
          <span class="housing-path__content">
            <span class="housing-path__label">For men</span>
            <h3>Men’s Recovery Housing</h3>
            <span class="housing-path__copy">Houses in McKees Rocks, Observatory Hill, Brighton Heights, and Sheraden, including one that works with men on parole.</span>
            <span class="housing-path__action">See the Men’s Houses<Icon name="lucide:arrow-up-right" aria-hidden="true" /></span>
          </span>
        </a>
        <a class="housing-path" href="/recovery-housing/women/">
          <img src="/images/shared-bedroom.webp" alt="" width="2200" height="1466" loading="lazy" />
          <span class="housing-path__shade"></span>
          <span class="housing-path__content">
            <span class="housing-path__label">For women</span>
            <h3>Women’s Recovery Housing</h3>
            <span class="housing-path__copy">One house in Bellevue, with the privacy and support that matter.</span>
            <span class="housing-path__action">See the Women’s House<Icon name="lucide:arrow-up-right" aria-hidden="true" /></span>
          </span>
        </a>
      </div>

      <aside class="housing-facts" aria-label="Where we serve, who we serve, and who runs it">
        <div class="housing-fact">
          <span class="housing-fact__icon icon-medallion icon-medallion--sm icon-medallion--dark"><Icon name="lucide:map-pin" aria-hidden="true" /></span>
          <div>
            <span class="housing-fact__label">Where</span>
            <h3>Pittsburgh’s North Side and West End</h3>
            <p>Houses in Sheraden, Observatory Hill, Brighton Heights, McKees Rocks, and Bellevue, on bus lines and a short ride from downtown.</p>
          </div>
        </div>
        <div class="housing-fact">
          <span class="housing-fact__icon icon-medallion icon-medallion--sm icon-medallion--dark"><Icon name="lucide:users-round" aria-hidden="true" /></span>
          <div>
            <span class="housing-fact__label">Who</span>
            <h3>Adults 18 and Older</h3>
            <p>Men and women who are done using and willing to live by the house rules. No referral required.</p>
          </div>
        </div>
        <div class="housing-fact">
          <span class="housing-fact__icon icon-medallion icon-medallion--sm icon-medallion--dark"><Icon name="lucide:badge-check" aria-hidden="true" /></span>
          <div>
            <span class="housing-fact__label">Who runs it</span>
            <h3>A Counselor Who Has Done This Since 1999</h3>
            <p>Founded in Pittsburgh in 2016 by Susan Rua, CADC, MSPC, LPC. Licensed by Pennsylvania and certified by WestPARR.</p>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="daily-section" id="daily-life">
    <div class="daily-layout">
      <div class="daily-content">
        <div class="daily-content__inner">
          <p class="eyebrow">A Normal Week</p>
          <h2>Most of Recovery Is Just a Normal Week</h2>
          <p class="lead">The house gives you a place to come back to. The rest of the day is yours: work, school, meetings, court dates, family, and everything else that goes into a normal week.</p>
          <ul class="daily-list">
            {dailyLife.map((item) => (
              <li><Icon name={`lucide:${item.icon}`} aria-hidden="true" /><span>{item.title}</span></li>
            ))}
          </ul>
          <p class="daily-scope">New Beginnings is housing, not treatment. If you’re in counseling, on medication, or seeing a doctor, you keep doing that with your own providers. We make sure you have a stable place to live while you do.</p>
        </div>
      </div>
      <figure class="daily-photo">
        <img src="/images/house-kitchen.webp" alt="A kitchen and dining table in a welcoming home" width="2200" height="1467" loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="trust-section" id="credentials">
    <div class="container">
      <div class="trust-intro">
        <header>
          <p class="eyebrow">Who Is Behind This</p>
          <h2>Run by a Counselor Who Has Done This Since 1999</h2>
        </header>
        <div class="trust-intro__copy">
          <p class="lead">I’m Susan Rua. I’ve worked in addiction counseling since 1999, and I’ve owned and run sober living homes in Pittsburgh for more than ten years. I started New Beginnings because people leaving treatment needed somewhere decent to go, and there weren’t enough of those places.</p>
          <p>New Beginnings is a Pittsburgh 501(c)(3) public charity. Our houses are licensed by Pennsylvania DDAP and certified by WestPARR, and you can check all of that yourself.</p>
          <div class="actions trust-section__actions">
            <a class="button" href="/about/board/#susan-rua">Meet Susan<Icon name="lucide:arrow-right" aria-hidden="true" /></a>
            <a class="button button--outline" href="/about/transparency/">Check Our Credentials</a>
          </div>
        </div>
      </div>

      <figure class="trust-panorama">
        <img src="/images/pittsburgh-point-panorama.webp" alt="Point State Park and the Pittsburgh skyline viewed across the three rivers" width="2400" height="680" loading="lazy" />
      </figure>

      <ul class="trust-points" aria-label="New Beginnings credentials">
        {trustPoints.map((item) => (
          <li>
            <Icon name={`lucide:${item.icon}`} aria-hidden="true" />
            <span><strong>{item.title}</strong><small>{item.copy}</small></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="conversation-section" id="start-a-conversation">
    <div class="container conversation-layout">
      <div class="conversation-content">
        <p class="eyebrow">Getting In</p>
        <h2>Start With a Phone Call</h2>
        <p>You don’t need a referral, and you don’t need to be coming straight from treatment. Call, or send the short application, and we’ll talk. Keep medical and legal details off the website. We’ll ask for what we need.</p>
        <ol class="conversation-steps">
          {firstConversation.map((step) => (
            <li>
              <span>{step.number}</span>
              <div><h3>{step.title}</h3><p>{step.copy}</p></div>
            </li>
          ))}
        </ol>
        <div class="actions conversation-actions">
          <a class="button button--light" href="/admissions/">Apply for Housing<Icon name="lucide:arrow-right" aria-hidden="true" /></a>
          <a class="button button--outline-light" href={site.phoneHref}><Icon name="lucide:phone" aria-hidden="true" />Call {site.phone}</a>
        </div>
        <p class="conversation-secondary">Referring a client? <a class="inline-link" href="/referrals/">See the professionals page</a>. Want to help? <a class="inline-link" href="/support-us/">Support the houses</a>.</p>
      </div>
      <figure class="conversation-photo">
        <img src="/images/admissions.jpg" alt="Notebooks and coffee arranged around a shared table" width="1880" height="1245" loading="lazy" />
      </figure>
    </div>
  </section>
</MainLayout>
<style>
  .home-hero { position: relative; display: grid; min-height: clamp(42rem,calc(100svh - var(--header-total-height)),50rem); overflow: hidden; align-items: center; color: var(--white); background: var(--navy-950); }
  .home-hero__image, .home-hero__shade { position: absolute; width: 100%; height: 100%; inset: 0; }
  .home-hero__image { object-fit: cover; object-position: 54% 62%; }
  .home-hero__shade { background: linear-gradient(90deg,rgba(9,34,45,.97) 0%,rgba(9,34,45,.91) 35%,rgba(9,34,45,.69) 57%,rgba(9,34,45,.26) 82%,rgba(9,34,45,.12) 100%); }
  .home-hero__inner { position: relative; z-index: 1; padding-block: clamp(5rem,9vw,8rem); }
  .home-hero__copy { max-width: 48rem; }
  .home-hero .eyebrow { color: var(--accent-on-image); }
  .home-hero h1 { max-width: 26ch; margin-top: var(--space-4); color: var(--white); font-size: var(--type-display-home); font-weight: var(--weight-heading); }
  .home-hero .lead { max-width: 39rem; margin-top: var(--space-5); color: var(--text-on-dark); }
  .home-hero__actions { margin-top: var(--space-6); }
  .home-hero__actions .button { gap: var(--button-gap); }
  .home-hero__actions :global(svg) { width: 1.05rem; height: 1.05rem; }
  .home-hero__actions .button--outline { border-color: rgba(255,255,255,.78); color: var(--white); background: rgba(9,34,45,.24); }
  .home-hero__actions .button--outline:hover { color: var(--navy-950); background: var(--white); }
  .home-hero__location { display: flex; max-width: 34rem; margin-top: var(--space-7); align-items: flex-start; gap: var(--button-gap); color: var(--text-muted-on-dark); font-size: .93rem; line-height: 1.45; }
  .home-hero__location :global(svg) { width: 1.15rem; height: 1.15rem; margin-top: .1rem; color: var(--accent-on-image); flex: 0 0 auto; }

  .purpose-section { padding-block: var(--section-standard); background: var(--canvas); }
  .purpose-layout { display: grid; grid-template-columns: minmax(0,.78fr) minmax(0,1.22fr); gap: clamp(3rem,8vw,8rem); align-items: start; }
  .purpose-heading { position: sticky; top: var(--sticky-offset); }
  .purpose-heading h2 { max-width: 24ch; margin-top: var(--space-4); }
  .purpose-heading h2 span { display: block; color: var(--teal-700); }
  .purpose-photo { position: relative; aspect-ratio: 4 / 3; margin: var(--space-7) 0 0; overflow: hidden; background: var(--slate-200); box-shadow: 0 1.4rem 3.5rem rgba(23,55,70,.16); }
  .purpose-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: saturate(.86) contrast(.97); }
  .purpose-content { max-width: 46rem; }
  .purpose-content > p + p { margin-top: var(--space-5); }
  .foundation-list { display: grid; margin: var(--space-7) 0 0; padding: 0; gap: var(--space-6); list-style: none; }
  .foundation-list li { display: grid; grid-template-columns: 2.35rem minmax(0,1fr); gap: var(--space-4); align-items: start; }
  .foundation-list > li > :global(svg) { width: 2rem; height: 2rem; color: var(--teal-700); stroke-width: 1.55; }
  .foundation-list h3 { font-size: 1.25rem; }
  .foundation-list p { max-width: 39rem; margin-top: .45rem; color: var(--slate-600); line-height: 1.5; }
  .purpose-action { margin-top: var(--space-7); gap: var(--button-gap); }
  .purpose-action :global(svg) { width: 1.05rem; height: 1.05rem; }

  .housing-section { padding-block: var(--section-standard); color: var(--white); background: var(--navy-950); }
  .housing-heading { display: grid; margin-bottom: var(--space-7); grid-template-columns: minmax(0,1.05fr) minmax(20rem,.95fr); gap: var(--gap-columns); align-items: center; }
  .housing-heading .eyebrow { color: var(--accent-on-dark); }
  .housing-heading h2 { max-width: 36ch; margin-top: var(--space-4); color: var(--white); }
  .housing-heading > p { max-width: 34rem; color: var(--sky-100); font-size: 1.15rem; }
  .housing-paths { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: var(--space-5); }
  .housing-path { position: relative; min-height: 34rem; overflow: hidden; color: var(--white); background: var(--navy-900); box-shadow: 0 1.5rem 3.5rem rgba(4,24,32,.28); }
  .housing-path:hover { color: var(--white); }
  .housing-path > img, .housing-path__shade { position: absolute; width: 100%; height: 100%; inset: 0; }
  .housing-path > img { object-fit: cover; transition: transform .4s ease; }
  .housing-path:first-child > img { object-position: 48% center; }
  .housing-path:last-child > img { object-position: 52% center; }
  .housing-path:hover > img { transform: scale(1.025); }
  .housing-path__shade { background: linear-gradient(0deg,rgba(10,35,46,.96) 0%,rgba(10,35,46,.7) 38%,rgba(10,35,46,.12) 76%); }
  .housing-path__content { position: absolute; display: flex; padding: clamp(1.75rem,4vw,2.5rem); inset: auto 0 0; flex-direction: column; align-items: flex-start; }
  .housing-path__label { color: var(--accent-on-image); font-size: .76rem; font-weight: var(--weight-semibold); letter-spacing: .12em; text-transform: uppercase; }
  .housing-path__content > h3 { min-height: 2.1em; max-width: 30ch; margin-top: .45rem; color: var(--white); font-size: clamp(2rem,3.5vw,3rem); font-weight: var(--weight-heading); line-height: 1.05; }
  .housing-path__copy { min-height: 3em; max-width: 32rem; margin-top: var(--space-3); color: var(--sky-100); font-size: 1.05rem; line-height: 1.45; }
  .housing-path__action { display: inline-flex; min-height: 3.15rem; margin-top: var(--space-5); padding: .75rem 1rem; align-items: center; gap: var(--button-gap); color: var(--navy-950); background: var(--white); font-weight: var(--weight-semibold); line-height: 1; }
  .housing-path__action :global(svg) { width: 1rem; height: 1rem; }
  .housing-facts { display: grid; margin-top: var(--space-7); padding-top: var(--space-6); border-top: 1px solid rgba(255,255,255,.2); grid-template-columns: repeat(3,minmax(0,1fr)); }
  .housing-fact { display: grid; padding-inline: clamp(1.25rem,2.5vw,2.25rem); grid-template-columns: 2.8rem minmax(0,1fr); gap: var(--space-4); align-items: start; }
  .housing-fact:first-child { padding-left: 0; }
  .housing-fact:last-child { padding-right: 0; }
  .housing-fact + .housing-fact { border-left: 1px solid rgba(255,255,255,.16); }
  .housing-fact__icon { width: 2.8rem; height: 2.8rem; border-color: rgba(158,215,210,.62); background: transparent; }
  .housing-fact__icon :global(svg) { width: 1.35rem; height: 1.35rem; color: var(--accent-on-dark); stroke-width: 1.65; }
  .housing-fact__label { display: block; color: var(--accent-on-dark); font-size: .7rem; font-weight: var(--weight-semibold); letter-spacing: .11em; text-transform: uppercase; }
  .housing-fact h3 { margin-top: .35rem; color: var(--white); font-size: 1.08rem; line-height: 1.3; }
  .housing-fact p { margin-top: .5rem; color: var(--sky-100); font-size: .9rem; line-height: 1.5; }

  .daily-section { padding: 0; background: var(--paper); }
  .daily-layout { display: grid; grid-template-columns: minmax(0,.92fr) minmax(0,1.08fr); align-items: stretch; }
  .daily-content { display: grid; align-items: center; }
  .daily-content__inner { width: min(100%,40rem); margin-left: auto; padding: var(--section-standard) clamp(2.25rem,5vw,5rem); }
  .daily-content h2 { max-width: 24ch; margin-top: var(--space-4); font-size: clamp(2.1rem,3.6vw,3.25rem); font-weight: var(--weight-heading); line-height: 1.08; }
  .daily-content .lead { max-width: 34rem; margin-top: var(--space-6); font-size: clamp(1.08rem,1.6vw,1.25rem); line-height: 1.52; }
  .daily-photo { min-height: 42rem; margin: 0; overflow: hidden; }
  .daily-photo img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 54% center; filter: saturate(.88) contrast(.96); }
  .daily-list { display: grid; margin: var(--space-6) 0 0; padding: var(--space-5); grid-template-columns: repeat(2,minmax(0,1fr)); gap: var(--space-5) var(--space-6); background: var(--sky-50); list-style: none; }
  .daily-list li { display: grid; grid-template-columns: auto 1fr; gap: .7rem; align-items: center; color: var(--navy-900); font-size: .96rem; font-weight: var(--weight-heading); line-height: 1.35; }
  .daily-list :global(svg) { width: 1.45rem; height: 1.45rem; color: var(--teal-700); stroke-width: 1.6; }
  .daily-scope { max-width: 34rem; margin-top: var(--space-5); color: var(--slate-600); font-size: .95rem; line-height: 1.6; }

  .trust-section { padding-block: var(--section-standard); background: var(--sky-50); }
  .trust-intro { display: grid; grid-template-columns: minmax(0,.92fr) minmax(0,1.08fr); gap: var(--gap-columns); align-items: start; }
  .trust-section h2 { max-width: 25ch; margin-top: var(--space-4); font-size: clamp(2.1rem,3.5vw,3.4rem); }
  .trust-intro__copy { max-width: 42rem; padding-top: 1.8rem; }
  .trust-intro__copy .lead { color: var(--slate-700); }
  .trust-intro__copy > p + p { margin-top: var(--space-4); }
  .trust-section__actions { margin-top: var(--space-6); }
  .trust-section__actions .button { gap: var(--button-gap); }
  .trust-section__actions :global(svg) { width: 1.05rem; height: 1.05rem; }
  .trust-panorama { aspect-ratio: 60 / 17; margin: var(--space-8) 0 0; overflow: hidden; background: var(--slate-200); }
  .trust-panorama img { display: block; width: 100%; height: 100%; object-fit: cover; filter: saturate(.82) contrast(.98); }
  .trust-points { display: grid; margin: 0; padding: var(--space-6) 0; border-block: 1px solid var(--slate-300); grid-template-columns: repeat(3,minmax(0,1fr)); gap: clamp(1.25rem,3vw,2.5rem); list-style: none; }
  .trust-points li { display: flex; justify-content: center; align-items: center; gap: .8rem; }
  .trust-points :global(svg) { width: 1.75rem; height: 1.75rem; color: var(--teal-700); stroke-width: 1.6; }
  .trust-points strong, .trust-points small { display: block; }
  .trust-points strong { color: var(--navy-900); font-size: 1rem; font-weight: var(--weight-heading); line-height: 1.25; }
  .trust-points small { margin-top: .2rem; color: var(--slate-600); font-size: .84rem; line-height: 1.3; }

  .conversation-section { padding-block: var(--section-standard); background: var(--canvas); }
  .conversation-layout { display: grid; grid-template-areas: 'photo content'; grid-template-columns: minmax(0,.92fr) minmax(0,1.08fr); align-items: stretch; box-shadow: var(--shadow-raised); }
  .conversation-photo { min-height: 43rem; margin: 0; overflow: hidden; grid-area: photo; }
  .conversation-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .conversation-content { display: flex; padding: clamp(2.7rem,6vw,5rem); color: var(--white); background: var(--teal-800); flex-direction: column; justify-content: center; grid-area: content; }
  .conversation-content .eyebrow { color: var(--accent-on-dark-soft); }
  .conversation-content h2 { max-width: 24ch; margin-top: var(--space-4); color: var(--white); }
  .conversation-content > p:not(.eyebrow):not(.conversation-secondary) { max-width: 37rem; margin-top: var(--space-4); color: var(--text-on-dark); }
  .conversation-steps { display: grid; margin: var(--space-6) 0 0; padding: 0; gap: var(--space-5); list-style: none; }
  .conversation-steps li { display: grid; grid-template-columns: 2.4rem minmax(0,1fr); gap: var(--space-3); }
