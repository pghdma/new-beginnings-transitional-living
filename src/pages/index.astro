---
import { Icon } from 'astro-icon/components';
import MainLayout from '../layouts/MainLayout.astro';
import { site } from '../data/site';

const foundations = [
  {
    icon: 'house',
    title: 'A dependable home',
    copy: 'A substance-free shared environment creates a consistent place to return to each day.',
  },
  {
    icon: 'users-round',
    title: 'Shared accountability',
    copy: 'Clear expectations and peer community support the everyday responsibility recovery requires.',
  },
  {
    icon: 'heart-handshake',
    title: 'Connected support',
    copy: 'Residents remain connected to independent treatment and community recovery resources.',
  },
];

const dailyLife = [
  { icon: 'briefcase-business', title: 'Work and education' },
  { icon: 'calendar-check', title: 'Appointments and meetings' },
  { icon: 'list-checks', title: 'Shared responsibilities' },
  { icon: 'users', title: 'Peer and community connection' },
];

const firstConversation = [
  { number: '01', title: 'Reach out', copy: 'Call New Beginnings to begin a private, general conversation.' },
  { number: '02', title: 'Talk through the fit', copy: 'Discuss current availability and what you are looking for.' },
  { number: '03', title: 'Receive private next steps', copy: 'If appropriate, location and process details are shared directly.' },
];

const trustPoints = [
  { icon: 'heart-handshake', title: '501(c)(3)', copy: 'Public charity' },
  { icon: 'badge-check', title: 'Pennsylvania DDAP', copy: 'Licensed residences' },
  { icon: 'shield-check', title: 'WestPARR', copy: 'Inspected recovery housing' },
];
---

<MainLayout
  title={site.shortName}
  description="Nonprofit recovery housing for adult men and women in Pittsburgh, grounded in peer support, accountability, and connection to independent recovery resources."
>
  <section class="home-hero">
    <img class="home-hero__image" src="/images/hero-community.jpg" alt="" width="1880" height="1253" fetchpriority="high" />
    <div class="home-hero__shade" aria-hidden="true"></div>
    <div class="container home-hero__inner">
      <div class="home-hero__copy">
        <p class="eyebrow">Nonprofit recovery housing in Pittsburgh</p>
        <h1>A stable place to build what comes next.</h1>
        <p class="lead">Structured recovery residences for adult men and women, grounded in peer support, accountability, and connection to independent recovery resources.</p>
        <div class="actions home-hero__actions">
          <a class="button" href="/admissions/">Ask about housing<Icon name="lucide:arrow-right" aria-hidden="true" /></a>
          <a class="button button--outline" href="/referrals/">For professionals</a>
        </div>
        <p class="home-hero__location"><Icon name="lucide:map-pin" aria-hidden="true" />Serving Pittsburgh and surrounding Allegheny County communities</p>
      </div>
    </div>
  </section>

  <section class="purpose-section">
    <div class="container purpose-layout">
      <header class="purpose-heading">
        <p class="eyebrow">Recovery happens in daily life</p>
        <h2>A home that supports <span>what happens next.</span></h2>
        <figure class="purpose-photo">
          <img src="/images/community-table.jpg" alt="Chairs gathered around a shared table" width="1880" height="1253" loading="lazy" />
        </figure>
      </header>
      <div class="purpose-content">
        <p class="lead">Recovery takes more than a roof. A dependable home can make room for routines, responsibility, connection, and the work of moving forward.</p>
        <p>New Beginnings provides substance-free shared housing shaped by an AA/NA-based recovery culture. Residents can live alongside peers while continuing work, education, appointments, independent treatment, meetings, and responsibilities beyond the home.</p>
        <ul class="foundation-list">
          {foundations.map((item) => (
            <li>
              <Icon name={`lucide:${item.icon}`} aria-hidden="true" />
              <div><h3>{item.title}</h3><p>{item.copy}</p></div>
            </li>
          ))}
        </ul>
        <a class="button button--outline purpose-action" href="/recovery-housing/">How recovery housing works<Icon name="lucide:arrow-right" aria-hidden="true" /></a>
      </div>
    </div>
  </section>

  <section class="housing-section">
    <div class="container">
      <header class="housing-heading">
        <div>
          <p class="eyebrow">Homes for men and women</p>
          <h2>Two housing paths. One commitment to stability.</h2>
        </div>
        <p>New Beginnings operates recovery residences for adult men and women in established Pittsburgh-area communities.</p>
      </header>

      <div class="housing-paths">
        <a class="housing-path" href="/recovery-housing/men/">
          <img src="/images/mens-community.jpg" alt="" width="1880" height="1253" loading="lazy" />
          <span class="housing-path__shade"></span>
          <span class="housing-path__content">
            <span class="housing-path__label">For adult men</span>
            <strong>Men’s recovery housing</strong>
            <span class="housing-path__copy">Structured shared living in Pittsburgh-area communities.</span>
            <span class="housing-path__action">Explore men’s housing<Icon name="lucide:arrow-up-right" aria-hidden="true" /></span>
          </span>
        </a>
        <a class="housing-path" href="/recovery-housing/women/">
          <img src="/images/womens-shared-living.jpg" alt="" width="1600" height="1067" loading="lazy" />
          <span class="housing-path__shade"></span>
          <span class="housing-path__content">
            <span class="housing-path__label">For adult women</span>
            <strong>Women’s recovery housing</strong>
            <span class="housing-path__copy">A stable shared environment for continuing the work of recovery.</span>
            <span class="housing-path__action">Explore women’s housing<Icon name="lucide:arrow-up-right" aria-hidden="true" /></span>
          </span>
        </a>
      </div>

      <aside class="housing-privacy" aria-label="Service area and residence privacy">
        <div class="housing-privacy__heading">
          <Icon name="lucide:map-pin" aria-hidden="true" />
          <div>
            <span>Where we serve</span>
            <h3>Pittsburgh-area communities</h3>
          </div>
        </div>
        <div class="housing-privacy__details">
          <p><strong>Neighborhoods currently listed</strong>{site.neighborhoods.join(' · ')}</p>
          <p class="housing-privacy__note"><Icon name="lucide:lock-keyhole" aria-hidden="true" /><span>Exact locations are shared privately. Identifying exterior photographs are not published.</span></p>
        </div>
      </aside>
    </div>
  </section>

  <section class="daily-section">
    <div class="daily-layout">
      <div class="daily-content">
        <div class="daily-content__inner">
          <p class="eyebrow">Life beyond the front door</p>
          <h2>Recovery continues through ordinary days.</h2>
          <p class="lead">Ordinary routines matter: getting to work, keeping appointments, sharing household responsibilities, and making time for recovery meetings.</p>
          <p>New Beginnings provides housing, not clinical treatment. Counseling, medical care, and medication management remain with independent licensed providers.</p>
          <ul class="daily-list">
            {dailyLife.map((item) => (
              <li><Icon name={`lucide:${item.icon}`} aria-hidden="true" /><span>{item.title}</span></li>
            ))}
          </ul>
        </div>
      </div>
      <figure class="daily-photo">
        <img src="/images/daily-life.jpg" alt="Women working together at a table in a shared apartment" width="1600" height="1067" loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="trust-section">
    <div class="container">
      <div class="trust-intro">
        <header>
          <p class="eyebrow">Founded here. Accountable here.</p>
          <h2>A Pittsburgh nonprofit built around recovery housing.</h2>
        </header>
        <div class="trust-intro__copy">
          <p class="lead">Founded in Pittsburgh by Susan Rua, New Beginnings combines practical sober-living experience with public nonprofit accountability.</p>
          <p>Its standing can be checked independently through nonprofit records, state licensing, and recovery-residence inspection.</p>
          <div class="actions trust-section__actions">
            <a class="button" href="/about/susan-rua/">Meet Susan Rua<Icon name="lucide:arrow-right" aria-hidden="true" /></a>
            <a class="button button--outline" href="/about/transparency/">Verify our standing</a>
          </div>
        </div>
      </div>

      <figure class="trust-panorama">
        <img src="/images/pittsburgh.jpg" alt="The Pittsburgh skyline viewed across the rivers" width="1880" height="1253" loading="lazy" />
      </figure>

      <ul class="trust-points" aria-label="New Beginnings credentials">
        {trustPoints.map((item) => (
          <li>
            <Icon name={`lucide:${item.icon}`} aria-hidden="true" />
            <span><strong>{item.title}</strong><small>{item.copy}</small></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="conversation-section">
    <div class="container conversation-layout">
      <figure class="conversation-photo">
        <img src="/images/admissions.jpg" alt="Notebooks and coffee arranged around a shared table" width="1880" height="1245" loading="lazy" />
      </figure>
      <div class="conversation-content">
        <p class="eyebrow">Your first conversation</p>
        <h2>Start simply. Keep it private.</h2>
        <p>Begin with a general conversation about housing. Please do not send medical records or other sensitive information.</p>
        <ol class="conversation-steps">
          {firstConversation.map((step) => (
            <li>
              <span>{step.number}</span>
              <div><h3>{step.title}</h3><p>{step.copy}</p></div>
            </li>
          ))}
        </ol>
        <div class="actions conversation-actions">
          <a class="button button--light" href="/admissions/">Admissions information<Icon name="lucide:arrow-right" aria-hidden="true" /></a>
          <a class="button conversation-phone" href={site.phoneHref}><Icon name="lucide:phone" aria-hidden="true" />Call {site.phone}</a>
        </div>
        <p class="conversation-secondary">Making a professional referral? <a href="/referrals/">Start here</a>. Looking to help? <a href="/support-us/">Support the work</a>.</p>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .home-hero { position: relative; display: grid; min-height: clamp(42rem,calc(100svh - 7.25rem),50rem); overflow: hidden; align-items: center; color: var(--white); background: var(--navy-950); }
  .home-hero__image, .home-hero__shade { position: absolute; width: 100%; height: 100%; inset: 0; }
  .home-hero__image { object-fit: cover; object-position: 54% 62%; }
  .home-hero__shade { background: linear-gradient(90deg,rgba(9,34,45,.97) 0%,rgba(9,34,45,.91) 35%,rgba(9,34,45,.69) 57%,rgba(9,34,45,.26) 82%,rgba(9,34,45,.12) 100%); }
  .home-hero__inner { position: relative; z-index: 1; padding-block: clamp(5rem,9vw,8rem); }
  .home-hero__copy { max-width: 48rem; }
  .home-hero .eyebrow { color: #a6ddd8; }
  .home-hero h1 { max-width: 10.5ch; margin-top: var(--space-4); color: var(--white); font-size: clamp(3.8rem,7vw,6.75rem); }
  .home-hero .lead { max-width: 39rem; margin-top: var(--space-5); color: #eef5f4; }
  .home-hero__actions { margin-top: var(--space-6); }
  .home-hero__actions .button { gap: .65rem; }
  .home-hero__actions :global(svg) { width: 1.05rem; height: 1.05rem; }
  .home-hero__actions .button--outline { border-color: rgba(255,255,255,.78); color: var(--white); background: rgba(9,34,45,.24); }
  .home-hero__actions .button--outline:hover { color: var(--navy-950); background: var(--white); }
  .home-hero__location { display: flex; max-width: 34rem; margin-top: var(--space-7); align-items: flex-start; gap: .65rem; color: #dcebea; font-size: .93rem; line-height: 1.45; }
  .home-hero__location :global(svg) { width: 1.15rem; height: 1.15rem; margin-top: .1rem; color: #a6ddd8; flex: 0 0 auto; }

  .purpose-section { padding-block: var(--section-standard); background: var(--canvas); }
  .purpose-layout { display: grid; grid-template-columns: minmax(0,.78fr) minmax(0,1.22fr); gap: clamp(3rem,8vw,8rem); align-items: start; }
  .purpose-heading { position: sticky; top: 8.5rem; }
  .purpose-heading h2 { max-width: 12ch; margin-top: var(--space-4); }
  .purpose-heading h2 span { display: block; color: var(--teal-700); }
  .purpose-heading h2::after { display: block; width: 4.5rem; height: 3px; margin-top: var(--space-5); background: var(--teal-700); content: ''; }
  .purpose-photo { position: relative; aspect-ratio: 4 / 3; margin: var(--space-7) 0 0; overflow: hidden; background: var(--slate-200); box-shadow: 0 1.4rem 3.5rem rgba(23,55,70,.16); }
  .purpose-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: saturate(.86) contrast(.97); }
  .purpose-content { max-width: 46rem; }
  .purpose-content > p + p { margin-top: var(--space-5); }
  .foundation-list { display: grid; margin: var(--space-7) 0 0; padding: 0; gap: var(--space-6); list-style: none; }
  .foundation-list li { display: grid; grid-template-columns: 2.35rem minmax(0,1fr); gap: var(--space-4); align-items: start; }
  .foundation-list > li > :global(svg) { width: 2rem; height: 2rem; color: var(--teal-700); stroke-width: 1.55; }
  .foundation-list h3 { font-size: 1.25rem; }
  .foundation-list p { max-width: 39rem; margin-top: .45rem; color: var(--slate-600); line-height: 1.5; }
  .purpose-action { margin-top: var(--space-7); gap: .65rem; }
  .purpose-action :global(svg) { width: 1.05rem; height: 1.05rem; }

  .housing-section { padding-block: var(--section-standard); color: var(--white); background: var(--navy-950); }
  .housing-heading { display: grid; margin-bottom: var(--space-7); grid-template-columns: minmax(0,1.1fr) minmax(18rem,.9fr); gap: var(--gap-columns); align-items: end; }
  .housing-heading .eyebrow { color: #9ed7d2; }
  .housing-heading h2 { max-width: 17ch; margin-top: var(--space-4); color: var(--white); }
  .housing-heading > p { max-width: 34rem; color: var(--sky-100); font-size: 1.15rem; }
  .housing-paths { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: var(--space-5); }
  .housing-path { position: relative; min-height: 34rem; overflow: hidden; color: var(--white); background: var(--navy-900); box-shadow: 0 1.5rem 3.5rem rgba(4,24,32,.28); }
  .housing-path:hover { color: var(--white); }
  .housing-path > img, .housing-path__shade { position: absolute; width: 100%; height: 100%; inset: 0; }
  .housing-path > img { object-fit: cover; transition: transform .4s ease; }
  .housing-path:first-child > img { object-position: 48% center; }
  .housing-path:last-child > img { object-position: 52% center; }
  .housing-path:hover > img { transform: scale(1.025); }
  .housing-path__shade { background: linear-gradient(0deg,rgba(10,35,46,.96) 0%,rgba(10,35,46,.7) 38%,rgba(10,35,46,.12) 76%); }
  .housing-path__content { position: absolute; display: flex; padding: clamp(1.6rem,4vw,2.8rem); inset: auto 0 0; flex-direction: column; align-items: flex-start; }
  .housing-path__label { color: #a6ddd8; font-size: .76rem; font-weight: 750; letter-spacing: .12em; text-transform: uppercase; }
  .housing-path__content > strong { max-width: 14ch; margin-top: .45rem; color: var(--white); font-size: clamp(2rem,4vw,3.25rem); line-height: 1.05; }
  .housing-path__copy { max-width: 32rem; margin-top: var(--space-3); color: var(--sky-100); font-size: 1.05rem; line-height: 1.45; }
  .housing-path__action { display: inline-flex; min-height: 3.15rem; margin-top: var(--space-5); padding: .75rem 1rem; align-items: center; gap: .65rem; color: var(--navy-950); background: var(--white); font-weight: 750; line-height: 1; }
  .housing-path__action :global(svg) { width: 1rem; height: 1rem; }
  .housing-privacy { display: grid; margin-top: var(--space-7); padding-top: var(--space-6); border-top: 1px solid rgba(255,255,255,.2); grid-template-columns: minmax(14rem,.68fr) minmax(0,1.32fr); gap: var(--gap-columns); align-items: start; }
  .housing-privacy__heading { display: grid; grid-template-columns: 2rem minmax(0,1fr); gap: var(--space-3); align-items: start; }
  .housing-privacy__heading :global(svg) { width: 1.65rem; height: 1.65rem; color: #9ed7d2; stroke-width: 1.6; }
  .housing-privacy__heading span { display: block; color: #9ed7d2; font-size: .74rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .housing-privacy__heading h3 { margin-top: .35rem; color: var(--white); font-size: 1.2rem; }
  .housing-privacy__details { display: grid; grid-template-columns: minmax(14rem,.82fr) minmax(18rem,1.18fr); gap: clamp(1.5rem,4vw,4rem); }
  .housing-privacy__details p { color: var(--sky-100); font-size: .94rem; line-height: 1.55; }
  .housing-privacy__details strong { display: block; margin-bottom: .35rem; color: var(--white); font-size: .78rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .housing-privacy__note { display: grid; max-width: 32rem; grid-template-columns: 1.2rem minmax(0,1fr); gap: .65rem; }
  .housing-privacy__note :global(svg) { width: 1.15rem; height: 1.15rem; margin-top: .15rem; color: #9ed7d2; stroke-width: 1.7; }

  .daily-section { padding: 0; background: var(--paper); }
  .daily-layout { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); align-items: stretch; }
  .daily-content { display: grid; align-items: center; }
  .daily-content__inner { width: min(100%,43rem); margin-left: auto; padding: clamp(4rem,7vw,7rem) clamp(2.5rem,6vw,6rem); }
  .daily-content h2 { max-width: 13ch; margin-top: var(--space-4); }
  .daily-content h2::after { display: block; width: 4.5rem; height: 3px; margin-top: var(--space-5); background: var(--teal-700); content: ''; }
  .daily-content .lead { margin-top: var(--space-5); }
  .daily-content__inner > p:not(.eyebrow):not(.lead) { margin-top: var(--space-5); }
  .daily-photo { min-height: 46rem; margin: 0; overflow: hidden; }
  .daily-photo img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 54% center; filter: saturate(.88) contrast(.96); }
  .daily-list { display: grid; margin: var(--space-7) 0 0; padding: 0; grid-template-columns: repeat(2,minmax(0,1fr)); gap: var(--space-5) var(--space-6); list-style: none; }
  .daily-list li { display: grid; grid-template-columns: auto 1fr; gap: .75rem; align-items: center; color: var(--navy-900); font-weight: 700; line-height: 1.35; }
  .daily-list :global(svg) { width: 1.65rem; height: 1.65rem; color: var(--teal-700); stroke-width: 1.6; }

  .trust-section { padding-block: var(--section-standard); background: var(--sky-50); }
  .trust-intro { display: grid; grid-template-columns: minmax(0,.92fr) minmax(0,1.08fr); gap: var(--gap-columns); align-items: start; }
  .trust-section h2 { max-width: 15ch; margin-top: var(--space-4); font-size: clamp(2.65rem,4vw,4.15rem); }
  .trust-intro__copy { max-width: 42rem; padding-top: 1.8rem; }
  .trust-intro__copy .lead { color: var(--slate-700); }
  .trust-intro__copy > p + p { margin-top: var(--space-4); }
  .trust-section__actions { margin-top: var(--space-6); }
  .trust-section__actions .button { gap: .65rem; }
  .trust-section__actions :global(svg) { width: 1.05rem; height: 1.05rem; }
  .trust-panorama { height: clamp(14rem,22vw,18rem); margin: var(--space-8) 0 0; overflow: hidden; background: var(--slate-200); }
  .trust-panorama img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 57%; filter: saturate(.78) contrast(.98); }
  .trust-points { display: grid; margin: 0; padding: var(--space-6) 0; border-block: 1px solid var(--slate-300); grid-template-columns: repeat(3,minmax(0,1fr)); gap: clamp(1.25rem,3vw,2.5rem); list-style: none; }
  .trust-points li { display: grid; grid-template-columns: 2rem minmax(0,1fr); gap: .8rem; align-items: center; }
  .trust-points :global(svg) { width: 1.75rem; height: 1.75rem; color: var(--teal-700); stroke-width: 1.6; }
  .trust-points strong, .trust-points small { display: block; }
  .trust-points strong { color: var(--navy-900); font-size: 1rem; line-height: 1.25; }
  .trust-points small { margin-top: .2rem; color: var(--slate-600); font-size: .84rem; line-height: 1.3; }

  .conversation-section { padding-block: var(--section-standard); background: var(--canvas); }
  .conversation-layout { display: grid; grid-template-columns: minmax(0,.92fr) minmax(0,1.08fr); align-items: stretch; box-shadow: var(--shadow-raised); }
  .conversation-photo { min-height: 43rem; margin: 0; overflow: hidden; }
  .conversation-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .conversation-content { display: flex; padding: clamp(2.7rem,6vw,5rem); color: var(--white); background: var(--teal-800); flex-direction: column; justify-content: center; }
  .conversation-content .eyebrow { color: #b9e5e1; }
  .conversation-content h2 { max-width: 12ch; margin-top: var(--space-4); color: var(--white); }
  .conversation-content > p:not(.eyebrow):not(.conversation-secondary) { max-width: 37rem; margin-top: var(--space-4); color: #e5f1f0; }
  .conversation-steps { display: grid; margin: var(--space-6) 0 0; padding: 0; gap: var(--space-5); list-style: none; }
  .conversation-steps li { display: grid; grid-template-columns: 2.4rem minmax(0,1fr); gap: var(--space-3); }
  .conversation-steps > li > span { padding-top: .15rem; color: #b9e5e1; font-size: .82rem; font-weight: 800; letter-spacing: .08em; }
  .conversation-steps h3 { color: var(--white); font-size: 1.2rem; }
  .conversation-steps p { max-width: 33rem; margin-top: .35rem; color: #d7e9e7; font-size: .96rem; line-height: 1.45; }
  .conversation-actions { margin-top: var(--space-6); }
  .conversation-actions .button { gap: .65rem; }
  .conversation-actions :global(svg) { width: 1.05rem; height: 1.05rem; }
  .conversation-phone { border-color: rgba(255,255,255,.76); color: var(--white); background: transparent; }
  .conversation-phone:hover { color: var(--teal-800); background: var(--white); }
  .conversation-secondary { margin-top: var(--space-6); color: #d7e9e7; font-size: .92rem; }
  .conversation-secondary a { color: var(--white); font-weight: 750; }
  .conversation-secondary a:hover { color: #b9e5e1; }

  @media (max-width: 960px) {
    .home-hero { min-height: 43rem; }
    .home-hero__shade { background: linear-gradient(90deg,rgba(9,34,45,.96) 0%,rgba(9,34,45,.88) 49%,rgba(9,34,45,.5) 78%,rgba(9,34,45,.28) 100%); }
    .daily-layout { grid-template-columns: 1fr; }
    .daily-content__inner { width: 100%; padding: var(--section-standard) var(--gutter); }
    .daily-photo { min-height: 30rem; }
  }

  @media (max-width: 1100px) and (min-width: 821px) {
    .housing-privacy__details { grid-template-columns: 1fr; gap: var(--space-4); }
  }

  @media (max-width: 820px) {
    .purpose-layout, .housing-heading, .conversation-layout, .trust-intro { grid-template-columns: 1fr; }
    .home-hero__image { object-position: 62% center; }
    .home-hero__shade { background: linear-gradient(90deg,rgba(9,34,45,.94) 0%,rgba(9,34,45,.84) 64%,rgba(9,34,45,.54) 100%); }
