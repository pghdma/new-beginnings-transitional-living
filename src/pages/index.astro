---
import MainLayout from '../layouts/MainLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import FactRail from '../components/FactRail.astro';
import IconBadge from '../components/IconBadge.astro';
import SectionHead from '../components/SectionHead.astro';
import { site } from '../data/site';
---
<MainLayout title={site.shortName}>
  <section class="home-hero">
    <img src="/images/hero-community.jpg" alt="A welcoming shared living space with comfortable seating and natural light" width="1800" height="1050" />
    <div class="overlay"></div>
    <div class="container hero-content">
      <p class="eyebrow">Nonprofit recovery housing in Pittsburgh</p>
      <h1>A stable place to build what comes next.</h1>
      <p class="lead">Structured recovery residences for adult men and women, grounded in peer support, accountability, and connection to care.</p>
      <div class="actions"><a class="button" href="/admissions/">Ask about housing</a><a class="hero-phone" href={site.phoneHref}>Call {site.phone}</a></div>
    </div>
  </section>

  <FactRail />

  <section class="section mission">
    <div class="container editorial-split">
      <div class="editorial-title">
        <p class="eyebrow">A foundation for recovery</p>
        <h2>Housing with a practical purpose.</h2>
        <p class="mission-words" aria-label="Structure, dignity, and community">Structure<br />Dignity<br />Community</p>
      </div>
      <div class="editorial-copy">
        <p class="lead">Recovery takes more than a roof. A dependable home can give people the room to strengthen routines, live alongside peers, and keep moving toward greater stability.</p>
        <p>New Beginnings Transitional Living Foundation operates substance-free residences for adults in recovery. Residents remain connected to independent treatment, mutual-support meetings, employment, education, and community resources while taking responsibility for daily life in a shared home.</p>
        <p>Our work is recovery housing. It is not inpatient treatment, emergency shelter, or crisis care.</p>
        <a class="text-link" href="/recovery-housing/">Understand recovery housing</a>
      </div>
    </div>
  </section>

  <section class="section section--tint audience">
    <div class="container">
      <SectionHead eyebrow="Find your path" title="Start with what you need today." intro="Housing inquiries, professional referrals, and community support each have a clear place to begin." />
      <div class="route-list">
        <a class="route" href="/admissions/">
          <IconBadge name="house" />
          <div><h3>I need housing</h3><p>Learn how to make a private inquiry and what information to prepare.</p></div>
          <span class="route-arrow" aria-hidden="true">→</span>
        </a>
        <a class="route" href="/referrals/">
          <IconBadge name="user-round-check" />
          <div><h3>I am helping someone</h3><p>Information for families, providers, case managers, and referral partners.</p></div>
          <span class="route-arrow" aria-hidden="true">→</span>
        </a>
        <a class="route" href="/support-us/">
          <IconBadge name="hand-heart" />
          <div><h3>I want to support the work</h3><p>Explore financial, in-kind, and community partnership opportunities.</p></div>
          <span class="route-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section housing">
    <div class="container housing-grid">
      <figure><img src="/images/community-table.jpg" alt="A shared table prepared for a group conversation" width="900" height="750" loading="lazy" /></figure>
      <div class="housing-copy">
        <p class="eyebrow">Men’s and women’s housing</p>
        <h2>Recovery residences in Pittsburgh-area communities.</h2>
        <p class="lead">New Beginnings serves adult men and women in established neighborhoods while protecting the privacy of each residence.</p>
        <div class="program-routes">
          <a href="/recovery-housing/men/"><span>Men’s recovery housing</span><small>Sheraden, McKees Rocks, and other communities</small><b aria-hidden="true">→</b></a>
          <a href="/recovery-housing/women/"><span>Women’s recovery housing</span><small>Brighton Heights and the greater Pittsburgh area</small><b aria-hidden="true">→</b></a>
        </div>
        <p class="privacy-note">Exact residence locations are provided privately during the intake process. We do not publish house addresses or identifying exterior photographs.</p>
      </div>
    </div>
  </section>

  <section class="section section--paper foundation">
    <div class="container">
      <SectionHead eyebrow="Daily recovery" title="Stability is built in ordinary moments." intro="Recovery housing supports the day-to-day work that happens between appointments, meetings, workdays, and personal milestones." />
      <div class="foundation-row">
        <div><span>01</span><h3>A dependable home</h3><p>A substance-free environment creates a consistent place to return to each day.</p></div>
        <div><span>02</span><h3>Peer community</h3><p>Residents live alongside other adults who understand the effort recovery requires.</p></div>
        <div><span>03</span><h3>Connection beyond the house</h3><p>Independent treatment and community recovery resources remain part of the larger support network.</p></div>
      </div>
    </div>
  </section>

  <section class="section section--navy accountability">
    <div class="container accountability-grid">
      <div>
        <p class="eyebrow">Accountability you can verify</p>
        <h2>Standards matter.</h2>
        <p>Families, residents, professionals, and donors should be able to understand who operates a recovery residence and which standards apply.</p>
      </div>
      <ul class="proof-list">
        <li><span>Nonprofit status</span><strong>501(c)(3) public charity</strong></li>
        <li><span>State oversight</span><strong>Pennsylvania DDAP-licensed residences</strong></li>
        <li><span>Recovery-residence standards</span><strong>WestPARR inspected</strong></li>
        <li><span>Public information</span><a href="/about/transparency/">View credentials and records →</a></li>
      </ul>
    </div>
  </section>

  <CtaBand />
</MainLayout>

<style>
  .home-hero { position: relative; display: grid; min-height: min(48rem, calc(100svh - 7.25rem)); align-items: end; overflow: hidden; }
  .home-hero > img, .overlay { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .home-hero > img { object-position: 54% center; }
  .overlay { background: linear-gradient(90deg, rgba(18,48,61,.9) 0%, rgba(18,48,61,.7) 50%, rgba(18,48,61,.15) 100%); }
  .hero-content { position: relative; display: grid; gap: var(--space-5); padding-block: clamp(var(--space-9), 10vw, var(--space-10)); color: var(--white); }
  .hero-content h1 { max-width: 13ch; color: var(--white); }
  .hero-content .lead { max-width: 40rem; color: var(--white); }
  .hero-content .eyebrow { color: #9ed7d2; }
  .hero-phone { color: var(--white); font-weight: 750; }
  .mission-words { padding-left: var(--space-5); border-left: 3px solid var(--teal-700); color: var(--blue-700); font-size: clamp(1.35rem, 2.5vw, 2rem); font-weight: 650; line-height: 1.45; }
  .route { grid-template-rows: auto auto 1fr auto; }
  .route > div { display: grid; gap: var(--space-3); }
  .housing-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: var(--gap-columns); align-items: center; }
  .housing figure { height: min(42rem, 58vw); margin: 0; }
  .housing img { width: 100%; height: 100%; object-fit: cover; }
  .housing-copy { display: grid; gap: var(--space-5); }
  .program-routes { border-top: 1px solid var(--slate-300); }
  .program-routes a { display: grid; grid-template-columns: minmax(0, 1fr) auto; padding-block: var(--space-5); border-bottom: 1px solid var(--slate-300); color: var(--navy-900); text-decoration: none; }
  .program-routes span { font-size: 1.2rem; font-weight: 700; }
  .program-routes small { grid-column: 1; margin-top: var(--space-2); color: var(--slate-600); font-size: .92rem; }
  .program-routes b { grid-column: 2; grid-row: 1 / 3; align-self: center; color: var(--teal-700); font-size: 1.4rem; }
  .privacy-note { padding-left: var(--space-4); border-left: 2px solid var(--sky-200); color: var(--slate-600); font-size: .92rem; }
  .foundation-row { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--slate-300); }
  .foundation-row > div { padding: var(--space-6) var(--space-6) var(--space-6) 0; }
  .foundation-row > div + div { padding-left: var(--space-6); border-left: 1px solid var(--slate-300); }
  .foundation-row span { display: block; margin-bottom: var(--space-7); color: var(--teal-700); font-size: 1rem; font-weight: 750; }
  .foundation-row h3 { margin-bottom: var(--space-3); }
  .accountability-grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: var(--gap-columns); align-items: start; }
  .accountability-grid > div { display: grid; gap: var(--space-4); }
  .accountability-grid > div p:last-child { max-width: 32rem; color: var(--sky-200); }
  .proof-list { margin: 0; padding: 0; border-top: 1px solid rgba(255,255,255,.24); list-style: none; }
  .proof-list li { display: grid; grid-template-columns: .72fr 1.28fr; gap: var(--space-5); padding-block: var(--space-5); border-bottom: 1px solid rgba(255,255,255,.24); }
  .proof-list span { color: #9ed7d2; font-size: .78rem; font-weight: 750; letter-spacing: .1em; text-transform: uppercase; }
  .proof-list strong { color: var(--white); font-size: 1.1rem; }
  .proof-list a { color: var(--white); font-weight: 750; }
  @media (max-width: 860px) {
    .housing-grid, .accountability-grid { grid-template-columns: 1fr; }
    .housing figure { height: 24rem; }
    .foundation-row { grid-template-columns: 1fr; }
    .foundation-row > div, .foundation-row > div + div { display: grid; grid-template-columns: 3rem minmax(0, 1fr); padding: var(--space-5) 0; border-left: 0; border-bottom: 1px solid var(--slate-300); gap: 0 var(--space-4); }
    .foundation-row span { grid-row: 1 / 3; margin: 0; }
  }
  @media (max-width: 520px) {
    .home-hero { min-height: 39rem; }
    .home-hero > img { object-position: 58% center; }
    .hero-content { gap: var(--space-4); padding-block: var(--space-8); }
    .hero-content .lead { font-size: 1.08rem; }
    .route > :global(.icon-badge) { align-self: start; }
    .housing figure { height: 18rem; margin-inline: calc(var(--gutter) * -1); }
    .proof-list li { grid-template-columns: 1fr; gap: var(--space-2); }
  }
</style>
