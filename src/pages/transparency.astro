---
import MainLayout from '../layouts/MainLayout.astro'; import PageHero from '../components/PageHero.astro'; import InquiryForm from '../components/InquiryForm.astro'; import IconBadge from '../components/IconBadge.astro'; import { site } from '../data/site';
---
<MainLayout title="Transparency and Credentials"><PageHero eyebrow="Accountability" title="Credentials and public records" intro="Independent standards and public nonprofit records help families, residents, professionals, and donors make informed decisions." image="/images/credentials.jpg" imageAlt="Organized documents and a pen on a professional desk" compact />
<section class="section"><div class="container"><div class="grid-3"><article class="card"><IconBadge name="landmark" /><h3>501(c)(3) public charity</h3><p>Tax-exempt since February 2019. EIN {site.ein}. Contributions are tax-deductible to the extent permitted by law.</p><a class="text-link" href="https://projects.propublica.org/nonprofits/organizations/812901849" rel="external">View public Form 990 filings</a></article><article class="card"><IconBadge name="badge-check" /><h3>Pennsylvania DDAP</h3><p>New Beginnings operates recovery residences holding full licenses from the Pennsylvania Department of Drug and Alcohol Programs.</p><a class="text-link" href="https://sais.health.pa.gov/CommonPOC/Content/PublicWeb/DAFind.aspx" rel="external">Search the state facility directory</a></article><article class="card"><IconBadge name="shield-check" /><h3>WestPARR</h3><p>New Beginnings is listed by WestPARR as an inspected AA/NA-based recovery-housing provider.</p><a class="text-link" href="https://westparr.org/search-homes/" rel="external">View the WestPARR directory</a></article></div></div></section>
<section class="section section--tint"><div class="container grid-2"><div><p class="eyebrow">A note on locations</p><h2>Public accountability without compromising resident privacy.</h2></div><div><p class="lead">Government records may include licensed facility addresses. New Beginnings does not reproduce those addresses on this website.</p><p>Neighborhood-level information gives prospective residents and referral partners useful context while helping protect the privacy of people who live in our homes.</p></div></div></section><InquiryForm /></MainLayout>
