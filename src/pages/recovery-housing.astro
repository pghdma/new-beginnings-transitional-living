---
import { Icon } from 'astro-icon/components';
import MainLayout from '../layouts/MainLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

const dailyRhythm = [
  {
    number: '01',
    title: 'A dependable place to return to',
    copy: 'A substance-free shared residence gives each day a consistent starting point and place to come home to.',
  },
  {
    number: '02',
    title: 'Responsibility within the home',
    copy: 'Shared expectations and household responsibilities help residents practice accountability in ordinary ways.',
  },
  {
    number: '03',
    title: 'Connection beyond the home',
    copy: 'Work, education, recovery meetings, appointments, and community relationships continue outside the residence.',
  },
  {
    number: '04',
    title: 'Independent clinical care',
    copy: 'Counseling, medical care, medication management, and other treatment remain with licensed outside providers.',
  },
];
---

<MainLayout title="Recovery Housing" description="Understand structured, peer-supported recovery housing for adult men and women in Pittsburgh.">
  <section class="housing-hero">
    <div class="container housing-hero__grid">
      <div class="housing-hero__copy">
        <p class="eyebrow">Recovery housing in Pittsburgh</p>
        <h1>A home for the work between the milestones.</h1>
        <p class="lead">Recovery happens in everyday routines, relationships, and choices. A stable, substance-free residence gives that daily work a dependable setting.</p>
        <div class="actions housing-hero__actions">
          <a class="button" href="/admissions/">Ask about housing<Icon name="lucide:arrow-right" aria-hidden="true" /></a>
          <a class="button button--outline" href="/referrals/">For professionals</a>
        </div>
        <p class="housing-hero__scope"><Icon name="lucide:home" aria-hidden="true" />Separate recovery residences for adult men and women</p>
      </div>
      <figure class="housing-hero__photo">
        <img src="/images/house-living-room.webp" alt="A bright living room with shared seating" width="2200" height="1467" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <section class="definition-section">
    <div class="container definition-layout">
      <figure class="definition-photo">
        <img src="/images/house-kitchen.webp" alt="A kitchen and dining table in a welcoming home" width="2200" height="1467" loading="lazy" />
      </figure>
      <div class="definition-copy">
        <p class="eyebrow">What recovery housing is</p>
        <h2>A bridge toward greater independence.</h2>
        <p class="lead">Recovery housing is a shared living environment for adults committed to building stable lives without alcohol or other drugs.</p>
        <p>Residents live alongside peers who understand the work of recovery. The home adds consistency and community while each person continues building connections to treatment, mutual-support groups, employment, education, family, and other community resources.</p>
        <aside class="scope-note">
          <Icon name="lucide:stethoscope" aria-hidden="true" />
          <p><strong>Housing, not clinical treatment.</strong> New Beginnings provides the living environment and recovery-focused structure. Clinical care remains with independent licensed providers.</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="rhythm-section">
    <div class="container rhythm-layout">
      <header class="rhythm-heading">
        <p class="eyebrow">How the environment helps</p>
        <h2>Recovery has room to become routine.</h2>
        <p>The important parts of a recovery residence are practical: consistency, shared responsibility, peer community, and connection to the wider recovery network.</p>
      </header>
      <div class="rhythm-content">
        <ol class="rhythm-list">
          {dailyRhythm.map((item) => (
            <li>
              <span>{item.number}</span>
              <div><h3>{item.title}</h3><p>{item.copy}</p></div>
            </li>
          ))}
        </ol>
        <aside class="crisis-note">
          <Icon name="lucide:circle-alert" aria-hidden="true" />
          <p><strong>Need immediate help?</strong> New Beginnings is not an emergency shelter or crisis service. Call 911 for an emergency, or call or text 988 for crisis support.</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="pathways-section">
    <div class="container pathways-layout">
      <figure class="pathways-photo">
        <img src="/images/pittsburgh.jpg" alt="The Pittsburgh skyline viewed across the rivers" width="1880" height="1253" loading="lazy" />
      </figure>
      <div class="pathways-content">
        <p class="eyebrow">Our housing network</p>
        <h2>Separate residences. A shared purpose.</h2>
        <p>New Beginnings provides recovery housing for adult men and women in established Pittsburgh-area communities.</p>
        <nav class="pathway-links" aria-label="Recovery housing options">
          <a href="/recovery-housing/men/">
            <span><small>For adult men</small><strong>Men’s recovery housing</strong></span>
            <Icon name="lucide:arrow-up-right" aria-hidden="true" />
          </a>
          <a href="/recovery-housing/women/">
            <span><small>For adult women</small><strong>Women’s recovery housing</strong></span>
            <Icon name="lucide:arrow-up-right" aria-hidden="true" />
          </a>
        </nav>
        <p class="pathways-location"><Icon name="lucide:map-pin" aria-hidden="true" />Public records reference {site.neighborhoods.join(', ')}. Additional homes serve other Pittsburgh-area communities.</p>
      </div>
    </div>
  </section>

  <section class="privacy-section">
    <div class="container privacy-layout">
      <div class="privacy-heading">
        <Icon name="lucide:lock-keyhole" aria-hidden="true" />
        <div><p class="eyebrow">Residence privacy</p><h2>Useful information without publishing someone’s home.</h2></div>
      </div>
      <div class="privacy-copy">
        <p>New Beginnings does not publish individual house addresses, maps, or identifying exterior photographs. Exact locations are shared privately when they are relevant to an admissions or referral conversation.</p>
        <a class="text-link" href="/about/transparency/">Review our public credentials</a>
      </div>
    </div>
  </section>

  <CtaBand text="Start with a private, general conversation about availability and what you are looking for. Staff can explain what may happen next." />
</MainLayout>

<style>
  .housing-hero { border-bottom: 1px solid var(--slate-200); background: var(--paper); }
  .housing-hero__grid { display: grid; min-height: clamp(35rem, 53vw, 44rem); grid-template-columns: minmax(0, .93fr) minmax(0, 1.07fr); align-items: stretch; }
  .housing-hero__copy { display: flex; padding: clamp(4.5rem, 8vw, 7rem) clamp(2rem, 5vw, 4.5rem) clamp(4.5rem, 8vw, 7rem) 0; flex-direction: column; justify-content: center; }
  .housing-hero h1 { max-width: 10.5ch; margin-top: var(--space-4); font-size: clamp(3.25rem, 5.9vw, 5.5rem); }
  .housing-hero .lead { max-width: 35rem; margin-top: var(--space-5); }
  .housing-hero__actions { margin-top: var(--space-6); }
  .housing-hero__actions .button { gap: .6rem; }
  .housing-hero__actions :global(svg) { width: 1rem; height: 1rem; }
  .housing-hero__scope { display: flex; max-width: 32rem; margin-top: var(--space-7); padding-top: var(--space-4); border-top: 1px solid var(--slate-300); align-items: center; gap: .7rem; color: var(--slate-600); font-size: .92rem; }
  .housing-hero__scope :global(svg) { width: 1.2rem; height: 1.2rem; color: var(--teal-700); stroke-width: 1.6; }
  .housing-hero__photo { margin: 0 calc((100vw - min(100vw - (var(--gutter) * 2), var(--max))) / -2) 0 0; overflow: hidden; background: var(--slate-200); }
  .housing-hero__photo img { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: saturate(.8) contrast(.96); }

  .definition-section { padding-block: var(--section-standard); background: var(--canvas); }
  .definition-layout { display: grid; grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr); gap: clamp(3rem, 8vw, 7rem); align-items: center; }
  .definition-photo { height: 35rem; margin: 0; overflow: hidden; box-shadow: var(--shadow-raised); }
  .definition-photo img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.82) contrast(.97); }
  .definition-copy { max-width: 42rem; }
  .definition-copy h2 { max-width: 13ch; margin-top: var(--space-4); }
  .definition-copy > .lead { margin-top: var(--space-6); }
  .definition-copy > p:not(.eyebrow):not(.lead) { margin-top: var(--space-4); }
  .scope-note { display: grid; margin-top: var(--space-7); padding: var(--space-5) 0; border-block: 1px solid var(--slate-300); grid-template-columns: 2rem minmax(0, 1fr); gap: var(--space-4); align-items: start; }
  .scope-note :global(svg) { width: 1.7rem; height: 1.7rem; color: var(--teal-700); stroke-width: 1.55; }
  .scope-note p { color: var(--slate-600); font-size: .96rem; line-height: 1.55; }
  .scope-note strong { display: block; margin-bottom: .25rem; color: var(--navy-900); font-weight: 600; }

  .rhythm-section { padding-block: var(--section-standard); background: var(--sky-50); }
  .rhythm-layout { display: grid; grid-template-columns: minmax(0, .72fr) minmax(0, 1.28fr); gap: clamp(3rem, 8vw, 7rem); align-items: start; }
  .rhythm-heading { position: sticky; top: 8.5rem; }
  .rhythm-heading h2 { max-width: 12ch; margin-top: var(--space-4); }
  .rhythm-heading > p:last-child { max-width: 31rem; margin-top: var(--space-5); }
  .rhythm-list { margin: 0; padding: 0; border-top: 1px solid var(--slate-300); list-style: none; }
  .rhythm-list li { display: grid; padding-block: var(--space-5); border-bottom: 1px solid var(--slate-300); grid-template-columns: 3rem minmax(0, 1fr); gap: var(--space-4); }
  .rhythm-list > li > span { padding-top: .15rem; color: var(--teal-700); font-size: .82rem; font-weight: 650; letter-spacing: .08em; }
  .rhythm-list h3 { font-size: 1.28rem; }
  .rhythm-list p { max-width: 43rem; margin-top: .45rem; color: var(--slate-600); line-height: 1.55; }
  .crisis-note { display: grid; margin-top: var(--space-6); grid-template-columns: 1.5rem minmax(0, 1fr); gap: var(--space-3); color: var(--slate-600); font-size: .92rem; line-height: 1.5; }
  .crisis-note :global(svg) { width: 1.2rem; height: 1.2rem; margin-top: .15rem; color: var(--teal-700); stroke-width: 1.6; }
  .crisis-note strong { color: var(--navy-900); font-weight: 600; }

  .pathways-section { padding-block: var(--section-standard); color: var(--white); background: var(--navy-950); }
  .pathways-layout { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); align-items: stretch; }
  .pathways-photo { min-height: 38rem; margin: 0; overflow: hidden; }
  .pathways-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: saturate(.72) contrast(.96); }
  .pathways-content { display: flex; padding: clamp(2.5rem, 6vw, 5rem); background: var(--navy-900); flex-direction: column; justify-content: center; }
  .pathways-content .eyebrow { color: #9ed7d2; }
  .pathways-content h2 { max-width: 12ch; margin-top: var(--space-4); color: var(--white); }
  .pathways-content > p:not(.eyebrow):not(.pathways-location) { max-width: 34rem; margin-top: var(--space-5); color: var(--sky-100); }
  .pathway-links { margin-top: var(--space-6); border-top: 1px solid rgba(255,255,255,.25); }
  .pathway-links a { display: grid; padding-block: var(--space-5); border-bottom: 1px solid rgba(255,255,255,.25); grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-4); align-items: center; color: var(--white); }
  .pathway-links a:hover { color: #b9e5e1; }
  .pathway-links small, .pathway-links strong { display: block; }
  .pathway-links small { color: #9ed7d2; font-size: .76rem; font-weight: 650; letter-spacing: .1em; text-transform: uppercase; }
  .pathway-links strong { margin-top: .25rem; font-size: 1.35rem; font-weight: 600; }
  .pathway-links :global(svg) { width: 1.3rem; height: 1.3rem; stroke-width: 1.6; }
  .pathways-location { display: flex; max-width: 34rem; margin-top: var(--space-5); align-items: flex-start; gap: .65rem; color: var(--sky-200); font-size: .9rem; line-height: 1.5; }
  .pathways-location :global(svg) { width: 1rem; height: 1rem; margin-top: .2rem; flex: 0 0 auto; }

  .privacy-section { padding-block: var(--section-compact); background: var(--paper); }
  .privacy-layout { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: var(--gap-columns); align-items: start; }
  .privacy-heading { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: var(--space-4); }
  .privacy-heading :global(svg) { width: 2rem; height: 2rem; margin-top: .1rem; color: var(--teal-700); stroke-width: 1.55; }
  .privacy-heading h2 { max-width: 15ch; margin-top: var(--space-3); font-size: clamp(1.8rem, 3vw, 2.55rem); }
  .privacy-copy { max-width: 42rem; }
  .privacy-copy .text-link { margin-top: var(--space-5); }

  @media (max-width: 900px) {
    .housing-hero__grid, .definition-layout, .rhythm-layout, .pathways-layout, .privacy-layout { grid-template-columns: 1fr; }
    .housing-hero__photo { order: -1; height: clamp(20rem, 52vw, 28rem); margin: 0 calc(var(--gutter) * -1); }
    .housing-hero__copy { padding: var(--space-8) 0; }
    .definition-layout, .rhythm-layout { gap: var(--space-7); }
    .definition-photo { height: auto; aspect-ratio: 16 / 10; }
    .rhythm-heading { position: static; }
    .pathways-layout { box-shadow: var(--shadow-raised); }
    .pathways-photo { height: clamp(18rem, 48vw, 26rem); min-height: 0; }
    .privacy-layout { gap: var(--space-6); }
  }

  @media (max-width: 560px) {
    .housing-hero__photo { height: 16rem; }
    .housing-hero__copy { padding-block: var(--space-7); }
    .housing-hero h1 { font-size: clamp(2.7rem, 12vw, 3.55rem); }
    .housing-hero__actions { display: grid; }
    .housing-hero__actions .button { width: 100%; }
    .definition-layout, .rhythm-layout { gap: var(--space-6); }
    .definition-photo { aspect-ratio: 4 / 3; }
    .scope-note { grid-template-columns: 1.7rem minmax(0, 1fr); gap: var(--space-3); }
    .pathways-content { padding: var(--space-7) var(--space-5); }
    .privacy-heading { grid-template-columns: 2rem minmax(0, 1fr); }
  }
</style>
