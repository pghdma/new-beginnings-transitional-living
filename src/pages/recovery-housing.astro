---
import MainLayout from '../layouts/MainLayout.astro'; import PageHero from '../components/PageHero.astro'; import InquiryForm from '../components/InquiryForm.astro'; import IconBadge from '../components/IconBadge.astro';
---
<MainLayout title="Recovery Housing" description="Learn about structured, peer-supported recovery housing for men and women in Pittsburgh.">
  <PageHero eyebrow="Recovery housing" title="More than a place to stay." intro="A substance-free home can provide the consistency, peer connection, and accountability that help recovery take root in everyday life." image="/images/recovery-routine.jpg" imageAlt="A bright common room arranged for conversation" />
  <section class="section"><div class="container grid-2"><div><p class="eyebrow">What it is</p><h2>A bridge toward greater independence.</h2></div><div class="narrow"><p class="lead">Recovery housing is a shared, substance-free living environment for people building stable lives in recovery.</p><p>Residents live alongside peers who understand the work of recovery. The home provides structure and community while residents remain connected to appropriate outside treatment, mutual-support groups, employment, education, and other services.</p><p>New Beginnings provides recovery housing, not inpatient treatment or emergency shelter. Our role is to support the day-to-day foundation that makes continued recovery possible.</p></div></div></section>
  <section class="section section--tint"><div class="container"><div class="section-head"><p class="eyebrow">The environment</p><h2>What residents can expect</h2></div><div class="grid-3"><article class="card"><IconBadge name="calendar-check" /><h3>Structure</h3><p>Clear expectations and shared routines help create a dependable living environment.</p></article><article class="card"><IconBadge name="users-round" /><h3>Peer community</h3><p>Residents live with other adults working toward stability and sustained recovery.</p></article><article class="card"><IconBadge name="waypoints" /><h3>Connection</h3><p>Recovery housing works alongside independent treatment, mutual-support meetings, and community resources.</p></article></div></div></section>
  <section class="section"><div class="container grid-2"><div><p class="eyebrow">Pittsburgh-area homes</p><h2>Privacy is part of safety.</h2></div><div><p class="lead">New Beginnings operates men’s and women’s residences in several Pittsburgh-area communities.</p><p>We name neighborhoods publicly, but we do not publish individual residence addresses or identifying exterior photographs. Exact location information is provided privately as part of the intake process.</p><div class="actions"><a class="button button--outline" href="/mens-housing/">Men’s housing</a><a class="button button--outline" href="/womens-housing/">Women’s housing</a></div></div></div></section>
  <InquiryForm />
</MainLayout>
