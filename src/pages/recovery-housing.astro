---
import { Icon } from 'astro-icon/components';
import MainLayout from '../layouts/MainLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

const dailyRhythm = [
  {
    number: '01',
    icon: 'lucide:home',
    title: 'A Dependable Place to Return To',
    copy: 'A substance-free shared residence gives each day a consistent starting point and place to come home to.',
  },
  {
    number: '02',
    icon: 'lucide:list-checks',
    title: 'Responsibility Within the Home',
    copy: 'Shared expectations and household responsibilities help residents practice accountability in ordinary ways.',
  },
  {
    number: '03',
    icon: 'lucide:route',
    title: 'Connection Beyond the Home',
    copy: 'Work, education, recovery meetings, appointments, and community relationships continue outside the residence.',
  },
  {
    number: '04',
    icon: 'lucide:stethoscope',
    title: 'Independent Clinical Care',
    copy: 'Counseling, medical care, medication management, and other treatment remain with licensed outside providers.',
  },
];
---

<MainLayout title="Recovery Housing" description="Understand structured, peer-supported recovery housing for adult men and women in Pittsburgh.">
  <section class="housing-hero">
    <div class="container housing-hero__grid">
      <div class="housing-hero__copy">
        <p class="eyebrow">Recovery Housing in Pittsburgh</p>
        <h1>A Home for the Work Between the Milestones</h1>
        <p class="lead">Recovery happens in everyday routines, relationships, and choices. A stable, substance-free residence gives that daily work a dependable setting.</p>
        <div class="actions housing-hero__actions">
          <a class="button" href="/admissions/">Ask About Housing<Icon name="lucide:arrow-right" aria-hidden="true" /></a>
          <a class="button button--outline" href="/referrals/">For Professionals</a>
        </div>
        <p class="housing-hero__scope"><Icon name="lucide:home" aria-hidden="true" />Separate recovery residences for adult men and women</p>
      </div>
      <figure class="housing-hero__photo">
        <img src="/images/house-living-room.webp" alt="A bright living room with shared seating" width="2200" height="1467" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <section class="definition-section">
    <div class="container definition-layout">
      <div class="definition-copy">
        <p class="eyebrow">What Recovery Housing Is</p>
        <h2>A Bridge Toward Greater Independence</h2>
        <p class="lead">Recovery housing is a shared living environment for adults committed to building stable lives without alcohol or other drugs.</p>
        <p>Residents live alongside peers who understand the work of recovery. The home adds consistency and community while each person continues building connections to treatment, mutual-support groups, employment, education, family, and other community resources.</p>
        <aside class="scope-note">
          <span class="scope-note__icon icon-medallion"><Icon name="lucide:stethoscope" aria-hidden="true" /></span>
          <div>
            <p class="scope-note__label">Scope of service</p>
            <h3>Housing, Not Clinical Treatment</h3>
            <p>New Beginnings provides the living environment and recovery-focused structure. Clinical care remains with independent licensed providers.</p>
          </div>
        </aside>
      </div>
      <figure class="definition-photo">
        <img src="/images/house-kitchen.webp" alt="A kitchen and dining table in a welcoming home" width="2200" height="1467" loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="rhythm-section" id="daily-rhythm">
    <div class="container rhythm-layout">
      <header class="rhythm-heading split-intro">
        <div class="rhythm-heading__title">
          <p class="eyebrow">How the Environment Helps</p>
          <h2>Recovery Becomes Part of the Routine</h2>
        </div>
        <p>The important parts of a recovery residence are practical: consistency, shared responsibility, peer community, and connection to the wider recovery network.</p>
      </header>
      <div class="rhythm-composition">
        <figure class="rhythm-photo">
          <img src="/images/household-linens.webp" alt="Neatly folded household linens in a shared home" width="2200" height="1236" loading="lazy" />
        </figure>
        <div class="rhythm-field">
          <ol class="rhythm-list">
            {dailyRhythm.map((item) => (
              <li>
                <div class="rhythm-list__marker">
                  <Icon name={item.icon} aria-hidden="true" />
                  <span>{item.number}</span>
                </div>
                <div><h3>{item.title}</h3><p>{item.copy}</p></div>
              </li>
            ))}
          </ol>
          <aside class="crisis-note">
            <Icon name="lucide:circle-alert" aria-hidden="true" />
            <p><strong>Need immediate help?</strong> New Beginnings is not an emergency shelter or crisis service. Call 911 for an emergency, or call or text 988 for crisis support.</p>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <section class="pathways-section">
    <div class="container pathways-layout">
      <div class="pathways-content">
        <p class="eyebrow">Our Housing Network</p>
        <h2>Separate Residences. A Shared Purpose</h2>
        <p>New Beginnings provides recovery housing for adult men and women in established Pittsburgh-area communities.</p>
        <nav class="pathway-links" aria-label="Recovery housing options">
          <a href="/recovery-housing/men/">
            <span class="pathway-links__icon icon-medallion icon-medallion--sm"><Icon name="lucide:house" aria-hidden="true" /></span>
            <span><small>For adult men</small><strong>Men’s Recovery Housing</strong></span>
            <Icon class="pathway-links__arrow" name="lucide:arrow-up-right" aria-hidden="true" />
          </a>
          <a href="/recovery-housing/women/">
            <span class="pathway-links__icon icon-medallion icon-medallion--sm"><Icon name="lucide:house" aria-hidden="true" /></span>
            <span><small>For adult women</small><strong>Women’s Recovery Housing</strong></span>
            <Icon class="pathway-links__arrow" name="lucide:arrow-up-right" aria-hidden="true" />
          </a>
        </nav>
        <p class="pathways-location"><Icon name="lucide:map-pin" aria-hidden="true" />Public records reference {site.neighborhoods.join(', ')}. Additional homes serve other Pittsburgh-area communities.</p>
      </div>
      <figure class="pathways-photo">
        <img src="/images/pittsburgh.jpg" alt="The Pittsburgh skyline viewed across the rivers" width="1880" height="1253" loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="privacy-section" id="residence-privacy">
    <div class="container privacy-layout">
      <div class="privacy-content">
        <span class="privacy-content__icon icon-medallion icon-medallion--solid"><Icon name="lucide:lock-keyhole" aria-hidden="true" /></span>
        <p class="eyebrow">Residence Privacy</p>
        <h2>Useful Information Without Publishing Someone’s Home</h2>
        <p>New Beginnings does not publish individual house addresses, maps, or identifying exterior photographs. Exact locations are shared privately when they are relevant to an admissions or referral conversation.</p>
        <a class="button button--outline" href="/about/transparency/">
          Review Our Public Credentials
          <Icon name="lucide:arrow-right" aria-hidden="true" />
        </a>
      </div>
      <figure class="privacy-photo">
        <img src="/images/front-door.webp" alt="A welcoming residential front door viewed from inside" width="2200" height="3481" loading="lazy" />
      </figure>
    </div>
  </section>

  <CtaBand text="Start with a private, general conversation about availability and what you are looking for. Staff can explain what may happen next." />
</MainLayout>

<style>
  .housing-hero { border-bottom: 1px solid var(--slate-200); background: var(--paper); }
  .housing-hero__grid { display: grid; min-height: clamp(35rem, 53vw, 44rem); grid-template-columns: minmax(0, .93fr) minmax(0, 1.07fr); align-items: stretch; }
  .housing-hero__copy { display: flex; padding: clamp(4.5rem, 8vw, 7rem) clamp(2rem, 5vw, 4.5rem) clamp(4.5rem, 8vw, 7rem) 0; flex-direction: column; justify-content: center; }
  .housing-hero h1 { max-width: 10.5ch; margin-top: var(--space-4); font-size: var(--type-display-feature); }
  .housing-hero .lead { max-width: 35rem; margin-top: var(--space-5); }
  .housing-hero__actions { margin-top: var(--space-6); }
  .housing-hero__actions .button { gap: var(--button-gap); }
  .housing-hero__actions :global(svg) { width: 1rem; height: 1rem; }
  .housing-hero__scope { display: flex; width: fit-content; max-width: 32rem; margin-top: var(--space-7); padding: .8rem 1rem; align-items: center; gap: .7rem; color: var(--slate-600); background: var(--sky-50); font-size: .92rem; }
  .housing-hero__scope :global(svg) { width: 1.2rem; height: 1.2rem; color: var(--teal-700); stroke-width: 1.6; }
  .housing-hero__photo { margin: 0 calc((100vw - min(100vw - (var(--gutter) * 2), var(--max))) / -2) 0 0; overflow: hidden; background: var(--slate-200); }
  .housing-hero__photo img { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: saturate(.8) contrast(.96); }

  .definition-section { padding-block: var(--section-standard); background: var(--canvas); }
  .definition-layout { display: grid; grid-template-areas: 'photo copy'; grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr); gap: clamp(3rem, 8vw, 7rem); align-items: center; }
  .definition-photo { height: 35rem; margin: 0; overflow: hidden; grid-area: photo; box-shadow: var(--shadow-raised); }
  .definition-photo img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.82) contrast(.97); }
  .definition-copy { max-width: 42rem; grid-area: copy; }
  .definition-copy h2 { max-width: 13ch; margin-top: var(--space-4); }
  .definition-copy > .lead { margin-top: var(--space-6); }
  .definition-copy > p:not(.eyebrow):not(.lead) { margin-top: var(--space-4); }
  .scope-note { display: grid; margin-top: var(--space-7); padding: clamp(1.35rem, 2.5vw, 1.8rem); grid-template-columns: 3.25rem minmax(0, 1fr); gap: var(--space-4); align-items: start; background: var(--sky-50); }
  .scope-note__icon :global(svg) { width: 1.55rem; height: 1.55rem; }
  .scope-note__label { color: var(--teal-700); font-size: .72rem; font-weight: var(--weight-bold); letter-spacing: .12em; line-height: 1.2; text-transform: uppercase; }
  .scope-note h3 { margin-top: .35rem; font-size: 1.18rem; }
  .scope-note div > p:last-child { margin-top: .5rem; color: var(--slate-600); font-size: .94rem; line-height: 1.55; }

  .rhythm-section { padding-block: var(--section-standard); background: var(--sky-50); }
  .rhythm-heading__title h2 { margin-top: var(--space-4); }
  .rhythm-heading > p:last-child { max-width: 37rem; color: var(--slate-600); font-size: 1.1rem; line-height: 1.65; }
  .rhythm-composition { display: grid; margin-top: clamp(2.75rem, 6vw, 4.5rem); grid-template-columns: minmax(0, .72fr) minmax(0, 1.28fr); box-shadow: var(--shadow-raised); }
  .rhythm-photo { min-height: 43rem; margin: 0; overflow: hidden; background: var(--slate-200); }
  .rhythm-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: saturate(.78) contrast(.96); }
  .rhythm-field { display: flex; padding: clamp(2.5rem, 5.5vw, 4.5rem); flex-direction: column; justify-content: center; color: var(--white); background: var(--navy-900); }
  .rhythm-list { display: grid; margin: 0; padding: 0; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2.5rem, 5vw, 4rem) clamp(2rem, 5vw, 3.5rem); list-style: none; }
  .rhythm-list li { min-width: 0; }
  .rhythm-list__marker { display: flex; margin-bottom: var(--space-4); align-items: center; gap: .7rem; color: var(--accent-on-dark); }
  .rhythm-list__marker :global(svg) { width: 1.45rem; height: 1.45rem; stroke-width: 1.55; }
  .rhythm-list__marker span { font-size: .75rem; font-weight: var(--weight-bold); letter-spacing: .12em; }
  .rhythm-list h3 { max-width: 15rem; color: var(--white); font-size: 1.3rem; line-height: 1.2; }
  .rhythm-list p { max-width: 19rem; margin-top: .65rem; color: var(--sky-100); font-size: .96rem; line-height: 1.58; }
  .crisis-note { display: grid; margin-top: clamp(2.75rem, 5vw, 4rem); padding: var(--space-5); grid-template-columns: 1.5rem minmax(0, 1fr); gap: var(--space-3); color: var(--sky-100); background: rgba(255,255,255,.07); font-size: .9rem; line-height: 1.5; }
  .crisis-note :global(svg) { width: 1.2rem; height: 1.2rem; margin-top: .15rem; color: var(--accent-on-dark); stroke-width: 1.6; }
  .crisis-note strong { color: var(--white); font-weight: var(--weight-semibold); }

  .pathways-section { padding-block: var(--section-standard); color: var(--white); background: var(--navy-950); }
  .pathways-layout { display: grid; grid-template-areas: 'photo content'; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); align-items: stretch; }
  .pathways-photo { min-height: 38rem; margin: 0; overflow: hidden; grid-area: photo; }
  .pathways-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: saturate(.72) contrast(.96); }
  .pathways-content { display: flex; padding: clamp(2.5rem, 6vw, 5rem); background: var(--navy-900); flex-direction: column; justify-content: center; grid-area: content; }
  .pathways-content .eyebrow { color: var(--accent-on-dark); }
  .pathways-content h2 { max-width: 12ch; margin-top: var(--space-4); color: var(--white); }
  .pathways-content > p:not(.eyebrow):not(.pathways-location) { max-width: 34rem; margin-top: var(--space-5); color: var(--sky-100); }
  .pathway-links { display: grid; margin-top: var(--space-6); gap: .8rem; }
  .pathway-links a { display: grid; padding: 1.15rem 1.25rem; grid-template-columns: 2.65rem minmax(0, 1fr) auto; gap: var(--space-4); align-items: center; color: var(--white); background: var(--teal-700); box-shadow: 0 12px 30px rgba(5, 25, 35, .2); transition: transform .2s ease, background-color .2s ease; }
  .pathway-links a:nth-child(2) { color: var(--navy-950); background: var(--paper); }
  .pathway-links a:hover { color: var(--white); background: var(--teal-800); transform: translateY(-2px); }
  .pathway-links a:nth-child(2):hover { color: var(--navy-950); background: var(--sky-100); }
  .pathway-links__icon { color: var(--teal-700); background: var(--sky-100); }
  .pathway-links small, .pathway-links strong { display: block; }
  .pathway-links small { color: var(--accent-on-dark); font-size: .7rem; font-weight: var(--weight-bold); letter-spacing: .1em; text-transform: uppercase; }
  .pathway-links a:nth-child(2) small { color: var(--teal-700); }
  .pathway-links strong { margin-top: .15rem; font-size: 1.15rem; font-weight: var(--weight-semibold); }
  .pathway-links :global(svg) { width: 1.25rem; height: 1.25rem; stroke-width: 1.6; }
  .pathways-location { display: flex; max-width: 34rem; margin-top: var(--space-5); align-items: flex-start; gap: var(--button-gap); color: var(--sky-200); font-size: .9rem; line-height: 1.5; }
  .pathways-location :global(svg) { width: 1rem; height: 1rem; margin-top: .2rem; flex: 0 0 auto; }

  .privacy-section { padding-block: var(--section-standard); background: var(--paper); }
  .privacy-layout { display: grid; min-height: 31rem; grid-template-areas: 'photo content'; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); align-items: stretch; box-shadow: 0 1.15rem 3rem rgba(23,55,70,.12); }
  .privacy-photo { min-height: 31rem; margin: 0; overflow: hidden; background: var(--slate-200); grid-area: photo; }
  .privacy-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: saturate(.74) contrast(.98); }
  .privacy-content { display: flex; padding: clamp(var(--space-7), 6vw, var(--space-9)); background: var(--sky-50); flex-direction: column; align-items: flex-start; justify-content: center; grid-area: content; }
  .privacy-content__icon { margin-bottom: var(--space-6); }
  .privacy-content__icon :global(svg) { width: 1.55rem; height: 1.55rem; }
  .privacy-content h2 { max-width: 15ch; margin-top: var(--space-3); font-size: var(--type-section-medium); }
  .privacy-content > p:not(.eyebrow) { max-width: 38rem; margin-top: var(--space-5); }
  .privacy-content .button { margin-top: var(--space-6); gap: var(--space-2); }
  .privacy-content .button :global(svg) { width: 1rem; height: 1rem; }

  @media (max-width: 900px) {
    .housing-hero__grid, .definition-layout, .pathways-layout, .privacy-layout { grid-template-columns: 1fr; }
    .housing-hero__photo { height: clamp(20rem, 52vw, 28rem); margin: 0 calc(var(--gutter) * -1); }
    .housing-hero__copy { padding: var(--space-8) 0; }
    .definition-layout { grid-template-areas: 'copy' 'photo'; gap: var(--space-7); }
    .definition-photo { height: auto; aspect-ratio: 16 / 10; }
    .rhythm-composition { grid-template-columns: 1fr; }
    .rhythm-heading > p:last-child { max-width: 40rem; }
    .rhythm-photo { min-height: 0; aspect-ratio: 16 / 8.5; }
    .pathways-layout { grid-template-areas: 'content' 'photo'; box-shadow: var(--shadow-raised); }
    .pathways-photo { height: clamp(18rem, 48vw, 26rem); min-height: 0; }
    .privacy-layout { min-height: 0; grid-template-areas: 'content' 'photo'; }
    .privacy-photo { min-height: 0; aspect-ratio: 16 / 9; }
  }

  @media (max-width: 760px) {
    .housing-hero__photo { height: 16rem; }
    .housing-hero__copy { padding-block: var(--space-7); }
    .housing-hero h1 { font-size: clamp(2.7rem, 12vw, 3.55rem); }
    .housing-hero__actions { display: grid; }
    .housing-hero__actions .button { width: 100%; }
    .housing-hero__scope { width: 100%; }
    .definition-layout { gap: var(--space-6); }
    .definition-photo { aspect-ratio: 4 / 3; }
    .scope-note { grid-template-columns: 2.75rem minmax(0, 1fr); gap: var(--space-3); }
    .rhythm-photo { aspect-ratio: 4 / 3; }
    .rhythm-field { padding: var(--space-7) var(--space-5); }
    .rhythm-list { grid-template-columns: 1fr; gap: var(--space-7); }
    .rhythm-list h3, .rhythm-list p { max-width: none; }
    .crisis-note { padding: var(--space-4); }
    .pathway-links a { padding: 1rem; grid-template-columns: 2.35rem minmax(0, 1fr) auto; gap: .8rem; }
    .pathways-content { padding: var(--space-7) var(--space-5); }
    .privacy-content { padding: var(--space-7) var(--space-5); }
    .privacy-content .button { width: 100%; }
  }
</style>
