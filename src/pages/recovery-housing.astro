---
import { Icon } from 'astro-icon/components';
import Hero from '../components/Hero.astro';
import SplitPanel from '../components/SplitPanel.astro';
import MainLayout from '../layouts/MainLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

const dailyRhythm = [
  {
    number: '01',
    icon: 'lucide:shield-check',
    title: 'Substance Free, No Exceptions',
    copy: 'No alcohol, no drugs, no prescription narcotics. Random drug screens throughout your stay. Refusing a screen counts as a failed one.',
  },
  {
    number: '02',
    icon: 'lucide:users-round',
    title: 'Weekly House Meeting',
    copy: 'Every resident attends the mandatory in-house meeting each week. It’s where the house sorts out chores, problems, and plans.',
  },
  {
    number: '03',
    icon: 'lucide:route',
    title: 'AA and NA',
    copy: 'Our houses are 12-step based. You’re expected to go to outside meetings, get a sponsor, and work a program.',
  },
  {
    number: '04',
    icon: 'lucide:house',
    title: 'Respect the House',
    copy: 'No threats or violence, on or off the property. Bags are checked at move-in and rooms can be searched. Everyone does their share.',
  },
];
---

<MainLayout title="Recovery Housing" description="What a recovery house is, how New Beginnings’ Pittsburgh recovery houses run, and what every resident can expect.">
  <Hero
    variant="split"
    tone="paper"
    eyebrow="Recovery Housing in Pittsburgh"
    title="What a Recovery House Actually Is"
    lead="Recovery housing, also called sober living or a recovery house, is a substance-free home where adults in recovery live together, follow house rules, and back each other up while getting on with life. Here’s how ours work."
    image={{ src: '/images/house-living-room.webp', alt: 'A bright living room with shared seating', width: 2200, height: 1467 }}
  >
    <Fragment slot="actions">
      <a class="button" href="/admissions/">Ask About a Bed<Icon name="lucide:arrow-right" aria-hidden="true" /></a>
      <a class="button button--outline" href="/referrals/">For Professionals</a>
    </Fragment>
    <p class="housing-hero__scope"><Icon name="lucide:house" aria-hidden="true" />Men’s houses in four neighborhoods and one women’s house</p>
  </Hero>

  <section class="definition-section">
    <div class="container definition-layout">
      <div class="definition-copy">
        <p class="eyebrow">The Basics</p>
        <h2>The Safe Place Between Treatment and Life on Your Own</h2>
        <p class="lead">A recovery house fills the gap most people fall into: after detox or rehab, before you’re ready to live alone and stay sober doing it.</p>
        <p>You live with other people in recovery. You go to meetings, keep a job or look for one, do your share around the house, and come home to a place where nobody is using. You keep seeing your own counselor or doctor. The house isn’t treatment. It’s a stable place to live while you do the work.</p>
        <aside class="scope-note">
          <span class="scope-note__icon icon-medallion"><Icon name="lucide:stethoscope" aria-hidden="true" /></span>
          <div>
            <p class="scope-note__label">Not a shelter. Not a treatment program</p>
            <h3>Housing, Not Treatment</h3>
            <p>New Beginnings doesn’t provide counseling, detox, or medical care. Keep those with your own providers, and live here while you do.</p>
          </div>
        </aside>
      </div>
      <figure class="definition-photo">
        <img src="/images/house-kitchen.webp" alt="A kitchen and dining table in a welcoming home" width="2200" height="1467" loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="pathways-section">
    <div class="container">
      <SplitPanel tone="navy" padding="lg" photo={{ src: '/images/pittsburgh.jpg', alt: 'The Pittsburgh skyline viewed across the rivers', width: 1880, height: 1253 }} photoFraction={1.05} contentFraction={0.95} minHeight="38rem">
      <div class="pathways-content">
        <p class="eyebrow">Our Houses</p>
        <h2>Separate Houses for Men and Women</h2>
        <p>New Beginnings runs men’s houses on Pittsburgh’s North Side and in the West End, McKees Rocks, and Mount Oliver, and a women’s house on the North Side. They’re regular houses on regular streets, not facilities.</p>
        <nav class="pathway-links" aria-label="Recovery housing options">
          <a href="/recovery-housing/men/">
            <span class="pathway-links__icon icon-medallion icon-medallion--sm"><Icon name="lucide:house" aria-hidden="true" /></span>
            <span><small>North Side, West End, and South Hills</small><strong>Men’s Recovery Housing</strong></span>
            <Icon class="pathway-links__arrow" name="lucide:arrow-up-right" aria-hidden="true" />
          </a>
          <a href="/recovery-housing/women/">
            <span class="pathway-links__icon icon-medallion icon-medallion--sm"><Icon name="lucide:house" aria-hidden="true" /></span>
            <span><small>North Side</small><strong>Women’s Recovery Housing</strong></span>
            <Icon class="pathway-links__arrow" name="lucide:arrow-up-right" aria-hidden="true" />
          </a>
        </nav>
        <p class="pathways-location"><Icon name="lucide:map-pin" aria-hidden="true" />Houses on the North Side and in the West End, McKees Rocks, and Mount Oliver. Administrative office in Mt. Washington.</p>
      </div>
      </SplitPanel>
    </div>
  </section>
  <section class="rhythm-section" id="daily-rhythm">
    <div class="container rhythm-layout">
      <header class="rhythm-heading split-intro">
        <div class="rhythm-heading__title">
          <p class="eyebrow">How the House Works</p>
          <h2>What Every Resident Can Expect</h2>
        </div>
        <p>The rules are the same in every New Beginnings house. They’re simple and they’re not negotiable, because they keep the house safe for everyone living in it.</p>
      </header>
      <div class="rhythm-composition">
        <SplitPanel tone="navy" photo={{ src: '/images/household-linens.webp', alt: 'Neatly folded household linens in a shared home', width: 2200, height: 1236 }} photoFraction={0.72} contentFraction={1.28}>
        <div class="rhythm-field">
          <ol class="rhythm-list">
            {dailyRhythm.map((item) => (
              <li>
                <div class="rhythm-list__marker">
                  <Icon name={item.icon} aria-hidden="true" />
                  <span>{item.number}</span>
                </div>
                <div><h3>{item.title}</h3><p>{item.copy}</p></div>
              </li>
            ))}
          </ol>
          <aside class="crisis-note">
            <Icon name="lucide:circle-alert" aria-hidden="true" />
            <p><strong>Need help right now?</strong> New Beginnings isn’t an emergency shelter or crisis line. Call 911 for an emergency, or call or text 988 for crisis support.</p>
          </aside>
        </div>
        </SplitPanel>
      </div>
    </div>
  </section>



  <CtaBand text={`Call ${site.phone} or send the application. Tell us which house you’re asking about and we’ll tell you what’s open, what it costs, and what the house expects.`} />
</MainLayout>
<style>
  .housing-hero{ border-bottom: 1px solid var(--slate-200); background: var(--paper); }
  .housing-hero__scope{ display: flex; width: fit-content; max-width: 32rem; margin-top: var(--space-7); padding: .8rem 1rem; align-items: center; gap: .7rem; color: var(--slate-600); background: var(--sky-50); font-size: .92rem; }
  .housing-hero__scope :global(svg){ width: 1.2rem; height: 1.2rem; color: var(--teal-700); stroke-width: 1.6; }

  .definition-section{ padding-block: var(--section-standard); background: var(--canvas); }
  .definition-layout{ display: grid; grid-template-areas: 'photo copy'; grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr); gap: clamp(3rem, 8vw, 7rem); align-items: center; }
  .definition-photo{ border-radius: var(--radius-md); height: 35rem; margin: 0; overflow: hidden; grid-area: photo; box-shadow: var(--shadow-raised); }
  .definition-photo img{ width: 100%; height: 100%; object-fit: cover; filter: var(--photo-filter); }
  .definition-copy{ max-width: 42rem; grid-area: copy; }
  .definition-copy h2{ max-width: 24ch; margin-top: var(--space-4); }
  .definition-copy > .lead{ margin-top: var(--space-6); }
  .definition-copy > p:not(.eyebrow):not(.lead){ margin-top: var(--space-4); }
  .scope-note{ border-radius: var(--radius-md); display: grid; margin-top: var(--space-7); padding: clamp(1.35rem, 2.5vw, 1.8rem); grid-template-columns: 3.25rem minmax(0, 1fr); gap: var(--space-4); align-items: start; background: var(--sky-50); }
  .scope-note__icon :global(svg){ width: 1.55rem; height: 1.55rem; }
  .scope-note__label{ color: var(--teal-700); font-size: .72rem; font-weight: var(--weight-bold); letter-spacing: .12em; line-height: 1.2; text-transform: uppercase; }
  .scope-note h3{ margin-top: .35rem; font-size: 1.18rem; }
  .scope-note div > p:last-child{ margin-top: .5rem; color: var(--slate-600); font-size: .94rem; line-height: 1.55; }

  .rhythm-section{ padding-block: var(--section-standard); background: var(--sky-50); }
  .rhythm-heading__title h2{ margin-top: var(--space-4); }
  .rhythm-heading > p:last-child{ max-width: 37rem; color: var(--slate-600); font-size: 1.1rem; line-height: 1.65; }
  .rhythm-composition { margin-top: clamp(2.75rem, 6vw, 4.5rem); }
  .rhythm-field { color: var(--white); }
  .rhythm-list{ display: grid; margin: 0; padding: 0; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2.5rem, 5vw, 4rem) clamp(2rem, 5vw, 3.5rem); list-style: none; }
  .rhythm-list li{ min-width: 0; }
  .rhythm-list__marker{ display: flex; margin-bottom: var(--space-4); align-items: center; gap: .7rem; color: var(--accent-on-dark); }
  .rhythm-list__marker :global(svg){ width: 1.45rem; height: 1.45rem; stroke-width: 1.55; }
  .rhythm-list__marker span{ font-size: .75rem; font-weight: var(--weight-bold); letter-spacing: .12em; }
  .rhythm-list h3{ max-width: 15rem; color: var(--white); font-size: 1.3rem; line-height: 1.2; }
  .rhythm-list p{ max-width: 19rem; margin-top: .65rem; color: var(--sky-100); font-size: .96rem; line-height: 1.58; }
  .crisis-note{ border-radius: var(--radius-md); display: grid; margin-top: clamp(2.75rem, 5vw, 4rem); padding: var(--space-5); grid-template-columns: 1.5rem minmax(0, 1fr); gap: var(--space-3); color: var(--sky-100); background: var(--surface-on-dark); font-size: .9rem; line-height: 1.5; }
  .crisis-note :global(svg){ width: 1.2rem; height: 1.2rem; margin-top: .15rem; color: var(--accent-on-dark); stroke-width: 1.6; }
  .crisis-note strong{ color: var(--white); font-weight: var(--weight-semibold); }

  .pathways-section{ padding-block: var(--section-standard); color: var(--white); background: var(--navy-950); }
  .pathways-content { color: var(--white); }
  .pathways-content .eyebrow{ color: var(--accent-on-dark); }
  .pathways-content h2{ max-width: 24ch; margin-top: var(--space-4); color: var(--white); }
  .pathways-content > p:not(.eyebrow):not(.pathways-location){ max-width: 34rem; margin-top: var(--space-5); color: var(--sky-100); }
  .pathway-links{ display: grid; margin-top: var(--space-6); gap: .8rem; }
  .pathway-links a{ border-radius: var(--radius-sm); overflow: hidden; display: grid; padding: 1.15rem 1.25rem; grid-template-columns: 2.65rem minmax(0, 1fr) auto; gap: var(--space-4); align-items: center; color: var(--white); background: var(--teal-700); box-shadow: var(--shadow-photo); transition: transform .2s ease, background-color .2s ease; }
  .pathway-links a:nth-child(2){ color: var(--navy-950); background: var(--paper); }
  .pathway-links a:hover{ color: var(--white); background: var(--teal-800); transform: translateY(-2px); }
  .pathway-links a:nth-child(2):hover{ color: var(--navy-950); background: var(--sky-100); }
  .pathway-links__icon{ color: var(--teal-700); background: var(--sky-100); }
  .pathway-links small, .pathway-links strong{ display: block; }
  .pathway-links small{ color: var(--accent-on-dark); font-size: .7rem; font-weight: var(--weight-bold); letter-spacing: .1em; text-transform: uppercase; }
  .pathway-links a:nth-child(2) small{ color: var(--teal-700); }
  .pathway-links strong{ margin-top: .15rem; font-size: 1.15rem; font-weight: var(--weight-semibold); }
  .pathway-links :global(svg){ width: 1.25rem; height: 1.25rem; stroke-width: 1.6; }
  .pathways-location{ display: flex; max-width: 34rem; margin-top: var(--space-5); align-items: flex-start; gap: var(--button-gap); color: var(--sky-200); font-size: .9rem; line-height: 1.5; }
  .pathways-location :global(svg){ width: 1rem; height: 1rem; margin-top: .2rem; flex: 0 0 auto; }

  @media (max-width: 900px) {
    .definition-layout{ grid-template-columns: 1fr; }
    .housing-hero{ position: relative; overflow: hidden; border-bottom: 0; color: var(--white); background: var(--navy-950); }
    .housing-hero__scope{ color: var(--sky-100); background: var(--surface-on-dark); }
    .housing-hero__scope :global(svg){ color: var(--accent-on-dark); }
    .definition-layout{ grid-template-areas: 'copy' 'photo'; gap: var(--space-7); }
    .definition-photo{ height: auto; aspect-ratio: 16 / 10; }
    .rhythm-composition{ grid-template-columns: 1fr; }
    .rhythm-heading > p:last-child{ max-width: 40rem; }
  }

  @media (max-width: 760px) {
    .housing-hero__scope{ width: 100%; }
    .definition-layout{ gap: var(--space-6); }
    .definition-photo{ aspect-ratio: 4 / 3; }
    .scope-note{ grid-template-columns: 2.75rem minmax(0, 1fr); gap: var(--space-3); }
    .rhythm-field{ padding: var(--space-7) var(--space-5); }
    .rhythm-list{ grid-template-columns: 1fr; gap: var(--space-7); }
    .rhythm-list h3, .rhythm-list p{ max-width: none; }
    .crisis-note{ padding: var(--space-4); }
    .pathway-links a{ padding: 1rem; grid-template-columns: 2.35rem minmax(0, 1fr) auto; gap: .8rem; }
    .pathways-content{ padding: var(--space-7) var(--space-5); }
  }

  /* Mobile floor: 16px copy, one alignment per section, 44px tap targets. Measured by scripts/mobile-audit.mjs */
  @media (max-width: 900px) {
    .housing-hero__scope, .definition-copy p, .rhythm-list p, .crisis-note p, .pathways-location{ font-size: 1rem; line-height: 1.55; }
    .scope-note p{ font-size: 1rem; }
    .scope-note div > p:not(.scope-note__label){ font-size: 1rem; line-height: 1.55; }
  }
</style>
