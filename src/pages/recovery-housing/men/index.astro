---
import { Icon } from 'astro-icon/components';
import MainLayout from '../../../layouts/MainLayout.astro';
import CtaBand from '../../../components/CtaBand.astro';

const householdRhythm = [
  {
    icon: 'calendar-check',
    title: 'Clear expectations',
    copy: 'A shared framework helps make the residence more consistent for everyone who lives there.',
  },
  {
    icon: 'users-round',
    title: 'Peer community',
    copy: 'Residents live alongside other men who are taking the daily work of recovery seriously.',
  },
  {
    icon: 'briefcase-business',
    title: 'Everyday responsibility',
    copy: 'Work, education, appointments, meetings, and household responsibilities remain part of ordinary life.',
  },
  {
    icon: 'waypoints',
    title: 'Outside connection',
    copy: 'Treatment and other clinical services remain with independent licensed providers and community resources.',
  },
];
---

<MainLayout title="Men’s Recovery Housing" description="Structured recovery housing for adult men in Pittsburgh-area communities.">
  <section class="men-hero">
    <div class="container men-hero__grid">
      <div class="men-hero__copy">
        <p class="eyebrow">Men’s recovery housing</p>
        <h1>A structured place to keep moving forward.</h1>
        <p class="lead">Substance-free shared residences for adult men, with peer community and clear expectations built into daily life.</p>
        <div class="actions men-hero__actions">
          <a class="button button--light" href="/admissions/">Begin with admissions<Icon name="lucide:arrow-right" aria-hidden="true" /></a>
          <a class="men-hero__phone" href="tel:+14126280403"><Icon name="lucide:phone" aria-hidden="true" />Call 412-628-0403</a>
        </div>
      </div>
      <figure class="men-hero__photo">
        <img src="/images/home-entry.webp" alt="A home entry and staircase" width="2200" height="1467" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <section class="rhythm-section">
    <div class="container">
      <header class="rhythm-intro">
        <div>
          <p class="eyebrow">A place to rebuild routines</p>
          <h2>Recovery continues when the day becomes ordinary again.</h2>
        </div>
        <p class="lead">A dependable home creates space to focus on the responsibilities, relationships, and recovery connections that shape everyday life.</p>
      </header>

      <div class="rhythm-stage">
        <figure class="rhythm-photo">
          <img src="/images/rustic-dining-room.webp" alt="A warm dining room with a table and chairs" width="1600" height="2133" loading="lazy" />
        </figure>
        <div class="rhythm-copy">
          <p class="eyebrow">Inside the household</p>
          <p class="rhythm-copy__lead">New Beginnings provides substance-free shared housing for adult men. Residents live alongside peers in a recovery-focused household while remaining connected to independent treatment and community recovery resources.</p>
          <div class="rhythm-points" role="list">
            {householdRhythm.map((item) => (
              <article role="listitem">
                <Icon name={`lucide:${item.icon}`} aria-hidden="true" />
                <div><h3>{item.title}</h3><p>{item.copy}</p></div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="daily-section">
    <div class="daily-layout">
      <figure class="daily-photo">
        <img src="/images/house-living-room.webp" alt="A comfortable shared living room" width="2200" height="1467" loading="lazy" />
      </figure>
      <div class="daily-copy">
        <div class="daily-copy__inner">
          <p class="eyebrow">Life beyond the residence</p>
          <h2>A home can support the day without replacing it.</h2>
          <p class="lead">Recovery housing adds stability around the responsibilities a resident already carries.</p>
          <p>It is not inpatient care, a medical facility, or a substitute for professional treatment. The residence is one part of a wider recovery network that may include work, education, family, meetings, counseling, medical care, and other independent supports.</p>
          <a class="text-link" href="/recovery-housing/">How recovery housing works</a>
        </div>
      </div>
    </div>
  </section>

  <section class="location-section">
    <div class="container location-layout">
      <header class="location-heading">
        <Icon name="lucide:map-pin" aria-hidden="true" />
        <div><p class="eyebrow">Where we serve</p><h2>Pittsburgh-area communities.</h2></div>
      </header>
      <div class="location-details">
        <p>Public records reference <strong>Sheraden</strong> and <strong>McKees Rocks</strong>. Additional homes serve other Pittsburgh-area communities.</p>
        <p class="location-private"><Icon name="lucide:lock-keyhole" aria-hidden="true" />Exact residence locations are shared privately during the admissions process. Identifying exterior photographs are not published.</p>
      </div>
    </div>
  </section>

  <section class="first-step-section">
    <div class="container first-step-layout">
      <div>
        <p class="eyebrow">The first step</p>
        <h2>Begin with a general conversation.</h2>
      </div>
      <div class="first-step-copy">
        <p>Staff can explain the current admissions process, discuss general fit and availability, and provide exact location information privately when appropriate.</p>
        <aside class="first-step-privacy">
          <Icon name="lucide:lock-keyhole" aria-hidden="true" />
          <p><strong>Keep the first message general.</strong> Do not send diagnoses, medication details, treatment records, criminal-history information, Social Security numbers, or other sensitive information through the website.</p>
        </aside>
      </div>
    </div>
  </section>

  <CtaBand title="Ask about men’s recovery housing." label="Begin with admissions" text="Start with a private, general conversation. Staff can explain the current process and what may happen next." />
</MainLayout>

<style>
  .men-hero { color: var(--white); background: var(--navy-950); }
  .men-hero__grid { display: grid; min-height: clamp(34rem, 52vw, 43rem); grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); align-items: stretch; }
  .men-hero__copy { display: flex; padding: clamp(4.5rem, 8vw, 7rem) clamp(2.5rem, 6vw, 5rem) clamp(4.5rem, 8vw, 7rem) 0; flex-direction: column; justify-content: center; }
  .men-hero .eyebrow { color: #9ed7d2; }
  .men-hero h1 { max-width: 10.5ch; margin-top: var(--space-4); color: var(--white); font-size: clamp(3.1rem, 5.7vw, 5.35rem); }
  .men-hero .lead { max-width: 35rem; margin-top: var(--space-5); color: var(--sky-100); }
  .men-hero__actions { margin-top: var(--space-6); }
  .men-hero__actions .button { gap: .6rem; }
  .men-hero__actions :global(svg) { width: 1rem; height: 1rem; }
  .men-hero__phone { display: inline-flex; min-height: 3.25rem; padding-inline: .4rem; align-items: center; gap: .55rem; color: var(--white); font-weight: 650; }
  .men-hero__phone:hover { color: #b9e5e1; }
  .men-hero__phone :global(svg) { width: 1.05rem; height: 1.05rem; }
  .men-hero__photo { margin: 0 calc((100vw - min(100vw - (var(--gutter) * 2), var(--max))) / -2) 0 0; overflow: hidden; background: var(--navy-900); }
  .men-hero__photo img { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: saturate(.74) contrast(.98); }

  .rhythm-section { padding-block: var(--section-standard); background: var(--canvas); }
  .rhythm-intro { display: grid; margin-bottom: var(--space-7); grid-template-columns: minmax(0, .88fr) minmax(0, 1.12fr); gap: var(--gap-columns); align-items: end; }
  .rhythm-intro h2 { max-width: 13ch; margin-top: var(--space-4); }
  .rhythm-intro .lead { max-width: 36rem; padding-bottom: .35rem; }
  .rhythm-stage { display: grid; min-height: 36rem; grid-template-columns: minmax(17rem, .68fr) minmax(0, 1.32fr); box-shadow: var(--shadow-raised); }
  .rhythm-photo { min-height: 100%; margin: 0; overflow: hidden; background: var(--slate-200); }
  .rhythm-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 58%; filter: saturate(.72) contrast(.98); }
  .rhythm-copy { display: flex; padding: clamp(2.5rem, 5vw, 4.5rem); color: var(--white); background: var(--navy-900); flex-direction: column; justify-content: center; }
  .rhythm-copy .eyebrow { color: #9ed7d2; }
  .rhythm-copy__lead { max-width: 45rem; margin-top: var(--space-4); color: var(--sky-100); font-size: clamp(1.1rem, 1.6vw, 1.28rem); line-height: 1.55; }
  .rhythm-points { display: grid; margin-top: clamp(2.5rem, 5vw, 4rem); grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2rem, 4vw, 3.25rem) clamp(1.75rem, 4vw, 3rem); }
  .rhythm-points article { display: grid; grid-template-columns: 2.3rem minmax(0, 1fr); gap: var(--space-4); align-items: start; }
  .rhythm-points article > :global(svg) { width: 1.85rem; height: 1.85rem; color: #9ed7d2; stroke-width: 1.5; }
  .rhythm-points h3 { color: var(--white); font-size: 1.2rem; }
  .rhythm-points p { max-width: 29rem; margin-top: .45rem; color: var(--sky-200); font-size: .96rem; line-height: 1.5; }

  .daily-section { background: var(--sky-50); }
  .daily-layout { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); align-items: stretch; }
  .daily-photo { min-height: 40rem; margin: 0; overflow: hidden; }
  .daily-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: saturate(.78) contrast(.98); }
  .daily-copy { display: grid; padding: var(--section-standard) var(--gutter); align-items: center; }
  .daily-copy__inner { width: min(100%, 35rem); }
  .daily-copy h2 { max-width: 13ch; margin-top: var(--space-4); }
  .daily-copy .lead { margin-top: var(--space-6); }
  .daily-copy p:not(.eyebrow):not(.lead) { margin-top: var(--space-4); }
  .daily-copy .text-link { margin-top: var(--space-6); }

  .location-section { padding-block: var(--section-compact); border-bottom: 1px solid var(--slate-200); background: var(--paper); }
  .location-layout { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: var(--gap-columns); align-items: start; }
  .location-heading { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: var(--space-4); }
  .location-heading :global(svg) { width: 2rem; height: 2rem; color: var(--teal-700); stroke-width: 1.55; }
  .location-heading h2 { max-width: 14ch; margin-top: var(--space-3); font-size: clamp(1.85rem, 3vw, 2.6rem); }
  .location-details { max-width: 43rem; }
  .location-details strong { color: var(--navy-900); font-weight: 600; }
  .location-private { display: grid; margin-top: var(--space-5); padding: var(--space-5); background: var(--sky-50); grid-template-columns: 1.5rem minmax(0, 1fr); gap: var(--space-3); color: var(--slate-600); font-size: .94rem; line-height: 1.55; }
  .location-private :global(svg) { width: 1.2rem; height: 1.2rem; margin-top: .15rem; color: var(--teal-700); stroke-width: 1.6; }

  .first-step-section { padding-block: var(--section-standard); background: var(--canvas); }
  .first-step-layout { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: var(--gap-columns); align-items: start; }
  .first-step-layout h2 { max-width: 12ch; margin-top: var(--space-4); }
  .first-step-copy { max-width: 43rem; }
  .first-step-privacy { display: grid; margin-top: var(--space-6); padding: var(--space-5); background: var(--paper); box-shadow: var(--shadow); grid-template-columns: 1.5rem minmax(0, 1fr); gap: var(--space-3); color: var(--slate-600); font-size: .94rem; line-height: 1.55; }
  .first-step-privacy :global(svg) { width: 1.2rem; height: 1.2rem; margin-top: .15rem; color: var(--teal-700); stroke-width: 1.6; }
  .first-step-copy strong { color: var(--navy-900); font-weight: 600; }

  @media (max-width: 900px) {
    .men-hero__grid, .rhythm-intro, .rhythm-stage, .daily-layout, .location-layout, .first-step-layout { grid-template-columns: 1fr; }
    .men-hero__photo { order: -1; height: clamp(20rem, 52vw, 27rem); margin: 0 calc(var(--gutter) * -1); }
    .men-hero__copy { padding: var(--space-8) 0; }
    .rhythm-intro, .location-layout, .first-step-layout { gap: var(--space-7); }
    .rhythm-intro .lead { max-width: 43rem; }
    .rhythm-photo { height: clamp(19rem, 47vw, 25rem); min-height: 0; }
    .daily-photo { height: clamp(21rem, 55vw, 29rem); min-height: 0; }
    .daily-copy { padding-block: var(--space-8); }
    .daily-copy__inner { width: min(100%, 43rem); margin-inline: auto; }
  }

  @media (max-width: 560px) {
    .men-hero__photo { height: 16rem; }
    .men-hero__copy { padding-block: var(--space-7); }
    .men-hero h1 { font-size: clamp(2.7rem, 12vw, 3.55rem); }
    .men-hero__actions { display: grid; }
    .men-hero__actions .button, .men-hero__phone { width: 100%; justify-content: center; }
    .rhythm-intro, .location-layout, .first-step-layout { gap: var(--space-6); }
    .rhythm-copy { padding: var(--space-7) var(--space-5); }
    .rhythm-points { grid-template-columns: 1fr; gap: var(--space-6); }
    .daily-photo { height: 17rem; }
    .daily-copy { padding-inline: var(--gutter); }
  }
</style>
