---
import MainLayout from '../layouts/MainLayout.astro';
import HousingApplication from '../components/HousingApplication.astro';
---

<MainLayout title="Admissions" description="Apply for a bed in a New Beginnings sober living house for men or women in Pittsburgh, or call 412-628-0403.">
  <section class="admissions-masthead">
    <div class="container masthead-inner">
      <p class="eyebrow">Admissions</p>
      <h1>Apply for Recovery Housing</h1>
      <p class="lead">Fill this out and we will call you back. Or skip it and call 412-628-0403. Either way works, and you do not need a referral.</p>
      <p class="masthead-note">This is the first step, not a guarantee of a bed. Openings change week to week, so the sooner we talk, the better.</p>
    </div>
  </section>

  <HousingApplication />
</MainLayout>

<style>
  .admissions-masthead { padding-block: clamp(3rem, 5vw, 4.5rem); color: var(--white); background: var(--navy-950); }
  .masthead-inner { display: grid; max-width: 70rem; gap: var(--space-4); }
  .admissions-masthead .eyebrow { color: var(--accent-on-dark); }
  .admissions-masthead h1 { max-width: 15ch; color: var(--white); font-size: var(--type-display-compact); }
  .admissions-masthead .lead { max-width: 45rem; color: var(--sky-100); }
  .masthead-note { max-width: 45rem; color: var(--sky-200); font-size: .98rem; }

  @media (max-width: 520px) {
    .admissions-masthead { padding-block: 2.75rem; }
  }
</style>
