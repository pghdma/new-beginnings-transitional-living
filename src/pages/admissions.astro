---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import InquiryForm from '../components/InquiryForm.astro';
import IconBadge from '../components/IconBadge.astro';
import SectionHead from '../components/SectionHead.astro';
---
<MainLayout title="Admissions">
  <PageHero eyebrow="Admissions" title="The first step is a conversation." intro="Call or send a general inquiry. We will learn what you are looking for and explain the next appropriate step." image="/images/admissions.jpg" imageAlt="A notebook and cup on a clean table in a quiet room" />
  <section class="section"><div class="container"><SectionHead eyebrow="How to begin" title="A clear, private starting point." intro="You do not need to send your full history through the website. Start with your name, contact information, and whether you are calling for yourself, a loved one, or a client." /><ol class="steps grid-3"><li class="card"><IconBadge name="phone" /><span>01</span><h3>Reach out</h3><p>Call 412-628-0403 or send the short inquiry form below.</p></li><li class="card"><IconBadge name="messages-square" /><span>02</span><h3>Talk with us</h3><p>We will discuss your general needs and explain the current intake process.</p></li><li class="card"><IconBadge name="clipboard-check" /><span>03</span><h3>Review next steps</h3><p>If a New Beginnings residence may be appropriate, exact location and required information are shared privately.</p></li></ol></div></section>
  <section class="section section--tint"><div class="container grid-2"><div><p class="eyebrow">Before you submit</p><h2>Protect your private information.</h2></div><div><p class="lead">The website form is only for an initial inquiry.</p><p>Do not include diagnoses, medication information, treatment records, criminal-history details, Social Security numbers, or other sensitive information. Those details should only be discussed through an appropriate private intake process.</p><p>If you are experiencing a medical emergency, call 911. If you or someone else is in emotional distress or at risk of suicide, call or text 988.</p></div></div></section>
  <InquiryForm title="Begin a housing inquiry" />
</MainLayout>
<style>.steps { padding: 0; list-style: none; }.steps span { color: var(--blue-600); font-size: .8rem; font-weight: 750; letter-spacing: .12em; }</style>
