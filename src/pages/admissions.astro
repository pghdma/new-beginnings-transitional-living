---
import MainLayout from '../layouts/MainLayout.astro';
import HousingApplication from '../components/HousingApplication.astro';
---

<MainLayout title="Admissions" description="Ask about current recovery housing availability with New Beginnings in Pittsburgh.">
  <section class="admissions-masthead">
    <div class="container masthead-inner">
      <p class="eyebrow">Admissions</p>
      <h1>Recovery Housing Application</h1>
      <p class="lead">Complete this application to ask about current availability in a New Beginnings home for adult men or women.</p>
      <p class="masthead-note">Submitting an application begins a review. It does not guarantee admission or an available room.</p>
    </div>
  </section>

  <HousingApplication />
</MainLayout>

<style>
  .admissions-masthead { padding-block: clamp(3rem, 5vw, 4.5rem); color: var(--white); background: var(--navy-950); }
  .masthead-inner { display: grid; max-width: 70rem; gap: var(--space-4); }
  .admissions-masthead .eyebrow { color: #9ed7d2; }
  .admissions-masthead h1 { max-width: 15ch; color: var(--white); font-size: clamp(2.65rem, 5vw, 4.5rem); }
  .admissions-masthead .lead { max-width: 45rem; color: var(--sky-100); }
  .masthead-note { max-width: 45rem; color: var(--sky-200); font-size: .98rem; }

  @media (max-width: 520px) {
    .admissions-masthead { padding-block: 2.75rem; }
  }
</style>
