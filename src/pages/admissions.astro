---
import ApplicationForm from '../components/ApplicationForm.astro';
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Admissions" description="Apply for a bed in a New Beginnings recovery house for men or women in Pittsburgh, or call 412-628-0403.">
  <section class="apply">
    <div class="container">
      <ApplicationForm />
    </div>
  </section>
</MainLayout>

<style>
  /* The page is the form: one card, sized to sit within a laptop screen below the header. */
  .apply { min-height: calc(100svh - var(--header-total-height)); padding-block: var(--space-4) var(--space-8); background: var(--sky-50); }

  @media (max-width: 760px) {
    .apply { padding-block: var(--space-5) var(--space-7); }
  }
</style>
