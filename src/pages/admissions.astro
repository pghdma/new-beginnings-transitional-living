---
import { Icon } from 'astro-icon/components';
import ApplicationForm from '../components/ApplicationForm.astro';
import StepList from '../components/StepList.astro';
import MainLayout from '../layouts/MainLayout.astro';
import { site } from '../data/site';

const nextSteps = [
  { title: 'We call you back', copy: 'At the number you give us, to ask a few questions and answer yours.' },
  { title: 'We talk through the fit', copy: 'What’s open, what it costs, and what the house expects.' },
  { title: 'You move in', copy: 'If it’s a fit and a bed is open, you get the address, the move-in list, and a date.' },
];
---

<MainLayout title="Admissions" description="Apply for a bed in a New Beginnings recovery house for men or women in Pittsburgh, or call 412-628-0403.">
  <section class="apply">
    <div class="container apply__layout">
      <ApplicationForm />

      <aside class="apply__aside" aria-label="What happens next">
        <div class="aside-card">
          <p class="eyebrow">What happens next</p>
          <StepList items={nextSteps} numbers="circle" />
          <p class="aside-note">This is the first step, not a guarantee of a bed. Openings change week to week, so the sooner we talk, the better.</p>
        </div>
        <div class="aside-card aside-card--call">
          <p class="eyebrow">Rather just talk?</p>
          <a class="button button--light" href={site.phoneHref}><Icon name="lucide:phone" aria-hidden="true" />Call {site.phone}</a>
          <p>You don’t need to fill anything out first.</p>
        </div>
        <p class="privacy-note">This is a public web form, not a secure place for medical, treatment, financial, or legal records. <a href="/privacy/">Read the privacy policy.</a></p>
      </aside>
    </div>
  </section>
</MainLayout>

<style>
  /* The page is the form: the card plus a sticky rail, sized to sit within a laptop screen below the header. */
  .apply { display: grid; min-height: calc(100svh - var(--header-total-height)); padding-block: var(--space-4) var(--space-7); align-content: center; background: var(--sky-50); }
  .apply__layout { display: grid; grid-template-columns: minmax(0, 1fr) 21rem; gap: clamp(var(--space-5), 3vw, var(--space-7)); align-items: stretch; }
  .apply__aside { position: sticky; align-self: start; top: calc(var(--header-total-height) + var(--space-4)); display: grid; gap: var(--space-4); }
  .aside-card { padding: var(--space-5); border: 1px solid var(--slate-200); border-radius: var(--radius-lg); background: var(--paper); }
  .aside-card .eyebrow { margin-bottom: var(--space-3); }
  .apply__aside :global(.steps--circle) { gap: var(--space-3); }
  .apply__aside :global(.steps--circle p) { margin-top: .1rem; font-size: .9rem; line-height: 1.45; }
  .apply__aside :global(.steps--circle h3) { font-size: .95rem; }
  .aside-note { margin-top: var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--slate-200); color: var(--slate-600); font-size: .9rem; line-height: 1.45; }
  .aside-card--call { color: var(--white); background: var(--navy-950); border-color: var(--navy-950); }
  .aside-card--call .eyebrow { color: var(--accent-on-dark); }
  .aside-card--call .button { width: 100%; gap: var(--button-gap); }
  .aside-card--call .button :global(svg) { width: 1rem; height: 1rem; }
  .aside-card--call p:last-child { margin-top: var(--space-2); color: var(--sky-200); font-size: .9rem; }
  .privacy-note { max-width: 60ch; color: var(--slate-600); font-size: var(--form-help-size); line-height: 1.5; }
  .privacy-note a { color: var(--blue-700); font-weight: var(--weight-semibold); text-decoration: underline; }

  @media (max-width: 1080px) {
    .apply__layout { grid-template-columns: 1fr; }
    .apply__aside { position: static; }
  }

  @media (max-width: 900px) {
    .aside-note, .aside-card--call p:last-child, .privacy-note, .apply__aside :global(.steps--circle p) { font-size: 1rem; }
  }

  @media (max-width: 760px) {
    .apply { padding-block: var(--space-5) var(--space-7); }
    .aside-card { padding: var(--space-5); }
  }
</style>
