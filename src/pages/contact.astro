---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import InquiryForm from '../components/InquiryForm.astro';
---
<MainLayout title="Contact" description="Contact New Beginnings about recovery housing, professional referrals, partnerships, or the organization.">
  <PageHero variant="compact" eyebrow="Contact New Beginnings" title="Reach the right conversation." intro="Housing, referrals, organizational questions, and community support can all begin here." fact="This website is not monitored for emergencies or crisis support." />

  <InquiryForm context="contact" title="Send a general inquiry" intro="Choose the reason for your message and tell us how to reach you. Keep medical, treatment, legal, and other sensitive details out of the public form.">
    <div slot="aside" class="inquiry-aside">
      <div><h3>Residence privacy</h3><p>We do not publish recovery-house street addresses. Exact locations are shared privately when appropriate during intake.</p></div>
      <div><h3>Urgent help</h3><p>Call 911 for a medical emergency. Call or text 988 for the Suicide & Crisis Lifeline.</p></div>
    </div>
  </InquiryForm>
</MainLayout>
