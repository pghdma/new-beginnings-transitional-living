---
import { Icon } from 'astro-icon/components';
import MainLayout from '../layouts/MainLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { site } from '../data/site';

const routes = [
  {
    label: 'Housing availability',
    copy: 'For yourself, a loved one, or someone you support.',
    href: '/admissions/',
    action: 'Review admissions',
    icon: 'home',
  },
  {
    label: 'Professional referral',
    copy: 'For providers, case managers, discharge planners, courts, and community partners.',
    href: '/referrals/',
    action: 'Referral information',
    icon: 'briefcase-medical',
  },
  {
    label: 'Support or partnership',
    copy: 'For contributions, practical support, and community partnerships.',
    href: '/support-us/',
    action: 'Ways to support',
    icon: 'heart-handshake',
  },
  {
    label: 'Organization questions',
    copy: 'For governance, credentials, licensing, or public-record questions.',
    href: '/about/transparency/',
    action: 'Review public information',
    icon: 'badge-check',
  },
];
---

<MainLayout title="Contact" description="Contact New Beginnings about recovery housing, professional referrals, partnerships, or the organization.">
  <section class="contact-hero" aria-labelledby="contact-hero-title">
    <img
      class="contact-hero__image"
      src="/images/windowed-living-room.webp"
      alt="A bright living and dining room with wide windows"
      width="2200"
      height="1467"
      loading="eager"
    />
    <div class="contact-hero__shade" aria-hidden="true"></div>
    <div class="container contact-hero__inner">
      <div class="contact-hero__copy">
        <p class="eyebrow">Contact New Beginnings</p>
        <h1 id="contact-hero-title">Start with the right conversation.</h1>
        <p class="lead">Housing questions, professional referrals, community support, and organizational questions can all begin here.</p>
        <div class="actions">
          <a class="button button--light" href={site.phoneHref}>
            <Icon name="lucide:phone" aria-hidden="true" />
            Call {site.phone}
          </a>
          <a class="button contact-hero__message" href="#inquiry">Send a general message</a>
        </div>
        <p class="contact-hero__boundary"><Icon name="lucide:circle-alert" aria-hidden="true" />This website and phone line are not emergency or crisis services.</p>
      </div>
    </div>
  </section>

  <section class="section contact-directory" aria-labelledby="contact-start-title">
    <div class="container directory-layout">
      <header class="directory-intro">
        <p class="eyebrow">Choose the right route</p>
        <h2 id="contact-start-title">One organization. A few different starting points.</h2>
        <p class="lead">Choose the path closest to your question. If you are unsure, call or use the general form below.</p>
      </header>

      <div class="routing-options">
        <ul>
          {routes.map((route) => (
            <li>
              <Icon name={`lucide:${route.icon}`} aria-hidden="true" />
              <div>
                <h3>{route.label}</h3>
                <p>{route.copy}</p>
                <a href={route.href}>{route.action}<Icon name="lucide:arrow-up-right" aria-hidden="true" /></a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="service-area" aria-labelledby="service-area-title">
    <figure>
      <img src="/images/pittsburgh-rowhouses.webp" alt="A residential street of closely spaced houses in Pittsburgh" width="1800" height="1204" loading="lazy" />
    </figure>
    <div class="service-area-copy">
      <p class="eyebrow">Service area</p>
      <h2 id="service-area-title">Pittsburgh and surrounding Allegheny County communities.</h2>
      <p>Neighborhood-level information helps prospective residents and referral partners understand the general service area without publishing someone’s home address.</p>
      <div class="service-area-notes">
        <div>
          <Icon name="lucide:map-pin" aria-hidden="true" />
          <p><strong>Examples in public records</strong>{site.neighborhoods.join(' · ')}. Additional homes serve other Pittsburgh-area communities.</p>
        </div>
        <div>
          <Icon name="lucide:lock-keyhole" aria-hidden="true" />
          <p><strong>Residence privacy</strong>Exact locations are shared privately when appropriate during the intake process.</p>
        </div>
      </div>
    </div>
  </section>

  <InquiryForm
    context="contact"
    title="Send a general inquiry"
    intro="Choose the reason for your message and tell us how to reach you. Keep medical, treatment, legal, and other sensitive details out of the public form."
  >
    <div slot="aside" class="inquiry-aside">
      <div>
        <h3>Residence privacy</h3>
        <p>Recovery-house street addresses are not published. Exact locations are shared privately when appropriate.</p>
      </div>
      <div>
        <h3>Urgent help</h3>
        <p>Call 911 for a medical emergency. Call or text 988 for the Suicide &amp; Crisis Lifeline.</p>
      </div>
    </div>
  </InquiryForm>
</MainLayout>

<style>
  .contact-hero { position: relative; display: grid; min-height: clamp(35rem, 57vw, 45rem); overflow: hidden; align-items: center; color: var(--white); background: var(--navy-950); }
  .contact-hero__image,
  .contact-hero__shade { position: absolute; width: 100%; height: 100%; inset: 0; }
  .contact-hero__image { object-fit: cover; object-position: 58% center; filter: saturate(.82) contrast(.98); }
  .contact-hero__shade { background: linear-gradient(90deg, rgba(10,35,46,.97) 0%, rgba(10,35,46,.92) 39%, rgba(10,35,46,.66) 61%, rgba(10,35,46,.18) 100%); }
  .contact-hero__inner { position: relative; z-index: 1; padding-block: clamp(5rem, 9vw, 8rem); }
  .contact-hero__copy { max-width: 45rem; }
  .contact-hero .eyebrow { color: #a6ddd8; }
  .contact-hero h1 { max-width: 10ch; margin-top: var(--space-4); color: var(--white); font-size: clamp(3.25rem, 6vw, 5.5rem); }
  .contact-hero .lead { max-width: 36rem; margin-top: var(--space-5); color: #edf5f4; }
  .contact-hero .actions { margin-top: var(--space-6); }
  .contact-hero .button { gap: .65rem; }
  .contact-hero .button :global(svg) { width: 1.05rem; height: 1.05rem; }
  .contact-hero__message { border-color: rgba(255,255,255,.72); background: rgba(10,35,46,.22); }
  .contact-hero__message:hover { color: var(--navy-950); background: var(--white); }
  .contact-hero__boundary { display: flex; max-width: 34rem; margin-top: var(--space-7); align-items: flex-start; gap: .65rem; color: #d6e8e6; font-size: .93rem; }
  .contact-hero__boundary :global(svg) { width: 1.1rem; height: 1.1rem; margin-top: .2rem; color: #a6ddd8; flex: 0 0 auto; }

  .contact-directory { background: var(--paper); }
  .directory-layout { display: grid; grid-template-columns: minmax(18rem, .68fr) minmax(0, 1.32fr); gap: clamp(3rem, 8vw, 7rem); align-items: start; }
  .directory-intro { display: grid; gap: var(--space-4); }
  .directory-intro h2 { max-width: 12ch; }
  .routing-options ul { display: grid; margin: 0; padding: 0; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); list-style: none; }
  .routing-options li { display: grid; min-height: 15rem; padding: clamp(1.5rem, 3vw, 2.25rem); grid-template-columns: 2.25rem minmax(0, 1fr); gap: var(--space-4); background: var(--sky-50); box-shadow: var(--shadow); align-content: start; }
  .routing-options li > :global(svg) { width: 2rem; height: 2rem; color: var(--teal-700); stroke-width: 1.5; }
  .routing-options h3 { font-size: 1.3rem; }
  .routing-options p { max-width: 28rem; margin-top: var(--space-3); color: var(--slate-600); line-height: 1.5; }
  .routing-options a { display: inline-flex; margin-top: var(--space-5); align-items: center; gap: .55rem; font-weight: 650; }
  .routing-options a :global(svg) { width: 1rem; height: 1rem; }

  .service-area { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr); align-items: stretch; background: var(--sky-50); }
  .service-area figure { min-height: 37rem; margin: 0; overflow: hidden; }
  .service-area figure img { width: 100%; height: 100%; object-fit: cover; object-position: 47% center; filter: saturate(.82) contrast(.98); }
  .service-area-copy { display: flex; max-width: 43rem; padding: var(--section-standard) clamp(2.5rem, 6vw, 6rem); flex-direction: column; justify-content: center; }
  .service-area-copy h2 { max-width: 13ch; margin-top: var(--space-4); font-size: clamp(2rem, 3.6vw, 3.25rem); }
  .service-area-copy > p:not(.eyebrow) { max-width: 36rem; margin-top: var(--space-5); }
  .service-area-notes { display: grid; margin-top: var(--space-7); padding: var(--space-5); gap: var(--space-5); background: var(--paper); box-shadow: var(--shadow); }
  .service-area-notes > div { display: grid; grid-template-columns: 1.7rem minmax(0, 1fr); gap: var(--space-3); align-items: start; }
  .service-area-notes :global(svg) { width: 1.45rem; height: 1.45rem; margin-top: .15rem; color: var(--teal-700); stroke-width: 1.6; }
  .service-area-notes p { line-height: 1.5; }
  .service-area-notes strong { display: block; margin-bottom: .25rem; color: var(--navy-900); font-size: .88rem; font-weight: 650; letter-spacing: .04em; text-transform: uppercase; }

  @media (max-width: 820px) {
    .directory-layout,
    .service-area { grid-template-columns: 1fr; }
    .directory-layout { gap: var(--space-7); }
    .service-area figure { height: clamp(20rem, 62vw, 29rem); min-height: 0; }
    .service-area-copy { max-width: none; padding: var(--section-standard) var(--gutter); }
  }

  @media (max-width: 600px) {
    .contact-hero { min-height: 42rem; align-items: end; }
    .contact-hero__image { object-position: 64% center; }
    .contact-hero__shade { background: linear-gradient(0deg, rgba(10,35,46,.97) 0%, rgba(10,35,46,.86) 58%, rgba(10,35,46,.35) 100%); }
    .contact-hero__inner { padding-block: var(--space-8); }
    .contact-hero h1 { font-size: clamp(2.8rem, 12vw, 3.6rem); }
    .contact-hero .actions { display: grid; }
    .contact-hero .button { width: 100%; }
    .routing-options ul { grid-template-columns: 1fr; }
    .routing-options li { min-height: 0; padding: var(--space-5); }
    .service-area figure { order: -1; }
  }
</style>
