---
import { Icon } from 'astro-icon/components';
import Hero from '../components/Hero.astro';
import MainLayout from '../layouts/MainLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { site } from '../data/site';

const officeLine = `${site.office.city}, ${site.office.state} ${site.office.zip}`;
---

<MainLayout title="Contact" description="Call 412-628-0403 or send a message to New Beginnings about a bed in one of our Pittsburgh sober living houses, a client referral, a donation, or anything else.">
  <Hero
    variant="image"
    size="md"
    height="short"
    align="center"
    titleId="contact-title"
    eyebrow="Contact"
    title="Call, Email, or Send a Message"
    lead="Looking for a bed, referring a client, or just have a question? The fastest answer is a phone call. The form works too, and we’ll get back to you."
    image={{ src: '/images/pittsburgh-point-panorama.webp', alt: '', width: 2400, height: 680, position: 'center 52%', positionMobile: '68% center' }}
  />

  <section class="contact-main" aria-label="Contact details and message form">
    <div class="container contact-shell">
      <div class="contact-details">
        <header>
          <p class="eyebrow">Reach Us</p>
          <h2>Ways to Reach New Beginnings</h2>
          <p>Phone is best for anything about housing. Openings change week to week.</p>
        </header>

        <ul class="contact-list">
          <li>
            <span class="icon-medallion icon-medallion--dark" aria-hidden="true">
              <Icon name="lucide:phone" />
            </span>
            <div>
              <h3>Call Us</h3>
              <a href={site.phoneHref}>{site.phone}</a>
            </div>
          </li>
          <li>
            <span class="icon-medallion icon-medallion--dark" aria-hidden="true">
              <Icon name="lucide:mail" />
            </span>
            <div>
              <h3>Email Us</h3>
              <a href={site.emailHref}>{site.email}</a>
            </div>
          </li>
          <li>
            <span class="icon-medallion icon-medallion--dark" aria-hidden="true">
              <Icon name="lucide:map-pin" />
            </span>
            <div>
              <h3>Administrative Office</h3>
              <address>
                {site.office.street}<br />
                {officeLine}
              </address>
              <a
                class="directions-link"
                href={site.office.directionsHref}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Get directions, opens in a new tab"
              >
                Get Directions
                <Icon name="lucide:external-link" aria-hidden="true" />
              </a>
            </div>
          </li>
        </ul>

        <p class="office-note"><Icon name="lucide:info" aria-hidden="true" />This is our office in Mt. Washington, not one of the houses. Please call before stopping by.</p>
      </div>

      <InquiryForm />
    </div>
  </section>

  <section class="contact-safety" aria-labelledby="contact-safety-title">
    <div class="container contact-safety__inner">
      <span class="icon-medallion" aria-hidden="true">
        <Icon name="lucide:heart-pulse" />
      </span>
      <div>
        <h2 id="contact-safety-title">Need Help Right Now?</h2>
        <p>New Beginnings isn’t an emergency or crisis service. Call 911 for an emergency. Call or text 988 for crisis support.</p>
      </div>
    </div>
  </section>
</MainLayout>
<style>









  .contact-main{
    padding-block: var(--section-compact);
    background: var(--sky-50);
  }

  .contact-shell{ border-radius: var(--radius-lg);
    display: grid;
    grid-template-columns: minmax(18rem, .78fr) minmax(0, 1.22fr);
    overflow: hidden;
    background: var(--paper);
    box-shadow: var(--shadow-raised);
  }

  .contact-details{
    display: flex;
    min-width: 0;
    padding: clamp(var(--space-6), 4vw, var(--space-8));
    color: var(--white);
    background: var(--navy-900);
    flex-direction: column;
  }

  .contact-details header{
    display: grid;
    gap: var(--space-3);
  }

  .contact-details .eyebrow{
    color: var(--accent-on-image);
  }

  .contact-details h2,
  .contact-details h3{
    color: var(--white);
  }

  .contact-details h2{
    max-width: 24ch;
    font-size: var(--type-section-md);
  }

  .contact-details header > p:last-child{
    max-width: 28rem;
    color: var(--sky-200);
  }

  .contact-list{
    display: grid;
    margin: var(--space-7) 0 0;
    padding: 0;
    gap: var(--space-6);
    list-style: none;
  }

  .contact-list li{
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
  }

  .contact-list h3{
    margin-bottom: var(--space-2);
    font-size: 1.15rem;
  }

  .contact-list a,
  .contact-list address{
    color: var(--sky-100);
    font-style: normal;
    line-height: 1.55;
  }

  .contact-list a{
    font-weight: var(--weight-heading);
  }

  .contact-list a:hover{
    color: var(--white);
  }

  .directions-link{
    display: inline-flex;
    margin-top: var(--space-3);
    align-items: center;
    gap: var(--space-2);
  }

  .directions-link :global(svg){
    width: 1rem;
    height: 1rem;
  }

  .office-note{
    display: grid;
    margin-top: auto;
    padding-top: var(--space-7);
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    color: var(--sky-200);
    font-size: .9rem;
    line-height: 1.5;
  }

  .office-note :global(svg){
    width: 1.15rem;
    height: 1.15rem;
    margin-top: .15rem;
    color: var(--accent-on-image);
  }

  .contact-safety{
    padding-block: var(--section-compact);
    background: var(--paper);
  }

  .contact-safety__inner{
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-5);
    align-items: center;
  }

  .contact-safety h2{
    font-size: clamp(1.6rem, 2.5vw, 2.15rem);
  }

  .contact-safety p{
    max-width: 48rem;
    margin-top: var(--space-2);
  }

  @media (max-width: 900px) {
    .contact-shell{
      grid-template-columns: 1fr;
    }

    .contact-details{
      min-height: 0;
    }

    .office-note{
      margin-top: var(--space-7);
    }

    .contact-safety__inner{
      grid-template-columns: auto minmax(0, 1fr);
    }

  }

  @media (max-width: 760px) {



  }

  @media (max-width: 480px) {


    .contact-main{
      padding-block: var(--space-7);
    }

    .contact-details{
      padding: var(--space-6) var(--space-5);
    }

    .contact-list{
      gap: var(--space-5);
    }

    .contact-safety__inner{
      grid-template-columns: 1fr;
    }

    .contact-safety__inner > .icon-medallion{
      margin-bottom: var(--space-1);
    }

  }

  /* Mobile floor: 16px copy, one alignment per section, 44px tap targets. Measured by scripts/mobile-audit.mjs */
  @media (max-width: 900px) {
    .office-note{ font-size: 1rem; line-height: 1.55; }
    .contact-list a, .directions-link{ display: inline-flex; min-height: 2.75rem; align-items: center; }
  }
</style>
