---
import MainLayout from '../layouts/MainLayout.astro'; import PageHero from '../components/PageHero.astro'; import InquiryForm from '../components/InquiryForm.astro'; import { site } from '../data/site';
---
<MainLayout title="Contact"><PageHero eyebrow="Contact" title="Reach New Beginnings." intro="Whether you are looking for housing, helping someone else, or exploring a partnership, start with a call or general inquiry." image="/images/contact.jpg" imageAlt="A phone and notebook on an uncluttered desk" compact />
<section class="section"><div class="container grid-2"><div><p class="eyebrow">Call us</p><h2><a href={site.phoneHref}>{site.phone}</a></h2><p class="lead">This is the primary public number for housing, referrals, and organizational questions.</p></div><div><h3>Residence privacy</h3><p>We do not publish recovery-house street addresses. Exact locations are shared privately when appropriate during intake.</p><h3>Urgent help</h3><p>New Beginnings is not an emergency service. Call 911 for a medical emergency. Call or text 988 for the Suicide & Crisis Lifeline.</p></div></div></section><InquiryForm title="Send a general inquiry" /></MainLayout>
<style>h2 a { color: var(--navy-950); } .grid-2 > div:last-child { display: grid; gap: 1rem; }</style>
