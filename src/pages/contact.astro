---
import { Icon } from 'astro-icon/components';
import MainLayout from '../layouts/MainLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { site } from '../data/site';

const officeLine = `${site.office.city}, ${site.office.state} ${site.office.zip}`;
---

<MainLayout title="Contact" description="Call, email, or send a message to New Beginnings about recovery housing, professional questions, donations, or the organization.">
  <section class="contact-intro" aria-labelledby="contact-title">
    <div class="container contact-intro__grid">
      <div class="contact-intro__copy">
        <p class="eyebrow">Contact New Beginnings</p>
        <h1 id="contact-title">Contact New Beginnings</h1>
        <p class="lead">Questions about recovery housing, professional information, donations, or the organization can begin with a call, an email, or a message.</p>
      </div>
      <figure class="contact-intro__media">
        <img src="/images/rustic-dining-room.webp" alt="An empty dining room with a shared table and natural light" width="1600" height="2133" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <section class="contact-main" aria-label="Contact Details and Message Form">
    <div class="container contact-shell">
      <div class="contact-details">
        <header>
          <p class="eyebrow">Contact Details</p>
          <h2>Ways to Reach Us</h2>
          <p>Choose the contact option that works best for you.</p>
        </header>

        <ul class="contact-list">
          <li>
            <span class="icon-medallion icon-medallion--dark" aria-hidden="true">
              <Icon name="lucide:phone" />
            </span>
            <div>
              <h3>Call Us</h3>
              <a href={site.phoneHref}>{site.phone}</a>
            </div>
          </li>
          <li>
            <span class="icon-medallion icon-medallion--dark" aria-hidden="true">
              <Icon name="lucide:mail" />
            </span>
            <div>
              <h3>Email Us</h3>
              <a href={site.emailHref}>{site.email}</a>
            </div>
          </li>
          <li>
            <span class="icon-medallion icon-medallion--dark" aria-hidden="true">
              <Icon name="lucide:map-pin" />
            </span>
            <div>
              <h3>Administrative Office</h3>
              <address>
                {site.office.street}<br />
                {officeLine}
              </address>
              <a class="directions-link" href={site.office.directionsHref} target="_blank" rel="noopener noreferrer">
                Get Directions
                <Icon name="lucide:external-link" aria-hidden="true" />
              </a>
            </div>
          </li>
        </ul>

        <p class="office-note"><Icon name="lucide:info" aria-hidden="true" />This is the administrative office, not a recovery residence. Please call before visiting.</p>
      </div>

      <InquiryForm />
    </div>
  </section>

  <section class="contact-safety" aria-labelledby="contact-safety-title">
    <div class="container contact-safety__inner">
      <span class="icon-medallion" aria-hidden="true">
        <Icon name="lucide:heart-pulse" />
      </span>
      <div>
        <h2 id="contact-safety-title">Need Immediate Help?</h2>
        <p>New Beginnings is not an emergency or crisis service. Call 911 for an emergency. Call or text 988 for crisis support.</p>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .contact-intro {
    color: var(--white);
    background: var(--navy-950);
  }

  .contact-intro__grid {
    display: grid;
    height: clamp(26rem, 35vw, 31rem);
    grid-template-columns: minmax(0, 1.08fr) minmax(22rem, .92fr);
    align-items: stretch;
  }

  .contact-intro__copy {
    display: grid;
    padding: clamp(3.75rem, 6vw, 5rem) clamp(2.5rem, 5vw, 4.5rem) clamp(3.75rem, 6vw, 5rem) 0;
    align-content: center;
    gap: var(--space-4);
  }

  .contact-intro__media {
    position: relative;
    min-width: 0;
    min-height: 0;
    margin: 0 calc((100vw - min(100vw - (var(--gutter) * 2), var(--max))) / -2) 0 0;
    overflow: hidden;
    background: var(--navy-900);
  }

  .contact-intro__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 63%;
    filter: saturate(.82) contrast(.98);
  }

  .contact-intro .eyebrow {
    color: #a6ddd8;
  }

  .contact-intro h1 {
    max-width: 12ch;
    color: var(--white);
    font-size: clamp(3.1rem, 5vw, 4.5rem);
  }

  .contact-intro .lead {
    max-width: 46rem;
    color: var(--sky-100);
  }

  .contact-main {
    padding-block: var(--section-compact);
    background: var(--sky-50);
  }

  .contact-shell {
    display: grid;
    grid-template-columns: minmax(18rem, .78fr) minmax(0, 1.22fr);
    overflow: hidden;
    background: var(--paper);
    box-shadow: var(--shadow-raised);
  }

  .contact-details {
    display: flex;
    min-width: 0;
    padding: clamp(var(--space-6), 4vw, var(--space-8));
    color: var(--white);
    background: var(--navy-900);
    flex-direction: column;
  }

  .contact-details header {
    display: grid;
    gap: var(--space-3);
  }

  .contact-details .eyebrow {
    color: #a6ddd8;
  }

  .contact-details h2,
  .contact-details h3 {
    color: var(--white);
  }

  .contact-details h2 {
    max-width: 12ch;
    font-size: clamp(2rem, 3.1vw, 2.8rem);
  }

  .contact-details header > p:last-child {
    max-width: 28rem;
    color: var(--sky-200);
  }

  .contact-list {
    display: grid;
    margin: var(--space-7) 0 0;
    padding: 0;
    gap: var(--space-6);
    list-style: none;
  }

  .contact-list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
  }

  .contact-list h3 {
    margin-bottom: var(--space-2);
    font-size: 1.15rem;
  }

  .contact-list a,
  .contact-list address {
    color: var(--sky-100);
    font-style: normal;
    line-height: 1.55;
  }

  .contact-list a {
    font-weight: 600;
  }

  .contact-list a:hover {
    color: var(--white);
  }

  .directions-link {
    display: inline-flex;
    margin-top: var(--space-3);
    align-items: center;
    gap: var(--space-2);
  }

  .directions-link :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .office-note {
    display: grid;
    margin-top: auto;
    padding-top: var(--space-7);
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    color: var(--sky-200);
    font-size: .9rem;
    line-height: 1.5;
  }

  .office-note :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
    margin-top: .15rem;
    color: #a6ddd8;
  }

  .contact-safety {
    padding-block: var(--section-compact);
    background: var(--paper);
  }

  .contact-safety__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-5);
    align-items: center;
  }

  .contact-safety h2 {
    font-size: clamp(1.6rem, 2.5vw, 2.15rem);
  }

  .contact-safety p {
    max-width: 48rem;
    margin-top: var(--space-2);
  }

  @media (max-width: 860px) {
    .contact-intro__grid {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, .82fr);
    }

    .contact-intro__copy {
      padding-right: var(--space-6);
    }

    .contact-shell {
      grid-template-columns: 1fr;
    }

    .contact-details {
      min-height: 0;
    }

    .office-note {
      margin-top: var(--space-7);
    }

    .contact-safety__inner {
      grid-template-columns: auto minmax(0, 1fr);
    }

  }

  @media (max-width: 720px) {
    .contact-intro__grid {
      height: auto;
      grid-template-columns: 1fr;
    }

    .contact-intro__media {
      height: clamp(13.5rem, 48vw, 18rem);
      margin-inline: calc(var(--gutter) * -1);
    }

    .contact-intro__media img {
      object-position: center 64%;
    }

    .contact-intro__copy {
      padding: var(--space-7) 0;
    }
  }

  @media (max-width: 560px) {

    .contact-intro h1 {
      font-size: clamp(2.65rem, 12vw, 3.35rem);
    }

    .contact-main {
      padding-block: var(--space-7);
    }

    .contact-details {
      padding: var(--space-6) var(--space-5);
    }

    .contact-list {
      gap: var(--space-5);
    }

    .contact-safety__inner {
      grid-template-columns: 1fr;
    }

    .contact-safety__inner > .icon-medallion {
      margin-bottom: var(--space-1);
    }

  }
</style>
