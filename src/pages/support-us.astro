---
import { Icon } from 'astro-icon/components';
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';

const supportPaths = [
  {
    number: '01',
    icon: 'hand-coins',
    eyebrow: 'Financial support',
    title: 'Discuss a contribution directly.',
    copy: 'Online giving is not currently offered through this website. Contact New Beginnings to ask how financial contributions are being accepted and to receive appropriate documentation.',
    label: 'Ask about contributing',
  },
  {
    number: '02',
    icon: 'package-check',
    eyebrow: 'Practical support',
    title: 'Ask before collecting supplies.',
    copy: 'Household needs change. Before purchasing, collecting, or delivering items, contact the organization so any support can be matched to a current need.',
    label: 'Ask about current needs',
  },
  {
    number: '03',
    icon: 'handshake',
    eyebrow: 'Community partnership',
    title: 'Start a partnership conversation.',
    copy: 'Businesses, nonprofits, faith communities, and civic organizations can begin with a conversation about responsible ways to strengthen recovery housing.',
    label: 'Discuss a partnership',
  },
];
---

<MainLayout title="Support Our Work" description="Support nonprofit recovery housing for adult men and women in Pittsburgh-area communities.">
  <PageHero
    variant="image"
    eyebrow="Support New Beginnings"
    title="Strengthen the ordinary work of a stable home."
    intro="Community support helps sustain the practical resources and local relationships behind recovery-focused housing for adult men and women."
    image="/images/household-linens.webp"
    imageAlt="Clean household linens folded on a shelf"
    fact="Start with a direct conversation. Online giving is not currently offered through this website."
  />

  <section class="section support-foundation" aria-labelledby="foundation-title">
    <div class="container foundation-layout">
      <header>
        <p class="eyebrow">A Pittsburgh public charity</p>
        <h2 id="foundation-title">Support that reaches daily life.</h2>
      </header>
      <div class="foundation-copy">
        <p class="lead">New Beginnings Transitional Living Foundation is a tax-exempt 501(c)(3) public charity serving adults in recovery.</p>
        <p>Stable housing depends on ordinary, practical resources as well as long-term community relationships. The right place to begin is a conversation about what would be useful now.</p>
        <dl>
          <div><dt>Federal tax status</dt><dd>501(c)(3) public charity</dd></div>
          <div><dt>Employer identification number</dt><dd>{site.ein}</dd></div>
          <div><dt>Contribution note</dt><dd>Tax-deductible to the extent permitted by law</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="support-options" aria-labelledby="options-title">
    <div class="container">
      <header class="options-intro">
        <p class="eyebrow">Ways to help</p>
        <h2 id="options-title">Begin with the support you have in mind.</h2>
      </header>

      <div class="support-stories">
        {supportPaths.map((path, index) => (
          <article class:list={[{ 'story--reverse': index === 1 }]}>
            <div class="story-heading">
              <span class="story-number">{path.number}</span>
              <Icon name={`lucide:${path.icon}`} aria-hidden="true" />
              <div><p class="eyebrow">{path.eyebrow}</p><h3>{path.title}</h3></div>
            </div>
            <div class="story-body">
              <p>{path.copy}</p>
              <a class="text-link" href="/contact/#inquiry">{path.label}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="stewardship" aria-labelledby="stewardship-title">
    <div class="container stewardship-layout">
      <div>
        <p class="eyebrow">Accountability before support</p>
        <h2 id="stewardship-title">Review the organization for yourself.</h2>
      </div>
      <div class="stewardship-copy">
        <p>Public nonprofit records and independent recovery-housing credentials are available for supporters who want to understand the organization before contributing.</p>
        <ul>
          <li><span>501(c)(3) status, EIN, and available public filings</span><a href="/about/transparency/">Review nonprofit records</a></li>
          <li><span>Pennsylvania DDAP licensing and WestPARR inspection</span><a href="/about/transparency/">Review housing credentials</a></li>
        </ul>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .support-foundation { background: var(--paper); }
  .foundation-layout { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 1.25fr); gap: clamp(3rem, 8vw, 8rem); align-items: start; }
  .foundation-layout > header { display: grid; gap: var(--space-4); }
  .foundation-layout > header h2 { max-width: 12ch; }
  .foundation-copy { max-width: 47rem; }
  .foundation-copy > p + p { margin-top: var(--space-5); }
  .foundation-copy dl { margin: var(--space-7) 0 0; border-top: 1px solid var(--slate-300); }
  .foundation-copy dl > div { display: grid; padding-block: var(--space-4); border-bottom: 1px solid var(--slate-300); grid-template-columns: minmax(12rem, .68fr) minmax(0, 1.32fr); gap: var(--space-5); }
  .foundation-copy dt { color: var(--slate-600); font-size: .78rem; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; }
  .foundation-copy dd { margin: 0; color: var(--navy-900); font-weight: 600; }

  .support-options { padding-block: var(--section-standard); background: var(--sky-50); }
  .options-intro { display: grid; max-width: 48rem; margin-bottom: var(--space-8); gap: var(--space-4); }
  .options-intro h2 { max-width: 15ch; }
  .support-stories { border-top: 1px solid var(--slate-300); }
  .support-stories article { display: grid; padding-block: clamp(2.5rem, 6vw, 4.5rem); border-bottom: 1px solid var(--slate-300); grid-template-columns: minmax(0, 1.04fr) minmax(18rem, .96fr); gap: clamp(3rem, 8vw, 8rem); align-items: center; }
  .story-heading { display: grid; grid-template-columns: 2.5rem 3rem minmax(0, 1fr); gap: var(--space-4); align-items: start; }
  .story-heading :global(svg) { width: 2.25rem; height: 2.25rem; color: var(--teal-700); stroke-width: 1.45; }
  .story-number { padding-top: .25rem; color: var(--slate-600); font-size: .76rem; font-weight: 650; letter-spacing: .08em; }
  .story-heading h3 { max-width: 13ch; margin-top: var(--space-3); font-size: clamp(1.65rem, 3vw, 2.35rem); }
  .story-body { max-width: 35rem; }
  .story-body > p { color: var(--slate-700); font-size: 1.08rem; }
  .story-body .text-link { margin-top: var(--space-5); }
  .story--reverse .story-heading { grid-column: 2; }
  .story--reverse .story-body { grid-column: 1; grid-row: 1; }

  .stewardship { padding-block: var(--section-standard); color: var(--white); background: var(--navy-950); }
  .stewardship-layout { display: grid; grid-template-columns: minmax(0, .74fr) minmax(0, 1.26fr); gap: clamp(3rem, 8vw, 8rem); align-items: start; }
  .stewardship-layout > div:first-child { display: grid; gap: var(--space-4); }
  .stewardship .eyebrow { color: #9ed7d2; }
  .stewardship h2 { max-width: 12ch; color: var(--white); }
  .stewardship-copy > p { max-width: 43rem; color: var(--sky-100); font-size: 1.12rem; }
  .stewardship-copy ul { margin: var(--space-6) 0 0; padding: 0; border-top: 1px solid rgba(255, 255, 255, .24); list-style: none; }
  .stewardship-copy li { display: grid; padding-block: var(--space-5); border-bottom: 1px solid rgba(255, 255, 255, .24); grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-5); align-items: center; }
  .stewardship-copy li span { color: var(--sky-100); }
  .stewardship-copy a { color: var(--white); font-weight: 650; }
  .stewardship-copy a:hover { color: #b9e5e1; }

  @media (max-width: 820px) {
    .foundation-layout,
    .stewardship-layout { grid-template-columns: 1fr; gap: var(--space-7); }
    .support-stories article { grid-template-columns: 1fr; gap: var(--space-6); }
    .story--reverse .story-heading,
    .story--reverse .story-body { grid-column: auto; grid-row: auto; }
  }

  @media (max-width: 560px) {
    .options-intro { margin-bottom: var(--space-6); }
    .story-heading { grid-template-columns: 2rem 2.5rem minmax(0, 1fr); gap: var(--space-3); }
    .story-heading :global(svg) { width: 1.9rem; height: 1.9rem; }
    .foundation-copy dl > div,
    .stewardship-copy li { grid-template-columns: 1fr; gap: var(--space-2); }
  }
</style>
