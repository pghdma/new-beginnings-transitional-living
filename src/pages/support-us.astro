---
import { Icon } from 'astro-icon/components';
import MainLayout from '../layouts/MainLayout.astro';
import { site } from '../data/site';

const supportPaths = [
  {
    icon: 'hand-coins',
    eyebrow: 'Financial support',
    title: 'Discuss a contribution directly.',
    copy: 'Online giving is not currently offered through this website. Contact New Beginnings to ask how financial contributions are being accepted and to receive appropriate documentation.',
    label: 'Ask about contributing',
  },
  {
    icon: 'package-check',
    eyebrow: 'Practical support',
    title: 'Match help to a current household need.',
    copy: 'Household needs change. Before purchasing, collecting, or delivering items, contact the organization so practical support can be useful when it arrives.',
    label: 'Ask about current needs',
  },
  {
    icon: 'handshake',
    eyebrow: 'Community partnership',
    title: 'Begin a longer-term conversation.',
    copy: 'Businesses, nonprofits, faith communities, and civic organizations can ask about responsible ways to strengthen recovery housing in the Pittsburgh area.',
    label: 'Discuss a partnership',
  },
];
---

<MainLayout title="Support Our Work" description="Support nonprofit recovery housing for adult men and women in Pittsburgh-area communities.">
  <section class="support-hero" aria-labelledby="support-title">
    <div class="container support-hero__grid">
      <div class="support-hero__copy">
        <p class="eyebrow">Support New Beginnings</p>
        <h1 id="support-title">Help sustain the everyday work of a stable home.</h1>
        <p class="lead">Community support can strengthen the practical resources and local relationships behind recovery-focused housing for adult men and women.</p>
        <div class="actions">
          <a class="button button--light" href="/contact/#inquiry">Start a support conversation</a>
        </div>
        <p class="support-hero__truth">Online giving is not currently offered through this website. A direct conversation is the place to begin.</p>
      </div>

      <div class="support-hero__media">
        <figure class="support-hero__photo">
          <img src="/images/home-entry.webp" alt="A welcoming home entry with a staircase and sitting area" width="2200" height="1467" loading="eager" />
        </figure>
      </div>
    </div>
  </section>

  <section class="support-foundation" aria-labelledby="foundation-title">
    <img class="foundation-photo" src="/images/pittsburgh-rowhouses.webp" alt="" width="1800" height="1204" loading="lazy" />
    <div class="foundation-scrim" aria-hidden="true"></div>
    <div class="container foundation-layout">
      <header class="foundation-heading">
        <p class="eyebrow">A Pittsburgh public charity</p>
        <h2 id="foundation-title">Support with a clear purpose.</h2>
        <p class="lead">New Beginnings Transitional Living Foundation is a tax-exempt 501(c)(3) public charity serving adults in recovery.</p>
      </header>

      <div class="foundation-story">
        <p>Stable housing depends on ordinary resources, reliable routines, and strong community relationships. Because needs change, New Beginnings asks supporters to begin with a conversation rather than assume what a residence needs.</p>
        <dl class="foundation-facts" aria-label="Nonprofit information">
          <div><dt>Federal status</dt><dd>501(c)(3) public charity</dd></div>
          <div><dt>Employer identification number</dt><dd>{site.ein}</dd></div>
          <div><dt>Contribution note</dt><dd>Tax-deductible to the extent permitted by law</dd></div>
        </dl>
        <a class="button button--light" href="/about/transparency/">Review public records<Icon name="lucide:arrow-right" aria-hidden="true" /></a>
      </div>
    </div>
  </section>

  <section class="support-routes" aria-labelledby="support-routes-title">
    <div class="container routes-heading">
      <p class="eyebrow">Ways to support</p>
      <h2 id="support-routes-title">Bring the idea. We’ll begin with what is useful now.</h2>
      <p>Choose the conversation closest to the support you have in mind. Each route begins with the same practical step: contact New Beginnings directly.</p>
    </div>

    <div class="container support-scene">
      <figure>
        <img src="/images/house-living-room.webp" alt="A comfortable living room with seating and natural light" width="2200" height="1467" loading="lazy" />
      </figure>
      <div class="support-paths">
        {supportPaths.map((path) => (
          <article>
            <div class="path-icon icon-medallion"><Icon name={`lucide:${path.icon}`} aria-hidden="true" /></div>
            <div>
              <p class="eyebrow">{path.eyebrow}</p>
              <h3>{path.title}</h3>
              <p>{path.copy}</p>
              <a class="text-link" href="/contact/#inquiry">{path.label}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="support-next" aria-labelledby="support-next-title">
    <div class="container support-next__inner">
      <div class="support-next__copy">
        <p class="eyebrow">Accountability before support</p>
        <h2 id="support-next-title">Know the organization. Then start a conversation.</h2>
        <p>Public nonprofit records, Pennsylvania licensing, and independent recovery-housing credentials are available for review.</p>
      </div>
      <div class="support-next__actions">
        <a class="button button--light" href="/contact/#inquiry">Contact New Beginnings</a>
        <a class="support-next__record" href="/about/transparency/">Review credentials and public records</a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .support-hero { overflow: hidden; color: var(--white); background: var(--navy-950); }
  .support-hero__grid { display: grid; min-height: clamp(42rem, 62vw, 50rem); grid-template-columns: minmax(0, .88fr) minmax(0, 1.12fr); align-items: stretch; }
  .support-hero__copy { display: flex; padding: clamp(4.5rem, 8vw, 7rem) clamp(2.5rem, 5vw, 4.5rem) clamp(5.5rem, 9vw, 8rem) 0; flex-direction: column; justify-content: center; }
  .support-hero .eyebrow { color: #9ed7d2; }
  .support-hero h1 { max-width: 10.5ch; margin-top: var(--space-4); color: var(--white); font-size: clamp(3.15rem, 5.6vw, 5.35rem); }
  .support-hero .lead { max-width: 34rem; margin-top: var(--space-5); color: var(--sky-100); }
  .support-hero .actions { margin-top: var(--space-6); }
  .support-hero__truth { max-width: 32rem; margin-top: var(--space-6); color: var(--sky-200); font-size: .95rem; line-height: 1.55; }
  .support-hero__media { position: relative; min-width: 0; margin-right: calc((100vw - min(100vw - (var(--gutter) * 2), var(--max))) / -2); }
  .support-hero__photo { height: 100%; margin: 0; overflow: hidden; }
  .support-hero__photo img { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: saturate(.78) contrast(.98); }

  .support-foundation { position: relative; overflow: hidden; padding-block: var(--section-standard); color: var(--white); background: var(--navy-950); }
  .foundation-photo, .foundation-scrim { position: absolute; inset: 0; width: 100%; height: 100%; }
  .foundation-photo { object-fit: cover; object-position: center 44%; filter: saturate(.64) contrast(.98); }
  .foundation-scrim { background: linear-gradient(90deg, rgba(16,52,67,.96) 0%, rgba(16,52,67,.92) 52%, rgba(16,52,67,.77) 100%); }
  .foundation-layout { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr); gap: clamp(3rem, 8vw, 7.5rem); align-items: start; }
  .foundation-heading { display: grid; gap: var(--space-4); }
  .foundation-heading .eyebrow { color: #9ed7d2; }
  .foundation-heading h2 { max-width: 11ch; color: var(--white); }
  .foundation-heading .lead { max-width: 31rem; margin-top: var(--space-2); color: var(--sky-100); }
  .foundation-story > p { max-width: 43rem; color: var(--sky-100); font-size: 1.12rem; }
  .foundation-facts { display: grid; margin: var(--space-7) 0 0; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }
  .foundation-facts div { padding-top: var(--space-4); border-top: 1px solid rgba(185,229,225,.38); }
  .foundation-facts dt { color: #9ed7d2; font-size: .72rem; font-weight: 650; letter-spacing: .08em; line-height: 1.35; text-transform: uppercase; }
  .foundation-facts dd { margin: var(--space-2) 0 0; color: var(--white); font-size: .95rem; line-height: 1.45; }
  .foundation-story .button { margin-top: var(--space-7); gap: .6rem; }
  .foundation-story .button :global(svg) { width: 1rem; height: 1rem; }

  .support-routes { padding-block: var(--section-standard); background: var(--sky-50); }
  .routes-heading { display: grid; max-width: 50rem; margin-bottom: var(--space-8); gap: var(--space-4); }
  .routes-heading h2 { max-width: 15ch; }
  .routes-heading > p:last-child { max-width: 43rem; }
  .support-scene { display: grid; min-height: 48rem; grid-template-columns: minmax(0, 1.08fr) minmax(25rem, .92fr); align-items: center; }
  .support-scene > figure { height: 100%; min-height: 42rem; margin: 0; overflow: hidden; box-shadow: var(--shadow-raised); }
  .support-scene > figure img { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: saturate(.76) contrast(.98); }
  .support-paths { position: relative; z-index: 1; margin-left: clamp(-4.5rem, -5vw, -2.5rem); padding: clamp(2.25rem, 5vw, 4rem); background: var(--paper); box-shadow: var(--shadow-raised); }
  .support-paths article { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: var(--space-4); align-items: start; }
  .support-paths article + article { margin-top: var(--space-7); }
  .path-icon { width: 3rem; height: 3rem; }
  .path-icon :global(svg) { width: 1.4rem; height: 1.4rem; stroke-width: 1.6; }
  .support-paths h3 { max-width: 16ch; margin-top: var(--space-2); }
  .support-paths article div:last-child > p:not(.eyebrow) { margin-top: var(--space-3); color: var(--slate-600); line-height: 1.55; }
  .support-paths .text-link { margin-top: var(--space-4); }

  .support-next { padding-block: var(--section-standard); color: var(--white); background: var(--navy-950); }
  .support-next__inner { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(17rem, .9fr); gap: clamp(3rem, 8vw, 7rem); align-items: center; }
  .support-next .eyebrow { color: #9ed7d2; }
  .support-next h2 { max-width: 15ch; margin-top: var(--space-4); color: var(--white); }
  .support-next__copy > p:last-child { max-width: 42rem; margin-top: var(--space-5); color: var(--sky-100); }
  .support-next__actions { display: grid; justify-items: start; gap: var(--space-5); }
  .support-next__record { color: var(--white); font-weight: 650; }
  .support-next__record:hover { color: #b9e5e1; }

  @media (max-width: 900px) {
    .support-hero__grid, .foundation-layout, .support-next__inner { grid-template-columns: 1fr; }
    .support-hero__media { order: -1; height: clamp(23rem, 60vw, 32rem); margin: 0 calc(var(--gutter) * -1); }
    .support-hero__copy { padding: var(--space-8) 0; }
    .foundation-layout, .support-next__inner { gap: var(--space-7); }
    .foundation-heading { max-width: 42rem; }
    .foundation-story { max-width: 46rem; }
  }

  @media (max-width: 760px) {
    .support-scene { min-height: 0; grid-template-columns: 1fr; }
    .support-scene > figure { height: clamp(20rem, 62vw, 29rem); min-height: 0; }
    .support-paths { margin: calc(var(--space-6) * -1) var(--space-4) 0; }
    .support-hero__media { height: 19rem; }
    .support-hero__copy { padding-block: var(--space-7); }
    .support-hero h1 { font-size: clamp(2.7rem, 12vw, 3.55rem); }
    .support-hero .button { width: 100%; }
    .foundation-facts { grid-template-columns: 1fr; }
    .foundation-story .button { width: 100%; }
    .routes-heading { margin-bottom: var(--space-6); }
    .support-scene > figure { height: 17rem; }
    .support-paths { margin: calc(var(--space-5) * -1) var(--space-3) 0; padding: var(--space-6) var(--space-5); }
    .support-paths article { grid-template-columns: 2.65rem minmax(0, 1fr); gap: var(--space-3); }
    .support-paths article + article { margin-top: var(--space-6); }
    .path-icon { width: 2.65rem; height: 2.65rem; }
    .support-next__actions .button { width: 100%; }
  }
</style>
