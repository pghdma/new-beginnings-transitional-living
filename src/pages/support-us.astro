---
import { Icon } from 'astro-icon/components';
import MainLayout from '../layouts/MainLayout.astro';
import { site } from '../data/site';

const configuredPayPalUrl = import.meta.env.PUBLIC_PAYPAL_DONATE_URL?.trim();
const paypalDonateUrl = configuredPayPalUrl && /^https:\/\/(?:www\.)?paypal\.com\//i.test(configuredPayPalUrl)
  ? configuredPayPalUrl
  : '';
const paypalReady = Boolean(paypalDonateUrl);

const impactLevels = [
  {
    amount: '25',
    icon: 'package-open',
    title: 'Stock the House',
    copy: 'Cleaning supplies, paper goods, and the everyday things a shared kitchen runs through.',
  },
  {
    amount: '50',
    icon: 'house-heart',
    title: 'Make Up a Bed',
    copy: 'Sheets, blankets, and towels for a resident who arrives with nothing.',
  },
  {
    amount: '100',
    icon: 'key-round',
    title: 'Keep the Lights On',
    copy: 'Helps cover utilities and upkeep in a house full of people rebuilding their lives.',
  },
  {
    amount: '250',
    icon: 'heart-handshake',
    title: 'Help With a Hard Week',
    copy: 'Helps cover the weeks when a resident is between jobs and the bills still come.',
  },
];
---

<MainLayout title="Donate" description="Help keep a sober house open in Pittsburgh. Give once or monthly to New Beginnings, a 501(c)(3) that runs licensed recovery housing for men and women.">
  <section class="donate-hero" aria-labelledby="donate-title">
    <div class="container donate-hero__grid">
      <div class="donate-hero__copy">
        <p class="eyebrow">Support New Beginnings</p>
        <h1 id="donate-title">Help Keep a Sober House Open in Pittsburgh</h1>
        <p class="lead">Rent covers some of it. Donations cover the rest: repairs, furniture, and a made-up bed for someone who arrives with nothing. Give once or monthly.</p>
        <p class="donate-hero__reassurance">
          <Icon name="lucide:badge-check" aria-hidden="true" />
          New Beginnings is a 501(c)(3) public charity. Gifts are tax deductible as allowed by law.
        </p>
      </div>

      <form
        class="donation-planner"
        id="donation-planner"
        action="/contact/"
        method="get"
        data-paypal-url={paypalDonateUrl || undefined}
        aria-labelledby="gift-title"
      >
        <input type="hidden" name="topic" value="Donation" />
        <div class="donation-planner__heading">
          <p class="eyebrow">Make a Gift</p>
          <h2 id="gift-title">Choose Your Gift</h2>
          <p>Pick how often and how much. You’ll confirm before anything is charged.</p>
        </div>

        <fieldset class="choice-group frequency-group">
          <legend>How Often Would You Like to Give?</legend>
          <div class="frequency-options">
            <label>
              <input type="radio" name="frequency" value="One Time" checked />
              <span><Icon name="lucide:gift" aria-hidden="true" />One Time</span>
            </label>
            <label>
              <input type="radio" name="frequency" value="Monthly" />
              <span><Icon name="lucide:calendar-heart" aria-hidden="true" />Monthly</span>
            </label>
          </div>
        </fieldset>

        <fieldset class="choice-group amount-group">
          <legend>Choose an Amount</legend>
          <div class="amount-options">
            {impactLevels.map((level, index) => (
              <label>
                <input type="radio" name="amount" value={level.amount} checked={index === 1} />
                <span>${level.amount}</span>
              </label>
            ))}
            <label class="amount-options__other">
              <input type="radio" name="amount" value="Other" />
              <span>Other</span>
            </label>
          </div>

          <div class="custom-amount" id="custom-amount" hidden>
            <label for="custom-gift-amount">Enter Your Gift Amount</label>
            <div class="custom-amount__control">
              <span aria-hidden="true">$</span>
              <input id="custom-gift-amount" name="customAmount" type="number" min="1" step="1" inputmode="decimal" autocomplete="off" />
            </div>
          </div>
        </fieldset>

        <p class="gift-summary" id="gift-summary" aria-live="polite">Your Planned Gift: $50 One Time</p>

        <button class="button donation-planner__submit" type="submit">
          {paypalReady ? 'Continue With PayPal' : 'Contact Us About This Gift'}
          <Icon name={paypalReady ? 'lucide:external-link' : 'lucide:arrow-right'} aria-hidden="true" />
        </button>

        <p class="donation-planner__note">
          {paypalReady
            ? 'You’ll review and complete your gift securely through PayPal.'
            : 'Online giving is being set up. Until then, send us a note or call and we’ll arrange a one-time or monthly gift with you directly.'}
        </p>
      </form>
    </div>
  </section>

  <section class="gift-impact" aria-labelledby="impact-title">
    <div class="container">
      <header class="section-head section-head--center">
        <p class="eyebrow">Where It Goes</p>
        <h2 id="impact-title">What Your Gift Actually Pays For</h2>
        <p class="lead">New Beginnings is small. There’s no marketing budget and no big staff. Money goes into the houses and the people living in them.</p>
      </header>

      <div class="gift-impact__composition">
        <figure class="gift-impact__media">
          <img src="/images/household-linens.webp" alt="Freshly folded household linens" width="2200" height="1236" loading="lazy" />
          <figcaption>The ordinary things that make a house a home.</figcaption>
        </figure>

        <div class="impact-directory" aria-label="Giving levels">
          {impactLevels.map((level) => (
            <button class="impact-level" type="button" data-impact-amount={level.amount} aria-label={`Choose a $${level.amount} gift`}>
              <span class="impact-level__amount">${level.amount}</span>
              <span class="icon-medallion" aria-hidden="true">
                <Icon name={`lucide:${level.icon}`} />
              </span>
              <span class="impact-level__copy">
                <strong>{level.title}</strong>
                <span>{level.copy}</span>
              </span>
              <Icon class="impact-level__arrow" name="lucide:arrow-up" aria-hidden="true" />
            </button>
          ))}
        </div>
      </div>

      <p class="impact-disclaimer">These examples show the kinds of costs gifts help cover. They aren’t the price of a specific item or a promise of a specific result. Real needs and costs vary.</p>
    </div>
  </section>

  <section class="donation-trust section--navy" aria-labelledby="trust-title">
    <div class="container donation-trust__grid">
      <div class="donation-trust__heading">
        <p class="eyebrow">Give With Confidence</p>
        <h2 id="trust-title">A Pittsburgh Public Charity</h2>
      </div>

      <div class="donation-trust__details">
        <p>New Beginnings Transitional Living Foundation is a 501(c)(3) public charity, tax exempt since 2019. Contributions are deductible to the extent the law allows. Our IRS filings, state license, and WestPARR certification are all public.</p>
        <div class="donation-trust__facts" aria-label="Nonprofit information">
          <div>
            <Icon name="lucide:badge-check" aria-hidden="true" />
            <span><strong>Federal Status</strong>501(c)(3) Public Charity</span>
          </div>
          <div>
            <Icon name="lucide:landmark" aria-hidden="true" />
            <span><strong>Employer Identification Number</strong>{site.ein}</span>
          </div>
        </div>
        <div class="actions">
          <a class="button button--light" href="/about/transparency/">
            See Our Credentials
            <Icon name="lucide:arrow-right" aria-hidden="true" />
          </a>
          <a class="button donation-trust__phone" href={site.phoneHref}>
            <Icon name="lucide:phone" aria-hidden="true" />
            Questions About Giving
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
<style>
  .donate-hero {
    padding-block: var(--section-hero);
    color: var(--white);
    background: var(--navy-950);
  }

  .donate-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, .82fr) minmax(32rem, 1.18fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: center;
  }

  .donate-hero .eyebrow { color: var(--accent-on-dark); }

  .donate-hero h1 {
    max-width: 26ch;
    margin-top: var(--space-4);
    color: var(--white);
    font-size: var(--type-display-donation);
  }

  .donate-hero .lead {
    max-width: 34rem;
    margin-top: var(--space-5);
    color: var(--sky-100);
  }

  .donate-hero__reassurance {
    display: flex;
    margin-top: var(--space-6);
    align-items: center;
    gap: var(--space-3);
    color: var(--sky-200);
    font-weight: var(--weight-heading);
  }

  .donate-hero__reassurance :global(svg) {
    width: 1.55rem;
    height: 1.55rem;
    color: var(--accent-on-dark);
  }

  .donation-planner {
    display: grid;
    padding: clamp(2rem, 4vw, 3rem);
    border: 1px solid rgba(255, 255, 255, .5);
    border-radius: var(--radius-lg);
    color: var(--slate-700);
    background: var(--paper);
    box-shadow: 0 26px 70px rgba(4, 25, 35, .32);
    gap: var(--space-6);
  }

  .donation-planner__heading { display: grid; gap: var(--space-3); }
  .donation-planner__heading .eyebrow { color: var(--teal-700); }
  .donation-planner__heading h2 { font-size: var(--type-section-medium); }
  .donation-planner__heading p:last-child { max-width: 38rem; }

  .choice-group {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .choice-group legend,
  .custom-amount > label {
    margin-bottom: var(--space-3);
    color: var(--navy-900);
    font-size: .92rem;
    font-weight: var(--weight-semibold);
  }

  .frequency-options,
  .amount-options { display: grid; gap: var(--space-2); }
  .frequency-options { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .amount-options { grid-template-columns: repeat(5, minmax(0, 1fr)); }

  .frequency-options label,
  .amount-options label { position: relative; cursor: pointer; }

  .frequency-options input,
  .amount-options input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .frequency-options span,
  .amount-options span {
    display: flex;
    min-height: 3.4rem;
    border: 1px solid var(--slate-300);
    border-radius: var(--radius);
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    color: var(--navy-900);
    background: var(--white);
    font-weight: var(--weight-semibold);
    transition: border-color .15s ease, color .15s ease, background .15s ease;
  }

  .frequency-options span :global(svg) { width: 1.2rem; height: 1.2rem; }
  .frequency-options label:hover span,
  .amount-options label:hover span { border-color: var(--teal-700); }

  .frequency-options input:checked + span,
  .amount-options input:checked + span {
    border-color: var(--teal-700);
    color: var(--white);
    background: var(--teal-700);
    box-shadow: 0 8px 18px rgba(20, 116, 111, .18);
  }

  .frequency-options input:focus-visible + span,
  .amount-options input:focus-visible + span {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .custom-amount[hidden] { display: none; }
  .custom-amount { margin-top: var(--space-4); }

  .custom-amount__control {
    display: grid;
    min-height: 3.5rem;
    border: 1px solid var(--slate-300);
    border-radius: var(--radius);
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    background: var(--white);
  }

  .custom-amount__control span { padding-left: var(--space-4); color: var(--navy-900); font-weight: var(--weight-semibold); }

  .custom-amount__control input {
    width: 100%;
    min-width: 0;
    height: 100%;
    padding: .75rem 1rem .75rem .5rem;
    border: 0;
    outline: 0;
    color: var(--navy-900);
    background: transparent;
  }

  .custom-amount__control:focus-within { outline: 3px solid var(--focus); outline-offset: 3px; }

  .gift-summary {
    padding: var(--space-4);
    color: var(--navy-900);
    background: var(--sky-100);
    font-weight: var(--weight-semibold);
    text-align: center;
  }

  .donation-planner__submit {
    width: 100%;
    min-height: 3.75rem;
    gap: var(--space-3);
    font-size: 1.08rem;
    cursor: pointer;
  }

  .donation-planner__submit :global(svg) { width: 1.15rem; height: 1.15rem; }

  .donation-planner__note {
    color: var(--slate-600);
    font-size: .92rem;
    line-height: 1.5;
    text-align: center;
  }

  .gift-impact { padding-block: var(--section-standard); background: var(--canvas); }

  .gift-impact .section-head {
    max-width: 51rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .gift-impact .section-head h2 { max-width: 30ch; margin-inline: auto; }
  .gift-impact .section-head .lead { margin-inline: auto; }

  .gift-impact__composition { border-radius: var(--radius-lg); overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
    align-items: stretch;
    background: var(--paper);
    box-shadow: var(--shadow-raised);
  }

  .gift-impact__media {
    position: relative;
    min-height: 36rem;
    margin: 0;
    overflow: hidden;
  }

  .gift-impact__media::after {
    position: absolute;
    background: linear-gradient(180deg, transparent 45%, rgba(23, 55, 70, .82));
    content: '';
    inset: 0;
  }

  .gift-impact__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 51% center;
  }

  .gift-impact__media figcaption {
    position: absolute;
    z-index: 1;
    right: var(--space-6);
    bottom: var(--space-6);
    left: var(--space-6);
    max-width: 22rem;
    color: var(--white);
    font-size: 1.15rem;
    font-weight: var(--weight-heading);
  }

  .impact-directory { display: grid; align-content: stretch; }

  .impact-level {
    display: grid;
    min-height: 9rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 0;
    border-bottom: 1px solid var(--slate-200);
    grid-template-columns: 4.5rem 3.25rem minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: center;
    color: inherit;
    background: transparent;
    cursor: pointer;
    text-align: left;
    transition: background .15s ease;
  }

  .impact-level:last-child { border-bottom: 0; }
  .impact-level:hover,
  .impact-level:focus-visible { background: var(--sky-50); }

  .impact-level__amount { color: var(--teal-700); font-size: 1.55rem; font-weight: var(--weight-bold); }
  .impact-level__copy { display: grid; gap: var(--space-1); }

  .impact-level__copy strong {
    color: var(--navy-900);
    font-size: 1.15rem;
    font-weight: var(--weight-semibold);
  }

  .impact-level__copy span { color: var(--slate-600); }

  .impact-level__arrow {
    width: 1.2rem;
    height: 1.2rem;
    color: var(--teal-700);
    transition: transform .15s ease;
  }

  .impact-level:hover .impact-level__arrow { transform: translateY(-.2rem); }

  .impact-disclaimer {
    max-width: 68rem;
    margin: var(--space-5) auto 0;
    color: var(--slate-600);
    font-size: .9rem;
    line-height: 1.5;
    text-align: center;
  }

  .donation-trust { padding-block: var(--section-standard); }

  .donation-trust__grid {
    display: grid;
    grid-template-columns: minmax(0, .78fr) minmax(0, 1.22fr);
    gap: clamp(3rem, 8vw, 7.5rem);
    align-items: start;
  }

  .donation-trust__heading { display: grid; gap: var(--space-4); }
  .donation-trust__heading h2 { max-width: 24ch; color: var(--white); }

  .donation-trust__details > p {
    max-width: 44rem;
    color: var(--sky-100);
    font-size: 1.12rem;
  }

  .donation-trust__facts {
    display: grid;
    margin-top: var(--space-7);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .donation-trust__facts > div {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
    color: var(--sky-100);
  }

  .donation-trust__facts :global(svg) {
    width: 1.65rem;
    height: 1.65rem;
    color: var(--accent-on-dark);
    stroke-width: 1.65;
  }

  .donation-trust__facts span { display: grid; gap: var(--space-1); }

  .donation-trust__facts strong {
    color: var(--white);
    font-size: .8rem;
    font-weight: var(--weight-semibold);
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .donation-trust__details .actions { margin-top: var(--space-7); }
  .donation-trust__details .button { gap: var(--button-gap); }
  .donation-trust__details .button :global(svg) { width: 1.05rem; height: 1.05rem; }

  .donation-trust__phone {
    border-color: rgba(255, 255, 255, .72);
    color: var(--white);
    background: transparent;
  }

  .donation-trust__phone:hover { color: var(--navy-950); background: var(--white); }

  @media (max-width: 1000px) {
    .donate-hero__grid,
    .donation-trust__grid { grid-template-columns: 1fr; }
    .donate-hero__grid { max-width: 47rem; }
    .donate-hero__copy { max-width: 40rem; }
    .donation-trust__grid { gap: var(--space-7); }
    .donation-trust__heading h2 { max-width: 25ch; }
  }

  @media (max-width: 760px) {
    .donate-hero { padding-block: var(--space-8); }
    .donate-hero__grid { gap: var(--space-7); }
    .donate-hero h1 { font-size: clamp(2.65rem, 12.2vw, 3.55rem); }
    .donation-planner { padding: var(--space-5); gap: var(--space-5); }
    .amount-options { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .amount-options__other { grid-column: 1 / -1; }
    .gift-impact__composition { grid-template-columns: 1fr; }
    .gift-impact__media {
      min-width: 0;
      min-height: 0;
      aspect-ratio: 4 / 3;
    }

    .impact-level {
      min-height: auto;
      grid-template-columns: 3.5rem 3.25rem minmax(0, 1fr);
    }

    .impact-level__amount { font-size: 1.3rem; }
    .impact-level__arrow { display: none; }
    .donation-trust__facts { grid-template-columns: 1fr; }
    .donation-trust__details .actions { display: grid; }
    .donation-trust__details .button { width: 100%; }
  }

  @media (max-width: 430px) {
    .donation-planner {
      margin-inline: calc(var(--gutter) * -.25);
      padding: var(--space-5) var(--space-4);
    }

    .frequency-options span { padding-inline: .65rem; font-size: .95rem; }

    .impact-level {
      grid-template-columns: 3.25rem minmax(0, 1fr);
      gap: var(--space-3);
    }

    .impact-level .icon-medallion { grid-column: 1; grid-row: 2; }
    .impact-level__amount { grid-column: 1 / -1; }
    .impact-level__copy { grid-column: 2; grid-row: 2; }
  }

  /* Mobile floor: 16px copy, one alignment per section, 44px tap targets. Measured by scripts/mobile-audit.mjs */
  @media (max-width: 900px) {
    .gift-summary, .donation-planner__note { text-align: left; }
    .donation-planner__note, .impact-disclaimer { font-size: 1rem; line-height: 1.55; }
    .impact-disclaimer { margin-inline: 0; text-align: left; }
  }
</style>
